(module paper.micro-raster)
(import "paper.material" :as material)
(import "paper.paint" :as paint)
(import "paper.objc" :as o)
(import "coil.primitive" :as p)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "paper.scene" :use [scene Sheet Ink intersects])
(import "paper.texture" :as texture)
(import "paper.geometry" :use [clamp])
(import "paper.objc" :use [nil])
(import "paper.ffi" :use *)

;;; Coverage is rasterized separately from numeric microstructure. Float arrays
;;; preserve signed normals and avoid ever blending discrete material IDs.
(defstruct MicroRaster
  [(mask (ptr i8))
   (dx (ptr f32))
   (dy (ptr f32))
   (grain (ptr f32))
   (finish-rough (ptr f32))
   (finish-axis-x (ptr f32))
   (finish-axis-y (ptr f32))
   (specular (ptr f32))
   (metallic (ptr f32))
   (sheen (ptr f32))])

(defn state [] (-> (ptr MicroRaster))
  (p/alloc-static MicroRaster))

(extern free :cc c [(ptr i8)] (-> void))

(defn setup [(enabled bool)] (-> i64)
  (let [m (state)
        s (scene)]
    (when (!= (.mask m) (nil)) (CGContextRelease (.mask m)) 0)
    (free (cast (ptr i8) (.dx m)))
    (free (cast (ptr i8) (.dy m)))
    (free (cast (ptr i8) (.grain m)))
    (free (cast (ptr i8) (.finish-rough m)))
    (free (cast (ptr i8) (.finish-axis-x m)))
    (free (cast (ptr i8) (.finish-axis-y m)))
    (free (cast (ptr i8) (.specular m)))
    (free (cast (ptr i8) (.metallic m)))
    (free (cast (ptr i8) (.sheen m)))
    (set! (.mask m) (nil))
    (set! (.dx m) (cast (ptr f32) 0))
    (set! (.dy m) (cast (ptr f32) 0))
    (set! (.grain m) (cast (ptr f32) 0))
    (set! (.finish-rough m) (cast (ptr f32) 0))
    (set! (.finish-axis-x m) (cast (ptr f32) 0))
    (set! (.finish-axis-y m) (cast (ptr f32) 0))
    (set! (.specular m) (cast (ptr f32) 0))
    (set! (.metallic m) (cast (ptr f32) 0))
    (set! (.sheen m) (cast (ptr f32) 0))
    (when enabled
      (let [cs (CGColorSpaceCreateDeviceGray)
            bytes (cast isize (* (* (.width s) (.height s)) 4))]
        (set! (.mask m)
              (CGBitmapContextCreate (nil)
                                     (cast u64 (.width s))
                                     (cast u64 (.height s))
                                     8
                                     (cast u64 (.width s))
                                     cs
                                     0))
        (CGColorSpaceRelease cs)
        (assert (!= (.mask m) (nil)))
        (CGContextTranslateCTM (.mask m) 0.0 (cast f64 (.height s)))
        (CGContextScaleCTM (.mask m) (.scale s) (- 0.0 (.scale s)))
        (set! (.dx m) (cast (ptr f32) (alloc/malloc bytes)))
        (set! (.dy m) (cast (ptr f32) (alloc/malloc bytes)))
        (set! (.grain m) (cast (ptr f32) (alloc/malloc bytes)))
        (set! (.finish-rough m) (cast (ptr f32) (alloc/malloc bytes)))
        (assert (!= (.finish-rough m) (cast (ptr f32) 0)))
        (set! (.finish-axis-x m) (cast (ptr f32) (alloc/malloc bytes)))
        (assert (!= (.finish-axis-x m) (cast (ptr f32) 0)))
        (set! (.finish-axis-y m) (cast (ptr f32) (alloc/malloc bytes)))
        (assert (!= (.finish-axis-y m) (cast (ptr f32) 0)))
        (set! (.specular m) (cast (ptr f32) (alloc/malloc bytes)))
        (assert (!= (.specular m) (cast (ptr f32) 0)))
        (set! (.metallic m) (cast (ptr f32) (alloc/malloc bytes)))
        (assert (!= (.metallic m) (cast (ptr f32) 0)))
        (set! (.sheen m) (cast (ptr f32) (alloc/malloc bytes)))
        (assert (!= (.sheen m) (cast (ptr f32) 0)))
        (assert (!= (.dx m) (cast (ptr f32) 0)))
        (assert (!= (.dy m) (cast (ptr f32) 0)))
        (assert (!= (.grain m) (cast (ptr f32) 0)))
        0)))
  0)

(defn pixel-bounds [(bounds CGRect)] (-> CGRect)
  (let [s (scene)
        scale (.scale s)
        x (clamp (floor (* (.x bounds) scale)) 0.0 (cast f64 (.width s)))
        y (clamp (floor (* (.y bounds) scale)) 0.0 (cast f64 (.height s)))
        right (clamp (- 0.0 (floor (- 0.0 (* (+ (.x bounds) (.w bounds)) scale)))) 0.0 (cast f64 (.width s)))
        bottom (clamp (- 0.0 (floor (- 0.0 (* (+ (.y bounds) (.h bounds)) scale)))) 0.0 (cast f64 (.height s)))]
    (cgrect x y (- right x) (- bottom y))))

(defn composite [(sheet Sheet) (region CGRect) (mask (ptr i8))] (-> i64)
  (let [s (scene)
        m (state)
        scale (.scale s)
        bounds (CGPathGetPathBoundingBox (.path sheet))
        left (texture/tex-max (.x bounds) (.x region))
        top (texture/tex-max (.y bounds) (.y region))
        right (texture/tex-min (+ (.x bounds) (.w bounds)) (+ (.x region) (.w region)))
        bottom (texture/tex-min (+ (.y bounds) (.h bounds)) (+ (.y region) (.h region)))
        pixels
          (pixel-bounds (cgrect left top (texture/tex-max 0.0 (- right left)) (texture/tex-max 0.0 (- bottom top))))
        data (CGBitmapContextGetData (.mask m))
        finish (.finish sheet)
        axis-x (* (.anisotropy finish) (cos (* 2.0 (.angle (.pattern sheet)))))
        axis-y (* (.anisotropy finish) (sin (* 2.0 (.angle (.pattern sheet)))))]
    (CGContextSetGrayFillColor mask 0.0 1.0)
    (CGContextFillRect mask region)
    (CGContextSetGrayFillColor mask 1.0 1.0)
    (CGContextAddPath mask (.path sheet))
    (CGContextEOFillPath mask)
    (for [y (cast i64 (.y pixels)) (cast i64 (+ (.y pixels) (.h pixels)))]
      (for [x (cast i64 (.x pixels)) (cast i64 (+ (.x pixels) (.w pixels)))]
        (let [pos (+ (* y (.width s)) x)
              a (/ (cast f64 (load (index data pos))) 255.0)]
          (when (> a 0.0)
            (let [detail
                    (if (= (.kind (.pattern sheet)) 0)
                        (load (texture/MicroSurface
                                :dx 0.0
                                :dy 0.0
                                :grain 0.0))
                        (texture/sample (.pattern sheet)
                                        (.seed sheet)
                                        (/ (+ (cast f64 x) 0.5) scale)
                                        (/ (+ (cast f64 y) 0.5) scale)
                                        scale))]
              (set! (index (.dx m) pos)
                    (cast f32 (texture/tex-mix (cast f64 (load (index (.dx m) pos))) (.dx detail) a)))
              (set! (index (.dy m) pos)
                    (cast f32 (texture/tex-mix (cast f64 (load (index (.dy m) pos))) (.dy detail) a)))
              (set! (index (.grain m) pos)
                    (cast f32 (texture/tex-mix (cast f64 (load (index (.grain m) pos))) (.grain detail) a)))
              (set! (index (.finish-rough m) pos)
                    (cast f32 (texture/tex-mix (cast f64 (load (index (.finish-rough m) pos))) (.roughness finish) a)))
              (set! (index (.finish-axis-x m) pos)
                    (cast f32 (texture/tex-mix (cast f64 (load (index (.finish-axis-x m) pos))) axis-x a)))
              (set! (index (.finish-axis-y m) pos)
                    (cast f32 (texture/tex-mix (cast f64 (load (index (.finish-axis-y m) pos))) axis-y a)))
              (set! (index (.specular m) pos)
                    (cast f32 (texture/tex-mix (cast f64 (load (index (.specular m) pos))) (.specular finish) a)))
              (set! (index (.metallic m) pos)
                    (cast f32 (texture/tex-mix (cast f64 (load (index (.metallic m) pos))) (.metallic finish) a)))
              (set! (index (.sheen m) pos)
                    (cast f32 (texture/tex-mix (cast f64 (load (index (.sheen m) pos))) (.sheen finish) a)))
              0))))))
  0)

;;; Printed ink is a matte coating. Clear reflection weights in submission order;
;;; keep the paper's microstructure and the geometry-derived normal beneath it.
(defn composite-ink [(ink Ink) (region CGRect) (mask (ptr i8))] (-> i64)
  (when (intersects (.bounds ink) region)
    (let [m (state)
          s (scene)
          b (.bounds ink)
          left (texture/tex-max (.x b) (.x region))
          top (texture/tex-max (.y b) (.y region))
          right (texture/tex-min (+ (.x b) (.w b)) (+ (.x region) (.w region)))
          bottom (texture/tex-min (+ (.y b) (.h b)) (+ (.y region) (.h region)))
          pixels (pixel-bounds (cgrect left top (- right left) (- bottom top)))
          (mut white-ink) (load ink)
          data (CGBitmapContextGetData (.mask m))]
      (set! (.color white-ink) (cast u32 0xffffff))
      (CGContextSetGrayFillColor mask 0.0 1.0)
      (CGContextFillRect mask region)
      (o/msg i64 (o/class c"NSGraphicsContext") (o/sel c"saveGraphicsState") [])
      (o/msg i64
             (o/class c"NSGraphicsContext")
             (o/sel c"setCurrentContext:")
             [(ptr i8)]
             (o/msg (ptr i8)
                    (o/class c"NSGraphicsContext")
                    (o/sel c"graphicsContextWithCGContext:flipped:")
                    [(ptr i8) bool]
                    mask
                    true))
      (paint/paint-ink mask (load white-ink))
      (o/msg i64 (o/class c"NSGraphicsContext") (o/sel c"restoreGraphicsState") [])
      (for [y (cast i64 (.y pixels)) (cast i64 (+ (.y pixels) (.h pixels)))]
        (for [x (cast i64 (.x pixels)) (cast i64 (+ (.x pixels) (.w pixels)))]
          (let [pos (+ (* y (.width s)) x)
                remaining (- 1.0 (/ (cast f64 (load (index data pos))) 255.0))]
            (set! (index (.specular m) pos) (cast f32 (* (cast f64 (load (index (.specular m) pos))) remaining)))
            (set! (index (.metallic m) pos) (cast f32 (* (cast f64 (load (index (.metallic m) pos))) remaining)))
            (set! (index (.sheen m) pos) (cast f32 (* (cast f64 (load (index (.sheen m) pos))) remaining))))))
      0))
  0)

;;; Workers own complete, disjoint rows of both the coverage mask and float arrays.
(defn raster [(region CGRect) (mask (ptr i8))] (-> i64)
  (let [s (scene)
        m (state)
        pixels (pixel-bounds region)
        (mut textured) false
        (mut reflective) false
        ink-count (al/al-len [Ink] (.inks s))
        (mut next-ink) 0]
    (for [y (cast i64 (.y pixels)) (cast i64 (+ (.y pixels) (.h pixels)))]
      (for [x (cast i64 (.x pixels)) (cast i64 (+ (.x pixels) (.w pixels)))]
        (let [pos (+ (* y (.width s)) x)]
          (set! (index (.dx m) pos) (cast f32 0.0))
          (set! (index (.dy m) pos) (cast f32 0.0))
          (set! (index (.grain m) pos) (cast f32 0.0))
          (set! (index (.finish-rough m) pos) (cast f32 0.5))
          (set! (index (.finish-axis-x m) pos) (cast f32 0.0))
          (set! (index (.finish-axis-y m) pos) (cast f32 0.0))
          (set! (index (.specular m) pos) (cast f32 0.0))
          (set! (index (.metallic m) pos) (cast f32 0.0))
          (set! (index (.sheen m) pos) (cast f32 0.0)))))
    (CGContextSaveGState mask)
    (CGContextClipToRect mask region)
    (for [i 0 (al/al-len [Sheet] (.sheets s))]
      (let [sheet (al/al-get [Sheet] (.sheets s) i)]
        (while (< (load next-ink) ink-count)
          (let [ink (al/al-get [Ink] (.inks s) (load next-ink))]
            (if (or (< (.z ink) (.z sheet)) (and (p/fcmp-eq (.z ink) (.z sheet)) (< (.order ink) (.order sheet))))
                (do
                  (when (load reflective) (composite-ink ink region mask))
                  (set! next-ink (+ (load next-ink) 1)))
                (break))))
        (when (intersects (CGPathGetPathBoundingBox (.path sheet)) region)
          (when (material/finish-active (.finish sheet)) (set! reflective true) (set! textured true))
          (when (> (.kind (.pattern sheet)) 0) (set! textured true))
          (when (load textured) (composite sheet region mask))
          0)))
    (when (load reflective)
      (while (< (load next-ink) ink-count)
        (composite-ink (al/al-get [Ink] (.inks s) (load next-ink)) region mask)
        (set! next-ink (+ (load next-ink) 1))))
    (CGContextRestoreGState mask))
  0)
