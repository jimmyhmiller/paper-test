(module paper.gpu)
(import "coil.primitive" :as p)
(import "coil.slice" :as slice)
(import "paper.objc" :use *)
(import "paper.ffi" :use *)
(import "paper.scene" :use *)
(import "paper.geometry" :use [clamp])

(defstruct MetalSize [(width u64) (height u64) (depth u64)])

(defstruct MetalRegion [(x u64) (y u64) (z u64) (width u64) (height u64) (depth u64)])

(defstruct Params
  [(light-x f32)
   (light-y f32)
   (elevation f32)
   (depth f32)
   (grain f32)
   (scale f32)
   (origin-x u32)
   (origin-y u32)
   (width u32)
   (height u32)])

(defstruct GPU
  [(device (ptr i8))
   (queue (ptr i8))
   (library (ptr i8))
   (maximum-pipeline (ptr i8))
   (maximum (ptr i8))
   (prepare (ptr i8))
   (shade (ptr i8))
   (display (ptr i8))
   (colors (ptr i8))
   (heights (ptr i8))
   (materials (ptr i8))
   (output (ptr i8))
   (prepared (ptr i8))
   (presentation-time f64)
   (command (ptr i8))
   (last-command (ptr i8))
   (last-drawable (ptr i8))
   (pending CGRect)
   (gpu-ms f64)
   (present-ms f64)
   (available bool)])

(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))

(extern MTLCreateSystemDefaultDevice :cc c [] (-> (ptr i8)))

(defn gpu [] (-> (ptr GPU))
  (p/alloc-static GPU))

(defn checked-object [(object (ptr i8)) (error (ptr i8))] (-> (ptr i8))
  (when (= object (nil))
    (when (!= error (nil))
      (let [description (utf8 (msg (ptr i8) error (sel c"localizedDescription") []))]
        (println "Metal error: {}" (slice/slice-new (cast (ptr u8) description) (cast i64 (strlen description))))
        0))
    (assert false))
  object)

(defn compute-pipeline [(name (ptr i8))] (-> (ptr i8))
  (let [g (gpu)
        function (msg (ptr i8) (.library g) (sel c"newFunctionWithName:") [(ptr i8)] (ns name))
        (mut error) (nil)
        pipeline
          (msg (ptr i8)
               (.device g)
               (sel c"newComputePipelineStateWithFunction:error:")
               [(ptr i8) (mut (ptr i8))]
               function
               (mut error))]
    (release function)
    (checked-object pipeline (load error))))

(defn initialize [] (-> bool)
  (let [mode (getenv c"PAPER_RENDERER")]
    (if (and (!= mode (nil)) (= (strcmp mode c"cpu") 0)) false (initialize-metal))))

(defn initialize-metal [] (-> bool)
  (let [g (gpu)]
    (when (= (.device g) (nil))
      (set! (.device g) (MTLCreateSystemDefaultDevice))
      (when (!= (.device g) (nil))
        (let [source (include-str "../shaders/paper.metal")
              text
                (msg (ptr i8)
                     (msg (ptr i8) (class c"NSString") (sel c"alloc") [])
                     (sel c"initWithBytes:length:encoding:")
                     [(ptr u8) u64 u64]
                     (slice/slice-data source)
                     (cast u64 (len source))
                     4)
              options (new c"MTLCompileOptions")
              (mut error) (nil)]
          (msg i64 options (sel c"setFastMathEnabled:") [bool] false)
          (set! (.library g)
                (msg (ptr i8)
                     (.device g)
                     (sel c"newLibraryWithSource:options:error:")
                     [(ptr i8) (ptr i8) (mut (ptr i8))]
                     text
                     options
                     (mut error)))
          (checked-object (.library g) (load error))
          (release options)
          (release text))
        (set! (.queue g) (msg (ptr i8) (.device g) (sel c"newCommandQueue") []))
        (set! (.maximum-pipeline g) (compute-pipeline c"height_maximum"))
        (set! (.prepare g) (compute-pipeline c"prepare_paper"))
        (set! (.shade g) (compute-pipeline c"shade_paper"))
        (set! (.available g) true)))
    (.available g)))

(defn texture [(format u64) (usage u64)] (-> (ptr i8))
  (texture-storage format usage 2))

(defn texture-storage [(format u64) (usage u64) (storage u64)] (-> (ptr i8))
  (let [s (scene)
        descriptor
          (msg (ptr i8)
               (class c"MTLTextureDescriptor")
               (sel c"texture2DDescriptorWithPixelFormat:width:height:mipmapped:")
               [u64 u64 u64 bool]
               format
               (cast u64 (.width s))
               (cast u64 (.height s))
               false)]
    (msg i64 descriptor (sel c"setUsage:") [u64] usage)
    (msg i64 descriptor (sel c"setStorageMode:") [u64] storage)
    (checked-object (msg (ptr i8) (.device (gpu)) (sel c"newTextureWithDescriptor:") [(ptr i8)] descriptor) (nil))))

(defn power-of-two [(value i64)] (-> u64)
  (let [(mut n) (cast u64 1)]
    (while (< (load n) (cast u64 value)) (set! n (* (load n) (cast u64 2))))
    (load n)))

(defn maximum-texture [] (-> (ptr i8))
  (let [descriptor
          (msg (ptr i8)
               (class c"MTLTextureDescriptor")
               (sel c"texture2DDescriptorWithPixelFormat:width:height:mipmapped:")
               [u64 u64 u64 bool]
               10
               (power-of-two (/ (+ (.width (scene)) 15) 16))
               (power-of-two (/ (+ (.height (scene)) 15) 16))
               true)]
    (msg i64 descriptor (sel c"setUsage:") [u64] 3)
    (msg i64 descriptor (sel c"setStorageMode:") [u64] 2)
    (checked-object (msg (ptr i8) (.device (gpu)) (sel c"newTextureWithDescriptor:") [(ptr i8)] descriptor) (nil))))

(defn encode-maximum [(command (ptr i8))] (-> i64)
  (let [g (gpu)
        count (msg u64 (.maximum g) (sel c"mipmapLevelCount") [])
        (mut width) (msg u64 (.maximum g) (sel c"width") [])
        (mut height) (msg u64 (.maximum g) (sel c"height") [])]
    (for [i 0 (cast i64 count)]
      (let [encoder (msg (ptr i8) command (sel c"computeCommandEncoder") [])
            (mut level) (cast u32 i)]
        (msg i64 encoder (sel c"setComputePipelineState:") [(ptr i8)] (.maximum-pipeline g))
        (msg i64 encoder (sel c"setBytes:length:atIndex:") [(mut u32) u64 u64] (mut level) 4 1)
        (msg i64 encoder (sel c"setTexture:atIndex:") [(ptr i8) u64] (.heights g) 1)
        (msg i64 encoder (sel c"setTexture:atIndex:") [(ptr i8) u64] (.maximum g) 5)
        (msg i64 encoder (sel c"setTexture:atIndex:") [(ptr i8) u64] (.maximum g) 6)
        (msg i64
             encoder
             (sel c"dispatchThreads:threadsPerThreadgroup:")
             [MetalSize MetalSize]
             (MetalSize
               :width (load width)
               :height (load height)
               :depth 1)
             (MetalSize
               :width 8
               :height 8
               :depth 1))
        (msg i64 encoder (sel c"endEncoding") [])
        (set! width (if (> (load width) (cast u64 1)) (/ (load width) (cast u64 2)) (cast u64 1)))
        (set! height (if (> (load height) (cast u64 1)) (/ (load height) (cast u64 2)) (cast u64 1))))))
  0)

(defn setup [] (-> bool)
  (synchronize)
  (when (initialize)
    (let [g (gpu)]
      (release (.colors g))
      (release (.heights g))
      (release (.materials g))
      (release (.output g))
      (release (.prepared g))
      (release (.maximum g))
      (set! (.colors g) (texture 70 5))
      (set! (.heights g) (texture 10 5))
      (set! (.materials g) (texture 70 5))
      (set! (.output g) (texture 70 3))
      (set! (.prepared g) (texture 103 3))
      (set! (.maximum g) (maximum-texture))
      (set! (.pending g) (cgrect 0.0 0.0 0.0 0.0))))
  (.available (gpu)))

(defn pixel-region [(r CGRect) (padding f64)] (-> MetalRegion)
  (let [s (scene)
        scale (.scale s)
        x (cast u64 (clamp (floor (- (* (.x r) scale) padding)) 0.0 (cast f64 (.width s))))
        y (cast u64 (clamp (floor (- (* (.y r) scale) padding)) 0.0 (cast f64 (.height s))))
        right
          (cast u64 (clamp (- 0.0 (floor (- 0.0 (+ (* (+ (.x r) (.w r)) scale) padding)))) 0.0 (cast f64 (.width s))))
        bottom
          (cast u64 (clamp (- 0.0 (floor (- 0.0 (+ (* (+ (.y r) (.h r)) scale) padding)))) 0.0 (cast f64 (.height s))))]
    (MetalRegion
      :x x
      :y y
      :z 0
      :width (- right x)
      :height (- bottom y)
      :depth 1)))

(defn encode [(command (ptr i8)) (pipeline (ptr i8)) (region MetalRegion)] (-> i64)
  (when (and (> (.width region) (cast u64 0)) (> (.height region) (cast u64 0)))
    (encode-region command pipeline region))
  0)

(defn encode-region [(command (ptr i8)) (pipeline (ptr i8)) (region MetalRegion)] (-> i64)
  (let [g (gpu)
        s (scene)
        encoder (msg (ptr i8) command (sel c"computeCommandEncoder") [])
        params
          (Params
            :light-x (cast f32 (.light-x s))
            :light-y (cast f32 (.light-y s))
            :elevation (cast f32 (.elevation s))
            :depth (cast f32 (.depth s))
            :grain (cast f32 (.grain s))
            :scale (cast f32 (.scale s))
            :origin-x (cast u32 (.x region))
            :origin-y (cast u32 (.y region))
            :width (cast u32 (.width s))
            :height (cast u32 (.height s)))]
    (msg i64 encoder (sel c"setComputePipelineState:") [(ptr i8)] pipeline)
    (msg i64 encoder (sel c"setBytes:length:atIndex:") [(ref Params) u64 u64] params 40 0)
    (msg i64 encoder (sel c"setTexture:atIndex:") [(ptr i8) u64] (.colors g) 0)
    (msg i64 encoder (sel c"setTexture:atIndex:") [(ptr i8) u64] (.heights g) 1)
    (msg i64 encoder (sel c"setTexture:atIndex:") [(ptr i8) u64] (.materials g) 2)
    (msg i64 encoder (sel c"setTexture:atIndex:") [(ptr i8) u64] (.output g) 3)
    (msg i64 encoder (sel c"setTexture:atIndex:") [(ptr i8) u64] (.prepared g) 4)
    (msg i64 encoder (sel c"setTexture:atIndex:") [(ptr i8) u64] (.maximum g) 5)
    (msg i64
         encoder
         (sel c"dispatchThreads:threadsPerThreadgroup:")
         [MetalSize MetalSize]
         (MetalSize
           :width (.width region)
           :height (.height region)
           :depth 1)
         (MetalSize
           :width 16
           :height 16
           :depth 1))
    (msg i64 encoder (sel c"endEncoding") []))
  0)

(defn command-buffer [] (-> (ptr i8))
  (let [g (gpu)]
    (when (= (.command g) (nil))
      (set! (.command g) (retain (msg (ptr i8) (.queue g) (sel c"commandBuffer") []))))
    (.command g)))

;;; Raster, lighting, and presentation share one ordered command buffer. Cached
;;; CPU masks are immutable, and subsequent frames use the same serial queue.
;;; CAMetalLayer's three drawables bound the number of frames in flight.
(defn submit [] (-> i64)
  (let [g (gpu)]
    (when (!= (.command g) (nil))
      (release (.last-command g))
      (set! (.last-command g) (.command g))
      (set! (.command g) (nil))
      (msg i64 (.last-command g) (sel c"commit") [])))
  0)

(defn synchronize [] (-> i64)
  (submit)
  (let [g (gpu)
        command (.last-command g)]
    (when (!= command (nil))
      (msg i64 command (sel c"waitUntilCompleted") [])
      (assert (= (msg i64 command (sel c"status") []) 4))
      (set! (.gpu-ms g)
            (* 1000.0 (- (msg f64 command (sel c"GPUEndTime") []) (msg f64 command (sel c"GPUStartTime") []))))))
  0)

(defn finish [(command (ptr i8))] (-> f64)
  (msg i64 command (sel c"commit") [])
  (msg i64 command (sel c"waitUntilCompleted") [])
  (assert (= (msg i64 command (sel c"status") []) 4))
  (* 1000.0 (- (msg f64 command (sel c"GPUEndTime") []) (msg f64 command (sel c"GPUStartTime") []))))

(defn render [(bounds CGRect) (all bool) (readback bool)] (-> i64)
  (let [g (gpu)
        s (scene)
        command (command-buffer)
        region
          (if all
              (load (MetalRegion
                      :x 0
                      :y 0
                      :z 0
                      :width (cast u64 (.width s))
                      :height (cast u64 (.height s))
                      :depth 1))
              (pixel-region bounds (+ (* 181.0 (.scale s)) 2.0)))]
    (when (> (.w (.pending g)) 0.0)
      (encode command (.prepare g) (pixel-region (.pending g) 2.0))
      (encode-maximum command)
      (set! (.pending g) (cgrect 0.0 0.0 0.0 0.0)))
    (encode command (.shade g) region)
    (when readback (read-output)))
  0)

(defn read-texture [(source (ptr i8)) (context (ptr i8)) (format u64) (channels i64)] (-> i64)
  (synchronize)
  (let [s (scene)
        staging (texture-storage format 1 0)
        command (msg (ptr i8) (.queue (gpu)) (sel c"commandBuffer") [])
        encoder (msg (ptr i8) command (sel c"blitCommandEncoder") [])
        origin
          (MetalSize
            :width 0
            :height 0
            :depth 0)
        size
          (MetalSize
            :width (cast u64 (.width s))
            :height (cast u64 (.height s))
            :depth 1)]
    (msg i64
         encoder
         (sel c"copyFromTexture:sourceSlice:sourceLevel:sourceOrigin:sourceSize:toTexture:destinationSlice:destinationLevel:destinationOrigin:")
         [(ptr i8) u64 u64 MetalSize MetalSize (ptr i8) u64 u64 MetalSize]
         source
         0
         0
         origin
         size
         staging
         0
         0
         origin)
    (msg i64 encoder (sel c"endEncoding") [])
    (finish command)
    (msg i64
         staging
         (sel c"getBytes:bytesPerRow:fromRegion:mipmapLevel:")
         [(ptr u8) u64 MetalRegion u64]
         (CGBitmapContextGetData context)
         (cast u64 (* (.width s) channels))
         (MetalRegion
           :x 0
           :y 0
           :z 0
           :width (cast u64 (.width s))
           :height (cast u64 (.height s))
           :depth 1)
         0)
    (release staging))
  0)

(defn read-output [] (-> i64)
  (read-texture (.output (gpu)) (.output-context (scene)) 70 4))

(defn display-pipeline [] (-> (ptr i8))
  (let [g (gpu)]
    (when (= (.display g) (nil))
      (let [descriptor (new c"MTLRenderPipelineDescriptor")
            vertex (msg (ptr i8) (.library g) (sel c"newFunctionWithName:") [(ptr i8)] (ns c"paper_vertex"))
            fragment (msg (ptr i8) (.library g) (sel c"newFunctionWithName:") [(ptr i8)] (ns c"paper_fragment"))
            attachments (msg (ptr i8) descriptor (sel c"colorAttachments") [])
            color (msg (ptr i8) attachments (sel c"objectAtIndexedSubscript:") [u64] 0)
            (mut error) (nil)]
        (msg i64 descriptor (sel c"setVertexFunction:") [(ptr i8)] vertex)
        (msg i64 descriptor (sel c"setFragmentFunction:") [(ptr i8)] fragment)
        (msg i64 color (sel c"setPixelFormat:") [u64] 80)
        (set! (.display g)
              (msg (ptr i8)
                   (.device g)
                   (sel c"newRenderPipelineStateWithDescriptor:error:")
                   [(ptr i8) (mut (ptr i8))]
                   descriptor
                   (mut error)))
        (checked-object (.display g) (load error))
        (release vertex)
        (release fragment)
        (release descriptor)))
    (.display g)))

(defn layer-size [(layer (ptr i8)) (width f64) (height f64) (scale f64)] (-> i64)
  (msg i64 layer (sel c"setContentsScale:") [f64] scale)
  (msg i64 layer (sel c"setDrawableSize:") [CGSize] (CGSize :w (* width scale) :h (* height scale)))
  0)

(defn create-layer [(view (ptr i8)) (width f64) (height f64) (scale f64)] (-> (ptr i8))
  (let [layer (new c"CAMetalLayer")]
    (msg i64 layer (sel c"setDevice:") [(ptr i8)] (.device (gpu)))
    (msg i64 layer (sel c"setPixelFormat:") [u64] 80)
    (msg i64 layer (sel c"setFramebufferOnly:") [bool] true)
    (msg i64 layer (sel c"setMaximumDrawableCount:") [u64] 3)
    (msg i64 layer (sel c"setOpaque:") [bool] true)
    (layer-size layer width height scale)
    (msg i64 view (sel c"setLayer:") [(ptr i8)] layer)
    (display-pipeline)
    (release layer)
    (msg (ptr i8) view (sel c"layer") [])))

;;; The image remains on the GPU through presentation. A fullscreen triangle
;;; samples the native-resolution result directly into the drawable; there is
;;; no CPU readback or CGImage allocation in the interactive path.
(defn present [(layer (ptr i8))] (-> bool)
  (let [g (gpu)
        drawable (msg (ptr i8) layer (sel c"nextDrawable") [])]
    (if (= drawable (nil))
        false
        (let [command (command-buffer)
              descriptor (msg (ptr i8) (class c"MTLRenderPassDescriptor") (sel c"renderPassDescriptor") [])
              attachments (msg (ptr i8) descriptor (sel c"colorAttachments") [])
              color (msg (ptr i8) attachments (sel c"objectAtIndexedSubscript:") [u64] 0)]
          (msg i64 color (sel c"setTexture:") [(ptr i8)] (msg (ptr i8) drawable (sel c"texture") []))
          (msg i64 color (sel c"setLoadAction:") [u64] 0)
          (msg i64 color (sel c"setStoreAction:") [u64] 1)
          (let [encoder (msg (ptr i8) command (sel c"renderCommandEncoderWithDescriptor:") [(ptr i8)] descriptor)]
            (msg i64 encoder (sel c"setRenderPipelineState:") [(ptr i8)] (display-pipeline))
            (msg i64 encoder (sel c"setFragmentTexture:atIndex:") [(ptr i8) u64] (.output g) 0)
            (msg i64 encoder (sel c"drawPrimitives:vertexStart:vertexCount:") [u64 u64 u64] 3 0 3)
            (msg i64 encoder (sel c"endEncoding") []))
          (release (.last-drawable g))
          (set! (.last-drawable g) (retain drawable))
          (if (> (.presentation-time g) 0.0)
              (msg i64 command (sel c"presentDrawable:atTime:") [(ptr i8) f64] drawable (.presentation-time g))
              (msg i64 command (sel c"presentDrawable:") [(ptr i8)] drawable))
          (submit)
          true))))
