(module paper.scene)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "paper.ffi" :use *)
(import "paper.objc" :as objc)

(defstruct Sheet [(path (ptr i8)) (z f64) (order i64) (color u32) (rough f64) (fiber f64) (seed f64)])

(defstruct Ink
  [(x f64)
   (y f64)
   (width f64)
   (height f64)
   (size f64)
   (color u32)
   (font i64)
   (text (ptr i8))
   (z f64)
   (order i64)
   (kind i64)
   (clip (ptr i8))
   (bounds CGRect)])

(defstruct Hit
  [(id i64)
   (bounds CGRect)
   (label (ptr i8))
   (role i64)
   (value f64)
   (z f64)
   (path (ptr i8))
   (enabled bool)
   (group i64)])

(defstruct FocusTarget [(id i64) (native bool)])

(defstruct Scene
  [(sheets (al/ArrayList Sheet))
   (inks (al/ArrayList Ink))
   (hits (al/ArrayList Hit))
   (focus-targets (al/ArrayList FocusTarget))
   (path (ptr i8))
   (background u32)
   (light-x f64)
   (light-y f64)
   (elevation f64)
   (depth f64)
   (grain f64)
   (dirty bool)
   (geometry-dirty bool)
   (color-context (ptr i8))
   (height-context (ptr i8))
   (material-context (ptr i8))
   (output-context (ptr i8))
   (width i64)
   (height i64)
   (scale f64)
   (serial i64)
   (paint-z f64)
   (offset f64)
   (enabled bool)])

(defn scene [] (-> (ptr Scene))
  (primitive/alloc-static Scene))

(defn init [] (-> i64)
  (let [s (scene)
        a (alloc/malloc-allocator)]
    (set! (.sheets s) (al/al-new [Sheet] a))
    (set! (.inks s) (al/al-new [Ink] a))
    (set! (.hits s) (al/al-new [Hit] a))
    (set! (.focus-targets s) (al/al-new [FocusTarget] a))
    (set! (.light-x s) 200.0)
    (set! (.light-y s) -100.0)
    (set! (.elevation s) 520.0)
    (set! (.depth s) 1.0)
    (set! (.grain s) 1.0)
    (set! (.width s) 2960)
    (set! (.height s) 1920)
    (set! (.scale s) 2.0)
    (set! (.dirty s) true)
    (set! (.geometry-dirty s) true))
  0)

(defn clear [(background u32)] (-> i64)
  (let [s (scene)]
    (for [i 0 (al/al-len [Sheet] (.sheets s))] (CGPathRelease (.path (al/al-elem [Sheet] (field s sheets) i))))
    (for [i 0 (al/al-len [Ink] (.inks s))]
      (let [ink (al/al-elem [Ink] (field s inks) i)]
        (objc/release (.text ink))
        (when (!= (.clip ink) (objc/nil)) (CGPathRelease (.clip ink)) 0)))
    (clear-hits)
    (al/al-clear! [Sheet] (mut (.sheets s)))
    (al/al-clear! [Ink] (mut (.inks s)))
    (set! (.background s) background)
    (set! (.serial s) 0)
    (set! (.paint-z s) 0.0)
    (set! (.offset s) 0.0)
    (set! (.enabled s) true)
    (set! (.geometry-dirty s) true))
  0)

(defn release-hit [(hit Hit)] (-> i64)
  (objc/release (.label hit))
  (CGPathRelease (.path hit))
  0)

(defn clear-hits [] (-> i64)
  (let [s (scene)]
    (for [i 0 (al/al-len [Hit] (.hits s))]
      (release-hit (al/al-get [Hit] (.hits s) i)))
    (al/al-clear! [Hit] (mut (.hits s)))
    (al/al-clear! [FocusTarget] (mut (.focus-targets s))))
  0)

(defn remove-hit [(index i64)] (-> i64)
  (let [s (scene)
        count (al/al-len [Hit] (.hits s))]
    (assert (and (>= index 0) (< index count)))
    (remove-focus (.id (al/al-elem [Hit] (field s hits) index)))
    (release-hit (al/al-get [Hit] (.hits s) index))
    (for [i (+ index 1) count]
      (al/al-set! [Hit] (mut (.hits s)) (- i 1) (al/al-get [Hit] (.hits s) i)))
    (al/al-pop! [Hit] (mut (.hits s))))
  0)

(defn focus-index [(id i64)] (-> i64)
  (let [(mut result) -1]
    (for [i 0 (al/al-len [FocusTarget] (.focus-targets (scene)))]
      (when (= id (.id (al/al-elem [FocusTarget] (field (scene) focus-targets) i)))
        (set! result i)))
    (load result)))

;;; Register once per draw, in reading order. IDs span native and paper controls.
(defn register-focus [(id i64) (native bool)] (-> i64)
  (assert (and (> id 0) (< (focus-index id) 0)))
  (al/al-push! [FocusTarget]
               (mut (.focus-targets (scene)))
               (FocusTarget :id id :native native)))

(defn remove-focus [(id i64)] (-> i64)
  (let [s (scene)
        index (focus-index id)
        count (al/al-len [FocusTarget] (.focus-targets s))]
    (when (>= index 0)
      (for [i (+ index 1) count]
        (al/al-set! [FocusTarget]
                    (mut (.focus-targets s))
                    (- i 1)
                    (al/al-get [FocusTarget] (.focus-targets s) i)))
      (al/al-pop! [FocusTarget] (mut (.focus-targets s)))
      0))
  0)

(extern qsort :cc c [(ptr i8) u64 u64 (fnptr c [(ptr i8) (ptr i8)] i32)] (-> void))

(defn compare-sheet [(a (ptr i8)) (b (ptr i8))] (-> i32)
  (let [x (cast (ptr Sheet) a)
        y (cast (ptr Sheet) b)]
    (cond (< (.z x) (.z y)) -1 (> (.z x) (.z y)) 1 (< (.order x) (.order y)) -1 (> (.order x) (.order y)) 1 :else 0)))

(defn compare-ink [(a (ptr i8)) (b (ptr i8))] (-> i32)
  (let [x (cast (ptr Ink) a)
        y (cast (ptr Ink) b)]
    (cond (< (.z x) (.z y)) -1 (> (.z x) (.z y)) 1 (< (.order x) (.order y)) -1 (> (.order x) (.order y)) 1 :else 0)))

;;; Sort once after submission. Painter order breaks ties explicitly; building
;;; a large scene no longer shifts the growing arrays for each added item.
(defn sort-commands [] (-> i64)
  (let [s (scene)]
    (qsort (cast (ptr i8) (.data (.sheets s)))
           (cast u64 (al/al-len [Sheet] (.sheets s)))
           (cast u64 (primitive/sizeof Sheet))
           (fnptr-of compare-sheet))
    (qsort (cast (ptr i8) (.data (.inks s)))
           (cast u64 (al/al-len [Ink] (.inks s)))
           (cast u64 (primitive/sizeof Ink))
           (fnptr-of compare-ink)))
  0)

(defn add-sheet [(sheet Sheet)] (-> i64)
  (al/al-push! [Sheet] (mut (.sheets (scene))) sheet))

(defn next-order [] (-> i64)
  (set! (.serial (scene)) (+ (.serial (scene)) 1))
  (.serial (scene)))

(defn add-ink [(ink Ink)] (-> i64)
  (al/al-push! [Ink] (mut (.inks (scene))) ink))

;;; Bounding boxes are a conservative rejection test; exact path operations still
;;; decide intersecting geometry. Empty rectangles never overlap.
(defn intersects [(a CGRect) (b CGRect)] (-> bool)
  (and (> (.w a) 0.0)
       (> (.h a) 0.0)
       (> (.w b) 0.0)
       (> (.h b) 0.0)
       (< (.x a) (+ (.x b) (.w b)))
       (< (.x b) (+ (.x a) (.w a)))
       (< (.y a) (+ (.y b) (.h b)))
       (< (.y b) (+ (.y a) (.h a)))))
