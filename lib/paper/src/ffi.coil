(module paper.ffi)
(import "coil.cc" :as cc)

(defstruct CGPoint [(x f64) (y f64)])

(defstruct CGSize [(w f64) (h f64)])

(defstruct CGRect [(x f64) (y f64) (w f64) (h f64)])

(defstruct CGAffine [(a f64) (b f64) (c f64) (d f64) (tx f64) (ty f64)])

(defn cgrect [(x f64) (y f64) (w f64) (h f64)] (-> CGRect)
  (CGRect
    :x x
    :y y
    :w w
    :h h))

(extern CGColorSpaceCreateDeviceRGB :cc (cc/C) [] (-> (ptr i8)))

(extern CGColorSpaceCreateDeviceGray :cc (cc/C) [] (-> (ptr i8)))

(extern CGColorSpaceRelease :cc (cc/C) [(ptr i8)] (-> void))

