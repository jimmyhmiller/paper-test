(module paper.relief)
(import "coil.primitive" :as p)
(import "coil.alloc" :as alloc)
(import "paper.ffi" :use *)
(import "paper.material" :as material)
(import "paper.geometry" :use [Rect])

(extern free :cc c [(ptr i8)] (-> void))

;;; Immutable, owning description of one rounded panel and its carved aperture.
;;; The callback expands it to ordinary sheets when cuts/interleaving require it.
(defstruct Panel
  [(refs i64)
   (bounds Rect)
   (radius f64)
   (shoulder-width f64)
   (shoulder-depth f64)
   (depth f64)
   (width f64)
   (z f64)
   (glyph (ptr i8))
   (edge material/Material)
   (top material/Material)
   (bottom material/Material)
   (expand (fnptr c [(ptr i8)] i64))])

(defn retain [(panel (ptr Panel))] (-> (ptr Panel))
  (when (!= panel (cast (ptr Panel) 0))
    (set! (.refs panel) (+ (.refs panel) 1)))
  panel)

(defn release [(panel (ptr Panel))] (-> i64)
  (when (!= panel (cast (ptr Panel) 0))
    (set! (.refs panel) (- (.refs panel) 1))
    (when (= (.refs panel) 0)
      (CGPathRelease (.glyph panel))
      (free (cast (ptr i8) panel))
      0))
  0)

(defn stock-equal [(a material/Material) (b material/Material)] (-> bool)
  (and (= (.pigment a) (.pigment b))
       (p/fcmp-eq (.roughness a) (.roughness b))
       (p/fcmp-eq (.fiber a) (.fiber b))
       (p/fcmp-eq (.seed a) (.seed b))
       (material/pattern-equal (.pattern a) (.pattern b))
       (material/finish-equal (.finish a) (.finish b))))

(defn equal [(a (ptr Panel)) (b (ptr Panel))] (-> bool)
  (if (= a b)
      true
      (and (!= a (cast (ptr Panel) 0))
           (!= b (cast (ptr Panel) 0))
           (p/fcmp-eq (.x (.bounds a)) (.x (.bounds b)))
           (p/fcmp-eq (.y (.bounds a)) (.y (.bounds b)))
           (p/fcmp-eq (.w (.bounds a)) (.w (.bounds b)))
           (p/fcmp-eq (.h (.bounds a)) (.h (.bounds b)))
           (p/fcmp-eq (.radius a) (.radius b))
           (p/fcmp-eq (.shoulder-width a) (.shoulder-width b))
           (p/fcmp-eq (.shoulder-depth a) (.shoulder-depth b))
           (p/fcmp-eq (.depth a) (.depth b))
           (p/fcmp-eq (.width a) (.width b))
           (p/fcmp-eq (.z a) (.z b))
           (stock-equal (.edge a) (.edge b))
           (stock-equal (.top a) (.top b))
           (stock-equal (.bottom a) (.bottom b))
           (CGPathEqualToPath (.glyph a) (.glyph b)))))
