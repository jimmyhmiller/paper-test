(module paper.damage)
(import "paper.relief" :as relief)
(import "paper.material" :as material)
(import "coil.primitive" :as p)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "paper.ffi" :use *)
(import "paper.objc" :as o)
(import "paper.scene" :use *)

(defstruct Cache
  [(sheets (al/ArrayList Sheet))
   (inks (al/ArrayList Ink))
   (ink-orders (al/ArrayList i64))
   (paint-order (al/ArrayList i64))
   (previous-order (al/ArrayList i64))
   (ready bool)
   (valid bool)
   (background u32)
   (bounds CGRect)
   (light-x f64)
   (light-y f64)
   (elevation f64)
   (depth f64)
   (grain f64)
   (lit bool)])

(defn cache [] (-> (ptr Cache))
  (p/alloc-static Cache))

(defn discard [] (-> i64)
  (let [c (cache)]
    (when (.ready c)
      (for [i 0 (al/al-len [Sheet] (.sheets c))]
        (CGPathRelease (.path (al/al-elem [Sheet] (field c sheets) i)))
        (relief/release (.relief (al/al-elem [Sheet] (field c sheets) i))))
      (for [i 0 (al/al-len [Ink] (.inks c))]
        (let [ink (al/al-elem [Ink] (field c inks) i)]
          (o/release (.text ink))
          (when (!= (.clip ink) (o/nil)) (CGPathRelease (.clip ink)) 0)))
      (al/al-clear! [Sheet] (mut (.sheets c)))
      (al/al-clear! [Ink] (mut (.inks c)))
      0))
  0)

(defn reset [] (-> i64)
  (discard)
  (let [c (cache)]
    (when (not (.ready c))
      (set! (.sheets c) (al/al-new [Sheet] (alloc/malloc-allocator)))
      (set! (.inks c) (al/al-new [Ink] (alloc/malloc-allocator)))
      (set! (.ink-orders c) (al/al-new [i64] (alloc/malloc-allocator)))
      (set! (.paint-order c) (al/al-new [i64] (alloc/malloc-allocator)))
      (set! (.previous-order c) (al/al-new [i64] (alloc/malloc-allocator)))
      (set! (.ready c) true))
    (set! (.valid c) false)
    (set! (.lit c) false)
    (set! (.bounds c) (cgrect 0.0 0.0 0.0 0.0)))
  0)

(defn include [(r CGRect)] (-> i64)
  (when (and (> (.w r) 0.0) (> (.h r) 0.0))
    (let [c (cache)
          a (.bounds c)]
      (if (<= (.w a) 0.0)
          (set! (.bounds c) r)
          (let [x (if (< (.x a) (.x r)) (.x a) (.x r))
                y (if (< (.y a) (.y r)) (.y a) (.y r))
                right
                  (if (> (+ (.x a) (.w a)) (+ (.x r) (.w r)))
                      (+ (.x a) (.w a))
                      (+ (.x r) (.w r)))
                bottom
                  (if (> (+ (.y a) (.h a)) (+ (.y r) (.h r)))
                      (+ (.y a) (.h a))
                      (+ (.y r) (.h r)))]
            (set! (.bounds c) (cgrect x y (- right x) (- bottom y)))))))
  0)

(defn sheet-equal [(a Sheet) (b Sheet)] (-> bool)
  (and (p/fcmp-eq (.z a) (.z b))
       (= (.color a) (.color b))
       (p/fcmp-eq (.rough a) (.rough b))
       (p/fcmp-eq (.fiber a) (.fiber b))
       (p/fcmp-eq (.seed a) (.seed b))
       (material/pattern-equal (.pattern a) (.pattern b))
       (material/finish-equal (.finish a) (.finish b))
       (relief/equal (.relief a) (.relief b))
       (CGPathEqualToPath (.path a) (.path b))))

(defn ink-equal [(a Ink) (b Ink)] (-> bool)
  (and (p/fcmp-eq (.x a) (.x b))
       (p/fcmp-eq (.y a) (.y b))
       (p/fcmp-eq (.width a) (.width b))
       (p/fcmp-eq (.height a) (.height b))
       (p/fcmp-eq (.size a) (.size b))
       (p/fcmp-eq (.z a) (.z b))
       (= (.color a) (.color b))
       (= (.font a) (.font b))
       (= (.kind a) (.kind b))
       (or (= (.text a) (.text b))
           (o/msg bool
                  (.text a)
                  (o/sel c"isEqualToString:")
                  [(ptr i8)]
                  (.text b)))
       (CGPathEqualToPath (.clip a) (.clip b))))

;;; Merge sheets and ink into their actual painter sequence. Positive tokens
;;; name sheets, negative tokens ink; zero is never a command. Raw submission
;;; ordinals are only tie breakers, not visual identity: inserting one cursor
;;; must not invalidate every later sheet merely because its ordinal increased.
(defn order-commands [(sheets (al/ArrayList Sheet))
                      (inks (al/ArrayList Ink))
                      (out (mut (al/ArrayList i64)))] (-> i64)
  (al/al-clear! [i64] (mut out))
  (let [(mut next) 0
        count (al/al-len [Ink] inks)]
    (for [i 0 (al/al-len [Sheet] sheets)]
      (let [sheet (al/al-get [Sheet] sheets i)]
        (while (< (load next) count)
          (let [ink (al/al-get [Ink] inks (load next))]
            (if (or (< (.z ink) (.z sheet))
                    (and (p/fcmp-eq (.z ink) (.z sheet))
                         (< (.order ink) (.order sheet))))
                (do
                  (al/al-push! [i64] (mut out) (- -1 (load next)))
                  (set! next (+ (load next) 1)))
                (break))))
        (al/al-push! [i64] (mut out) (+ i 1))))
    (while (< (load next) count)
      (al/al-push! [i64] (mut out) (- -1 (load next)))
      (set! next (+ (load next) 1))))
  0)

(defn command-equal [(current i64) (previous i64)] (-> bool)
  (let [s (scene)
        c (cache)]
    (cond (and (> current 0) (> previous 0))
            (sheet-equal (al/al-get [Sheet] (.sheets s) (- current 1))
                         (al/al-get [Sheet] (.sheets c) (- previous 1)))
          (and (< current 0) (< previous 0))
            (ink-equal (al/al-get [Ink] (.inks s) (- -1 current))
                       (al/al-get [Ink] (.inks c) (- -1 previous)))
          :else false)))

(defn include-command [(token i64) (previous bool)] (-> i64)
  (if (> token 0)
      (let [item
              (if previous
                  (al/al-get [Sheet] (.sheets (cache)) (- token 1))
                  (al/al-get [Sheet] (.sheets (scene)) (- token 1)))]
        (include (CGPathGetPathBoundingBox (.path item))))
      (let [item
              (if previous
                  (al/al-get [Ink] (.inks (cache)) (- -1 token))
                  (al/al-get [Ink] (.inks (scene)) (- -1 token)))]
        (include (.bounds item)))))

(defstruct DiffScratch [(frontiers (array i64 8515))])

(defn frontier [(depth i64) (diagonal i64)] (-> (ptr i64))
  (index (field (p/alloc-static DiffScratch) frontiers)
         (+ (* depth 131) (+ diagonal 65))))

;;; Myers shortest edit script over exact painter commands. Keep a monotone
;;; common subsequence, so reordered commands are still removal/insertion edits.
;;; A 64-edit search budget bounds scratch storage and comparison work. Larger
;;; changes use conservative damage below, without changing rendered results.
(defn measure-edits [(first i64) (end-a i64) (end-b i64)] (-> bool)
  (let [a (.paint-order (cache))
        b (.previous-order (cache))
        n (- end-a first)
        m (- end-b first)
        (mut found) -1]
    (when (and (<= (- n m) 64) (<= (- m n) 64))
      (for [depth 0 65]
        (for [step 0 (+ depth 1)]
          (let [k (+ (- 0 depth) (* step 2))
                (mut x)
                  (if (= depth 0)
                      0
                      (if (or (= k (- 0 depth))
                              (and (!= k depth)
                                   (< (load (frontier (- depth 1) (- k 1)))
                                      (load (frontier (- depth 1) (+ k 1))))))
                          (load (frontier (- depth 1) (+ k 1)))
                          (+ (load (frontier (- depth 1) (- k 1))) 1)))
                (mut y) (- (load x) k)]
            (while (and (< (load x) n)
                        (< (load y) m)
                        (command-equal (al/al-get [i64] a (+ first (load x)))
                                       (al/al-get [i64] b (+ first (load y)))))
              (set! x (+ (load x) 1))
              (set! y (+ (load y) 1)))
            (store! (frontier depth k) (load x))
            (when (and (>= (load x) n) (>= (load y) m))
              (set! found depth)
              (break))))
        (when (>= (load found) 0) (break))))
    (if (< (load found) 0)
        false
        (do
          (let [(mut x) n
                (mut y) m
                (mut depth) (load found)]
            (while (> (load depth) 0)
              (let [k (- (load x) (load y))
                    previous (- (load depth) 1)
                    previous-k
                      (if (or (= k (- 0 (load depth)))
                              (and (!= k (load depth))
                                   (< (load (frontier previous (- k 1)))
                                      (load (frontier previous (+ k 1))))))
                          (+ k 1)
                          (- k 1))
                    previous-x (load (frontier previous previous-k))
                    previous-y (- previous-x previous-k)]
                (while (and (> (load x) previous-x) (> (load y) previous-y))
                  (set! x (- (load x) 1))
                  (set! y (- (load y) 1)))
                (if (= (load x) previous-x)
                    (include-command (al/al-get [i64]
                                                b
                                                (+ first (- (load y) 1)))
                                     true)
                    (include-command (al/al-get [i64]
                                                a
                                                (+ first (- (load x) 1)))
                                     false))
                (set! x previous-x)
                (set! y previous-y)
                (set! depth previous))))
          true))))

;;; Strip equal ends, then retain unchanged interior commands across independent
;;; edits (for example, a selection change followed by a cursor insertion).
(defn measure-commands [] (-> i64)
  (let [c (cache)
        s (scene)]
    (order-commands (.sheets s) (.inks s) (mut (.paint-order c)))
    (order-commands (.sheets c) (.inks c) (mut (.previous-order c)))
    (let [a (.paint-order c)
          b (.previous-order c)
          (mut first) 0
          (mut end-a) (al/al-len [i64] a)
          (mut end-b) (al/al-len [i64] b)]
      (while (and (< (load first) (load end-a))
                  (< (load first) (load end-b))
                  (command-equal (al/al-get [i64] a (load first))
                                 (al/al-get [i64] b (load first))))
        (set! first (+ (load first) 1)))
      (while (and (> (load end-a) (load first))
                  (> (load end-b) (load first))
                  (command-equal (al/al-get [i64] a (- (load end-a) 1))
                                 (al/al-get [i64] b (- (load end-b) 1))))
        (set! end-a (- (load end-a) 1))
        (set! end-b (- (load end-b) 1)))
      (when (not (measure-edits (load first) (load end-a) (load end-b)))
        (if (= (load end-a) (load end-b))
            (for [i (load first) (load end-a)]
              (let [x (al/al-get [i64] a i)
                    y (al/al-get [i64] b i)]
                (when (not (command-equal x y))
                  (include-command x false)
                  (include-command y true))))
            (do
              (for [i (load first) (load end-a)]
                (include-command (al/al-get [i64] a i) false))
              (for [i (load first) (load end-b)]
                (include-command (al/al-get [i64] b i) true)))))))
  0)

;;; Compare exact retained commands, including old bounds for removed geometry.
;;; Clip damage to integral backing pixels so antialiasing remains unchanged.
(defn measure [] (-> CGRect)
  (let [c (cache)
        s (scene)]
    (set! (.bounds c) (cgrect 0.0 0.0 0.0 0.0))
    (if (or (not (.valid c)) (!= (.background c) (.background s)))
        (include (cgrect 0.0
                         0.0
                         (/ (cast f64 (.width s)) (.scale s))
                         (/ (cast f64 (.height s)) (.scale s))))
        (measure-commands))
    (let [r (.bounds c)
          scale (.scale s)]
      (if (<= (.w r) 0.0)
          (load r)
          (let [x (floor (- (* (.x r) scale) 2.0))
                y (floor (- (* (.y r) scale) 2.0))
                right
                  (- 0.0 (floor (- 0.0 (+ (* (+ (.x r) (.w r)) scale) 2.0))))
                bottom
                  (- 0.0 (floor (- 0.0 (+ (* (+ (.y r) (.h r)) scale) 2.0))))]
            (cgrect (/ x scale)
                    (/ y scale)
                    (/ (- right x) scale)
                    (/ (- bottom y) scale)))))))

(defn remember [] (-> i64)
  (discard)
  (let [c (cache)
        s (scene)]
    (al/al-clear! [i64] (mut (.ink-orders c)))
    (for [i 0 (+ (.serial s) 1)] (al/al-push! [i64] (mut (.ink-orders c)) -1))
    (for [i 0 (al/al-len [Sheet] (.sheets s))]
      (let [(mut sheet) (al/al-get [Sheet] (.sheets s) i)]
        (set! (.path sheet) (CGPathCreateCopy (.path sheet)))
        (relief/retain (.relief sheet))
        (al/al-push! [Sheet] (mut (.sheets c)) (load sheet))))
    (for [i 0 (al/al-len [Ink] (.inks s))]
      (let [(mut ink) (al/al-get [Ink] (.inks s) i)]
        (al/al-set! [i64] (mut (.ink-orders c)) (.order ink) i)
        (set! (.text ink) (o/retain (.text ink)))
        (when (!= (.clip ink) (o/nil))
          (set! (.clip ink) (CGPathCreateCopy (.clip ink))))
        (al/al-push! [Ink] (mut (.inks c)) (load ink))))
    (set! (.background c) (.background s))
    (set! (.valid c) true))
  0)

(defn light-changed [] (-> bool)
  (let [c (cache)
        s (scene)]
    (or (not (.lit c))
        (p/fcmp-ne (.light-x c) (.light-x s))
        (p/fcmp-ne (.light-y c) (.light-y s))
        (p/fcmp-ne (.elevation c) (.elevation s))
        (p/fcmp-ne (.depth c) (.depth s))
        (p/fcmp-ne (.grain c) (.grain s)))))

(defn remember-light [] (-> i64)
  (let [c (cache)
        s (scene)]
    (set! (.light-x c) (.light-x s))
    (set! (.light-y c) (.light-y s))
    (set! (.elevation c) (.elevation s))
    (set! (.depth c) (.depth s))
    (set! (.grain c) (.grain s))
    (set! (.lit c) true))
  0)
