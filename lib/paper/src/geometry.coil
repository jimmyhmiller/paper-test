(module paper.geometry)

;;; Logical coordinates are points, independent of the backing pixel scale.
(defstruct Rect [(x f64) (y f64) (w f64) (h f64)])

(defn rect [(x f64) (y f64) (w f64) (h f64)] (-> Rect)
  (Rect
    :x x
    :y y
    :w w
    :h h))

(defn clamp [(v f64) (lo f64) (hi f64)] (-> f64)
  (if (< v lo) lo (if (> v hi) hi v)))

;;; Negative insets expand the rectangle. Dimensions never become negative.
(defn inset [(r Rect) (amount f64)] (-> Rect)
  (rect (+ (.x r) amount)
        (+ (.y r) amount)
        (clamp (- (.w r) (* 2.0 amount)) 0.0 1000000.0)
        (clamp (- (.h r) (* 2.0 amount)) 0.0 1000000.0)))

(defn contains? [(r Rect) (x f64) (y f64)] (-> bool)
  (and (>= x (.x r))
       (>= y (.y r))
       (< x (+ (.x r) (.w r)))
       (< y (+ (.y r) (.h r)))))

;;; Normalize a slider gesture and clamp it at both ends; zero width is safe.
(defn fraction [(x f64) (start f64) (width f64)] (-> f64)
  (if (<= width 0.0) 0.0 (clamp (/ (- x start) width) 0.0 1.0)))

;;; Shadow displacement for a directional light at a given height above a sheet.
(defn shadow-offset [(height f64) (light-horizontal f64) (elevation f64)] (-> f64)
  (/ (* (- 0.0 light-horizontal) height) (clamp elevation 1.0 1000000.0)))
