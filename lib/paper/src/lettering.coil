(module paper.lettering)
(import "paper.flow" :use *)
(import "paper.ffi" :use *)
(import "paper.objc" :use *)
(import "paper.scene" :use [scene])
(import "paper.paint" :use [type-face])
(import "coil.primitive" :as p)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as al)
(import "paper.relief" :as relief)
(import "paper.scene" :as commands)
(import "paper.platform" :as host)

(extern CTFontCreateWithName :cc c [(ptr i8) f64 (ptr CGAffine)] (-> (ptr i8)))

(extern CTFontGetGlyphsForCharacters
        :cc
        c
        [(ptr i8) (ptr u16) (ptr u16) i64]
        (-> bool))

(extern CTFontGetAdvancesForGlyphs
        :cc
        c
        [(ptr i8) u32 (ptr u16) (ptr CGSize) i64]
        (-> f64))

(extern CTFontCreatePathForGlyph
        :cc
        c
        [(ptr i8) u16 (ptr CGAffine)]
        (-> (ptr i8)))

(defstruct FontRange [(location i64) (length i64)])

(extern CTFontCreateForString :cc c [(ptr i8) (ptr i8) FontRange] (-> (ptr i8)))

;;; Real outline apertures share the paper renderer's material and lighting.
;;; CoreText selects fallback fonts for symbols and provides their native advances.
;;; Leave the combined outline in the current path for a cut or another treatment.
(defn lettering-path [(r Rect)
                      (text (ptr i8))
                      (size f64)
                      (font-index i64)
                      (right bool)] (-> i64)
  (let [string (ns text)
        (mut found) -1
        (mut oldest) 0]
    (store! (lettering-serial) (+ (load (lettering-serial)) 1))
    (for [i 0 256]
      (let [entry (index (lettering-entries) i)]
        (when (< (.used entry)
                 (.used (index (lettering-entries) (load oldest))))
          (set! oldest i))
        (when (and (!= (.path entry) (nil))
                   (= (.font entry) font-index)
                   (= (.right entry) right)
                   (p/fcmp-eq (.size entry) size)
                   (p/fcmp-eq (.width entry) (.w r))
                   (p/fcmp-eq (.height entry) (.h r))
                   (msg bool
                        (.text entry)
                        (sel c"isEqualToString:")
                        [(ptr i8)]
                        string))
          (set! found i)
          (break))))
    (let [entry
            (index (lettering-entries)
                   (if (>= (load found) 0) (load found) (load oldest)))]
      (when (< (load found) 0)
        (when (!= (.path entry) (nil))
          (CGPathRelease (.path entry))
          (release (.text entry)))
        (uncached-lettering-path (rect 0.0 0.0 (.w r) (.h r))
                                 text
                                 size
                                 font-index
                                 right)
        (set! (.path entry) (CGPathCreateCopy (.path (scene))))
        (set! (.text entry) (retain string))
        (set! (.size entry) size)
        (set! (.font entry) font-index)
        (set! (.right entry) right)
        (set! (.width entry) (.w r))
        (set! (.height entry) (.h r)))
      (set! (.used entry) (load (lettering-serial)))
      (begin-sheet)
      (let [path
              (CGPathCreateCopyByTransformingPath (.path entry)
                                                  (CGAffine
                                                    :a 1.0
                                                    :b 0.0
                                                    :c 0.0
                                                    :d 1.0
                                                    :tx (.x r)
                                                    :ty (.y r)))]
        (CGPathAddPath (.path (scene)) (cast (ptr CGAffine) 0) path)
        (CGPathRelease path))))
  0)

(defstruct LetteringEntry
  [(text (ptr i8))
   (path (ptr i8))
   (size f64)
   (font i64)
   (width f64)
   (height f64)
   (right bool)
   (used i64)])

(defn lettering-entries [] (-> (ptr (array LetteringEntry 256)))
  (p/alloc-static (array LetteringEntry 256)))

(defn lettering-serial [] (-> (ptr i64))
  (p/alloc-static i64))

(defn uncached-lettering-path [(r Rect)
                               (text (ptr i8))
                               (size f64)
                               (font-index i64)
                               (right bool)] (-> i64)
  (let [font
          (CTFontCreateWithName (ns (type-face font-index))
                                size
                                (cast (ptr CGAffine) 0))
        string (ns text)
        count (msg i64 string (sel c"length") [])
        (mut width) 0.0]
    (for [i 0 count]
      (let [face
              (CTFontCreateForString font
                                     string
                                     (FontRange :location i :length 1))
            (mut ch)
              (msg u16 string (sel c"characterAtIndex:") [u64] (cast u64 i))
            (mut glyph) (cast u16 0)]
        (CTFontGetGlyphsForCharacters face ch glyph 1)
        (set! width
              (+ (load width)
                 (CTFontGetAdvancesForGlyphs face
                                             0
                                             glyph
                                             (cast (ptr CGSize) 0)
                                             1)))
        (CFRelease face)))
    (let [scale (if (> (load width) (.w r)) (/ (.w r) (load width)) 1.0)
          (mut x)
            (+ (.x r)
               (if right
                   (- (.w r) (* (load width) scale))
                   (* 0.5 (- (.w r) (* (load width) scale)))))
          baseline (+ (.y r) (* 0.5 (+ (.h r) (* (* size scale) 0.72))))]
      (begin-sheet)
      (for [i 0 count]
        (let [face
                (CTFontCreateForString font
                                       string
                                       (FontRange :location i :length 1))
              (mut ch)
                (msg u16 string (sel c"characterAtIndex:") [u64] (cast u64 i))
              (mut glyph) (cast u16 0)]
          (CTFontGetGlyphsForCharacters face ch glyph 1)
          (let [(mut transform)
                  (load (CGAffine
                          :a scale
                          :b 0.0
                          :c 0.0
                          :d (- 0.0 scale)
                          :tx (load x)
                          :ty baseline))
                path (CTFontCreatePathForGlyph face (load glyph) transform)]
            (when (!= path (nil))
              (CGPathAddPath (.path (scene)) (cast (ptr CGAffine) 0) path)
              (CGPathRelease path)
              0)
            (set! x
                  (+ (load x)
                     (* scale
                        (CTFontGetAdvancesForGlyphs face
                                                    0
                                                    glyph
                                                    (cast (ptr CGSize) 0)
                                                    1))))
            (CFRelease face))))
      0)
    (CFRelease font))
  0)

;;; Center visible outlines, independently of baseline and advance side bearings.
;;; This is for standalone symbols; ordinary text retains its shared baseline.
(defn centered-lettering-path [(r Rect)
                               (text (ptr i8))
                               (size f64)
                               (font-index i64)] (-> i64)
  (lettering-path r text size font-index false)
  (let [bounds (CGPathGetPathBoundingBox (.path (scene)))]
    (when (and (> (.w bounds) 0.0) (> (.h bounds) 0.0))
      (let [(mut transform)
              (load (CGAffine
                      :a 1.0
                      :b 0.0
                      :c 0.0
                      :d 1.0
                      :tx
                        (- (+ (.x r) (* 0.5 (.w r)))
                           (+ (.x bounds) (* 0.5 (.w bounds))))
                      :ty
                        (- (+ (.y r) (* 0.5 (.h r)))
                           (+ (.y bounds) (* 0.5 (.h bounds))))))
            path (CGPathCreateCopyByTransformingPath (.path (scene)) transform)]
        (begin-sheet)
        (CGPathAddPath (.path (scene)) (cast (ptr CGAffine) 0) path)
        (CGPathRelease path)
        0)))
  0)

;;; Backward-compatible shallow carving.
(defn carved [(r Rect)
              (text (ptr i8))
              (size f64)
              (font-index i64)
              (z f64)
              (right bool)
              (material Material)] (-> i64)
  (lettering-path r text size font-index right)
  (cut-through (- z 3.8))
  (finish-sheet (- z 3.8) material))

(defn beveled-carved [(r Rect)
                      (text (ptr i8))
                      (size f64)
                      (font-index i64)
                      (z f64)
                      (right bool)
                      (depth f64)
                      (width f64)
                      (edge Material)
                      (bottom Material)] (-> i64)
  (lettering-path r text size font-index right)
  (bevel-lettering r z depth width edge bottom))

(defn centered-beveled-carved [(r Rect)
                               (text (ptr i8))
                               (size f64)
                               (font-index i64)
                               (z f64)
                               (depth f64)
                               (width f64)
                               (edge Material)
                               (bottom Material)] (-> i64)
  (centered-lettering-path r text size font-index)
  (bevel-lettering r z depth width edge bottom))

(defn bevel-lettering [(r Rect)
                       (z f64)
                       (depth f64)
                       (width f64)
                       (edge Material)
                       (bottom Material)] (-> i64)
  (let [bounds (CGPathGetPathBoundingBox (.path (scene)))]
    (beveled-cut z
                 depth
                 width
                 (texture-offset edge
                                 (+ (.x (.pattern edge))
                                    (- (.x r) (- (.x bounds) width)))
                                 (+ (.y (.pattern edge))
                                    (- (.y r) (- (.y bounds) width))))
                 bottom)))

;;; A self-contained raised key needs no subtraction from the rest of the scene.
;;; Its aperture is explicitly enclosed by the convex panel at every bevel level.
(defn lettered-panel [(r Rect)
                      (radius f64)
                      (shoulder-width f64)
                      (shoulder-depth f64)
                      (padding f64)
                      (text (ptr i8))
                      (size f64)
                      (font-index i64)
                      (z f64)
                      (centered bool)
                      (depth f64)
                      (width f64)
                      (edge Material)
                      (top Material)
                      (bottom Material)] (-> i64)
  (assert (> depth shoulder-depth))
  (assert (and (> shoulder-width 0.0)
               (<= shoulder-width radius)
               (> shoulder-depth 0.0)
               (> width 0.0)
               (>= z depth)))
  (assert (and (> (.w r) (* 2.0 shoulder-width))
               (> (.h r) (* 2.0 shoulder-width))))
  (if centered
      (centered-lettering-path (inset r padding) text size font-index)
      (lettering-path (inset r padding) text size font-index false))
  (let [payload (cast (ptr relief/Panel) (alloc/malloc (p/sizeof relief/Panel)))
        glyph (CGPathCreateCopy (.path (scene)))]
    (let [bounds (CGPathGetPathBoundingBox glyph)]
      (begin-sheet)
      (rounded-path (inset r shoulder-width) (- radius shoulder-width))
      (when (not (CGPathIsEmpty glyph))
        (for [i 0 4]
          (assert (CGPathContainsPoint (.path (scene))
                                       (cast (ptr CGAffine) 0)
                                       (CGPoint :x
                                                  (+ (- (.x bounds) width)
                                                     (if (= (% i 2) 0)
                                                         0.0
                                                         (+ (.w bounds)
                                                            (* 2.0 width))))
                                         :y
                                           (+ (- (.y bounds) width)
                                              (if (< i 2)
                                                  0.0
                                                  (+ (.h bounds) (* 2.0 width)))))
                                       true)))))
    (store! payload
            (relief/Panel
              :refs 1
              :bounds r
              :radius radius
              :shoulder-width shoulder-width
              :shoulder-depth shoulder-depth
              :depth depth
              :width width
              :z (+ z (.offset (scene)))
              :glyph glyph
              :edge edge
              :top top
              :bottom bottom
              :expand (fnptr-of expand-panel)))
    (panel r radius z top)
    (set! (.relief (al/al-elem [commands/Sheet]
                               (field (scene) sheets)
                               (- (al/al-len [commands/Sheet] (.sheets (scene)))
                                  1)))
          payload))
  0)

;;; General cuts and interleaved sheets retain the full vector semantics.
(defn expand-panel [(context (ptr i8))] (-> i64)
  (let [v (cast (ptr relief/Panel) context)
        r (.bounds v)
        active (.active (host/clip-state))]
    (set! (.active (host/clip-state)) false)
    (if (CGPathIsEmpty (.glyph v))
        (edged-panel r
                     (.radius v)
                     (.z v)
                     (.shoulder-width v)
                     (.shoulder-depth v)
                     (.edge v)
                     (.top v))
        (let [contours (bevel-contours (.glyph v) (.width v))
              bounds (CGPathGetPathBoundingBox (.outer contours))]
          (perforated-panel r
                            (.radius v)
                            (.z v)
                            (.shoulder-width v)
                            (.shoulder-depth v)
                            (.edge v)
                            (.top v)
                            (.outer contours))
          (finish-aperture contours
                           (.z v)
                           (.depth v)
                           (.width v)
                           (texture-offset (.edge v)
                                           (+ (.x (.pattern (.edge v)))
                                              (- (.x r) (.x bounds)))
                                           (+ (.y (.pattern (.edge v)))
                                              (- (.y r) (.y bounds))))
                           (.bottom v))))
    (set! (.active (host/clip-state)) active))
  0)
