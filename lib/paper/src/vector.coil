(module paper.vector)
(import "coil.primitive" :as p)

;;; Four-wide float lighting maps directly to Apple Silicon NEON. Geometry and
;;; native layout keep double precision; color is quantized to eight bits.
(defn splat [(a f64)] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4)
             [(cast f32 a)]
             "%a = insertelement $ret poison, float $0, i32 0
%b = shufflevector $ret %a, $ret poison, <4 x i32> zeroinitializer
ret $ret %b"))

(defn coordinates [(x i64)] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4)
             [(splat (cast f64 x))]
             "%r = fadd $ret $0, <float 0.0, float 1.0, float 2.0, float 3.0>
ret $ret %r"))

(defn add [(a (vec f32 4)) (b (vec f32 4))] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4) [a b] "%r = fadd $ret $0, $1
ret $ret %r"))

(defn sub [(a (vec f32 4)) (b (vec f32 4))] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4) [a b] "%r = fsub $ret $0, $1
ret $ret %r"))

(defn mul [(a (vec f32 4)) (b (vec f32 4))] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4) [a b] "%r = fmul $ret $0, $1
ret $ret %r"))

(defn div [(a (vec f32 4)) (b (vec f32 4))] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4) [a b] "%r = fdiv $ret $0, $1
ret $ret %r"))

(defn root [(a (vec f32 4))] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4)
             [a]
             "declare <4 x float> @llvm.sqrt.v4f32(<4 x float>)
%r = call $ret @llvm.sqrt.v4f32($ret $0)
ret $ret %r"))

(defn minimum [(a (vec f32 4)) (b (vec f32 4))] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4)
             [a b]
             "%c = fcmp olt $ret $0, $1
%r = select <4 x i1> %c, $ret $0, $ret $1
ret $ret %r"))

(defn limit [(a (vec f32 4)) (low f64) (high f64)] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4)
             [a (splat low) (splat high)]
             "%l = fcmp olt $ret $0, $1
%lo = select <4 x i1> %l, $ret $1, $ret $0
%h = fcmp ogt $ret %lo, $2
%r = select <4 x i1> %h, $ret $2, $ret %lo
ret $ret %r"))

(defn greater [(a (vec f32 4)) (b (vec f32 4))] (-> (vec i32 4))
  (p/llvm-ir (vec i32 4) [a b] "%c = fcmp ogt $t0 $0, $1
%r = sext <4 x i1> %c to $ret
ret $ret %r"))

(defn both [(a (vec i32 4)) (b (vec i32 4))] (-> (vec i32 4))
  (p/llvm-ir (vec i32 4) [a b] "%r = and $ret $0, $1
ret $ret %r"))

(defn any [(a (vec i32 4))] (-> bool)
  (p/llvm-ir bool [a] "%bits = bitcast $t0 $0 to i128
%r = icmp ne i128 %bits, 0
ret i1 %r"))

(defn choose [(mask (vec i32 4)) (a (vec f32 4)) (b (vec f32 4))] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4)
             [mask a b]
             "%c = icmp ne $t0 $0, zeroinitializer
%r = select <4 x i1> %c, $ret $1, $ret $2
ret $ret %r"))

(defn read-texture [(data (ptr f64))] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4)
             [data]
             "%v = load <4 x double>, ptr $0, align 8
%r = fptrunc <4 x double> %v to $ret
ret $ret %r"))

;;; Out-of-canvas lanes load a valid sentinel address and then select zero.
;;; This avoids per-lane branches while guaranteeing every read is in bounds.
;;; Coordinates truncate toward zero, matching the scalar renderer.
(defn heights [(data (ptr u8)) (x (vec f32 4)) (y (vec f32 4)) (w i64) (h i64)] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4)
             [data x y w h]
             "declare <4 x i8> @llvm.masked.gather.v4i8.v4p0(<4 x ptr>, i32 immarg, <4 x i1>, <4 x i8>)
%xi = fptosi $t1 $1 to <4 x i32>
%yi = fptosi $t2 $2 to <4 x i32>
%wi = trunc i64 $3 to i32
%w0 = insertelement <4 x i32> poison, i32 %wi, i32 0
%ws = shufflevector <4 x i32> %w0, <4 x i32> poison, <4 x i32> zeroinitializer
%hi = trunc i64 $4 to i32
%h0 = insertelement <4 x i32> poison, i32 %hi, i32 0
%hs = shufflevector <4 x i32> %h0, <4 x i32> poison, <4 x i32> zeroinitializer
%xp = icmp sge <4 x i32> %xi, zeroinitializer
%yp = icmp sge <4 x i32> %yi, zeroinitializer
%xq = icmp slt <4 x i32> %xi, %ws
%yq = icmp slt <4 x i32> %yi, %hs
%xy = and <4 x i1> %xp, %yp
%wh = and <4 x i1> %xq, %yq
%ok = and <4 x i1> %xy, %wh
%row = mul <4 x i32> %yi, %ws
%index = add <4 x i32> %row, %xi
%safe = select <4 x i1> %ok, <4 x i32> %index, <4 x i32> zeroinitializer
%ptrs = getelementptr i8, ptr $0, <4 x i32> %safe
%bytes = call <4 x i8> @llvm.masked.gather.v4i8.v4p0(<4 x ptr> %ptrs, i32 1, <4 x i1> <i1 true, i1 true, i1 true, i1 true>, <4 x i8> zeroinitializer)
%bounded = select <4 x i1> %ok, <4 x i8> %bytes, <4 x i8> zeroinitializer
%r = uitofp <4 x i8> %bounded to $ret
ret $ret %r"))

(defn write-colors [(input (ptr u8)) (output (ptr u8)) (shade (vec f32 4))] (-> i64)
  (write-lit-colors input output shade (splat 0.0)))

(defn write-lit-colors [(input (ptr u8)) (output (ptr u8)) (shade (vec f32 4)) (addition (vec f32 4))] (-> i64)
  (p/llvm-ir i64
             [input output shade addition]
             "%bytes = load <16 x i8>, ptr $0, align 1
%r8 = shufflevector <16 x i8> %bytes, <16 x i8> poison, <4 x i32> <i32 0, i32 4, i32 8, i32 12>
%g8 = shufflevector <16 x i8> %bytes, <16 x i8> poison, <4 x i32> <i32 1, i32 5, i32 9, i32 13>
%b8 = shufflevector <16 x i8> %bytes, <16 x i8> poison, <4 x i32> <i32 2, i32 6, i32 10, i32 14>
%rf = uitofp <4 x i8> %r8 to <4 x float>
%gf = uitofp <4 x i8> %g8 to <4 x float>
%bf = uitofp <4 x i8> %b8 to <4 x float>
%rm = fmul <4 x float> %rf, $2
%ra = fadd <4 x float> %rm, $3
%rnegative = fcmp olt <4 x float> %ra, zeroinitializer
%rv = select <4 x i1> %rnegative, <4 x float> zeroinitializer, <4 x float> %ra
%gm = fmul <4 x float> %gf, $2
%ga = fadd <4 x float> %gm, $3
%gnegative = fcmp olt <4 x float> %ga, zeroinitializer
%gv = select <4 x i1> %gnegative, <4 x float> zeroinitializer, <4 x float> %ga
%bm = fmul <4 x float> %bf, $2
%ba = fadd <4 x float> %bm, $3
%bnegative = fcmp olt <4 x float> %ba, zeroinitializer
%bv = select <4 x i1> %bnegative, <4 x float> zeroinitializer, <4 x float> %ba
%ri = fptoui <4 x float> %rv to <4 x i32>
%gi = fptoui <4 x float> %gv to <4 x i32>
%bi = fptoui <4 x float> %bv to <4 x i32>
%rc = icmp ugt <4 x i32> %ri, <i32 255, i32 255, i32 255, i32 255>
%gc = icmp ugt <4 x i32> %gi, <i32 255, i32 255, i32 255, i32 255>
%bc = icmp ugt <4 x i32> %bi, <i32 255, i32 255, i32 255, i32 255>
%rs = select <4 x i1> %rc, <4 x i32> <i32 255, i32 255, i32 255, i32 255>, <4 x i32> %ri
%gs = select <4 x i1> %gc, <4 x i32> <i32 255, i32 255, i32 255, i32 255>, <4 x i32> %gi
%bs = select <4 x i1> %bc, <4 x i32> <i32 255, i32 255, i32 255, i32 255>, <4 x i32> %bi
%gshift = shl <4 x i32> %gs, <i32 8, i32 8, i32 8, i32 8>
%bshift = shl <4 x i32> %bs, <i32 16, i32 16, i32 16, i32 16>
%rg = or <4 x i32> %rs, %gshift
%rgb = or <4 x i32> %rg, %bshift
%rgba = or <4 x i32> %rgb, <i32 -16777216, i32 -16777216, i32 -16777216, i32 -16777216>
store <4 x i32> %rgba, ptr $1, align 1
ret i64 0"))

(defn write-reflected-colors [(input (ptr u8))
                              (output (ptr u8))
                              (shade (vec f32 4))
                              (addition (vec f32 4))
                              (reflection (vec f32 4))] (-> i64)
  (p/llvm-ir i64
             [input output shade addition reflection]
             "%bytes = load <16 x i8>, ptr $0, align 1
%r8 = shufflevector <16 x i8> %bytes, <16 x i8> poison, <4 x i32> <i32 0, i32 4, i32 8, i32 12>
%g8 = shufflevector <16 x i8> %bytes, <16 x i8> poison, <4 x i32> <i32 1, i32 5, i32 9, i32 13>
%b8 = shufflevector <16 x i8> %bytes, <16 x i8> poison, <4 x i32> <i32 2, i32 6, i32 10, i32 14>
%rf = uitofp <4 x i8> %r8 to <4 x float>
%gf = uitofp <4 x i8> %g8 to <4 x float>
%bf = uitofp <4 x i8> %b8 to <4 x float>
%rraw = fmul <4 x float> %rf, $2
%rlow = fcmp olt <4 x float> %rraw, zeroinitializer
%rpositive = select <4 x i1> %rlow, <4 x float> zeroinitializer, <4 x float> %rraw
%rhigh = fcmp ogt <4 x float> %rpositive, <float 255.0, float 255.0, float 255.0, float 255.0>
%rbase = select <4 x i1> %rhigh, <4 x float> <float 255.0, float 255.0, float 255.0, float 255.0>, <4 x float> %rpositive
%rcolored = fmul <4 x float> %rf, $4
%rreflected = fadd <4 x float> %rcolored, $3
%runit = fdiv <4 x float> %rreflected, <float 255.0, float 255.0, float 255.0, float 255.0>
%rdenom = fadd <4 x float> %runit, <float 1.0, float 1.0, float 1.0, float 1.0>
%rnumer = fadd <4 x float> %rbase, %rreflected
%ra = fdiv <4 x float> %rnumer, %rdenom
%rnegative = fcmp olt <4 x float> %ra, zeroinitializer
%rv = select <4 x i1> %rnegative, <4 x float> zeroinitializer, <4 x float> %ra
%graw = fmul <4 x float> %gf, $2
%glow = fcmp olt <4 x float> %graw, zeroinitializer
%gpositive = select <4 x i1> %glow, <4 x float> zeroinitializer, <4 x float> %graw
%ghigh = fcmp ogt <4 x float> %gpositive, <float 255.0, float 255.0, float 255.0, float 255.0>
%gbase = select <4 x i1> %ghigh, <4 x float> <float 255.0, float 255.0, float 255.0, float 255.0>, <4 x float> %gpositive
%gcolored = fmul <4 x float> %gf, $4
%greflected = fadd <4 x float> %gcolored, $3
%gunit = fdiv <4 x float> %greflected, <float 255.0, float 255.0, float 255.0, float 255.0>
%gdenom = fadd <4 x float> %gunit, <float 1.0, float 1.0, float 1.0, float 1.0>
%gnumer = fadd <4 x float> %gbase, %greflected
%ga = fdiv <4 x float> %gnumer, %gdenom
%gnegative = fcmp olt <4 x float> %ga, zeroinitializer
%gv = select <4 x i1> %gnegative, <4 x float> zeroinitializer, <4 x float> %ga
%braw = fmul <4 x float> %bf, $2
%blow = fcmp olt <4 x float> %braw, zeroinitializer
%bpositive = select <4 x i1> %blow, <4 x float> zeroinitializer, <4 x float> %braw
%bhigh = fcmp ogt <4 x float> %bpositive, <float 255.0, float 255.0, float 255.0, float 255.0>
%bbase = select <4 x i1> %bhigh, <4 x float> <float 255.0, float 255.0, float 255.0, float 255.0>, <4 x float> %bpositive
%bcolored = fmul <4 x float> %bf, $4
%breflected = fadd <4 x float> %bcolored, $3
%bunit = fdiv <4 x float> %breflected, <float 255.0, float 255.0, float 255.0, float 255.0>
%bdenom = fadd <4 x float> %bunit, <float 1.0, float 1.0, float 1.0, float 1.0>
%bnumer = fadd <4 x float> %bbase, %breflected
%ba = fdiv <4 x float> %bnumer, %bdenom
%bnegative = fcmp olt <4 x float> %ba, zeroinitializer
%bv = select <4 x i1> %bnegative, <4 x float> zeroinitializer, <4 x float> %ba
%ri = fptoui <4 x float> %rv to <4 x i32>
%gi = fptoui <4 x float> %gv to <4 x i32>
%bi = fptoui <4 x float> %bv to <4 x i32>
%rc = icmp ugt <4 x i32> %ri, <i32 255, i32 255, i32 255, i32 255>
%gc = icmp ugt <4 x i32> %gi, <i32 255, i32 255, i32 255, i32 255>
%bc = icmp ugt <4 x i32> %bi, <i32 255, i32 255, i32 255, i32 255>
%rs = select <4 x i1> %rc, <4 x i32> <i32 255, i32 255, i32 255, i32 255>, <4 x i32> %ri
%gs = select <4 x i1> %gc, <4 x i32> <i32 255, i32 255, i32 255, i32 255>, <4 x i32> %gi
%bs = select <4 x i1> %bc, <4 x i32> <i32 255, i32 255, i32 255, i32 255>, <4 x i32> %bi
%gshift = shl <4 x i32> %gs, <i32 8, i32 8, i32 8, i32 8>
%bshift = shl <4 x i32> %bs, <i32 16, i32 16, i32 16, i32 16>
%rg = or <4 x i32> %rs, %gshift
%rgb = or <4 x i32> %rg, %bshift
%rgba = or <4 x i32> %rgb, <i32 -16777216, i32 -16777216, i32 -16777216, i32 -16777216>
store <4 x i32> %rgba, ptr $1, align 1
ret i64 0"))

(defn read-floats [(data (ptr f32))] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4) [data] "%v = load $ret, ptr $0, align 4
ret $ret %v"))

(defn read-heights [(data (ptr u8))] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4) [data] "%v = load <4 x i8>, ptr $0, align 1
%r = uitofp <4 x i8> %v to $ret
ret $ret %r"))
