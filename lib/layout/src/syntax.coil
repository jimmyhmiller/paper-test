(module layout.syntax)
(import "coil.primitive" :as p)
(import "layout.core" :as l)

;;; Flatten named nested bindings into one lexical scope. All identifiers retain
;;; caller syntax identity. Builders append once; no repeated syntax copying.
(defn collect-nodes [(tree Code) (parent Code) (ctx Code) (bindings CodeBuilder)] (-> i64)
  (assert (>= (p/code-count tree) 2))
  (let [name (p/code-nth tree 0)
        style (p/code-nth tree 1)
        measured? (and (> (p/code-count tree) 2) (p/code-eq (p/code-nth tree 2) `:measure))]
    (when measured? (assert (= (p/code-count tree) 5)))
    (p/code-list-push! bindings name)
    (p/code-list-push! bindings
                       (if measured?
                           `(l/measured ~ctx ~parent ~style ~(p/code-nth tree 3) ~(p/code-nth tree 4))
                           `(l/add ~ctx ~parent ~style)))
    (let [(mut count) 1]
      (for [i (if measured? 5 2) (p/code-count tree)]
        (set! count (+ (load count) (collect-nodes (p/code-nth tree i) name ctx bindings))))
      (load count))))

;;; Declare a named tree, solve it, then evaluate body exactly once. Every name
;;; in the tree is a resolved Rect in body. Ordinary runtime styles, conditionals,
;;; functions, and local values work without capture or deferred drawing.
;;; (arrange viewport [page (column ...)
;;;                    [header (box ...)] [body (row ...) [left ...] [right ...]]]
;;;   (panel header ...) (draw-content body))
(defn arrange [(viewport Code) (tree Code) & (body Code)] (-> Code)
  (let [ctx (p/fresh-identifier "layout-context")
        storage (p/fresh-identifier "layout-storage")
        bindings (p/code-list-new)
        count (collect-nodes tree `-1 ctx bindings)
        handles (p/code-list-done bindings)
        rectangles (p/code-list-new)]
    (for [i 0 count]
      (let [name (p/code-nth handles (* i 2))]
        (p/code-list-push! rectangles name)
        (p/code-list-push! rectangles `(l/bounds ~ctx ~name))))
    `(let [(mut ~storage) (zeroed (array l/Node ~count))
           (mut ~ctx) (l/layout (index ~storage 0) ~count)
           ~@handles]
       (l/solve ~ctx ~viewport)
       (let [~@(p/code-list-done rectangles)] ~@body))))
