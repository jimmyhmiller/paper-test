(module papercut.finish-test)
(import "coil.primitive" :as p)
(import "coil.alloc" :as alloc)
(import "paper.ui" :use *)
(import "paper.texture" :as tex)
(import "paper.finish-light" :as finish)
(import "paper.scene" :as scene)
(import "paper.platform" :as host)
(import "paper.render" :as render)
(import "paper.damage" :as damage)
(import "paper.gpu" :as gpu)
(import "paper.objc" :as o)
(import "paper.ffi" :use *)

(extern memcpy :cc c [(ptr u8) (ptr u8) u64] (-> (ptr u8)))

(extern memcmp :cc c [(ptr u8) (ptr u8) u64] (-> i32))

(extern setenv :cc c [(ptr i8) (ptr i8) i32] (-> i32))

(extern unsetenv :cc c [(ptr i8)] (-> i32))

(defn setup [] (-> i64)
  (scene/init)
  (set! (.width (scene/scene)) 401)
  (set! (.height (scene/scene)) 321)
  (set! (.scale (scene/scene)) 1.0)
  (render/setup))

(defn stock-at [(i i64)] (-> Material)
  (case i 0
        (velvet 0x713e60) 1
        (brushed-aluminum 0xb7bec5) 2
        (satin 0xb8909c) 3
        (glazed-ceramic 0x629c98) 4
        (polished-leather 0x8b5f49) (varnished-wood 0xba8d59)))

(defn swatches [] (-> i64)
  (host/paper_begin 0xdddddd)
  (host/paper_light 205.0 155.0 110.0 0.7 1.0)
  (for [i 0 6]
    (let [x (+ 8.0 (* (cast f64 (% i 3)) 132.0))
          y (+ 8.0 (* (cast f64 (/ i 3)) 160.0))]
      (panel (rect x y 120.0 144.0) 4.0 18.0 (texture-angle (stock-at i) 31.0))))
  0)

(deftest reflection-is-directional-and-distinguishes-metal-from-cloth
         (let [along (finish/fin-specular 0.0 0.0 250.0 0.0 200.0 0.3 0.75 0.0)
               across (finish/fin-specular 0.0 0.0 0.0 250.0 200.0 0.3 0.75 0.0)
               rotated (finish/fin-specular 0.0 0.0 0.0 250.0 200.0 0.3 -0.75 0.0)
               front (finish/fin-sheen 0.0 0.0 0.0 0.0 200.0 0.65 0.65 0.0)
               grazing (finish/fin-sheen 0.0 0.0 350.0 0.0 200.0 0.65 0.65 0.0)
               metal (finish/evaluate 0.0 0.0 0.0 0.0 200.0 0.3 0.75 0.0 1.0 1.0 0.0)
               plastic (finish/evaluate 0.0 0.0 0.0 0.0 200.0 0.3 0.75 0.0 1.0 0.0 0.0)]
           (assert (> along (* 5.0 across)))
           (assert (< (tex/tex-abs (- along rotated)) 0.000001))
           (assert (> grazing (+ front 0.01)))
           (assert (> (.pigment metal) 0.5))
           (assert (< (.white metal) 0.000001))
           (assert (> (.white plastic) 0.01))
           (assert (< (.pigment plastic) 0.000001))))

(deftest reflection-remains-finite-at-extreme-slopes-and-grazing-light
         (for [i 0 160]
           (let [r
                   (finish/evaluate (- (cast f64 (% i 9)) 4.0)
                                    (- (cast f64 (% i 7)) 3.0)
                                    (- (* (cast f64 i) 17.0) 1300.0)
                                    400.0
                                    80.0
                                    (if (= (% i 2) 0) 0.12 1.0)
                                    0.63
                                    -0.63
                                    1.0
                                    1.0
                                    1.0)]
             (assert (and (>= (.base r) 0.0) (<= (.base r) 1.0)))
             (assert (and (>= (.pigment r) 0.0) (< (.pigment r) 1000.0)))
             (assert (and (>= (.white r) 0.0) (< (.white r) 1000.0)))
             (let [value (finish/fin-channel 0.8 (.base r) (.pigment r) (.white r))]
               (assert (and (>= value 0.0) (<= value 1.0)))))))

(deftest bright-reflections-retain-gradation-without-clipping
         (let [a (finish/fin-channel 0.7 0.3 2.0 0.1)
               b (finish/fin-channel 0.7 0.3 5.0 0.1)
               c (finish/fin-channel 0.7 0.3 10.0 0.1)]
           (assert (and (< a b) (< b c) (< c 1.0)))
           (assert (> (- c b) 0.02))
           (assert (< (tex/tex-abs (- (finish/fin-channel 0.7 0.8 0.0 0.0) 0.56)) 0.000001))))

(deftest tint-and-texture-modifiers-preserve-finish
         (let [a (brushed-aluminum 0xb0b0b0)
               b (tint (texture-scale (texture-angle (texture-offset a 3.0 7.0) 45.0) 1.5) 0xaa7744 0.2)]
           (assert (finish-equal (.finish a) (.finish b)))
           (let [matte (without-finish b)]
             (assert (not (finish-active (.finish matte))))
             (assert (pattern-equal (.pattern matte) (.pattern b)))
             (assert (= (.pigment matte) (.pigment b))))))

(deftest finish-only-changes-invalidate-and-match-full-frames
         (let [pool (o/new c"NSAutoreleasePool")]
           (setup)
           (let [bytes (cast u64 (* (* 401 321) 4))
                 previous (cast (ptr u8) (alloc/malloc (cast isize bytes)))
                 current (cast (ptr u8) (alloc/malloc (cast isize bytes)))]
             (for [i 0 6]
               (host/paper_begin 0xdddddd)
               (host/paper_light 170.0 145.0 110.0 0.6 1.0)
               (panel (rect 8.0 8.0 380.0 300.0)
                      8.0
                      18.0
                      (surface-finish (felt 0x71948a)
                                      (if (= i 1) 0.7 0.3)
                                      (if (= i 2) 0.2 0.9)
                                      (if (= i 3) 1.0 0.0)
                                      (if (= i 4) 0.8 0.0)
                                      (if (= i 5) 0.8 0.0)))
               (host/paper_rule 80.0 125.0 230.0 20.0 0x111111)
               (render/render)
               (memcpy current (CGBitmapContextGetData (.output-context (scene/scene))) bytes)
               (when (> i 0) (assert (!= (memcmp previous current bytes) (cast i32 0))))
               (memcpy previous current bytes)
               (set! (.valid (damage/cache)) false)
               (set! (.geometry-dirty (scene/scene)) true)
               (render/render)
               (assert (= (memcmp current (CGBitmapContextGetData (.output-context (scene/scene))) bytes) (cast i32 0))))
             (render/free (cast (ptr i8) previous))
             (render/free (cast (ptr i8) current)))
           (o/release pool)))

(deftest reflective-materials-agree-between-cpu-and-metal
         (let [pool (o/new c"NSAutoreleasePool")]
           (setup)
           (when (.available (gpu/gpu))
             (swatches)
             (render/render)
             (let [bytes (cast u64 (* (* 401 321) 4))
                   copy (cast (ptr u8) (alloc/malloc (cast isize bytes)))]
               (memcpy copy (CGBitmapContextGetData (.output-context (scene/scene))) bytes)
               (setenv c"PAPER_RENDERER" c"cpu" 1)
               (set! (.available (gpu/gpu)) false)
               (render/setup)
               (swatches)
               (render/render)
               (let [cpu (CGBitmapContextGetData (.output-context (scene/scene)))
                     (mut maximum) 0]
                 (for [i 0 6]
                   (let [(mut local) 0]
                     (for [y (+ 20 (* (/ i 3) 160)) (+ 140 (* (/ i 3) 160))]
                       (for [x (+ 20 (* (% i 3) 132)) (+ 115 (* (% i 3) 132))]
                         (for [channel 0 3]
                           (let [pos (+ (* (+ (* y 401) x) 4) channel)
                                 difference
                                   (tex/tex-abs (- (cast f64 (load (index cpu pos))) (cast f64 (load (index copy pos)))))]
                             (when (> difference (cast f64 (load local))) (set! local (cast i64 difference)))
                             (when (> difference (cast f64 (load maximum))) (set! maximum (cast i64 difference)))))))
                     (println "Reflective stock {} max RGB difference {}" i (load local))))
                 (assert (<= (load maximum) 2)))
               (unsetenv c"PAPER_RENDERER")
               (render/free (cast (ptr i8) copy)))
             0)
           (o/release pool)))

(deftest printed-ink-and-cuts-do-not-inherit-shiny-highlights
         (let [pool (o/new c"NSAutoreleasePool")]
           (setup)
           (host/paper_begin 0xdddddd)
           (host/paper_light 205.0 155.0 110.0 0.0 1.0)
           (panel (rect 0.0 0.0 401.0 321.0) 0.0 10.0 (smooth 0x555555))
           (panel (rect 8.0 8.0 385.0 305.0) 0.0 30.0 (brushed-aluminum 0xaaaaaa))
           (host/paper_rule 90.0 130.0 220.0 45.0 0x000000)
           (begin-sheet)
           (rounded-path (rect 165.0 70.0 60.0 45.0) 0.0)
           (cut-through 10.0)
           (render/render)
           (let [pixels (CGBitmapContextGetData (.output-context (scene/scene)))]
             (for [y 138 167]
               (for [x 100 300]
                 (assert (= (load (index pixels (* (+ (* y 401) x) 4))) (cast u8 0)))))
             (let [hole (cast i64 (load (index pixels (* (+ (* 90 401) 195) 4))))]
               (assert (and (> hole 60) (< hole 100)))))
           (o/release pool)))

(deftest cast-shadows-extinguish-direct-reflections
         (setup)
         (host/paper_begin 0xdddddd)
         (host/paper_light 80.0 160.0 80.0 1.0 0.0)
         (panel (rect 0.0 0.0 401.0 321.0) 0.0 0.0 (surface-finish (smooth 0x000000) 0.3 1.0 0.0 0.0 0.0))
         (render/render)
         (let [lit
                 (cast i64
                       (load (index (CGBitmapContextGetData (.output-context (scene/scene))) (* (+ (* 160 401) 130) 4))))]
           (host/paper_begin 0xdddddd)
           (panel (rect 0.0 0.0 401.0 321.0) 0.0 0.0 (surface-finish (smooth 0x000000) 0.3 1.0 0.0 0.0 0.0))
           (panel (rect 95.0 130.0 20.0 60.0) 0.0 60.0 (smooth 0x555555))
           (render/render)
           (let [shadow
                   (cast i64
                         (load (index (CGBitmapContextGetData (.output-context (scene/scene)))
                                      (* (+ (* 160 401) 130) 4))))]
             (assert (> lit 4))
             (assert (<= shadow 1)))))

(deftest printed-glyphs-suppress-finish-and-light-movement-reuses-materials
         (let [pool (o/new c"NSAutoreleasePool")]
           (setup)
           (host/paper_begin 0xdddddd)
           (host/paper_light 200.0 155.0 180.0 0.6 1.0)
           (panel (rect 0.0 0.0 401.0 321.0) 0.0 10.0 (brushed-aluminum 0xaaaaaa))
           (label 90.0 130.0 30.0 0x000000 2 c"PRINTED INK")
           (render/render)
           (let [pixels (CGBitmapContextGetData (.output-context (scene/scene)))
                 colors (CGBitmapContextGetData (.color-context (scene/scene)))
                 (mut ink-pixels) 0
                 bytes (cast u64 (* (* 401 321) 4))
                 copy (cast (ptr u8) (alloc/malloc (cast isize bytes)))]
             (for [y 130 170]
               (for [x 90 320]
                 (let [pos (* (+ (* y 401) x) 4)]
                   (when (= (load (index colors pos)) (cast u8 0))
                     (assert (= (load (index pixels pos)) (cast u8 0)))
                     (set! ink-pixels (+ (load ink-pixels) 1))))))
             (assert (> (load ink-pixels) 80))
             (memcpy copy pixels bytes)
             (host/paper_light 100.0 60.0 180.0 0.6 1.0)
             (assert (not (.geometry-dirty (scene/scene))))
             (render/render)
             (assert (!= (memcmp copy pixels bytes) (cast i32 0)))
             (memcpy copy pixels bytes)
             (set! (.geometry-dirty (scene/scene)) true)
             (set! (.valid (damage/cache)) false)
             (render/render)
             (assert (= (memcmp copy pixels bytes) (cast i32 0)))
             (render/free (cast (ptr i8) copy)))
           (o/release pool)))
