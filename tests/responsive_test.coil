(module papercut.responsive-test)
(import "coil.primitive" :as p)
(import "paper.platform" :as host)
(import "paper.scene" :as scene)
(import "paper.render" :as render)
(import "paper.surface" :use [panel])
(import "paper.material" :use [smooth])
(import "paper.geometry" :use [rect])

(deftest responsive-window-reallocates-render-targets-without-scaling-points
         (scene/init)
         (host/paper_configure c"Responsive test" 800.0 600.0)
         (host/paper_responsive 320.0 240.0)
         (assert (host/resize-responsive 640.0 480.0))
         (assert (= (cast i64 (host/logical-width)) 640))
         (assert (= (cast i64 (host/logical-height)) 480))
         (assert (= (.width (scene/scene))
                    (cast i64 (* 640.0 (.scale (scene/scene))))))
         (host/paper_begin 0xffffff)
         (panel (rect 20.0 20.0 100.0 60.0) 0.0 10.0 (smooth 0x334455))
         (render/render)
         (assert (not (host/resize-responsive 640.0 480.0)))
         (assert (host/resize-responsive 720.0 400.0))
         (host/paper_begin 0xffffff)
         (panel (rect 20.0 20.0 100.0 60.0) 0.0 10.0 (smooth 0x334455))
         (render/render)
         (assert (= (cast i64 (host/logical-height)) 400))
         (assert (not (host/resize-responsive 0.0 0.0)))
         (set! (.responsive (host/host)) false)
         (assert (not (host/resize-responsive 800.0 600.0))))
