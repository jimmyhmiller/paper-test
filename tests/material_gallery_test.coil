(module papercut.material-gallery-test)
(import "coil.primitive" :as p)
(import "papercut.material-workbench" :as gallery)
(import "paper.scene" :as scene)
(import "paper.platform" :as host)
(import "paper.render" :as render)
(import "paper.objc" :as o)

(deftest gallery-selects-transforms-and-returns-to-swatches
         (let [pool (o/new c"NSAutoreleasePool")]
           (scene/init)
           (set! (.headless (host/host)) true)
           (set! (.width (scene/scene)) 1280)
           (set! (.height (scene/scene)) 920)
           (set! (.scale (scene/scene)) 1.0)
           (render/setup)
           (gallery/event 0 0 0.0 0.0)
           (gallery/draw)
           (assert (= (.selected (gallery/workbench)) -1))
           (gallery/event 3 8 0.0 0.0)
           (gallery/draw)
           (assert (= (.selected (gallery/workbench)) 7))
           (gallery/event 3 101 0.0 0.0)
           (assert (p/fcmp-eq (.angle (gallery/workbench)) 30.0))
           (gallery/event 3 102 0.0 0.0)
           (assert (p/fcmp-eq (.size (gallery/workbench)) 2.0))
           (gallery/draw)
           (render/render)
           (gallery/event 3 103 0.0 0.0)
           (assert (= (.selected (gallery/workbench)) 8))
           (gallery/event 4 53 0.0 0.0)
           (gallery/draw)
           (assert (= (.selected (gallery/workbench)) -1))
           (gallery/event 3 20 0.0 0.0)
           (assert (= (.selected (gallery/workbench)) 19))
           (assert (.show-finish (gallery/workbench)))
           (gallery/event 3 104 0.0 0.0)
           (assert (not (.show-finish (gallery/workbench))))
           (gallery/draw)
           (render/render)
           (gallery/event 3 104 0.0 0.0)
           (gallery/event 3 24 0.0 0.0)
           (gallery/event 3 103 0.0 0.0)
           (assert (= (.selected (gallery/workbench)) 0))
           (o/release pool)))
