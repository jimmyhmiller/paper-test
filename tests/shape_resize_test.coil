(module paper.shape-resize-test)
(import "paper.shape-resize" :as sizing)
(import "paper.geometry" :use [rect])
(import "paper.ffi" :use [cgrect CGPoint fabs])

(deftest rounded-casing-resize-targets-exclude-interior-and-transparent-corners
         (let [r (rect 38.0 52.0 544.0 698.0)]
           (assert (= (sizing/edge-at r 52.0 38.0 400.0 7.0) 2))
           (assert (= (sizing/edge-at r 52.0 582.0 400.0 7.0) 8))
           (assert (= (sizing/edge-at r 52.0 300.0 52.0 7.0) 1))
           (assert (= (sizing/edge-at r 52.0 300.0 750.0 7.0) 4))
           (assert (= (sizing/edge-at r 52.0 54.0 68.0 7.0) 3))
           (assert (= (sizing/edge-at r 52.0 566.0 68.0 7.0) 9))
           (assert (= (sizing/edge-at r 52.0 54.0 734.0 7.0) 6))
           (assert (= (sizing/edge-at r 52.0 566.0 734.0 7.0) 12))
           (assert (= (sizing/edge-at r 52.0 38.0 52.0 7.0) 0))
           (assert (= (sizing/edge-at r 52.0 300.0 72.0 7.0) 0))
           (assert (= (sizing/edge-at r 52.0 300.0 400.0 7.0) 0))))

(deftest shaped-resize-preserves-aspect-opposite-anchor-and-minimum-size
         (let [original (cgrect 100.0 200.0 620.0 790.0)
               shape (rect 38.0 52.0 544.0 698.0)
               start (CGPoint :x 682.0 :y 590.0)
               grown
                 (sizing/frame-for original
                                   shape
                                   620.0
                                   790.0
                                   8
                                   start
                                   (CGPoint :x 790.8 :y 610.0)
                                   372.0
                                   474.0)
               small
                 (sizing/frame-for original
                                   shape
                                   620.0
                                   790.0
                                   8
                                   start
                                   (CGPoint :x -1000.0 :y 590.0)
                                   372.0
                                   474.0)]
           (assert (< (fabs (- (.w grown) 744.0)) 0.000001))
           (assert (< (fabs (- (/ (.w grown) (.h grown)) (/ 620.0 790.0)))
                      0.000001))
           (assert (< (fabs (- (+ (.x grown) (* (/ 38.0 620.0) (.w grown)))
                               138.0))
                      0.000001))
           (assert (< (fabs (- (.w small) 372.0)) 0.000001))
           (assert (< (fabs (- (.h small) 474.0)) 0.000001))))
