(module papercut.interaction-test)
(import "coil.arraylist" :as al)
(import "paper.scene" :as scene)
(import "paper.platform" :as host)
(import "paper.surface" :use *)
(import "paper.geometry" :use [rect])
(import "paper.material" :use [cream])
(import "paper.components" :use [with-enabled])

(deftest hit-testing-follows-height-before-submission-order
         (scene/init)
         (host/paper_begin 0xffffff)
         (ink-height 30.0)
         (host/paper_hit 1 20.0 20.0 100.0 100.0 c"Upper" 0 0.0)
         (ink-height 10.0)
         (host/paper_hit 2 20.0 20.0 100.0 100.0 c"Lower" 0 0.0)
         (assert (= (host/hit-test 50.0 50.0) 1))
         (assert (= (host/hit-test 120.0 50.0) 0)))

(deftest a-hole-in-a-control-exposes-the-control-below
         (scene/init)
         (host/paper_begin 0xffffff)
         (ink-height 10.0)
         (host/paper_hit 1 20.0 20.0 100.0 100.0 c"Lower" 0 0.0)
         (ink-height 30.0)
         (host/paper_hit 2 20.0 20.0 100.0 100.0 c"Upper" 0 0.0)
         (begin-sheet)
         (oval-path (rect 40.0 40.0 40.0 40.0))
         (cut-through 10.0)
         (assert (= (host/hit-test 60.0 60.0) 1))
         (assert (= (host/hit-test 30.0 30.0) 2)))

(deftest a-fully-carved-control-leaves-the-focus-and-accessibility-list
         (scene/init)
         (host/paper_begin 0xffffff)
         (ink-height 30.0)
         (for [i 0 3]
           (host/paper_hit (+ i 1) (* (cast f64 i) 50.0) 20.0 40.0 40.0 c"Control" 0 0.0))
         (set! (.focus (host/host)) 2)
         (begin-sheet)
         (rounded-path (rect 45.0 10.0 50.0 60.0) 0.0)
         (cut-through 0.0)
         (assert (= (al/al-len [scene/Hit] (.hits (scene/scene))) 2))
         (assert (= (.focus (host/host)) 0))
         (assert (not (host/activate-control 2)))
         (assert (= (host/hit-test 70.0 40.0) 0))
         (assert (= (host/hit-test 20.0 40.0) 1))
         (assert (= (host/hit-test 120.0 40.0) 3)))

(deftest forward-and-reverse-focus-enter-and-wrap-correctly
         (scene/init)
         (host/paper_begin 0xffffff)
         (assert (= (host/next-control 0 false) 0))
         (assert (= (host/next-control 0 true) 0))
         (for [i 0 3]
           (host/paper_hit (+ i 1) (* (cast f64 i) 50.0) 20.0 40.0 40.0 c"Control" 0 0.0))
         (assert (= (host/next-control 0 false) 1))
         (assert (= (host/next-control 0 true) 3))
         (assert (= (host/next-control 1 true) 3))
         (assert (= (host/next-control 3 false) 1))
         (assert (= (host/next-control 2 false) 3)))

(deftest absent-controls-and-sliders-reject-button-activation
         (scene/init)
         (host/paper_begin 0xffffff)
         (host/paper_hit 1 20.0 20.0 100.0 30.0 c"Slider" 1 0.5)
         (assert (not (host/activate-control 99)))
         (assert (not (host/activate-control 1))))

(deftest tab-order-interleaves-native-fields-with-paper-controls
         (scene/init)
         (host/paper_begin 0xffffff)
         (host/paper_hit 1 0.0 0.0 50.0 30.0 c"Before" 0 0.0)
         (set! (.headless (host/host)) true)
         (host/paper_input 2 0.0 40.0 100.0 30.0 c"Name")
         (set! (.headless (host/host)) false)
         (host/paper_hit 3 0.0 80.0 50.0 30.0 c"After" 0 0.0)
         (assert (= (host/next-control 1 false) 2))
         (assert (= (host/next-control 2 false) 3))
         (assert (= (host/next-control 3 true) 2))
         (assert (= (host/next-control 2 true) 1))
         (assert (not (host/activate-control 2))))

(deftest modal-focus-scope-removes-background-fields
         (scene/init)
         (host/paper_begin 0xffffff)
         (scene/register-focus 1 true)
         (host/paper_hit 2 0.0 80.0 50.0 30.0 c"Background" 0 0.0)
         (host/paper_modal_scope)
         (scene/register-focus 3 true)
         (host/paper_hit 4 0.0 80.0 50.0 30.0 c"Dialog" 0 0.0)
         (assert (= (host/next-control 0 false) 3))
         (assert (= (host/next-control 4 false) 3))
         (assert (< (scene/focus-index 1) 0))
         (assert (< (scene/focus-index 2) 0)))

(deftest disabled-controls-block-click-through-and-skip-focus
         (scene/init)
         (host/paper_begin 0xffffff)
         (ink-height 10.0)
         (host/paper_hit 1 20.0 20.0 100.0 30.0 c"Underneath" 0 0.0)
         (ink-height 30.0)
         (with-enabled false
                       (with-enabled true
                                     (host/paper_hit 2 20.0 20.0 100.0 30.0 c"Disabled" 0 0.0)))
         (assert (host/paper_enabled))
         (assert (= (host/hit-test 50.0 30.0) 0))
         (assert (= (host/next-control 1 false) 1))
         (assert (not (host/activate-control 2))))

(deftest pressed-feedback-follows-capture-and-pointer-position
         (scene/init)
         (host/paper_begin 0xffffff)
         (host/paper_hit 1 20.0 20.0 100.0 30.0 c"Button" 0 0.0)
         (set! (.drag (host/host)) 1)
         (host/update-hover 50.0 30.0)
         (assert (host/paper_pressed 1))
         (host/update-hover 140.0 30.0)
         (assert (not (host/paper_pressed 1)))
         (host/update-hover 50.0 30.0)
         (assert (host/paper_pressed 1))
         (set! (.drag (host/host)) 0)
         (assert (not (host/paper_pressed 1))))
