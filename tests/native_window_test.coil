(module papercut.native-window-test)
(import "paper.platform" :as host)
(import "paper.objc" :use *)
(import "paper.ffi" :use *)
(import "paper.scene" :as scene)
(import "paper.surface" :use [with-clip])
(import "paper.geometry" :use [rect])
(import "coil.arraylist" :as al)
(import "coil.alloc" :as alloc)

(deftest native-content-covers-window-and-clipped-field-retains-editing-geometry
         (let [pool (new c"NSAutoreleasePool")
               app (msg (ptr i8) (class c"NSApplication") (sel c"sharedApplication") [])
               window (host/create-window 640.0 480.0)
               view (msg (ptr i8) window (sel c"contentView") [])
               frame (msg CGRect window (sel c"frame") [])
               bounds (msg CGRect view (sel c"bounds") [])]
           (assert (< (- (.h frame) (.h bounds)) 0.1))
           (assert (> (.h bounds) 479.9))
           (assert (!= (msg (ptr i8) window (sel c"standardWindowButton:") [u64] 0) (nil)))
           (scene/init)
           (host/paper_configure c"Native integration test" 640.0 480.0)
           (set! (.window (host/host)) window)
           (set! (.view (host/host)) view)
           (set! (.window-w (host/host)) 640.0)
           (set! (.window-h (host/host)) 480.0)
           (set! (.inputs (host/host)) (al/al-new [host/Input] (alloc/malloc-allocator)))
           (host/paper_begin 0xffffff)
           (with-clip (rect 100.0 50.0 100.0 40.0)
                      (host/paper_input 7 80.0 40.0 200.0 30.0 c"Name"))
           (let [input (al/al-get [host/Input] (.inputs (host/host)) 0)
                 container (msg CGRect (.container input) (sel c"frame") [])
                 field (msg CGRect (.view input) (sel c"frame") [])]
             (assert (> (.w container) 99.9))
             (assert (< (.w container) 100.1))
             (assert (> (.h container) 19.9))
             (assert (< (.h container) 20.1))
             (assert (> (.w field) 199.9))
             (assert (< (.x field) -19.9))
             (assert (= (msg u64 (.view input) (sel c"focusRingType") []) (cast u64 1)))
             (host/paper_begin 0xffffff)
             (with-clip (rect 0.0 0.0 10.0 10.0)
                        (host/paper_input 7 80.0 40.0 200.0 30.0 c"Name"))
             (assert (msg bool (.container input) (sel c"isHidden") []))
             (assert (< (scene/focus-index 7) 0))
             (release (.previous input))
             (release (.view input))
             (release (.container input)))
           (al/al-free! [host/Input] (mut (.inputs (host/host))))
           (release window)
           (release pool)))
