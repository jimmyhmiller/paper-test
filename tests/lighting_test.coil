(module papercut.lighting-test)
(import "coil.primitive" :as p)
(import "paper.lighting" :as light)
(import "paper.scene" :as scene)
(import "paper.platform" :as host)
(import "paper.geometry" :use [rect])
(import "paper.objc" :as o)

(deftest lighting-popover-fits-minimum-window-and-keeps-instance-state
         (let [pool (o/new c"NSAutoreleasePool")
               (mut a) (p/zeroed light/Lighting)
               (mut b) (p/zeroed light/Lighting)]
           (scene/init)
           (set! a (light/lighting 0.2 -0.4 800.0 0.5 1.0))
           (set! b (light/lighting 0.8 0.4 600.0 0.7 1.0))
           (host/paper_begin 0xeeeeee)
           (light/apply-light a (rect 0.0 0.0 320.0 240.0))
           (assert (light/handle a 500 3 500 0.0 0.0))
           (light/popover a 500 (rect 270.0 200.0 32.0 32.0))
           (assert (>= (.x (.bounds a)) 16.0))
           (assert (<= (+ (.x (.bounds a)) (.w (.bounds a))) 304.0))
           (assert (>= (.y (.bounds a)) 16.0))
           (assert (<= (+ (.y (.bounds a)) (.h (.bounds a))) 224.0))
           (let [map (light/map-bounds a)] (assert (> (.h map) 0.0)))
           (assert (not (.open b)))
           (assert (not (light/handle a 500 6 0 0.0 0.0)))
           (assert (light/handle a 500 4 53 0.0 0.0))
           (assert (not (.open a)))
           (o/release pool)))

(deftest lighting-reset-eases-every-value-to-its-default
         (let [(mut s) (light/lighting 0.2 -0.4 800.0 0.5 1.0)]
           (set! (.x s) 1.4)
           (set! (.y s) 0.8)
           (set! (.height s) 1400.0)
           (set! (.depth s) 1.3)
           (set! (.grain s) 1.8)
           (light/animate-default-at s 10.0)
           (assert (.animating s))
           (assert (< (host/fabs (- (.x s) 1.4)) 0.000001))
           (assert (light/advance-animation s 10.16))
           (assert (> (.x s) 0.2))
           (assert (< (.x s) 1.4))
           (assert (> (.height s) 800.0))
           (assert (< (.height s) 1400.0))
           (assert (light/advance-animation s 10.32))
           (assert (not (.animating s)))
           (assert (< (host/fabs (- (.x s) 0.2)) 0.000001))
           (assert (< (host/fabs (- (.y s) -0.4)) 0.000001))
           (assert (< (host/fabs (- (.height s) 800.0)) 0.000001))
           (assert (< (host/fabs (- (.depth s) 0.5)) 0.000001))
           (assert (< (host/fabs (- (.grain s) 1.0)) 0.000001))))
