(module papercut.gpu-test)
(import "coil.cc" :as cc)
(import "coil.alloc" :as alloc)
(import "paper.gpu" :as gpu)
(import "paper.masks" :as masks)
(import "paper.damage" :as damage)
(import "paper.render" :as render)
(import "paper.scene" :as scene)
(import "paper.platform" :as host)
(import "paper.objc" :as o)
(import "paper.ffi" :use *)
(import "paper.ui" :use *)

(extern memcpy :cc (cc/C) [(ptr u8) (ptr u8) u64] (-> (ptr u8)))

(extern memcmp :cc (cc/C) [(ptr u8) (ptr u8) u64] (-> i32))

(deftest absent-and-offscreen-sheets-have-no-mask-or-shadow
  (let [pool (o/new c"NSAutoreleasePool")]
    (scene/init)
    (set! (.width (scene/scene)) 173)
    (set! (.height (scene/scene)) 151)
    (set! (.scale (scene/scene)) 1.0)
    (render/setup)
    (host/paper_begin 0xeeeeee)
    (panel (rect 20.0 20.0 50.0 50.0) 5.0 36.0 (sage))
    (begin-sheet)
    (rounded-path (rect 0.0 0.0 100.0 100.0) 0.0)
    (cut-through 0.0)
    (host/paper_light -100.0 80.0 80.0 2.0 0.0)
    (render/render)
    (let [bytes (* (* 173 151) 4)
          copy (cast (ptr u8) (alloc/malloc (cast isize bytes)))]
      (memcpy copy
              (CGBitmapContextGetData (.output-context (scene/scene)))
              (cast u64 bytes))
      (host/paper_begin 0xeeeeee)
      (render/render)
      (assert (= (memcmp copy
                         (CGBitmapContextGetData (.output-context (scene/scene)))
                         (cast u64 bytes))
                 (: 0 i32)))
      (host/paper_begin 0xeeeeee)
      (panel (rect 1000.0 1000.0 50.0 50.0) 5.0 36.0 (sage))
      (render/render)
      (assert (= (memcmp copy
                         (CGBitmapContextGetData (.output-context (scene/scene)))
                         (cast u64 bytes))
                 (: 0 i32)))
      (render/free (cast (ptr i8) copy)))
    (o/release pool)))

;;; Compare accelerated shadows against all 32 original samples, using the same
;;; full-resolution geometry. Odd dimensions exercise partial hierarchy tiles.
(deftest conservative-height-hierarchy-matches-all-shadow-samples
  (let [pool (o/new c"NSAutoreleasePool")]
    (scene/init)
    (set! (.width (scene/scene)) 1051)
    (set! (.height (scene/scene)) 769)
    (set! (.scale (scene/scene)) 1.5)
    (render/setup)
    (when (.available (gpu/gpu))
      (host/paper_begin 0xeee8d9)
      (for [i 0 61]
        (let [x (- (cast f64 (% (* i 137) 1069)) 190.0)
              y (- (cast f64 (% (* i 83) 701)) 90.0)]
          (panel (rect x
                       y
                       (+ 23.0 (cast f64 (% (* i 31) 180)))
                       (+ 17.0 (cast f64 (% (* i 47) 210))))
                 (cast f64 (% i 14))
                 (cast f64 (% (* i 11) 65))
                 (if (= (% i 2) 0) (cream) (sage)))))
      (begin-sheet)
      (oval-path (rect 270.0 190.0 130.0 140.0))
      (cut-through 12.0)
      (let [g (gpu/gpu)
            accelerated (.shade g)
            reference (gpu/compute-pipeline c"shade_paper_reference")
            bytes (* (* 1051 769) 4)
            copy (cast (ptr u8) (alloc/malloc (cast isize bytes)))]
        (for [i 0 24]
          (host/paper_light (+ -300.0 (* (cast f64 i) 60.0))
                            (- 600.0 (* (cast f64 i) 53.0))
                            (case (% i 4) 0 80.0 1 2000.0 2 270.0 680.0)
                            (if (= (% i 7) 0) 0.0 (if (= (% i 2) 0) 2.0 0.82))
                            1.0)
          (render/render)
          (memcpy copy
                  (CGBitmapContextGetData (.output-context (scene/scene)))
                  (cast u64 bytes))
          (set! (.shade g) reference)
          (masks/render-lit (cgrect 0.0 0.0 0.0 0.0) true true)
          (set! (.shade g) accelerated)
          (assert (= (memcmp copy
                             (CGBitmapContextGetData (.output-context (scene/scene)))
                             (cast u64 bytes))
                     (: 0 i32))))
        (o/release reference)
        (render/free (cast (ptr i8) copy)))
      0)
    (o/release pool)))

(deftest cached-interactive-frames-can-still-be-read-back
  (let [pool (o/new c"NSAutoreleasePool")]
    (scene/init)
    (set! (.width (scene/scene)) 199)
    (set! (.height (scene/scene)) 179)
    (set! (.scale (scene/scene)) 1.0)
    (render/setup)
    (host/paper_begin 0xeeeeee)
    (panel (rect 20.0 20.0 100.0 90.0) 7.0 30.0 (sage))
    (render/render-frame false)
    (render/render)
    (let [bytes (* (* 199 179) 4)
          copy (cast (ptr u8) (alloc/malloc (cast isize bytes)))]
      (memcpy copy
              (CGBitmapContextGetData (.output-context (scene/scene)))
              (cast u64 bytes))
      (render/render)
      (assert (= (memcmp copy
                         (CGBitmapContextGetData (.output-context (scene/scene)))
                         (cast u64 bytes))
                 (: 0 i32)))
      (assert (> (cast i64 (load (index copy (* (+ (* 70 199) 70) 4)))) 30))
      (render/free (cast (ptr i8) copy)))
    (o/release pool)))

(deftest cached-masks-preserve-fractional-placement-and-viewport-clipping
  (let [pool (o/new c"NSAutoreleasePool")]
    (scene/init)
    (set! (.width (scene/scene)) 389)
    (set! (.height (scene/scene)) 257)
    (set! (.scale (scene/scene)) 1.5)
    (render/setup)
    (let [bytes (* (* 389 257) 4)
          copy (cast (ptr u8) (alloc/malloc (cast isize bytes)))]
      (for [i 0 13]
        (host/paper_begin 0xeeeeee)
        (let [x (+ -30.0 (/ (cast f64 i) 3.0))
              y (+ -7.0 (/ (cast f64 i) 7.0))]
          (panel (rect x y 210.0 125.0) 13.0 20.0 (sage))
          (label (+ x 45.0) (+ y 30.0) 19.0 0x202020 1 c"Paper glyphs")
          (begin-sheet)
          (oval-path (rect (+ x 80.0) (+ y 55.0) 50.0 60.0))
          (cut-through 0.0))
        (render/render)
        (memcpy copy
                (CGBitmapContextGetData (.output-context (scene/scene)))
                (cast u64 bytes))
        (masks/reset)
        (set! (.valid (damage/cache)) false)
        (set! (.geometry-dirty (scene/scene)) true)
        (render/render)
        (assert (= (memcmp copy
                           (CGBitmapContextGetData (.output-context (scene/scene)))
                           (cast u64 bytes))
                   (: 0 i32))))
      (render/free (cast (ptr i8) copy)))
    (o/release pool)))

(deftest interactive-rendering-keeps-working-textures-bounded-and-cpu-bitmaps-lazy
  (let [pool (o/new c"NSAutoreleasePool")]
    (scene/init)
    (set! (.width (scene/scene)) 2563)
    (set! (.height (scene/scene)) 1801)
    (set! (.scale (scene/scene)) 2.0)
    (render/setup)
    (when (.available (gpu/gpu))
      (let [s (scene/scene)
            g (gpu/gpu)
            textures
              [(.colors g)
               (.materials g)
               (.micro g)
               (.finish-shape g)
               (.finish-weight g)]]
        (for [i 0 5]
          (let [texture (get textures i)]
            (assert (<= (o/msg u64 texture (o/sel c"width") []) 512))
            (assert (<= (o/msg u64 texture (o/sel c"height") []) 512))))
        (host/paper_begin 0xeee8d9)
        (panel (rect 230.0 220.0 590.0 480.0) 12.0 32.0 (sage))
        (label 240.0 250.0 18.0 0x202020 0 c"Crossing tile boundaries")
        (render/render-frame false)
        (gpu/synchronize)
        (assert (= (.color-context s) (o/nil)))
        (assert (= (.height-context s) (o/nil)))
        (assert (= (.material-context s) (o/nil)))
        (assert (= (.output-context s) (o/nil)))
        (assert (<= (o/msg u64
                           (.texture (masks/visibility))
                           (o/sel c"width")
                           [])
                    512))
        (assert (= (o/msg u64 (.heights g) (o/sel c"width") []) 2563))
        (assert (= (o/msg u64 (.output g) (o/sel c"height") []) 1801))
        (gpu/read-output)
        (assert (!= (.output-context s) (o/nil)))
        (assert (= (.color-context s) (o/nil)))))
    (o/release pool)))

(defn tile-boundary-fixture [(phase i64)] (-> i64)
  (let [shift (* (cast f64 phase) 7.25)]
    (host/paper_begin 0xeee8d9)
    (host/paper_light (+ -100.0 shift) 750.0 90.0 1.9 1.0)
    (panel (rect 3.0 4.0 690.0 670.0) 16.0 12.0 (cream))
    (panel (rect (+ 300.5 shift) (+ 315.25 shift) 210.0 190.0) 23.0 38.0 (sage))
    (label (+ 305.25 shift) (+ 338.5 shift) 23.0 0x202020 1 c"Across seams")
    (begin-sheet)
    (oval-path (rect (+ 350.25 shift) 398.0 40.0 75.0))
    (cut-through 0.0))
  0)

(deftest tiled-incremental-damage-and-shadow-halos-match-full-rendering
  (let [pool (o/new c"NSAutoreleasePool")]
    (scene/init)
    (set! (.width (scene/scene)) 1071)
    (set! (.height (scene/scene)) 1033)
    (set! (.scale (scene/scene)) 1.5)
    (render/setup)
    (let [bytes (cast u64 (* (* 1071 1033) 4))
          copy (cast (ptr u8) (alloc/malloc (cast isize bytes)))]
      (for [phase 0 5]
        (tile-boundary-fixture phase)
        (render/render)
        (memcpy copy
                (CGBitmapContextGetData (.output-context (scene/scene)))
                bytes)
        (set! (.valid (damage/cache)) false)
        (set! (.geometry-dirty (scene/scene)) true)
        (render/render)
        (assert (= (memcmp copy
                           (CGBitmapContextGetData (.output-context (scene/scene)))
                           bytes)
                   (: 0 i32))))
      (render/free (cast (ptr i8) copy)))
    (o/release pool)))
