(module papercut.atlas)
(import "paper.flow" :use *)
(import "papercut.state" :use *)

(defn destination-name [(i i64)] (-> (ptr i8))
  (case i 0 c"The quiet coast" 1 c"Into the highlands" c"An island of your own"))

(defn map-art [(bounds Rect)] (-> i64)
  (let [space (art-space bounds (rect 334.0 233.0 813.0 404.0))]
    (let [s (state)
          phase (* (cast f64 (.destination s)) 1.3)]
      (panel (rect (art-x space 334.0) (art-y space 233.0) (art-length space 813.0) (art-length space 404.0))
             (art-length space 27.0)
             20.0
             (linen 0x4e7c89))
      (for [i 0 5]
        (let [shrink (* (cast f64 i) 22.0)
              mat
                (case i 0
                      (recycled 0x9eac83) 1
                      (cotton 0xe5dbc0) 2
                      (recycled 0xd4dac5) 3
                      (cotton 0xb9cfca) (linen 0x95b4b8))]
          (begin-sheet)
          (rounded-path (rect (art-x space 334.0) (art-y space 233.0) (art-length space 813.0) (art-length space 404.0))
                        (art-length space 27.0))
          (contour-path (art-x space 775.0)
                        (art-y space 435.0)
                        (art-length space (- 290.0 shrink))
                        (art-length space (- 145.0 (* shrink 0.7)))
                        phase)
          (finish-sheet (- 44.0 (* (cast f64 i) 4.0)) mat)))
      (begin-sheet)
      (contour-path (art-x space 800.0) (art-y space 469.0) (art-length space 81.0) (art-length space 61.0) phase)
      (finish-sheet 30.0 (cotton 0xd6d5b4))
      (begin-sheet)
      (contour-path (art-x space 800.0) (art-y space 469.0) (art-length space 61.0) (art-length space 40.0) phase)
      (finish-sheet 35.0 (recycled 0x809673))
      (for [i 0 12]
        (disc (art-x space (+ 526.0 (* (cast f64 i) 20.0)))
              (art-y space (+ 383.0 (* (cast f64 i) 7.0)))
              (art-length space 4.0)
              45.0
              (cream)))
      (disc (art-x space 506.0) (art-y space 363.0) (art-length space 30.0) 46.0 (clay))
      (disc (art-x space 516.0) (art-y space 373.0) (art-length space 10.0) 48.0 (cream))
      (disc (art-x space 778.0) (art-y space 461.0) (art-length space 25.0) 43.0 (ochre))
      (disc (art-x space 787.0) (art-y space 470.0) (art-length space 7.0) 46.0 (cream))
      (label (art-x space 375.0) (art-y space 266.0) (art-length space 10.0) 0x5c736a 2 c"N  ↑")
      (label (art-x space 368.0)
             (art-y space 593.0)
             (art-length space 10.0)
             0x617970
             2
             c"1 : 25 000     CONTOUR INTERVAL 20 M")
      (label (art-x space 920.0)
             (art-y space 274.0)
             (art-length space 13.0)
             0x5c7668
             1
             c"Somewhere worth getting lost.")
      (label (art-x space 449.0) (art-y space 341.0) (art-length space 12.0) 0x536d5d 3 c"You start here")
      (label (art-x space 826.0) (art-y space 491.0) (art-length space 13.0) 0xe0e2ca 1 c"a quieter place"))
    0))

(defn compass [(bounds Rect)] (-> i64)
  (let [space (art-space bounds (rect 62.0 636.0 205.0 211.0))]
    (well (art-rect space (rect 62.0 636.0 205.0 211.0))
          (art-length space 80.0)
          28.0
          (linen 0xc2d0c5)
          (cotton 0xa8bdb0)
          (cotton 0xd7ddc6))
    (ring (art-x space 111.0) (art-y space 672.0) (art-length space 104.0) (art-length space 4.0) 33.0 (linen 0x7d9b8e))
    (begin-sheet)
    (move-to (art-x space 163.0) (art-y space 684.0))
    (line-to (art-x space 151.0) (art-y space 731.0))
    (line-to (art-x space 163.0) (art-y space 721.0))
    (line-to (art-x space 174.0) (art-y space 731.0))
    (close-path)
    (finish-sheet 38.0 (clay))
    (label (art-x space 159.0) (art-y space 653.0) (art-length space 10.0) 0x5f8173 2 c"N")
    (label (art-x space 103.0) (art-y space 798.0) (art-length space 11.0) 0x648172 1 c"Follow your curiosity."))
  0)

(defn sidebar [(bounds Rect)] (-> i64)
  (arrange bounds
           [root
            (padded (column (grow 1.0) (grow 1.0) 18.0) (padding 16.0))
            [heading (box (grow 1.0) (fixed 44.0))]
            [motto (box (grow 1.0) (fixed 18.0))]
            [line (box (grow 1.0) (fixed 1.0))]
            [eyebrow (box (grow 1.0) (fixed 18.0))]
            [places (box (grow 1.0) (fixed 263.0))]
            [space (box (grow 1.0) (grow 1.0))]
            [art (box (grow 1.0) (fixed 211.0))]]
           (panel root 23.0 23.0 (linen 0xc2d0c5))
           (caption heading 32.0 0x375e56 1 c"elsewhere")
           (caption motto 10.0 0x658277 3 c"TAKE THE SCENIC ROUTE")
           (separator line 0x9caf9f)
           (caption eyebrow 11.0 0x59786b 3 c"PLACES TO DAYDREAM ABOUT")
           (let [(mut style) (selection-style (linen 0xc2d0c5) (cotton 0xb3c9bb) (linen 0x8aaba5))]
             (set! (.font style) 1)
             (set! (.size style) 16.0)
             (set! (.radius style) 16.0)
             (set! (.z style) 29.0)
             (set! (.ink style) 0x3c655a)
             (set! (.active-ink style) 0x3c655a)
             (set! (.secondary style) 0x6c8a7c)
             (for [i 0 3]
               (selection-row 400
                              (choice (+ 400 i)
                                      (destination-name i)
                                      (case i 0
                                            c"Salt air · coastal paths" 1
                                            c"Open skies · winding trails" c"Still water · hidden coves"))
                              (column-cell places 3 16.0 i)
                              (= i (.destination (state)))
                              (load style))))
           (compass art))
  0)

(defn itinerary [(bounds Rect)] (-> i64)
  (arrange bounds
           [root
            (padded (column (grow 1.0) (grow 1.0) 12.0) (padding 22.0))
            [heading (box (grow 1.0) (fixed 29.0))]
            [first (box (grow 1.0) (grow 1.0))]
            [line-one (box (grow 1.0) (fixed 1.0))]
            [second (box (grow 1.0) (grow 1.0))]
            [line-two (box (grow 1.0) (fixed 1.0))]
            [third (box (grow 1.0) (grow 1.0))]]
           (panel root 22.0 29.0 (cotton 0xedead6))
           (caption heading 20.0 0x4d6c5a 1 c"A loose plan. Plenty of room.")
           (caption first 12.0 0x6c8270 0 c"01    Arrive slowly. Find the water.")
           (separator line-one 0xcbd2bc)
           (caption second 12.0 0x6c8270 0 c"02    Walk until the map folds differently.")
           (separator line-two 0xcbd2bc)
           (caption third
                    12.0
                    0x6c8270
                    0
                    (if (> (.days (state)) 2)
                        c"03    One more sunrise before you go."
                        c"      Leave room for another visit.")))
  0)

(defn duration [(bounds Rect)] (-> i64)
  (arrange bounds
           [root
            (padded (column (grow 1.0) (grow 1.0) 18.0) (padding 22.0))
            [heading (box (grow 1.0) (fixed 18.0))]
            [value
             (aligned (row (grow 1.0) (grow 1.0) 14.0) 1.0 0.0)
             [days (box (fixed 42.0) (fixed 58.0))]
             [unit (box (grow 1.0) (fixed 24.0))]]
            [controls
             (aligned (row (grow 1.0) (fixed 40.0) 16.0) 0.5 0.0)
             [less (box (fixed 68.0) (grow 1.0))]
             [more (box (fixed 68.0) (grow 1.0))]
             [limit (box (grow 1.0) (fixed 18.0))]]]
           (panel root 22.0 29.0 (linen 0xd3dcc6))
           (caption heading 11.0 0x668371 3 c"MAKE A LITTLE TIME")
           (numeral days 44.0 0x426956 (.days (state)))
           (caption unit 14.0 0x668371 1 c"unhurried days")
           (button 411 less c"−" false (cotton 0xe7e6ce))
           (button 412 more c"+" false (cotton 0xe7e6ce))
           (caption limit 10.0 0x79907d 0 c"1–7 days"))
  0)

(defn draw [(bounds Rect)] (-> i64)
  (arrange bounds
           [page
            (padded (row (grow 1.0) (grow 1.0) 44.0) (padding 20.0))
            [navigation (box (fixed 245.0) (grow 1.0))]
            [main
             (padded (column (grow 1.0) (grow 1.0) 20.0) (edges 0.0 14.0 16.0 8.0))
             [eyebrow (box (grow 1.0) (fixed 18.0))]
             [header
              (row (grow 1.0) (fixed 48.0) 20.0)
              [heading (box (grow 1.0) (grow 1.0))]
              [save (box (fixed 186.0) (fixed 43.0))]]
             [map (box (grow 1.0) (grow 1.0))]
             [footer
              (row (grow 1.0) (fixed 207.0) 16.0)
              [plan (box (grow 1.65) (grow 1.0))]
              [time (box (grow 1.0) (grow 1.0))]]]]
           (panel (shifted page 0.0 10.0) 30.0 6.0 (linen 0x789295))
           (panel page 30.0 15.0 (cotton 0xe4e4d1))
           (sidebar navigation)
           (caption eyebrow 10.0 0x7d8977 3 c"YOUR NEXT SMALL ADVENTURE")
           (caption heading 34.0 0x3c6155 1 (destination-name (.destination (state))))
           (button 410
                   save
                   (if (selected-bit? (.saved (state)) (.destination (state)))
                       c"✓  Saved to your places"
                       c"+  Save this place")
                   false
                   (cotton 0xd2ddc4))
           (map-art map)
           (itinerary plan)
           (duration time))
  0)
