(module papercut.botanical)
(import "paper.surface" :use *)
(import "paper.material" :use *)
(import "paper.geometry" :use [rect])
(import "paper.components" :use *)
(import "paper.navigation" :use *)
(import "paper.charts" :use *)
(import "papercut.state" :use *)
(import "paper.platform" :as host)

(defn plant-name [(i i64)] (-> (ptr i8))
  (case i 0 c"Monstera deliciosa" 1 c"Ficus elastica" c"Pilea peperomioides"))

(defn stem [(x f64) (y f64) (height f64)] (-> i64)
  (begin-sheet)
  (move-to x y)
  (curve-to (+ x 13.0) (- y (* height 0.4)) (- x 9.0) (- y (* height 0.7)) (+ x 8.0) (- y height))
  (line-to (+ x 12.0) (- y height))
  (curve-to (+ x 1.0) (- y (* height 0.6)) (+ x 20.0) (- y (* height 0.25)) (+ x 7.0) y)
  (close-path)
  (finish-sheet 29.0 (recycled 0x526945)))

(defn illustration [] (-> i64)
  (let [s (state)
        green (case (.plant s) 0 (recycled 0x4f7154) 1 (smooth 0x52614c) (cotton 0x72906b))]
    (well (rect 328.0 253.0 445.0 480.0) 160.0 28.0 (cotton 0xe4dfc8) (linen 0xc8d0b1) (cotton 0xb8c4a2))
    (disc 424.0 299.0 262.0 21.0 (cotton 0xd9daba))
    (stem 544.0 640.0 275.0)
    (leaf 552.0 567.0 -140.0 112.0 32.0 green)
    (leaf 551.0 528.0 131.0 126.0 34.0 (recycled 0x8da578))
    (leaf 550.0 461.0 -100.0 115.0 33.0 (recycled 0x7a936a))
    (leaf 555.0 407.0 89.0 91.0 35.0 green)
    (leaf 551.0 600.0 144.0 90.0 35.0 green)
    (begin-sheet)
    (move-to 492.0 616.0)
    (line-to 611.0 616.0)
    (line-to 596.0 698.0)
    (curve-to 580.0 710.0 521.0 710.0 507.0 698.0)
    (close-path)
    (finish-sheet 37.0 (recycled 0xbe7960))
    (panel (rect 484.0 609.0 136.0 18.0) 5.0 42.0 (cotton 0xd69a79))
    (label 516.0 653.0 10.0 0x794d3d 2 c"GROW SLOW")
    (label 355.0 296.0 10.0 0x6e7a59 2 c"FIG. 0")
    (number 400.0 296.0 10.0 0x6e7a59 (+ (.plant s) 1))
    (label 349.0 690.0 10.0 0x6e7a59 2 c"PRESSED & PRESERVED"))
  0)

(defn draw [] (-> i64)
  (let [s (state)
        stock (recycled 0xe9e5ce)]
    (panel (rect 25.0 101.0 1160.0 802.0) 30.0 6.0 (recycled 0xc3b89b))
    (panel (rect 24.0 92.0 1160.0 802.0) 30.0 15.0 stock)
    (panel (rect 42.0 110.0 228.0 765.0) 23.0 23.0 (linen 0xd6dcc0))
    (label 68.0 142.0 31.0 0x3c5135 1 c"herbarium")
    (label 69.0 183.0 10.0 0x657452 3 c"A JOURNAL OF GROWING THINGS")
    (rule 67.0 218.0 179.0 0xaab697)
    (label 70.0 247.0 11.0 0x627151 3 c"ON YOUR WINDOWSILL")
    (let [(mut style) (selection-style (linen 0xd5dbc1) (recycled 0xb0bd97) (recycled 0x8c9d77))]
      (set! (.leading style) 34.0)
      (set! (.font style) 3)
      (set! (.size style) 13.0)
      (set! (.radius style) 17.0)
      (set! (.ink style) 0x344b30)
      (set! (.active-ink style) 0x344b30)
      (for [i 0 3]
        (let [y (+ 282.0 (* 89.0 (cast f64 i)))]
          (selection-row 200
                         (choice (+ 200 i)
                                 (case i 0 c"Monstera" 1 c"Rubber plant" c"Chinese money plant")
                                 (case i 0 c"Living room · 2 years" 1 c"Bedroom · 8 months" c"Kitchen · 5 months"))
                         (rect 59.0 (- y 8.0) 196.0 76.0)
                         (= i (.plant s))
                         (load style))
          (leaf 81.0 (+ y 30.0) 18.0 29.0 33.0 (moss)))))
    (label 69.0 609.0 12.0 0x576b48 3 c"A gentle reminder")
    (label 69.0 639.0 13.0 0x5f7152 1 c"“To plant a garden is")
    (label 69.0 663.0 13.0 0x5f7152 1 c"to believe in tomorrow.”")
    (label 69.0 699.0 10.0 0x7f886c 0 c"— Audrey Hepburn")
    (leaf 183.0 845.0 -47.0 65.0 28.0 (recycled 0x9da985))
    (leaf 187.0 819.0 38.0 60.0 29.0 (recycled 0xaab592))
    (label 318.0 132.0 10.0 0x7b8169 3 c"YOUR COLLECTION / FIELD NOTES")
    (label 318.0 167.0 34.0 0x354d32 1 (plant-name (.plant s)))
    (label 319.0 216.0 13.0 0x737f62 0 c"Room to grow. Time to notice the small things.")
    (button 210 (rect 968.0 158.0 185.0 43.0) c"+  Log an observation" false (cotton 0xe4d2a6))
    (illustration)
    (label 823.0 263.0 10.0 0x7d866d 3 c"TODAY’S CARE")
    (label 822.0 293.0 26.0 0x3e5538 1 c"Looking a little thirsty.")
    (panel (rect 813.0 343.0 338.0 114.0) 22.0 25.0 (cotton 0xdde0c5))
    (label 836.0 365.0 13.0 0x526948 3 c"WATERING")
    (label 836.0
           390.0
           15.0
           0x3b5137
           0
           (if (selected-bit? (.watered s) (.plant s)) c"Watered today. Thank you." c"The top two inches feel dry."))
    (label 836.0 420.0 11.0 0x748266 0 c"About 250 ml · room-temperature water")
    (checkbox 211 826.0 484.0 c"Water and let the soil drain" (selected-bit? (.watered s) (.plant s)) (moss))
    (checkbox 212 826.0 531.0 c"Turn toward the morning light" (selected-bit? (.watered s) (+ (.plant s) 3)) (moss))
    (checkbox 213 826.0 578.0 c"Wipe the leaves, gently" (selected-bit? (.watered s) (+ (.plant s) 6)) (moss))
    (rule 822.0 634.0 322.0 0xc8cfb3)
    (badge 827.0 659.0 c"Bright, indirect light" (ochre))
    (badge 827.0 689.0 c"18–27°C feels just right" (moss))
    (panel (rect 317.0 754.0 836.0 105.0) 21.0 25.0 (cotton 0xf0e9d4))
    (if (.journal-edit s)
        (do
          (label 342.0 770.0 10.0 0x8e8b72 3 c"WHAT DID YOU NOTICE TODAY?")
          (input 220 (rect 340.0 796.0 546.0 42.0) c"A new leaf, a little more light…")
          (button 214 (rect 900.0 797.0 76.0 40.0) c"Save" false (sage))
          (button 215 (rect 987.0 797.0 77.0 40.0) c"Cancel" false (cream)))
        (do
          (label 342.0 773.0 10.0 0x8e8b72 3 c"LATEST OBSERVATION")
          (text-box (rect 342.0 800.0 706.0 46.0)
                    18.0
                    0x4e6243
                    1
                    (host/paper_pref_text c"journal-note" c"A new leaf, slowly finding its shape."))))
    (number 1090.0 782.0 28.0 0x7d8f6a (+ 12 (.journal s)))
    (label 1081.0 821.0 10.0 0x7d8f6a 0 c"entries"))
  0)
