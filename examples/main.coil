(module papercut.main)
(import "coil.primitive" :as primitive)
(import "paper.platform" :as host)
(import "paper.flow" :use *)
(import "paper.audio" :as audio)
(import "papercut.state" :use *)
(import "papercut.agenthub" :as agents)
(import "papercut.botanical" :as plants)
(import "papercut.listening" :as music)
(import "papercut.atlas" :as atlas)
(import "paper.lighting" :as light)

(defn lighting [] (-> (ptr light/Lighting))
  (primitive/alloc-static light/Lighting))

(defn toolbar [(bounds Rect)] (-> i64)
  (arrange bounds
           [root
            (aligned (row (grow 1.0) (grow 1.0) 24.0) 0.5 0.0)
            [brand (box (fixed (text-width c"papercut" 25.0 1)) (fixed 36.0))]
            [edition (box (fixed 110.0) (fixed 18.0))]
            [space (box (grow 1.0) (grow 1.0))]
            [tabs (box (fixed 646.0) (fixed 40.0))]
            [end-space (box (grow 1.0) (grow 1.0))]]
           (caption brand 25.0 0xe8dfca 1 c"papercut")
           (caption edition 10.0 0x9eaa98 2 c"STUDIO / 01")
           (let [(mut style) (selection-style (linen 0x424a40) (cream) (moss))]
             (set! (.treatment style) 1)
             (set! (.z style) 14.0)
             (set! (.ink style) 0xbfc7b3)
             (set! (.active-ink style) 0x374632)
             (set! (.font style) 3)
             (set! (.size style) 12.0)
             (set! (.padding style) 12.0)
             (tab-strip 1
                        tabs
                        (: [(choice 1 c"01  AgentHub" c"")
                            (choice 2 c"02  Herbarium" c"")
                            (choice 3 c"03  Listening room" c"")
                            (choice 4 c"04  Elsewhere" c"")]
                           (slice Choice))
                        (+ (.app (state)) 1)
                        10.0
                        (load style)))
           0)
  0)

(defn light-well [(bounds Rect)] (-> i64)
  (let [s (state)
        inner (inset bounds 10.0)]
    (well bounds 18.0 30.0 (cream) (cotton 0xbdbda5) (linen 0xd9d8bd))
    (for [i 1 4]
      (host/paper_rule (+ (.x bounds) (* (.w bounds) (/ (cast f64 i) 4.0))) (.y inner) 0.5 (.h inner) 0xbabd9f)
      (rule (.x inner) (+ (.y bounds) (* (.h bounds) (/ (cast f64 i) 4.0))) (.w inner) 0xbabd9f))
    (disc (- (+ (.x bounds) (* (fraction (.light-x s) -800.0 3000.0) (.w bounds))) 10.5)
          (- (+ (.y bounds) (* (fraction (.light-y s) -800.0 2400.0) (.h bounds))) 10.5)
          21.0
          40.0
          (ochre))
    (hit 10 bounds c"Drag the light source"))
  0)

(defn aperture [(bounds Rect) (paper Material)] (-> i64)
  (let [s (state)
        x (+ (.x bounds) (* (.hole-x s) (.w bounds)))
        y (+ (.y bounds) (* (.hole-y s) (.h bounds)))]
    (begin-sheet)
    (rounded-path bounds 18.0)
    (cut-through 17.0)
    (panel bounds 18.0 18.0 (clay))
    (for [i 0 3]
      (let [shrink (* 7.0 (cast f64 i))
            rx (- 43.0 shrink)
            ry (- 30.0 shrink)]
        (begin-sheet)
        (rounded-path bounds 18.0)
        (case (.shape s) 0
              (rounded-path (rect (- x rx) (- y ry) (* 2.0 rx) (* 2.0 ry)) 16.0) 1
              (oval-path (rect (- x rx) (- y ry) (* 2.0 rx) (* 2.0 ry))) (contour-path x y (- rx 1.0) (- ry 3.0) 1.0))
        (finish-sheet (- 40.0 (* 6.0 (cast f64 i))) (case i 0 paper 1 (sage) (ochre)))))
    (hit 18 bounds c"Move the carved aperture"))
  0)

(defn workbench [(bounds Rect)] (-> i64)
  (let [s (state)
        paper (case (.stock s) 0 (cream) 1 (linen 0xdac7b0) (recycled 0xc9d3b2))]
    (arrange bounds
             [root
              (padded (column (grow 1.0) (grow 1.0) 12.0) (padding 20.0))
              [eyebrow (box (grow 1.0) (fixed 16.0))]
              [heading (box (grow 1.0) (fixed 36.0))]
              [subtitle (box (grow 1.0) (fixed 20.0))]
              [light-label (box (grow 1.0) (fixed 16.0))]
              [light (box (grow 1.0) (bounded (grow 1.0) 80.0 139.0))]
              [hint (box (grow 1.0) (fixed 18.0))]
              [sliders (box (grow 1.0) (fixed 185.0))]
              [line (box (grow 1.0) (fixed 1.0))]
              [cut-label (box (grow 1.0) (fixed 16.0))]
              [shapes (box (grow 1.0) (fixed 33.0))]
              [cut (box (grow 1.0) (fixed 98.0))]
              [buttons
               (row (grow 1.0) (fixed 30.0) 12.0)
               [stock (box (grow 1.15) (grow 1.0))]
               [reset (box (grow 1.0) (grow 1.0))]]]
             (panel (shifted root 0.0 5.0) 23.0 10.0 (cotton 0xbcb79f))
             (panel root 23.0 22.0 (cream))
             (caption eyebrow 10.0 0x8d8c76 3 c"THE MATERIAL WORKBENCH")
             (caption heading 26.0 0x3e4c36 1 c"Make it your own.")
             (caption subtitle 12.0 0x7c816b 0 c"A little light changes everything.")
             (caption light-label 10.0 0x69735d 3 c"LIGHT POSITION")
             (light-well light)
             (caption hint 10.0 0x92927c 0 c"Drag the golden point to move the light.")
             (for [i 0 3]
               (arrange (column-cell sliders 3 16.0 i)
                        [control
                         (column (grow 1.0) (grow 1.0) 8.0)
                         [title (box (grow 1.0) (fixed 18.0))]
                         [track (box (grow 1.0) (fixed 25.0))]]
                        (caption title 11.0 0x626f55 3 (case i 0 c"LIGHT HEIGHT" 1 c"PAPER DEPTH" c"FIBER & GRAIN"))
                        (slider (+ 11 i)
                                track
                                (case i 0 c"Light height" 1 c"Paper depth" c"Fiber and grain")
                                (case i 0
                                      (fraction (.elevation s) 150.0 1100.0) 1
                                      (/ (.depth s) 1.8) (/ (.grain s) 2.0))
                                (case i 0 (ochre) 1 (sage) (clay)))))
             (separator line 0xc9c9b1)
             (caption cut-label 10.0 0x69735d 3 c"TRY A CUT · DRAG THE APERTURE")
             (for [i 0 3]
               (button (+ 15 i)
                       (row-cell shapes 3 7.0 i)
                       (case i 0 c"Soft" 1 c"Oval" c"Free")
                       (= i (.shape s))
                       (if (= i (.shape s)) (sage) (cream))))
             (aperture cut paper)
             (button 19 stock c"Stock ↻" false paper)
             (button 20 reset c"Reset" false (cream))))
  0)

(defn draw [] (-> i64)
  (let [s (state)]
    (host/paper_begin (case (.app s) 0 0x2f362e 1 0x354035 2 0x493b34 0x293d3d))
    (set! (.x (lighting)) (/ (.light-x s) (host/logical-width)))
    (set! (.y (lighting)) (/ (.light-y s) (host/logical-height)))
    (set! (.height (lighting)) (.elevation s))
    (set! (.depth (lighting)) (.depth s))
    (set! (.grain (lighting)) (.grain s))
    (light/apply-light (lighting) (rect 0.0 0.0 (host/logical-width) (host/logical-height)))
    (arrange (rect 0.0 0.0 (host/logical-width) (host/logical-height))
             [studio
              (padded (column (grow 1.0) (grow 1.0) 24.0) (edges 24.0 40.0 24.0 24.0))
              [header (box (grow 1.0) (fixed 44.0))]
              [body
               (row (grow 1.0) (grow 1.0) 20.0)
               [app (box (grow 1.0) (grow 1.0))]
               [materials (box (fixed 254.0) (grow 1.0))]]
              [motto (box (grow 1.0) (fixed 20.0))]]
             (host/paper_drag_area (rect 0.0 0.0 (host/logical-width) (+ (.y header) (.h header))))
             (toolbar header)
             (case (.app s) 0 (agents/draw app) 1 (plants/draw app) 2 (music/draw app) (atlas/draw app))
             (workbench materials)
             (caption motto 11.0 0x9eaa96 0 c"Real cutouts. Layered fibers. Light you can touch.")

             (when (.agent-editor s) (agents/new-agent-dialog app)))
    (when (not (.agent-editor s))
      (light/popover (lighting) 800 (rect (- (host/logical-width) 62.0) 43.0 34.0 34.0))))
  0)

(defn event [(kind i64) (id i64) (x f64) (y f64)] (-> i64)
  (let [s (state)]
    (cond (= kind 0)
            (do
              (initialize id)
              (store! (lighting)
                      (light/lighting (/ 200.0 (host/logical-width)) (/ -160.0 (host/logical-height)) 680.0 0.82 1.0))
              0)
          (light/handle (lighting) 800 kind id x y)
            (do
              (set! (.light-x s) (* (.x (lighting)) (host/logical-width)))
              (set! (.light-y s) (* (.y (lighting)) (host/logical-height)))
              (set! (.elevation s) (.height (lighting)))
              (set! (.depth s) (.depth (lighting)))
              0)
          (and (or (= kind 1) (= kind 2)) (>= id 10) (<= id 18) (> x 0.0))
            (do
              (case id 10
                    (do
                      (set! (.light-x s) (+ -800.0 (* 3000.0 (host/control-fraction id x false))))
                      (set! (.light-y s) (+ -800.0 (* 2400.0 (host/control-fraction id y true)))))
                      11
                    (set! (.elevation s) (+ 150.0 (* 1100.0 (host/control-fraction id x false)))) 12
                    (set! (.depth s) (* 1.8 (host/control-fraction id x false))) 13
                    (set! (.grain s) (* 2.0 (host/control-fraction id x false))) 18
                    (do
                      (set! (.hole-x s) (clamp (host/control-fraction id x false) 0.24 0.76))
                      (set! (.hole-y s) (clamp (host/control-fraction id y true) 0.34 0.66)))
                      0)
              (host/paper_redraw))
          (and (= id 304) (or (= kind 1) (= kind 2)) (> x 0.0))
            (do
              (set! (.volume s) (host/control-fraction id x false))
              (audio/play (.playing s) (.track s) (.volume s))
              (host/paper_redraw))
          (= kind 3)
            (do
              (cond (and (>= id 1) (<= id 4)) (set! (.app s) (- id 1))
                    (and (>= id 15) (<= id 17)) (set! (.shape s) (- id 15))
                    (= id 19) (set! (.stock s) (% (+ (.stock s) 1) 3))
                    (= id 20)
                      (do
                        (set! (.light-x s) 200.0)
                        (set! (.light-y s) -160.0)
                        (set! (.elevation s) 680.0)
                        (set! (.depth s) 0.82)
                        (set! (.grain s) 1.0)
                        (set! (.hole-x s) 0.5)
                        (set! (.hole-y s) 0.5))
                    (and (>= id 100) (<= id 104)) (set! (.agent-nav s) (- id 100))
                    (and (>= id 110) (<= id 113)) (set! (.project s) (- id 110))
                    (= id 120) (do (set! (.agent-editor s) true) (set! (.agent-error s) false) (host/paper_focus 151))
                    (= id 122) (do (agents/create-agent) 0)
                    (= id 123) (do (set! (.agent-editor s) false) (host/paper_focus 120))
                    (= id 124) (set! (.agent-page s) (page-index (+ (.agent-page s) 1) (.agents s) 5))
                    (= id 125) (set! (.agent-page s) (page-index (- (.agent-page s) 1) (.agents s) 5))
                    (= id 121) (set! (.paused s) (not (.paused s)))
                    (and (>= id 130) (<= id 133)) (set! (.tasks s) (flip-bit (.tasks s) (- id 130)))
                    (and (>= id 200) (<= id 202)) (set! (.plant s) (- id 200))
                    (= id 210) (do (set! (.journal-edit s) true) (host/paper_focus 220))
                    (= id 214)
                      (when (> (host/strlen (host/paper_input_value 220)) (cast u64 0))
                        (host/paper_pref_text_set c"journal-note" (host/paper_input_value 220))
                        (set! (.journal s) (+ (.journal s) 1))
                        (host/paper_pref_set c"journal-count" (.journal s))
                        (host/paper_input_clear 220)
                        (set! (.journal-edit s) false)
                        (host/paper_focus 210))
                    (= id 215) (do (set! (.journal-edit s) false) (host/paper_focus 210))
                    (and (>= id 211) (<= id 213))
                      (do
                        (set! (.watered s) (flip-bit (.watered s) (+ (.plant s) (* (- id 211) 3))))
                        (host/paper_pref_set c"watered" (.watered s)))
                    (= id 300)
                      (do (set! (.playing s) (not (.playing s))) (audio/play (.playing s) (.track s) (.volume s)))
                    (= id 302)
                      (do
                        (set! (.track s) (% (+ (.track s) 2) 3))
                        (set! (.seconds s) 0)
                        (audio/play (.playing s) (.track s) (.volume s)))
                    (= id 303)
                      (do
                        (set! (.track s) (% (+ (.track s) 1) 3))
                        (set! (.seconds s) 0)
                        (audio/play (.playing s) (.track s) (.volume s)))
                    (= id 310)
                      (do
                        (set! (.favorite s) (flip-bit (.favorite s) (.track s)))
                        (host/paper_pref_set c"favorites" (.favorite s)))
                    (and (>= id 320) (<= id 322))
                      (do
                        (set! (.track s) (- id 320))
                        (set! (.seconds s) 0)
                        (audio/play (.playing s) (.track s) (.volume s)))
                    (and (>= id 400) (<= id 402)) (set! (.destination s) (- id 400))
                    (= id 410)
                      (do
                        (set! (.saved s) (flip-bit (.saved s) (.destination s)))
                        (host/paper_pref_set c"saved" (.saved s)))
                    (= id 411) (when (> (.days s) 1) (set! (.days s) (- (.days s) 1)))
                    (= id 412) (when (< (.days s) 7) (set! (.days s) (+ (.days s) 1)))
                    :else 0)
              (host/paper_redraw))
          (and (= kind 4) (= id 53) (.agent-editor s)) (do (set! (.agent-editor s) false) (host/paper_focus 120))
          (and (= kind 4) (= id 53) (.journal-edit s)) (do (set! (.journal-edit s) false) (host/paper_focus 210))
          (= kind 5) (host/paper_redraw)
          (and (= kind 6) (.playing s))
            (do (set! (.seconds s) (+ (.seconds s) 1)) (when (= (.app s) 2) (host/paper_redraw)))
          :else 0))
  0)

(defn main [] (-> i64)
  (host/paper_run (primitive/fnptr-of draw) (primitive/fnptr-of event)))
