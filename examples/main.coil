(module papercut.main)
(import "coil.primitive" :as primitive)
(import "paper.platform" :as host)
(import "paper.surface" :use *)
(import "paper.material" :use *)
(import "paper.geometry" :use [rect])
(import "paper.components" :use *)
(import "paper.navigation" :use *)
(import "paper.charts" :use [contour-path])
(import "paper.geometry" :use [fraction clamp])
(import "paper.audio" :as audio)
(import "papercut.state" :use *)
(import "papercut.agenthub" :as agents)
(import "papercut.botanical" :as plants)
(import "papercut.listening" :as music)
(import "papercut.atlas" :as atlas)

(defn toolbar [] (-> i64)
  (label 29.0 23.0 25.0 0xe8dfca 1 c"papercut")
  (label 140.0 33.0 10.0 0x9eaa98 2 c"STUDIO / 01")
  (let [(mut style) (selection-style (linen 0x424a40) (cream) (moss))]
    (set! (.treatment style) 1)
    (set! (.z style) 14.0)
    (set! (.ink style) 0xbfc7b3)
    (set! (.active-ink style) 0x374632)
    (set! (.font style) 3)
    (set! (.size style) 12.0)
    (set! (.padding style) 12.0)
    (tab-strip 1
               (rect 400.0 19.0 646.0 40.0)
               (: [(choice 1 c"01  AgentHub" c"")
                   (choice 2 c"02  Herbarium" c"")
                   (choice 3 c"03  Listening room" c"")
                   (choice 4 c"04  Elsewhere" c"")]
                  (slice Choice))
               (+ (.app (state)) 1)
               10.0
               (load style)))
  (label 1270.0 31.0 11.0 0xb0b9a4 2 c"CRAFTED IN COIL")
  0)

(defn workbench [] (-> i64)
  (let [s (state)
        paper (case (.stock s) 0 (cream) 1 (linen 0xdac7b0) (recycled 0xc9d3b2))]
    (panel (rect 1203.0 97.0 254.0 801.0) 23.0 10.0 (cotton 0xbcb79f))
    (panel (rect 1203.0 92.0 254.0 801.0) 23.0 22.0 (cream))
    (label 1227.0 115.0 10.0 0x8d8c76 3 c"THE MATERIAL WORKBENCH")
    (label 1226.0 142.0 26.0 0x3e4c36 1 c"Make it your own.")
    (label 1228.0 181.0 12.0 0x7c816b 0 c"A little light changes everything.")
    (label 1228.0 218.0 10.0 0x69735d 3 c"LIGHT POSITION")
    (well (rect 1227.0 244.0 207.0 139.0) 18.0 30.0 (cream) (cotton 0xbdbda5) (linen 0xd9d8bd))
    (for [i 1 4]
      (host/paper_rule (+ 1227.0 (* 51.75 (cast f64 i))) 254.0 0.5 119.0 0xbabd9f)
      (rule 1236.0 (+ 244.0 (* 34.75 (cast f64 i))) 189.0 0xbabd9f))
    (disc (+ 1227.0 (* (fraction (.light-x s) -800.0 3000.0) 207.0))
          (+ 238.0 (* (fraction (.light-y s) -800.0 2400.0) 139.0))
          21.0
          40.0
          (ochre))
    (hit 10 (rect 1227.0 244.0 207.0 139.0) c"Drag the light source")
    (label 1228.0 397.0 10.0 0x92927c 0 c"Drag the golden point to move the light.")
    (label 1228.0 432.0 11.0 0x626f55 3 c"LIGHT HEIGHT")
    (slider 11 (rect 1236.0 456.0 189.0 25.0) c"Light height" (fraction (.elevation s) 150.0 1100.0) (ochre))
    (label 1228.0 502.0 11.0 0x626f55 3 c"PAPER DEPTH")
    (slider 12 (rect 1236.0 526.0 189.0 25.0) c"Paper depth" (/ (.depth s) 1.8) (sage))
    (label 1228.0 572.0 11.0 0x626f55 3 c"FIBER & GRAIN")
    (slider 13 (rect 1236.0 596.0 189.0 25.0) c"Fiber and grain" (/ (.grain s) 2.0) (clay))
    (rule 1227.0 643.0 205.0 0xc9c9b1)
    (label 1228.0 662.0 10.0 0x69735d 3 c"TRY A CUT · DRAG THE APERTURE")
    (for [i 0 3]
      (button (+ 15 i)
              (rect (+ 1228.0 (* 70.0 (cast f64 i))) 686.0 63.0 33.0)
              (case i 0 c"Soft" 1 c"Oval" c"Free")
              (= i (.shape s))
              (if (= i (.shape s)) (sage) (cream))))
    (begin-sheet)
    (rounded-path (rect 1227.0 735.0 207.0 98.0) 18.0)
    (cut-through 17.0)
    (panel (rect 1227.0 735.0 207.0 98.0) 18.0 18.0 (clay))
    (for [i 0 3]
      (let [shrink (* 7.0 (cast f64 i))]
        (begin-sheet)
        (rounded-path (rect 1227.0 735.0 207.0 98.0) 18.0)
        (case (.shape s) 0
              (rounded-path (rect (- (.hole-x s) (- 43.0 shrink))
                                  (- (.hole-y s) (- 30.0 shrink))
                                  (* 2.0 (- 43.0 shrink))
                                  (* 2.0 (- 30.0 shrink)))
                            16.0)
                1
              (oval-path (rect (- (.hole-x s) (- 43.0 shrink))
                               (- (.hole-y s) (- 30.0 shrink))
                               (* 2.0 (- 43.0 shrink))
                               (* 2.0 (- 30.0 shrink))))
                (contour-path (.hole-x s) (.hole-y s) (- 42.0 shrink) (- 27.0 shrink) 1.0))
        (finish-sheet (- 40.0 (* 6.0 (cast f64 i))) (case i 0 paper 1 (sage) (ochre)))))
    (hit 18 (rect 1227.0 735.0 207.0 98.0) c"Move the carved aperture")
    (button 19 (rect 1228.0 848.0 104.0 30.0) c"Stock ↻" false paper)
    (button 20 (rect 1343.0 848.0 91.0 30.0) c"Reset" false (cream)))
  0)

(defn draw [] (-> i64)
  (let [s (state)]
    (host/paper_begin (case (.app s) 0 0x2f362e 1 0x354035 2 0x493b34 0x293d3d))
    (host/paper_light (.light-x s) (.light-y s) (.elevation s) (.depth s) (.grain s))
    (toolbar)
    (case (.app s) 0 (agents/draw) 1 (plants/draw) 2 (music/draw) (atlas/draw))
    (workbench)
    (label 30.0 923.0 11.0 0x9eaa96 0 c"Real cutouts. Layered fibers. Light you can touch.")
    (label 1055.0 923.0 10.0 0x9eaa96 2 c"FOUR SMALL WORLDS / ONE PAPER LIBRARY")
    (when (.agent-editor s) (agents/new-agent-dialog)))
  0)

(defn event [(kind i64) (id i64) (x f64) (y f64)] (-> i64)
  (let [s (state)]
    (cond (= kind 0) (initialize id)
          (and (or (= kind 1) (= kind 2)) (>= id 10) (<= id 18) (> x 0.0))
            (do
              (case id 10
                    (do
                      (set! (.light-x s) (+ -800.0 (* 3000.0 (fraction x 1227.0 207.0))))
                      (set! (.light-y s) (+ -800.0 (* 2400.0 (fraction y 244.0 139.0)))))
                      11
                    (set! (.elevation s) (+ 150.0 (* 1100.0 (fraction x 1236.0 189.0)))) 12
                    (set! (.depth s) (* 1.8 (fraction x 1236.0 189.0))) 13
                    (set! (.grain s) (* 2.0 (fraction x 1236.0 189.0))) 18
                    (do (set! (.hole-x s) (clamp x 1276.0 1385.0)) (set! (.hole-y s) (clamp y 768.0 800.0))) 0)
              (host/paper_redraw))
          (and (= id 304) (or (= kind 1) (= kind 2)) (> x 0.0))
            (do
              (set! (.volume s) (fraction x 735.0 332.0))
              (audio/play (.playing s) (.track s) (.volume s))
              (host/paper_redraw))
          (= kind 3)
            (do
              (cond (and (>= id 1) (<= id 4)) (set! (.app s) (- id 1))
                    (and (>= id 15) (<= id 17)) (set! (.shape s) (- id 15))
                    (= id 19) (set! (.stock s) (% (+ (.stock s) 1) 3))
                    (= id 20)
                      (do
                        (set! (.light-x s) 200.0)
                        (set! (.light-y s) -160.0)
                        (set! (.elevation s) 680.0)
                        (set! (.depth s) 0.82)
                        (set! (.grain s) 1.0)
                        (set! (.hole-x s) 1332.0)
                        (set! (.hole-y s) 784.0))
                    (and (>= id 100) (<= id 104)) (set! (.agent-nav s) (- id 100))
                    (and (>= id 110) (<= id 113)) (set! (.project s) (- id 110))
                    (= id 120) (do (set! (.agent-editor s) true) (set! (.agent-error s) false) (host/paper_focus 151))
                    (= id 122) (do (agents/create-agent) 0)
                    (= id 123) (do (set! (.agent-editor s) false) (host/paper_focus 120))
                    (= id 124) (set! (.agent-page s) (page-index (+ (.agent-page s) 1) (.agents s) 5))
                    (= id 125) (set! (.agent-page s) (page-index (- (.agent-page s) 1) (.agents s) 5))
                    (= id 121) (set! (.paused s) (not (.paused s)))
                    (and (>= id 130) (<= id 133)) (set! (.tasks s) (flip-bit (.tasks s) (- id 130)))
                    (and (>= id 200) (<= id 202)) (set! (.plant s) (- id 200))
                    (= id 210) (do (set! (.journal-edit s) true) (host/paper_focus 220))
                    (= id 214)
                      (when (> (host/strlen (host/paper_input_value 220)) (cast u64 0))
                        (host/paper_pref_text_set c"journal-note" (host/paper_input_value 220))
                        (set! (.journal s) (+ (.journal s) 1))
                        (host/paper_pref_set c"journal-count" (.journal s))
                        (host/paper_input_clear 220)
                        (set! (.journal-edit s) false)
                        (host/paper_focus 210))
                    (= id 215) (do (set! (.journal-edit s) false) (host/paper_focus 210))
                    (and (>= id 211) (<= id 213))
                      (do
                        (set! (.watered s) (flip-bit (.watered s) (+ (.plant s) (* (- id 211) 3))))
                        (host/paper_pref_set c"watered" (.watered s)))
                    (= id 300)
                      (do (set! (.playing s) (not (.playing s))) (audio/play (.playing s) (.track s) (.volume s)))
                    (= id 302)
                      (do
                        (set! (.track s) (% (+ (.track s) 2) 3))
                        (set! (.seconds s) 0)
                        (audio/play (.playing s) (.track s) (.volume s)))
                    (= id 303)
                      (do
                        (set! (.track s) (% (+ (.track s) 1) 3))
                        (set! (.seconds s) 0)
                        (audio/play (.playing s) (.track s) (.volume s)))
                    (= id 310)
                      (do
                        (set! (.favorite s) (flip-bit (.favorite s) (.track s)))
                        (host/paper_pref_set c"favorites" (.favorite s)))
                    (and (>= id 320) (<= id 322))
                      (do
                        (set! (.track s) (- id 320))
                        (set! (.seconds s) 0)
                        (audio/play (.playing s) (.track s) (.volume s)))
                    (and (>= id 400) (<= id 402)) (set! (.destination s) (- id 400))
                    (= id 410)
                      (do
                        (set! (.saved s) (flip-bit (.saved s) (.destination s)))
                        (host/paper_pref_set c"saved" (.saved s)))
                    (= id 411) (when (> (.days s) 1) (set! (.days s) (- (.days s) 1)))
                    (= id 412) (when (< (.days s) 7) (set! (.days s) (+ (.days s) 1)))
                    :else 0)
              (host/paper_redraw))
          (and (= kind 4) (= id 53) (.agent-editor s)) (do (set! (.agent-editor s) false) (host/paper_focus 120))
          (and (= kind 4) (= id 53) (.journal-edit s)) (do (set! (.journal-edit s) false) (host/paper_focus 210))
          (= kind 5) (host/paper_redraw)
          (and (= kind 6) (.playing s))
            (do (set! (.seconds s) (+ (.seconds s) 1)) (when (= (.app s) 2) (host/paper_redraw)))
          :else 0))
  0)

(defn main [] (-> i64)
  (host/paper_run (primitive/fnptr-of draw) (primitive/fnptr-of event)))
