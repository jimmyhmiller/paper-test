(module papercut.agenthub)
(import "paper.platform" :as host)
(import "paper.surface" :use *)
(import "paper.material" :use *)
(import "paper.geometry" :use [rect])
(import "paper.components" :use *)
(import "paper.navigation" :use *)
(import "paper.charts" :use *)
(import "papercut.state" :use *)
(import "paper.objc" :as o)

(defn robot [(x f64) (y f64) (scale f64) (material Material)] (-> i64)
  (disc x y (* 42.0 scale) 33.0 material)
  (panel (rect (+ x (* 9.0 scale)) (+ y (* 12.0 scale)) (* 25.0 scale) (* 20.0 scale)) (* 6.0 scale) 38.0 (cream))
  (disc (+ x (* 15.0 scale)) (+ y (* 18.0 scale)) (* 4.0 scale) 40.0 (ink-stock))
  (disc (+ x (* 25.0 scale)) (+ y (* 18.0 scale)) (* 4.0 scale) 40.0 (ink-stock))
  (panel (rect (+ x (* 20.0 scale)) (+ y (* 6.0 scale)) (* 3.0 scale) (* 7.0 scale)) 1.5 36.0 (ink-stock)))

(defn landscape-hole [(inset f64)] (-> i64)
  (let [x (+ 272.0 inset)
        right (- 1162.0 inset)
        bottom (- 878.0 inset)]
    (move-to (+ x 36.0) (+ 310.0 inset))
    (line-to 451.0 (+ 310.0 inset))
    (curve-to 500.0 (+ 310.0 inset) 480.0 (+ 196.0 inset) 534.0 (+ 196.0 inset))
    (line-to (- right 34.0) (+ 196.0 inset))
    (curve-to right (+ 196.0 inset) right (+ 206.0 inset) right (+ 234.0 inset))
    (line-to right (- bottom 32.0))
    (curve-to right bottom right bottom (- right 32.0) bottom)
    (line-to (+ x 32.0) bottom)
    (curve-to x bottom x bottom x (- bottom 32.0))
    (line-to x (+ 350.0 inset))
    (curve-to x (+ 320.0 inset) x (+ 310.0 inset) (+ x 36.0) (+ 310.0 inset))
    (close-path)))

(defn board [] (-> i64)
  (panel (rect 24.0 98.0 1160.0 806.0) 32.0 6.0 (cotton 0xc5b89c))
  (panel (rect 24.0 92.0 1160.0 806.0) 32.0 12.0 (sage))
  (begin-sheet)
  (rounded-path (rect 24.0 92.0 1160.0 806.0) 32.0)
  (rounded-path (rect 51.0 176.0 204.0 616.0) 24.0)
  (landscape-hole 22.0)
  (finish-sheet 18.0 (cotton 0xb7bca1))
  (begin-sheet)
  (rounded-path (rect 24.0 92.0 1160.0 806.0) 32.0)
  (rounded-path (rect 48.0 172.0 210.0 624.0) 25.0)
  (landscape-hole 10.0)
  (finish-sheet 23.0 (cotton 0xd8d4b9))
  (begin-sheet)
  (rounded-path (rect 24.0 92.0 1160.0 806.0) 32.0)
  (rounded-path (rect 46.0 168.0 214.0 630.0) 26.0)
  (landscape-hole 0.0)
  (finish-sheet 29.0 (cream)))

(defn sidebar [] (-> i64)
  (robot 65.0 191.0 0.9 (moss))
  (label 112.0 193.0 23.0 0x283626 3 c"AgentHub")
  (label 112.0 222.0 11.0 0x4b5741 0 c"Agent management")
  (let [(mut style) (selection-style (sage) (moss) (moss))]
    (set! (.z style) 25.0)
    (set! (.active-ink style) 0xf4eedb)
    (choice-list 100
                 (rect 62.0 266.0 180.0 227.0)
                 (: [(choice 100 c"⌂   Overview" c"")
                     (choice 101 c"◎   Agents" c"")
                     (choice 102 c"✓   Tasks" c"")
                     (choice 103 c"↗   Activity" c"")
                     (choice 104 c"◷   Analytics" c"")]
                    (slice Choice))
                 (+ (.agent-nav (state)) 100)
                 8.0
                 (load style)))
  (label 69.0 535.0 10.0 0x526145 3 c"YOUR PROJECTS")
  (for [i 0 4]
    (let [y (+ 566.0 (* (cast f64 i) 40.0))
          name (case i 0 c"Alpha Project" 1 c"Beta Research" 2 c"Customer Care" c"Experimental Lab")
          mat (case i 0 (moss) 1 (blue) 2 (ochre) (clay))]
      (when (= i (.project (state))) (panel (rect 61.0 (- y 5.0) 184.0 32.0) 9.0 22.0 (cotton 0xbcc3a4)))
      (disc 74.0 (+ y 3.0) 11.0 29.0 mat)
      (label 97.0 y 13.0 0x33442c 0 name)
      (hit (+ 110 i) (rect 61.0 (- y 5.0) 184.0 32.0) name)))
  (well (rect 47.0 817.0 212.0 58.0) 20.0 29.0 (cream) (sage) (sage))
  (disc 60.0 830.0 31.0 30.0 (moss))
  (label 67.0 838.0 12.0 0xf3ebd8 3 c"AM")
  (label 105.0 830.0 13.0 0x34452c 3 c"Alex Morgan")
  (label 105.0 850.0 10.0 0x626954 0 c"Personal workspace ⌄")
  0)

(defn activity [] (-> i64)
  (panel (rect 288.0 388.0 555.0 249.0) 22.0 32.0 (cream))
  (label 309.0 407.0 19.0 0x30382b 3 c"Agent activity")
  (badge 615.0 413.0 c"Success" (moss))
  (badge 701.0 413.0 c"Warning" (ochre))
  (for [i 0 4]
    (let [y (+ 461.0 (* 44.0 (cast f64 i)))]
      (number 307.0 (- y 7.0) 10.0 0x777b69 (- 75 (* i 25)))
      (rule 335.0 y 487.0 0xd0cfb8)))
  (let [green (: [0.33 0.46 0.38 0.72 0.59 0.7 0.51 0.74 0.91 0.59 0.65 0.83] (slice f64))
        gold (: [0.13 0.23 0.17 0.37 0.27 0.46 0.29 0.43 0.52 0.31 0.34 0.49] (slice f64))
        red (: [0.03 0.09 0.06 0.19 0.12 0.24 0.10 0.2 0.3 0.15 0.1 0.23] (slice f64))]
    (area-band 335.0 448.0 486.0 148.0 green gold 46.0 (sage))
    (area-band 335.0 448.0 486.0 148.0 gold red 40.0 (ochre))
    (area 335.0 448.0 486.0 148.0 red 34.0 (clay)))
  (for [i 0 7]
    (let [x (+ 335.0 (* 75.0 (cast f64 i)))]
      (label x 608.0 10.0 0x636a58 0 c"MAY")
      (number (+ x 26.0) 608.0 10.0 0x636a58 (+ 12 i))))
  0)

;;; Fixture statuses are shared by the directory, badges, and chart.
;;; New local agents start idle; pausing the cluster moves running agents to idle.
(defn agent-status [(i i64)] (-> i64)
  (let [base
          (cond (or (= i 4) (= i 23)) 3
                (or (= i 3) (and (>= i 20) (< i 23))) 2
                (or (= i 2) (and (>= i 15) (< i 20)) (>= i 24)) 1
                :else 0)]
    (if (and (= base 0) (.paused (state))) 1 base)))

(defn status-material [(i i64)] (-> Material)
  (case (agent-status i) 0 (moss) 1 (blue) 2 (ochre) (clay)))

(defn status [] (-> i64)
  (panel (rect 856.0 388.0 299.0 249.0) 22.0 32.0 (cream))
  (label 878.0 407.0 19.0 0x30382b 3 c"A healthy little ecosystem")
  (let [(mut start) -1.57079632679
        (mut caption) (zeroed (array i8 64))]
    (for [kind 0 4]
      (let [(mut count) 0]
        (for [i 0 (.agents (state))]
          (when (= (agent-status i) kind) (set! count (+ (load count) 1))))
        (let [end (+ (load start) (* 6.28318530718 (/ (cast f64 (load count)) (cast f64 (.agents (state))))))
              material (case kind 0 (moss) 1 (blue) 2 (ochre) (clay))]
          (when (> (load count) 0)
            (arc-sheet 944.0 535.0 70.0 31.0 (load start) end (+ 38.0 (cast f64 kind)) material))
          (host/snprintf (index caption 0)
                         64
                         c"%s  %lld"
                         (case kind 0 c"Running" 1 c"Idle" 2 c"Waiting" c"Error")
                         (load count))
          (badge 1033.0 (+ 478.0 (* 34.0 (cast f64 kind))) (index caption 0) material)
          (set! start end)))))
  (number 931.0 523.0 22.0 0x34462e (.agents (state)))
  0)

(defn agent-name [(i i64)] (-> (ptr i8))
  (o/utf8 (o/msg (ptr i8) (.agent-names (state)) (o/sel c"objectAtIndex:") [i64] i)))

(defn detail-view [] (-> i64)
  (let [s (state)]
    (panel (rect 288.0 388.0 555.0 249.0) 22.0 32.0 (cream))
    (label 309.0
           408.0
           20.0
           0x30382b
           3
           (case (.agent-nav s) 1 c"Your agent directory" 2 c"Today’s task list" c"Cluster analytics"))
    (case (.agent-nav s) 1
          (do
            (for [i 0 (page-length (.agent-page s) (.agents s) 5)]
              (let [y (+ 449.0 (* 29.0 (cast f64 i)))
                    index (+ (page-start (.agent-page s) (.agents s) 5) i)]
                (when (< index (.agents s))
                  (robot 311.0 y 0.55 (status-material index))
                  (text-box (rect 349.0 (+ y 4.0) 251.0 23.0) 13.0 0x46553b 3 (agent-name index))
                  (label 619.0
                         (+ y 4.0)
                         12.0
                         0x6f7b60
                         0
                         (case (agent-status index) 0 c"running" 1 c"idle" 2 c"waiting" c"retry scheduled")))))
            (label 313.0 610.0 10.0 0x7c866d 0 c"Local example workspace")
            (pager 125 124 (rect 640.0 597.0 178.0 30.0) (.agent-page s) (.agents s) 5 (cream)))
            2
          (for [i 0 4]
            (checkbox (+ 130 i)
                      313.0
                      (+ 453.0 (* 42.0 (cast f64 i)))
                      (case i 0
                            c"Review the research summary" 1
                            c"Refresh the customer dataset" 2
                            c"Approve the model rollout" c"Check the scraper retry")
                      (selected-bit? (.tasks s) i)
                      (moss)))
            (do
              (label 313.0 458.0 13.0 0x687458 0 c"Completed tasks across the last four weeks")
              (for [i 0 4]
                (let [y (+ 492.0 (* 31.0 (cast f64 i)))]
                  (number 314.0 y 11.0 0x718060 (+ 1 i))
                  (progress (rect 340.0 (+ y 3.0) 416.0 13.0)
                            (+ 0.43 (* 0.15 (cast f64 i)))
                            (case i 0 (blue) 1 (sage) 2 (ochre) (moss))))))))
  0)

(defn agent-list [] (-> i64)
  (panel (rect 858.0 652.0 297.0 210.0) 21.0 32.0 (cream))
  (label 880.0 670.0 18.0 0x30382b 3 c"Active agents")
  (let [(mut shown) 0
        query (host/paper_input_value 150)]
    (for [i 0 (.agents (state))]
      (when (and (< (load shown) 5) (!= (host/strcasestr (agent-name i) query) (cast (ptr i8) 0)))
        (let [y (+ 706.0 (* 29.0 (cast f64 (load shown))))]
          (robot 878.0 y 0.5 (status-material i))
          (text-box (rect 910.0 (+ y 3.0) 198.0 23.0) 12.0 0x3a4432 0 (agent-name i))
          (disc 1120.0 (+ y 8.0) 7.0 36.0 (status-material i))
          (set! shown (+ (load shown) 1)))))
    (when (= (load shown) 0) (label 882.0 724.0 13.0 0x67715b 0 c"No agents match your search.")))
  0)

(defn new-agent-dialog [] (-> i64)
  (host/paper_modal_scope)
  (with-elevation 20.0
                  (panel (rect 451.0 322.0 577.0 304.0) 25.0 32.0 (cream))
                  (label 481.0 352.0 29.0 0x3e5135 1 c"Make room for a new agent.")
                  (text-box (rect 483.0 402.0 501.0 47.0)
                            14.0
                            0x748064
                            0
                            c"Choose a unique name, from 1 to 48 characters. This creates an agent in your local example workspace.")
                  (input 151 (rect 482.0 465.0 515.0 51.0) c"Agent name")
                  (when (.agent-error (state))
                    (label 483.0 525.0 11.0 0x9f412b 0 c"Enter an unused name between 1 and 48 characters."))
                  (button 123 (rect 754.0 548.0 100.0 44.0) c"Cancel" false (cream))
                  (with-enabled (valid-agent-name? (proposed-agent-name))
                                (button 122 (rect 869.0 548.0 127.0 44.0) c"Create agent" false (sage)))))

(defn proposed-agent-name [] (-> (ptr i8))
  (o/msg (ptr i8)
         (o/ns (host/paper_input_value 151))
         (o/sel c"stringByTrimmingCharactersInSet:")
         [(ptr i8)]
         (o/msg (ptr i8) (o/class c"NSCharacterSet") (o/sel c"whitespaceAndNewlineCharacterSet") [])))

(defn valid-agent-name? [(name (ptr i8))] (-> bool)
  (let [length (o/msg i64 name (o/sel c"length") [])]
    (and (> length 0)
         (<= length 48)
         (not (o/msg bool (.agent-names (state)) (o/sel c"containsObject:") [(ptr i8)] name)))))

(defn create-agent [] (-> bool)
  (let [s (state)
        name (proposed-agent-name)]
    (if (valid-agent-name? name)
        (do
          (o/msg i64 (.agent-names s) (o/sel c"addObject:") [(ptr i8)] name)
          (set! (.agents s) (o/msg i64 (.agent-names s) (o/sel c"count") []))
          (host/paper_pref_array_set c"agent-names" (.agent-names s))
          (host/paper_input_clear 151)
          (set! (.agent-editor s) false)
          (set! (.agent-error s) false)
          (set! (.agent-nav s) 1)
          (set! (.agent-page s) (/ (- (.agents s) 1) 5))
          (host/paper_focus 120)
          true)
        (do (set! (.agent-error s) true) false))))

