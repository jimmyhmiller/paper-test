  (panel (rect 288.0 652.0 304.0 210.0) 21.0 32.0 (cream))
  (label 308.0 668.0 18.0 0x30382b 3 c"Terminal")
  (badge 413.0 674.0 c"Alpha cluster" (moss))
  (well (rect 302.0 699.0 276.0 147.0) 15.0 36.0 (cream) (ink-stock) (ink-stock))
  (label 318.0 716.0 10.0 0xc4c9a7 2 c"$ agentctl status --all")
  (label 318.0 743.0 9.0 0x9aab8c 2 c"NAME             STATUS    TASKS")
  (label 318.0 765.0 9.0 0xd3cfbb 2 c"ResearchAgent    running     12")
  (label 318.0 785.0 9.0 0xd3cfbb 2 c"DataCollector    running      8")
  (label 318.0 815.0 10.0 0xc4c9a7 2 (if (.paused (state)) c"$ cluster paused ▌" c"$ all systems looking good ▌"))
  (panel (rect 605.0 652.0 240.0 210.0) 21.0 32.0 (cream))
  (label 625.0 668.0 18.0 0x30382b 3 c"On the pinboard")
  (label 626.0 708.0 13.0 0x39472f 3 c"✦  A little smarter, every day")
  (label 626.0 733.0 11.0 0x636952 0 c"Model v2.1 is ready for Alpha.")
  (label 626.0 751.0 11.0 0x636952 0 c"Rollout begins with 50% of agents.")
  (rule 626.0 778.0 197.0 0xc7c7b0)
  (button 121
          (rect 623.0 796.0 204.0 40.0)
          (if (.paused (state)) c"▶  Resume cluster" c"Ⅱ  Pause cluster")
          (.paused (state))
          (sage))
  (agent-list))

