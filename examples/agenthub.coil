  (sidebar)
  (label 291.0
         130.0
         10.0
         0x777a66
         3
         (case (.project (state)) 0
               c"WORKSPACE / ALPHA PROJECT" 1
               c"WORKSPACE / BETA RESEARCH" 2
               c"WORKSPACE / CUSTOMER CARE" c"WORKSPACE / EXPERIMENTAL LAB"))
  (label 291.0 169.0 29.0 0x2a3528 1 c"Good morning, Alex.")
  (label 291.0 215.0 13.0 0x5a634d 0 c"Your agents have it from here.")
  (label 291.0 238.0 13.0 0x5a634d 0 c"A little more room to think.")
  (input 150 (rect 754.0 125.0 251.0 44.0) c"Search your agents…")
  (button 120 (rect 1019.0 125.0 135.0 44.0) c"+  New agent" false (cream))
  (metric (rect 535.0 216.0 145.0 148.0) c"ACTIVE AGENTS" c"" c"↑ 3 since yesterday" (sage))
  (number 557.0 264.0 37.0 0x253026 (.agents (state)))
  (metric (rect 692.0 216.0 145.0 148.0) c"TASKS DONE" c"158" c"↑ 12% this week" (ochre))
  (metric (rect 849.0 216.0 145.0 148.0) c"SUCCESS RATE" c"97.2%" c"↑ 2.1% this week" (blue))
  (metric (rect 1006.0 216.0 148.0 148.0) c"RESPONSE TIME" c"4.6m" c"↓ 8% this week" (clay))
  (if (or (= (.agent-nav (state)) 0) (= (.agent-nav (state)) 3)) (activity) (detail-view))
  (status)
  (bottom)
  0)
