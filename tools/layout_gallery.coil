(module papercut.layout-gallery)
(import "papercut.main" :as demo)
(import "papercut.state" :as state)
(import "paper.scene" :as scene)
(import "paper.render" :as render)
(import "paper.platform" :as host)
(import "paper.objc" :as o)
(import "paper.workers" :as workers)

;;; Alternate sizes and state-dependent branches, using fixture state only.
;;; Usage: mkdir -p build/layout-gallery && coil run tools/layout_gallery.coil
(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [pool (o/new c"NSAutoreleasePool")
        (mut path) (zeroed (array i8 128))
        variant
          (if (> argc (cast i32 1))
              (if (= (host/strcmp (load (index argv 1)) c"small") 0) 0 1)
              2)
        width (case variant 0 1280.0 1 1800.0 1480.0)
        height (case variant 0 900.0 1 1080.0 960.0)]
    (scene/init)
    (set! (.headless (host/host)) true)
    (host/paper_configure c"Layout verification" width height)
    (set! (.width (scene/scene)) (cast i64 (* width 2.0)))
    (set! (.height (scene/scene)) (cast i64 (* height 2.0)))
    (render/setup)
    (state/initialize 0)
    (for [app 0 4]
      (set! (.app (state/state)) app)
      (demo/draw)
      (render/render)
      (host/snprintf (index path 0) 128 c"build/layout-gallery/size-%lld-app-%lld.png" variant app)
      (assert-eq (render/snapshot (index path 0)) 0))
    (when (= variant 2)
      (set! (.app (state/state)) 0)
      (for [nav 1 5]
        (set! (.agent-nav (state/state)) nav)
        (demo/draw)
        (render/render)
        (host/snprintf (index path 0) 128 c"build/layout-gallery/agent-view-%lld.png" nav)
        (assert-eq (render/snapshot (index path 0)) 0))
      (set! (.agent-editor (state/state)) true)
      (set! (.agent-error (state/state)) true)
      (demo/draw)
      (render/render)
      (assert-eq (render/snapshot c"build/layout-gallery/agent-dialog.png") 0)
      (set! (.agent-editor (state/state)) false)
      (set! (.app (state/state)) 1)
      (set! (.journal-edit (state/state)) true)
      (set! (.plant (state/state)) 2)
      (demo/draw)
      (render/render)
      (assert-eq (render/snapshot c"build/layout-gallery/journal-edit.png") 0)
      (set! (.app (state/state)) 2)
      (set! (.track (state/state)) 2)
      (demo/draw)
      (render/render)
      (assert-eq (render/snapshot c"build/layout-gallery/long-track.png") 0))
    (when (= variant 2)
      (set! (.app (state/state)) 0)
      (set! (.agent-nav (state/state)) 1)
      (set! (.project (state/state)) 3)
      (set! (.hover (host/host)) 0)
      (set! (.focus (host/host)) 0)
      (demo/draw)
      (render/render)
      (assert-eq (render/snapshot c"build/layout-gallery/agent-directory-clean.png") 0)
      (set! (.hover (host/host)) 120)
      (demo/draw)
      (render/render)
      (assert-eq (render/snapshot c"build/layout-gallery/button-hover.png") 0)
      (set! (.hover (host/host)) 0)
      (set! (.focus (host/host)) 150)
      (set! (.keyboard-focus (host/host)) true)
      (demo/draw)
      (render/render)
      (assert-eq (render/snapshot c"build/layout-gallery/input-focus.png") 0)
      (set! (.focus (host/host)) 1)
      (demo/draw)
      (render/render)
      (assert-eq (render/snapshot c"build/layout-gallery/tab-focus.png") 0))
    (workers/stop)
    (o/release pool))
  0)
