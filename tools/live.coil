(module papercut.live)

(import "coil.alloc" :as alloc)
(import "coil.fs" :as fs)
(import "coil.primitive" :as primitive)
(import "coil.result" :use *)
(import "coil.str" :as str)
(import "coil.thread" :as thread)
(import "experiments.heap-inspector.controller" :as controller)
(import "experiments.heap-inspector.live-app-api" :as live-app)
(import "experiments.live-repl.server" :as nrepl)

(extern printf :cc c [(ptr i8) ...] (-> i32))
(extern setenv :cc c [(ptr i8) (ptr i8) i32] (-> i32))

(defn nrepl-thread [(unused (ptr i8))] (-> (ptr i8))
  (nrepl/serve!)
  (primitive/cast (ptr i8) 0))

(defn report [(message (ptr i8))] (-> i64)
  (printf c"%s\n" message)
  1)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [source-path
          (if (> (primitive/cast i64 argc) 1)
              (str/cstr->str (load (primitive/index argv 1)))
              "examples/minimal.coil")]
    ; The in-process compiler is a new compiler invocation, so give its namespace
    ; index the same project and dependency roots used to build this host.
    (setenv c"COIL_NAMESPACE_ROOTS"
            c"examples:tests:tools:lib/paper/src:lib/layout/src:../coil-experiments/src"
            (primitive/cast i32 1))
    (if (!= (controller/live-controller-enable-app!) 0)
        (report c"paper live: could not initialize retained live controller")
        (match (fs/read-file (alloc/malloc-allocator) source-path)
          (Err [_] (report c"paper live: could not read initial live source"))
          (Ok [source]
            (if (!= (controller/live-controller-edit-source! source) 0)
                (do
                  (printf c"paper live: initial source was rejected\n")
                  1)
                (let [server-thread (primitive/alloc-stack thread/Thread)]
                  (if (!= (primitive/cast i64
                            (thread/thread-spawn-configured
                              server-thread
                              (primitive/fnptr-of nrepl-thread)
                              (primitive/cast (ptr i8) 0)
                              (thread/thread-config 33554432 16384))) 0)
                      (report c"paper live: could not start nREPL thread")
                      (live-app/live-app-run!)))))))))
