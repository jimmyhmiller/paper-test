(module blog.exclusions-test)
(import "blog.exclusions" :as ex)
(import "blog.native" :as n)
(import "blog.model" :as m)

(deftest excluded-projection-reconciles-every-count-without-changing-the-source
  (let [pool (n/new c"NSAutoreleasePool")
        (mut raw) (m/empty)]
    (ex/reset)
    (assert (m/decode-utc (mut raw)
                          (n/read-json c"tests/fixtures/hourly.json")
                          (n/nil)))
    (assert (= (ex/project (mut raw)) (mut raw)))
    (ex/toggle (.path (index (.posts raw) 0)))
    (let [d (ex/project (mut raw))
          (mut sum) 0]
      (assert (= (.views d) 3))
      (assert (= (ex/included-count (mut raw)) 1))
      (assert (= (.views raw) 15))
      (assert (= (.views (index (.posts raw) 0)) 12))
      (assert (= (.count d) (.count raw)))
      (assert (= (.days d) (.days raw)))
      (assert (= (.observed d) (.observed raw)))
      (for [day 0 (.days d)]
        (set! sum (+ (load sum) (load (index (.totals d) day))))
        (assert (= (load (index (.values (index (.posts d) 0)) day)) 0)))
      (assert (= (load sum) 3))
      (set! sum 0)
      (for [hour 0 24]
        (set! sum (+ (load sum) (load (index (.hour-totals d) hour)))))
      (assert (= (load sum) 3))
      (assert (= (.peak d) 3))
      (assert (= (.cell-peak d) 3)))
    (ex/toggle (.path (index (.posts raw) 1)))
    (let [d (ex/project (mut raw))]
      (assert (= (.views d) 0))
      (assert (= (ex/included-count (mut raw)) 0))
      (assert (= (.peak d) 0))
      (assert (= (.hour-peak d) 0))
      (for [slot 0 (* (.days d) 24)]
        (assert (= (load (index (.heat d) slot)) 0))))
    (ex/reset)
    (assert (= (ex/project (mut raw)) (mut raw)))
    (assert (= (.views raw) 15))
    (m/clear (mut raw))
    (n/release pool)))

(deftest exclusions-follow-post-paths-across-refresh-and-new-posts-are-included
  (let [pool (n/new c"NSAutoreleasePool")
        (mut raw) (m/empty)]
    (ex/reset)
    (assert (m/decode-utc (mut raw)
                          (n/read-json c"tests/fixtures/hourly.json")
                          (n/nil)))
    (ex/toggle (.path (index (.posts raw) 0)))
    (assert (= (.views (ex/project (mut raw))) 3))
    (assert (m/decode-utc (mut raw)
                          (n/read-json c"tests/fixtures/exclusions-refresh.json")
                          (n/nil)))
    (let [d (ex/project (mut raw))]
      (assert (= (.views raw) 122))
      (assert (= (.views d) 102))
      (assert (= (ex/included-count (mut raw)) 2))
      (assert (= (.views (index (.posts d) 0)) 99))
      (assert (= (.views (index (.posts d) 1)) 0))
      (assert (ex/contains? (.path (index (.posts raw) 1)))))
    (ex/reset)
    (m/clear (mut raw))
    (n/release pool)))
