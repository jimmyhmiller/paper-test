(module blog.bar-motion-test)
(import "blog.bar-motion" :as motion)
(import "blog.tuning" :as tuning)
(import "paper.geometry" :use [rect])
(import "paper.ffi" :use [fabs])

(deftest bar-lift-eases-in-both-directions-and-settles
  (let [(mut value) 0.0]
    (for [frame 0 20]
      (let [next (motion/step (load value) 1.0 (/ 1.0 60.0))]
        (assert (>= next (load value)))
        (assert (<= next 1.0))
        (set! value next)))
    (assert (= (load value) 1.0))
    (for [frame 0 20]
      (let [next (motion/step (load value) 0.0 (/ 1.0 60.0))]
        (assert (<= next (load value)))
        (assert (>= next 0.0))
        (set! value next)))
    (assert (= (load value) 0.0))))

(deftest projected-paper-face-expands-around-its-center-without-diagonal-drift
  (let [base (rect 100.0 100.0 20.0 80.0)
        resting (motion/projected-face base 0.0 1.0)
        lifted (motion/projected-face base 1.0 1.0)
        deeper (motion/projected-face base 1.0 2.0)
        flat (motion/projected-face base 1.0 0.0)]
    (assert (= (.x resting) (.x base)))
    (assert (= (.y resting) (.y base)))
    (assert (< (.x lifted) (.x resting)))
    (assert (< (.y lifted) (.y resting)))
    (assert (< (.y deeper) (.y lifted)))
    (assert (= (.x flat) (.x base)))
    (assert (= (.y flat) (.y base)))
    (assert (> (.w lifted) (.w base)))
    (assert (> (.h lifted) (.h base)))
    (assert (> (.w deeper) (.w lifted)))
    (assert (> (.h deeper) (.h lifted)))
    (assert (< (fabs (- (+ (.x lifted) (* (.w lifted) 0.5))
                        (+ (.x base) (* (.w base) 0.5))))
               0.000000001))
    (assert (< (fabs (- (+ (.y lifted) (* (.h lifted) 0.5))
                        (+ (.y base) (* (.h base) 0.5))))
               0.000000001))
    (assert (< (fabs (- (/ (.w lifted) (.w base))
                        (/ (.h lifted) (.h base))))
               0.000000001))))

(deftest hover-movement-control-adjusts-and-can-disable-the-actual-projection
  (let [t (tuning/state)
        previous (.hover-lift (tuning/state))
        base (rect 100.0 100.0 20.0 80.0)]
    (set! (.hover-lift t) 0.0)
    (let [flat (motion/projected-face base 1.0 1.0)]
      (assert (= (.x flat) (.x base)))
      (assert (= (.y flat) (.y base))))
    (set! (.hover-lift t) 12.0)
    (let [lifted (motion/projected-face base 1.0 1.0)]
      (assert (< (.y lifted) (.y base)))
      (assert (> (.h lifted) (.h base))))
    (set! (.hover-lift t) previous)))

(deftest all-time-motion-storage-grows-past-a-year-with-separate-hourly-state
  (motion/reserve 1036)
  (set! (.animate (motion/state)) false)
  (assert (= (motion/amount 0 1035 true) 1.0))
  (assert (= (motion/amount 1 23 false) 0.0))
  (motion/reserve 4)
  (assert (= (motion/amount 0 3 false) 0.0))
  (motion/shutdown))
