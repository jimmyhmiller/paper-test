(module blog.model-test)
(import "blog.native" :as n)
(import "blog.model" :as m)
(import "blog.view" :as v)
(import "blog.app" :as app)
(import "blog.source" :as source)
(import "paper.ffi" :use [strcmp])
(import "paper.geometry" :use [rect])

(defn sparse [] (-> (ptr i8))
  (n/read-json c"tests/fixtures/sparse.json"))

(deftest sparse-counts-align-to-full-utc-window-and-rank-correctly
  (let [pool (n/new c"NSAutoreleasePool")
        (mut d) (m/empty)]
    (assert (m/decode (mut d) (sparse) (n/nil)))
    (assert (= (.days d) 4))
    (assert (= (.count d) 2))
    (assert (= (.views d) 15))
    (assert (= (.peak d) 7))
    (assert (= (load (index (.totals d) 0)) 5))
    (assert (= (load (index (.totals d) 1)) 0))
    (assert (= (load (index (.totals d) 2)) 3))
    (assert (= (load (index (.totals d) 3)) 7))
    (assert (= (strcmp (n/utf8 (.path (index (.posts d) 0))) c"/api/first") 0))
    (assert (= (m/find-post (mut d) c"/api/second") 1))
    (assert (= (m/find-post (mut d) c"/api/missing") -1))
    (m/clear (mut d))
    (n/release pool)))

(deftest empty-period-is-valid-and-retains-zero-days
  (let [pool (n/new c"NSAutoreleasePool")
        (mut d) (m/empty)]
    (assert (m/decode (mut d)
                      (n/read-json c"tests/fixtures/empty.json")
                      (n/nil)))
    (assert (= (.count d) 0))
    (assert (= (.days d) 4))
    (assert (= (.views d) 0))
    (for [i 0 (.days d)] (assert (= (load (index (.totals d) i)) 0)))
    (m/clear (mut d))
    (n/release pool)))

(deftest malformed-refresh-preserves-the-entire-previous-snapshot
  (let [pool (n/new c"NSAutoreleasePool")
        (mut d) (m/empty)]
    (assert (m/decode (mut d) (sparse) (n/nil)))
    (let [posts (.posts d)
          root (.root d)]
      (assert (not (m/decode (mut d) (n/parse-text c"{broken") (n/nil))))
      (assert (not (m/decode (mut d) (n/parse-text c"[]") (n/nil))))
      (assert (not (m/decode (mut d)
                             (n/parse-text c"{\"error\":\"upstream failed\"}")
                             (n/nil))))
      (assert (= (.posts d) posts))
      (assert (= (.root d) root))
      (assert (= (.views d) 15)))
    (m/clear (mut d))
    (n/release pool)))

(deftest rejects-mismatched-totals-negative-fractional-and-outside-buckets
  (let [pool (n/new c"NSAutoreleasePool")
        (mut d) (m/empty)
        values
          [c"{\"bucket_ms\":86400000,\"prefix\":\"/api/\",\"window\":{\"from\":0,\"to\":86400000},\"series\":[{\"path\":\"/api/a\",\"label\":\"a\",\"total_views\":5,\"points\":[{\"bucket_start_ms\":0,\"views\":4}]}]}"
           c"{\"bucket_ms\":86400000,\"prefix\":\"/api/\",\"window\":{\"from\":0,\"to\":86400000},\"series\":[{\"path\":\"/api/a\",\"label\":\"a\",\"total_views\":0,\"points\":[{\"bucket_start_ms\":0,\"views\":-1}]}]}"
           c"{\"bucket_ms\":86400000,\"prefix\":\"/api/\",\"window\":{\"from\":0,\"to\":86400000},\"series\":[{\"path\":\"/api/a\",\"label\":\"a\",\"total_views\":1,\"points\":[{\"bucket_start_ms\":0,\"views\":1.5}]}]}"
           c"{\"bucket_ms\":86400000,\"prefix\":\"/api/\",\"window\":{\"from\":0,\"to\":86400000},\"series\":[{\"path\":\"/api/a\",\"label\":\"a\",\"total_views\":1,\"points\":[{\"bucket_start_ms\":172800000,\"views\":1}]}]}"]]
    (for [i 0 4]
      (assert (not (m/decode (mut d) (n/parse-text (get values i)) (n/nil)))))
    (assert (= (.root d) (n/nil)))
    (m/clear (mut d))
    (n/release pool)))

(deftest rejects-unscoped-unbounded-and-unsupported-bucket-responses
  (let [pool (n/new c"NSAutoreleasePool")
        (mut d) (m/empty)
        values
          [c"{\"bucket_ms\":86400000,\"prefix\":\"/\",\"window\":{\"from\":0,\"to\":86400000},\"series\":[]}"
           c"{\"bucket_ms\":900000,\"prefix\":\"/api/\",\"window\":{\"from\":0,\"to\":86400000},\"series\":[]}"
           c"{\"bucket_ms\":86400000,\"prefix\":\"/api/\",\"window\":{\"from\":0,\"to\":null},\"series\":[]}"
           c"{\"bucket_ms\":86400000,\"prefix\":\"/api/\",\"window\":{\"from\":86400000,\"to\":0},\"series\":[]}"]]
    (for [i 0 4]
      (assert (not (m/decode (mut d) (n/parse-text (get values i)) (n/nil)))))
    (m/clear (mut d))
    (n/release pool)))

(deftest duplicate-post-paths-are-not-double-counted
  (let [pool (n/new c"NSAutoreleasePool")
        (mut d) (m/empty)
        root
          (n/parse-text c"{\"bucket_ms\":86400000,\"prefix\":\"/api/\",\"window\":{\"from\":0,\"to\":86400000},\"series\":[{\"path\":\"/api/a\",\"label\":\"a\",\"total_views\":0,\"points\":[]},{\"path\":\"/api/a\",\"label\":\"a\",\"total_views\":0,\"points\":[]}]}")]
    (assert (not (m/decode (mut d) root (n/nil))))
    (m/clear (mut d))
    (n/release pool)))

(deftest title-catalog-and-future-slug-fallback
  (let [pool (n/new c"NSAutoreleasePool")
        (mut d) (m/empty)
        catalog
          (n/parse-text c"{\"/api/first\":\"The first essay\",\"@short:/api/first\":\"First essay\"}")]
    (assert (m/decode (mut d) (sparse) catalog))
    (assert (= (strcmp (n/utf8 (.title (index (.posts d) 0)))
                       c"The first essay")
               0))
    (assert (= (strcmp (n/utf8 (.short-title (index (.posts d) 0)))
                       c"First essay")
               0))
    (assert (= (strcmp (n/utf8 (.title (index (.posts d) 1))) c"Second") 0))
    (m/clear (mut d))
    (n/release pool)))

(deftest layout-keeps-four-charts-and-scroll-index-in-bounds-at-minimum-size
  (for [size 0 3]
    (let [w (case size 0 1280.0 1 1560.0 2000.0)
          h (case size 0 900.0 1 1000.0 1250.0)
          l (v/layout w h 68)
          mounts [(.sidebar l) (.daily l) (.post l) (.hour l) (.heat l)]
          plots [(.plot l) (.post-plot l) (.hour-plot l) (.heat-plot l)]]
      (assert (< (.visible l) 68))
      (assert (>= (.visible l) 20))
      (assert (= (.row-height l) 32.0))
      (for [i 0 5]
        (let [r (get mounts i)]
          (assert (>= (.x r) 0.0))
          (assert (>= (.y r) 0.0))
          (assert (<= (+ (.x r) (.w r)) w))
          (assert (<= (+ (.y r) (.h r)) h))))
      (for [i 0 4]
        (let [r (get plots i)]
          (assert (> (.w r) 300.0))
          (assert (> (.h r) 95.0))))
      (let [last (v/row l (- (.visible l) 1))]
        (assert (<= (+ (.y last) (.h last)) h)))
      (let [max-scroll (v/max-scroll l 68)
            thumb (v/scroll-thumb l 68 max-scroll)]
        (assert (> max-scroll 0.0))
        (assert (<= (+ (.y thumb) (.h thumb)) (+ (.y (.list l)) (.h (.list l)))))))))

(deftest bucket-hit-mapping-clamps-at-edges-and-handles-one-day
  (let [r (rect 100.0 10.0 300.0 90.0)]
    (assert (= (v/bucket-at 20.0 r 31) 0))
    (assert (= (v/bucket-at 250.0 r 31) 15))
    (assert (= (v/bucket-at 900.0 r 31) 30))
    (assert (= (v/bucket-at 900.0 r 1) 0))))

(deftest selection-and-overflow-remain-reachable-after-refresh-or-resize
  (let [pool (n/new c"NSAutoreleasePool")
        d (field (source/state) data)
        ui (app/interaction)]
    (set! d (m/empty))
    (assert (m/decode d (sparse) (n/nil)))
    (app/select 1)
    (assert (= (.selected ui) 1))
    (app/select 10000)
    (assert (= (.selected ui) 1))
    (set! (.scroll ui) 10000.0)
    (app/limit-offset (v/layout 1280.0 900.0 (.count d)))
    (assert (= (.offset ui) 0))
    (m/clear d)
    (n/release pool)))

(deftest comma-formatting-is-correct-for-small-and-large-counts
  (assert (= (strcmp (app/formatted 0) c"0") 0))
  (assert (= (strcmp (app/formatted 7585) c"7,585") 0))
  (assert (= (strcmp (app/formatted 1234567890) c"1,234,567,890") 0)))

(deftest hourly-response-reconciles-every-chart-to-the-same-view-counts
  (let [pool (n/new c"NSAutoreleasePool")
        (mut d) (m/empty)]
    (assert (m/decode (mut d)
                      (n/read-json c"tests/fixtures/hourly.json")
                      (n/nil)))
    (assert (.hourly d))
    (assert (= (.views d) 15))
    (assert (= (.days d) 4))
    (assert (= (load (index (.totals d) 0)) 5))
    (assert (= (load (index (.totals d) 1)) 0))
    (assert (= (load (index (.totals d) 2)) 3))
    (assert (= (load (index (.totals d) 3)) 7))
    (assert (= (.hour-peak d) 9))
    (assert (= (.cell-peak d) 7))
    (assert (= (load (index (.heat d) 0)) 2))
    (assert (= (load (index (.heat d) 1)) 3))
    (assert (= (load (index (.heat d) 60)) 3))
    (let [(mut hourly) 0
          (mut cells) 0
          (mut daily) 0]
      (for [h 0 24]
        (set! hourly (+ (load hourly) (load (index (.hour-totals d) h)))))
      (for [cell 0 (* (.days d) 24)]
        (set! cells (+ (load cells) (load (index (.heat d) cell)))))
      (for [day 0 (.days d)]
        (set! daily (+ (load daily) (load (index (.totals d) day)))))
      (assert (= (load hourly) (.views d)))
      (assert (= (load cells) (.views d)))
      (assert (= (load daily) (.views d))))
    (m/clear (mut d))
    (n/release pool)))

(deftest daily-cache-is-explicitly-not-hourly-data
  (let [pool (n/new c"NSAutoreleasePool")
        (mut d) (m/empty)]
    (assert (m/decode (mut d) (sparse) (n/nil)))
    (assert (not (.hourly d)))
    (assert (= (.hour-peak d) 0))
    (m/clear (mut d))
    (n/release pool)))

(deftest partial-window-hours-are-not-reported-as-observed-zero-counts
  (let [pool (n/new c"NSAutoreleasePool")
        (mut d) (m/empty)]
    (assert (m/decode (mut d)
                      (n/read-json c"tests/fixtures/hourly.json")
                      (n/nil)))
    (assert (m/hour-in-window? (mut d) 0 0))
    (assert (m/hour-in-window? (mut d) 3 0))
    (assert (not (m/hour-in-window? (mut d) 3 1)))
    (assert (not (m/hour-in-window? (mut d) 4 0)))
    (m/clear (mut d))
    (n/release pool)))
