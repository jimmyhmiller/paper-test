(module blog.interaction-test)
(import "blog.native" :as n)
(import "coil.primitive" :as p)
(import "blog.model" :as m)
(import "blog.source" :as source)
(import "blog.app" :as app)
(import "blog.range-selection" :as range)
(import "blog.view" :as v)
(import "blog.stack" :as stack)
(import "blog.sun" :as sun)
(import "blog.theme" :as theme)
(import "blog.tuning" :as tuning)
(import "paper.lighting" :as light)
(import "paper.platform" :as host)
(import "paper.scene" :as scene)

(defn test-preferences [] (-> (ptr i8))
  (let [slot (p/alloc-static (ptr i8))]
    (when (= (load slot) (n/nil))
      (set! slot
            (n/msg (ptr i8)
                   (n/msg (ptr i8)
                          (n/class c"NSUserDefaults")
                          (n/sel c"alloc")
                          [])
                   (n/sel c"initWithSuiteName:")
                   [(ptr i8)]
                   (n/ns c"dev.coil.paper-blog.tests"))))
    (load slot)))

(defn setup [] (-> i64)
  (range/reset)
  (set! (.drag (host/host)) 0)
  (scene/init)
  (set! (sun/settings-store) (test-preferences))
  (set! (.open (sun/state)) false)
  (set! (.dragging (sun/map-state)) false)
  (host/paper_configure c"Paper Blog tests" 1560.0 1000.0)
  (let [s (source/state)
        ui (app/interaction)]
    (set! (.data s) (m/empty))
    (assert (m/decode-utc (field s data)
                          (n/read-json c"tests/fixtures/sparse.json")
                          (n/nil)))
    (set! (.message s) c"Test data")
    (set! (.selected ui) 0)
    (set! (.selection-locked ui) false)
    (set! (.keyboard-mode ui) false)
    (set! (.last-hover ui) -1)
    (set! (.day ui) -1)
    (set! (.detail-day ui) -1))
  (set! (.pinned-day (app/interaction)) -1)
  (set! (.pinned-hour (app/interaction)) -1)
  (set! (.hour (app/interaction)) -1)
  (set! (.hover (host/host)) 100)
  (app/draw))

(deftest hover-previews-a-post-and-leaving-restores-all-posts
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)
          l (v/layout 1560.0 1000.0 (.count d))
          r (v/row l 1)]
      (assert (= (host/hit-test (+ (.x r) 10.0) (+ (.y r) 8.0)) 101))
      (host/update-hover (+ (.x r) 10.0) (+ (.y r) 8.0))
      (app/draw)
      (assert (= (.selected (app/interaction)) 1))
      (host/update-hover -1.0 -1.0)
      (app/draw)
      (assert (= (.selected (app/interaction)) -1))
      (m/clear d))
    (n/release pool)))

(deftest main-and-detail-chart-hovers-map-to-exact-zero-filled-days
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)
          l (v/layout 1560.0 1000.0 (.count d))
          r (.plot l)
          detail (app/detail-plot l)]
      (host/update-hover (+ (.x r) (/ (.w r) 3.0)) (+ (.y r) 8.0))
      (app/draw)
      (assert (= (.day (app/interaction)) 1))
      (assert (= (load (index (.totals d) (.day (app/interaction)))) 0))
      (host/update-hover (+ (.x detail) (* (.w detail) (/ 2.0 3.0)))
                         (+ (.y detail) 8.0))
      (app/draw)
      (assert (= (.detail-day (app/interaction)) 2))
      (assert (= (.day (app/interaction)) 2))
      (m/clear d))
    (n/release pool)))

(deftest selecting-a-post-requests-matching-keyboard-focus
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (app/event 3 101 0.0 0.0)
    (assert (= (.selected (app/interaction)) 1))
    (assert (= (.requested-focus (host/host)) 101))
    (m/clear (field (source/state) data))
    (n/release pool)))

(deftest every-stacked-band-contains-exactly-that-posts-counts
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)]
      (for [day 0 (.days d)]
        (let [(mut sum) 0]
          (for [post 0 (.count d)]
            (let [upper (stack/upper d post day)
                  lower (stack/lower d post day)
                  views (load (index (.values (index (.posts d) post)) day))]
              (assert (= (- upper lower) views))
              (assert (>= lower 0))
              (set! sum (+ (load sum) (- upper lower)))))
          (assert (= (load sum) (load (index (.totals d) day))))))
      (m/clear d))
    (n/release pool)))

(deftest actual-cut-paper-hit-regions-select-their-post-not-a-rectangle
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)
          l (v/layout 1560.0 1000.0 (.count d))
          r (.plot l)
          peak (app/axis-peak (.peak d))
          x (+ (.x r) (* (.w r) (/ 2.0 3.0)))
          y (stack/y r 1 peak)]
      ;; Only the second post has views on this date. A bounding-box hit for
      ;; the first post would incorrectly win because that sheet is raised.
      (assert (= (host/hit-test x y) (+ app/LAYER_BASE 1)))
      (host/update-hover x y)
      (app/draw)
      (assert (= (.selected (app/interaction)) 1))
      (assert (= (.layer (app/interaction)) 1))
      (assert (= (host/hit-test x y) (+ app/LAYER_BASE 1)))
      (app/event 3 (+ app/LAYER_BASE 1) x y)
      (assert (= (.requested-focus (host/host)) 101))
      (m/clear d))
    (n/release pool)))

(deftest pixel-scrolling-and-thumb-drag-reach-the-last-post-without-changing-data
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)
          ui (app/interaction)]
      (assert (m/decode-utc d (n/read-json c"tests/fixtures/many.json") (n/nil)))
      (set! (.scroll ui) 0.0)
      (let [l (v/layout 1560.0 1000.0 (.count d))]
        (app/event 7 60 0.0 -7.5)
        (assert (= (.scroll ui) 7.5))
        (assert (= (.offset ui) 0))
        (app/event 7 60 0.0 -10000.0)
        (assert (= (.scroll ui) (v/max-scroll l (.count d))))
        (app/draw)
        (let [last (v/row l (- (.visible l) 1))]
          (assert (= (host/hit-test (+ (.x last) 10.0) (+ (.y last) 8.0)) 199)))
        (let [thumb (v/scroll-thumb l (.count d) (.scroll ui))]
          (app/event 1 70 (.x thumb) (+ (.y thumb) 4.0))
          (app/event 2 70 (.x thumb) (+ (.y (.list l)) 4.0))
          (app/event 3 70 (.x thumb) (+ (.y (.list l)) 4.0)))
        (assert (= (.scroll ui) 0.0))
        (assert (not (.dragging ui)))
        (app/select 99)
        (assert (= (.scroll ui) (v/max-scroll l (.count d))))
        (assert (= (.views d) 100)))
      (m/clear d))
    (n/release pool)))

(deftest heatmap-cell-inspection-links-day-and-hour-and-can-be-pinned
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)
          ui (app/interaction)]
      (assert (m/decode-utc d
                            (n/read-json c"tests/fixtures/hourly.json")
                            (n/nil)))
      (let [l (v/layout 1560.0 1000.0 (.count d))
            r (.heat-plot l)
            x (+ (.x r) (* (.w r) (/ 2.5 4.0)))
            y (+ (.y r) (* (.h r) (/ 12.5 24.0)))]
        (app/inspect-at l d app/HEAT_ID x y)
        (assert (= (.day ui) 2))
        (assert (= (.hour ui) 12))
        (assert (= (load (index (.heat d) (+ (* (.day ui) 24) (.hour ui)))) 3))
        (app/event 3 app/HEAT_ID x y)
        (assert (= (.pinned-day ui) 2))
        (assert (= (.pinned-hour ui) 12))
        (host/update-hover -1.0 -1.0)
        (app/draw)
        (assert (= (.day ui) 2))
        (assert (= (.hour ui) 12))
        (app/event 4 53 0.0 0.0)
        (app/draw)
        (assert (= (.day ui) -1))
        (assert (= (.hour ui) -1)))
      (m/clear d))
    (n/release pool)))

(deftest hourly-bars-use-absolute-post-counts-and-selection-links-the-inlay
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)]
      (assert (m/decode-utc d
                            (n/read-json c"tests/fixtures/hourly.json")
                            (n/nil)))
      (app/select 0)
      (assert (= (app/selected-hour d 0) 9))
      (assert (= (app/selected-hour d 1) 3))
      (app/select 1)
      (assert (= (app/selected-hour d 0) 0))
      (assert (= (app/selected-hour d 12) 3))
      (app/draw)
      (let [r (.hour-plot (v/layout 1560.0 1000.0 (.count d)))]
        (host/update-hover (+ (.x r) (* (.w r) (/ 12.5 24.0))) (+ (.y r) 5.0))
        (app/draw)
        (assert (= (.hour (app/interaction)) 12)))
      (m/clear d))
    (n/release pool)))

(deftest keyboard-selection-is-not-overridden-by-a-stationary-pointer
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)
          l (v/layout 1560.0 1000.0 (.count d))
          first (v/row l 0)]
      (app/event 3 101 0.0 0.0)
      (host/update-hover (+ (.x first) 10.0) (+ (.y first) 8.0))
      (app/draw)
      (assert (= (.selected (app/interaction)) 1))
      (m/clear d))
    (n/release pool)))

(deftest hourly-scale-follows-a-low-volume-post-without-aggregate-bars
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)]
      (assert (m/decode-utc d (n/read-json c"tests/fixtures/many.json") (n/nil)))
      (app/select 0)
      (assert (= (.hour-peak d) 100))
      (assert (= (app/selected-hour-peak d) 1))
      (assert (= (app/axis-peak (app/selected-hour-peak d)) 2))
      (app/draw)
      (let [r (.hour-plot (v/layout 1560.0 1000.0 (.count d)))
            bounds (app/bar r 0 24 1 2 0xf5af28 false 1 0)]
        (assert (> (.h bounds) 50.0)))
      (assert (= (load (index (.hour-totals d) 0)) 100))
      (m/clear d))
    (n/release pool)))

(deftest unified-window-drag-region-does-not-steal-index-or-chart-input
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (assert (host/window-drag-point? 800.0 20.0))
    (assert (not (host/window-drag-point? 60.0 200.0)))
    (assert (not (host/window-drag-point? 800.0 160.0)))
    (m/clear (field (source/state) data))
    (n/release pool)))

(deftest clicked-post-stays-locked-across-other-rows-and-chart-layers
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)
          ui (app/interaction)
          l (v/layout 1560.0 1000.0 (.count d))
          other (v/row l 0)]
      (app/event 3 101 35.0 240.0)
      (assert (.selection-locked ui))
      (host/update-hover (+ (.x other) 10.0) (+ (.y other) 8.0))
      (app/draw)
      (assert (= (.selected ui) 1))
      (set! (.hover (host/host)) app/LAYER_BASE)
      (app/update-hover d)
      (assert (= (.selected ui) 1))
      (app/event 3 100 35.0 208.0)
      (assert (= (.selected ui) 0))
      (assert (.selection-locked ui))
      (app/event 3 (+ app/LAYER_BASE 1) 800.0 200.0)
      (assert (= (.selected ui) 1))
      (assert (.selection-locked ui))
      (app/event 4 53 0.0 0.0)
      (assert (not (.selection-locked ui)))
      (set! (.hover (host/host)) 100)
      (app/update-hover d)
      (assert (= (.selected ui) 0))
      (m/clear d))
    (n/release pool)))

(deftest heatmap-counts-follow-hovered-and-locked-post-selection
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)
          ui (app/interaction)]
      (assert (m/decode-utc d
                            (n/read-json c"tests/fixtures/hourly.json")
                            (n/nil)))
      (for [post 0 (.count d)]
        (set! (.selected ui) post)
        (let [(mut sum) 0]
          (for [day 0 (.days d)]
            (for [hour 0 24]
              (set! sum (+ (load sum) (app/selected-cell d day hour)))))
          (assert (= (load sum) (.views (index (.posts d) post))))))
      (set! (.selected ui) 0)
      (set! (.hover (host/host)) 101)
      (app/update-hover d)
      (assert (= (.selected ui) 1))
      (assert (= (app/selected-cell d 0 1)
                 (load (index (.hours (index (.posts d) 1)) 1))))
      (app/event 3 100 35.0 208.0)
      (set! (.hover (host/host)) 101)
      (app/update-hover d)
      (assert (= (.selected ui) 0))
      (assert (= (app/selected-cell d 0 1)
                 (load (index (.hours (index (.posts d) 0)) 1))))
      (m/clear d))
    (n/release pool)))

(deftest unpin-total-and-background-restore-real-aggregate-charts
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)
          ui (app/interaction)]
      (assert (m/decode-utc d
                            (n/read-json c"tests/fixtures/hourly.json")
                            (n/nil)))
      (app/event 3 101 35.0 240.0)
      (assert (.selection-locked ui))
      (app/event 3 101 35.0 240.0)
      (assert (not (.selection-locked ui)))
      (assert (= (.selected ui) -1))
      (set! (.hover (host/host)) 101)
      (app/update-hover d)
      (assert (= (.selected ui) -1))
      (set! (.hover (host/host)) 0)
      (app/update-hover d)
      (set! (.hover (host/host)) 100)
      (app/update-hover d)
      (assert (= (.selected ui) 0))
      (for [action 0 2]
        (app/event 3 101 35.0 240.0)
        (app/event 3 (if (= action 0) 62 61) 30.0 70.0)
        (assert (= (.selected ui) -1))
        (assert (not (.selection-locked ui)))
        (let [(mut sum) 0]
          (for [hour 0 24]
            (assert (= (app/selected-hour d hour)
                       (load (index (.hour-totals d) hour))))
            (for [day 0 (.days d)]
              (let [amount (app/selected-cell d day hour)]
                (assert (= amount (load (index (.heat d) (+ (* day 24) hour)))))
                (set! sum (+ (load sum) amount)))))
          (assert (= (load sum) (.views d))))
        (assert (= (.views (app/displayed-post d)) (.views d))))
      (app/draw)
      (assert (= (host/hit-test 40.0 75.0) 62))
      (assert (= (host/hit-test 800.0 450.0) 61))
      (m/clear d))
    (n/release pool)))

(deftest sunlight-popup-allows-post-selection-and-closes-without-clearing-the-pin
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)
          l (v/layout 1560.0 1000.0 (.count d))
          anchor (sun/anchor (.daily l))
          lighting (sun/state)]
      (assert (= (host/hit-test (+ (.x anchor) 18.0) (+ (.y anchor) 18.0))
                 sun/BASE))
      (app/event 3 101 35.0 240.0)
      (app/event 3 sun/BASE 0.0 0.0)
      (app/draw)
      (assert (.open lighting))
      (assert (= (host/hit-test 35.0 240.0) 101))
      (app/event 3 100 35.0 208.0)
      (assert (= (.selected (app/interaction)) 0))
      (assert (.open lighting))
      (let [track (sun/track-bounds lighting 3)]
        (app/event 1
                   (+ sun/BASE 23)
                   (+ (.x track) (* (.w track) 0.5))
                   (.y track))
        (assert (= (.depth lighting) 6.0)))
      (app/event 4 53 0.0 0.0)
      (assert (not (.open lighting)))
      (assert (.selection-locked (app/interaction)))
      (assert (= (.selected (app/interaction)) 0))
      (m/clear d))
    (n/release pool)))

(deftest sunlight-settings-restore-and-reset-persist-without-changing-user-preferences
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [s (sun/state)
          store (test-preferences)]
      (set! (.x s) 0.31)
      (set! (.y s) -0.4)
      (set! (.height s) 1234.0)
      (set! (.depth s) 0.65)
      (sun/save-settings s)
      (set! (.height s) 0.0)
      (sun/state)
      (assert (= (.x s) 0.31))
      (assert (= (.y s) -0.4))
      (assert (= (.height s) 1234.0))
      (assert (= (.depth s) 0.65))
      (app/event 3 sun/BASE 0.0 0.0)
      (app/event 3 (+ sun/BASE 4) 0.0 0.0)
      (let [saved
              (n/msg (ptr i8)
                     store
                     (n/sel c"objectForKey:")
                     [(ptr i8)]
                     (n/ns c"paper-blog.sunlight.v1"))]
        (assert (= (sun/saved-number saved c"depth" -1.0 0.0 1.5)
                   (.default-depth s)))
        (assert (= (sun/saved-number saved c"height" -1.0 200.0 2000.0)
                   (.default-height s))))
      (let [invalid (n/parse-text c"{\"depth\":99,\"height\":\"bad\"}")]
        (assert (= (sun/saved-number invalid c"depth" 1.05 0.0 1.5) 1.05))
        (assert (= (sun/saved-number invalid c"height" 760.0 200.0 2000.0)
                   760.0)))
      (n/msg i64
             store
             (n/sel c"removePersistentDomainForName:")
             [(ptr i8)]
             (n/ns c"dev.coil.paper-blog.tests"))
      (set! (.animating s) false)
      (set! (.open s) false)
      (m/clear (field (source/state) data)))
    (n/release pool)))

(deftest expanded-paper-parameters-reach-the-renderer-and-persist-at-extremes
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [s (sun/state)]
      (for [i 0 sun/COUNT]
        (sun/set-fraction s i 1.0)
        (assert (= (sun/parameter-value s i) (sun/maximum-value i)))
        (assert (= (sun/parameter-fraction s i) 1.0)))
      (sun/save-settings s)
      (for [i 0 sun/COUNT] (sun/set-parameter s i (sun/default-value s i)))
      (sun/restore-settings s)
      (for [i 0 sun/COUNT]
        (assert (= (sun/parameter-value s i) (sun/maximum-value i))))
      (sun/apply)
      (assert (= (.depth (scene/scene)) 12.0))
      (assert (= (.grain (scene/scene)) 10.0))
      (assert (= (.elevation (scene/scene)) 20000.0))
      (let [stock (theme/paper 0x123456)]
        (assert (= (.size (.pattern stock)) 16.0))
        (assert (= (.relief (.pattern stock)) 8.0)))
      (assert (= (app/heat-tile (v/row (v/layout 1560.0 1000.0 2) 0)
                                1.0
                                false
                                false)
                 33.0))
      (app/event 3 sun/BASE 0.0 0.0)
      (app/draw)
      (let [last (sun/track-bounds s (- sun/COUNT 1))]
        (assert (< (+ (.y last) (.h last))
                   (+ (.y (.bounds s)) (.h (.bounds s)))))
        (assert (= (host/hit-test (+ (.x last) 10.0) (+ (.y last) 10.0))
                   (+ sun/BASE 20 (- sun/COUNT 1)))))
      (app/event 3 (+ sun/BASE 4) 0.0 0.0)
      (for [i 0 sun/COUNT]
        (assert (= (sun/parameter-value s i) (sun/default-value s i))))
      (set! (.open s) false)
      (n/msg i64
             (test-preferences)
             (n/sel c"removePersistentDomainForName:")
             [(ptr i8)]
             (n/ns c"dev.coil.paper-blog.tests"))
      (m/clear (field (source/state) data)))
    (n/release pool)))

(deftest sidebar-row-gaps-and-gutters-do-not-flash-the-all-post-view
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)
          ui (app/interaction)
          l (v/layout 1560.0 1000.0 (.count d))
          row (v/row l 1)]
      (host/update-hover (+ (.x row) 10.0) (+ (.y row) 10.0))
      (app/draw)
      (assert (= (.selected ui) 1))
      (host/update-hover (+ (.x row) 10.0) (+ (.y row) 31.5))
      (app/draw)
      (assert (= (.selected ui) 1))
      (assert (not (.selection-locked ui)))
      (host/update-hover 5.0 (+ (.y row) 10.0))
      (app/draw)
      (assert (= (.selected ui) 1))
      (set! (.hover (host/host)) 70)
      (app/update-hover d)
      (assert (= (.selected ui) 1))
      (set! (.hover (host/host)) 100)
      (app/update-hover d)
      (assert (= (.selected ui) 0))
      (set! (.hover (host/host)) 61)
      (app/update-hover d)
      (assert (= (.selected ui) -1))
      (m/clear d))
    (n/release pool)))

(deftest restored-sun-map-drags-the-global-light-and-saves-its-position
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [s (sun/state)
          d (field (source/state) data)]
      (for [i 0 sun/COUNT] (sun/set-parameter s i (sun/default-value s i)))
      (set! (.low (sun/map-state)) -1.0)
      (set! (.high (sun/map-state)) 2.0)
      (app/event 3 sun/BASE 0.0 0.0)
      (app/draw)
      (let [map (sun/map-bounds s)]
        (assert (= (host/hit-test (+ (.x map) 10.0) (+ (.y map) 10.0))
                   (+ sun/BASE 1)))
        (app/event 1
                   (+ sun/BASE 1)
                   (+ (.x map) (* (.w map) 0.25))
                   (+ (.y map) (* (.h map) 0.75)))
        (assert (= (.x s) -0.25))
        (assert (= (.y s) 1.25))
        (app/draw)
        (assert (= (.low (sun/map-state)) -1.0))
        (assert (= (.high (sun/map-state)) 2.0))
        (app/event 2
                   (+ sun/BASE 1)
                   (+ (.x map) (* (.w map) 0.5))
                   (+ (.y map) (* (.h map) 0.5)))
        (app/event 3 (+ sun/BASE 1) 0.0 0.0)
        (assert (= (.x s) 0.5))
        (assert (= (.y s) 0.5)))
      (sun/apply)
      (assert (= (.light-x (scene/scene)) (* 0.5 (host/logical-width))))
      (sun/set-parameter s 0 0.0)
      (sun/restore-settings s)
      (assert (= (.x s) 0.5))
      (app/event 3 (+ sun/BASE 4) 0.0 0.0)
      (set! (.open s) false)
      (n/msg i64
             (test-preferences)
             (n/sel c"removePersistentDomainForName:")
             [(ptr i8)]
             (n/ns c"dev.coil.paper-blog.tests"))
      (m/clear d))
    (n/release pool)))

(deftest raised-bars-keep-their-original-hover-target-and-view-count
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)
          l (v/layout 1560.0 1000.0 (.count d))
          r (.post-plot l)
          x (+ (.x r) (* (.w r) 0.875))
          y (+ (.y r) (* (.h r) 0.5))
          was-headless (.headless (host/host))]
      (set! (.headless (host/host)) true)
      (assert (= (host/hit-test x y) (+ app/POST_DAY_BASE 3)))
      (host/update-hover x y)
      (app/draw)
      (assert (= (.day (app/interaction)) 3))
      (assert (= (host/hit-test x y) (+ app/POST_DAY_BASE 3)))
      (let [rest (app/bar r 3 4 7 10 0xf5af28 false 0 3)
            raised (app/bar r 3 4 7 10 0xf5af28 true 0 3)]
        (assert (= (.x rest) (.x raised)))
        (assert (= (.y rest) (.y raised)))
        (assert (= (.w rest) (.w raised)))
        (assert (= (.h rest) (.h raised))))
      (assert (= (.views d) 15))
      (set! (.headless (host/host)) was-headless)
      (m/clear d))
    (n/release pool)))

(deftest nonmodal-lighting-popup-keeps-uncovered-hovers-scrolling-and-graphs-live
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)
          s (sun/state)
          ui (app/interaction)]
      (assert (m/decode-utc d (n/read-json c"tests/fixtures/many.json") (n/nil)))
      (app/event 3 sun/BASE 0.0 0.0)
      (app/draw)
      (let [l (v/layout 1560.0 1000.0 (.count d))
            row (v/row l 1)
            plot (.post-plot l)]
        (host/update-hover (+ (.x row) 10.0) (+ (.y row) 10.0))
        (app/draw)
        (assert (= (.selected ui) 1))
        (assert (.open s))
        (app/event 7 60 0.0 -32.0)
        (assert (> (.scroll ui) 0.0))
        (assert (.open s))
        (host/update-hover (+ (.x plot) (* (.w plot) 0.5)) (+ (.y plot) 10.0))
        (app/draw)
        (assert (>= (.day ui) 0))
        (assert (.open s)))
      (app/event 3 101 35.0 240.0)
      (assert (.selection-locked ui))
      (app/event 3 62 40.0 75.0)
      (assert (= (.selected ui) -1))
      (assert (.open s))
      (let [map (sun/map-bounds s)]
        (assert (= (host/hit-test (+ (.x map) 10.0) (+ (.y map) 10.0))
                   (+ sun/BASE 1))))
      (app/event 4 53 0.0 0.0)
      (assert (not (.open s)))
      (m/clear d))
    (n/release pool)))

(deftest brushing-filters-daily-hourly-and-heatmap-with-global-day-identities
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)
          ui (app/interaction)
          l (v/layout 1560.0 1000.0 (.count d))
          r (.plot l)]
      (m/clear d)
      (assert (m/decode-utc d
                            (n/read-json c"tests/fixtures/hourly.json")
                            (n/nil)))
      (set! (.selected ui) -1)
      (set! (.hover (host/host)) 0)
      (set! (.drag (host/host)) app/DAY_BASE)
      (app/event 1 app/DAY_BASE (.x r) (.y r))
      (app/event 2 app/DAY_BASE (+ (.x r) (* (.w r) (/ 2.0 3.0))) (.y r))
      (assert (.active (range/state)))
      (assert (= (range/first d) 0))
      (assert (= (range/last d) 2))
      (assert (= (app/period-views d (app/displayed-post d)) 8))
      (let [(mut hourly) 0]
        (for [hour 0 24]
          (set! hourly (+ (load hourly) (app/selected-hour d hour))))
        (assert (= (load hourly) 8)))
      ;; A release over a changed hit id still ends capture on the next draw.
      (set! (.drag (host/host)) 0)
      (app/draw)
      (assert (not (.gesture (range/state))))
      (assert (.active (range/state)))
      (range/set-range d 1 2)
      (app/draw)
      (let [heat (.heat-plot l)
            detail (.post-plot l)]
        (app/inspect-at l
                        d
                        app/HEAT_ID
                        (+ (.x heat) (* (.w heat) 0.75))
                        (+ (.y heat) 1.0))
        (assert (= (.day ui) 2))
        (assert (= (host/hit-test (+ (.x detail) (* (.w detail) 0.75))
                                  (+ (.y detail) 2.0))
                   (+ app/POST_DAY_BASE 2))))
      (app/event 3 62 0.0 0.0)
      (assert (not (.active (range/state))))
      (assert (= (app/period-views d (app/displayed-post d)) 15))
      (m/clear d))
    (n/release pool)))

(deftest date-range-moves-clamps-resizes-and-preserves-click-selection
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)
          r (.plot (v/layout 1560.0 1000.0 (.count d)))
          x1 (+ (.x r) (/ (.w r) 3.0))
          x2 (+ (.x r) (* (.w r) (/ 2.0 3.0)))]
      (range/set-range d 1 2)
      (assert (range/handle d r 1 range/MOVE x1 false))
      (assert (range/handle d r 2 range/MOVE (+ (.x r) (* 2.0 (.w r))) false))
      (assert (= (range/first d) 2))
      (assert (= (range/last d) 3))
      (assert (range/handle d r 3 range/MOVE x2 false))
      (assert (range/handle d r 1 range/LEFT x2 false))
      (assert (range/handle d r 2 range/LEFT (.x r) false))
      (assert (= (range/count d) 4))
      (assert (range/handle d r 3 range/LEFT (.x r) false))
      (assert (range/handle d r 1 range/RIGHT (+ (.x r) (.w r)) false))
      (assert (range/handle d r 2 range/RIGHT (.x r) false))
      (assert (= (range/count d) 1))
      (assert (range/handle d r 3 range/RIGHT (.x r) false))
      ;; Civil timestamps keep the selected days stable when the source extends.
      (set! (.start d) (- (.start d) m/DAY))
      (set! (.days d) (+ (.days d) 1))
      (assert (= (range/first d) 1))
      (set! (.start d) (+ (.start d) m/DAY))
      (set! (.days d) (- (.days d) 1))
      (range/reset)
      (app/event 1 app/LAYER_BASE (.x r) (.y r))
      (app/event 3 app/LAYER_BASE (.x r) (.y r))
      (assert (.selection-locked (app/interaction)))
      (assert (not (.active (range/state))))
      (range/reset)
      (m/clear d))
    (n/release pool)))

(deftest a-pinned-post-remains-selected-through-a-reverse-range-drag
  (let [pool (n/new c"NSAutoreleasePool")]
    (setup)
    (let [d (field (source/state) data)
          ui (app/interaction)
          r (.plot (v/layout 1560.0 1000.0 (.count d)))]
      (m/clear d)
      (assert (m/decode-utc d
                            (n/read-json c"tests/fixtures/hourly.json")
                            (n/nil)))
      (app/event 3 100 0.0 0.0)
      (set! (.drag (host/host)) app/DAY_BASE)
      (app/event 1 app/DAY_BASE (+ (.x r) (* (.w r) (/ 2.0 3.0))) (.y r))
      (app/event 2 app/DAY_BASE (.x r) (.y r))
      (assert (.selection-locked ui))
      (assert (= (.selected ui) 0))
      (assert (= (range/first d) 0))
      (assert (= (range/last d) 2))
      (assert (= (app/period-views d (app/displayed-post d)) 5))
      (assert (= (app/selected-hour d 0) 2))
      (assert (= (app/selected-hour d 1) 3))
      (set! (.drag (host/host)) 0)
      (app/draw)
      (app/event 4 53 0.0 0.0)
      (assert (not (.active (range/state))))
      (m/clear d))
    (n/release pool)))
