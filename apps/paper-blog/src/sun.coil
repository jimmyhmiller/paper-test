(module blog.sun)
(import "coil.primitive" :as p)
(import "paper.flow" :use *)
(import "paper.platform" :as host)
(import "paper.lighting" :as light)
(import "blog.theme" :as t)
(import "blog.native" :as n)
(import "blog.tuning" :as tuning)
(import "paper.ffi" :use [snprintf sqrt])

(const BASE 800000)

(defn settings-store [] (-> (ptr (ptr i8)))
  (p/alloc-static (ptr i8)))

(defn preferences [] (-> (ptr i8))
  (let [override (load (settings-store))]
    (if (!= override (n/nil))
        override
        (n/msg (ptr i8)
               (n/class c"NSUserDefaults")
               (n/sel c"standardUserDefaults")
               []))))

(defn saved-number [(settings (ptr i8))
                    (key (ptr i8))
                    (fallback f64)
                    (low f64)
                    (high f64)] (-> f64)
  (let [value (n/key settings key)]
    (if (n/number? value)
        (let [amount (n/msg f64 value (n/sel c"doubleValue") [])]
          (if (and (>= amount low) (<= amount high)) amount fallback))
        fallback)))

(const COUNT 9)

(defn parameter-name [(i i64)] (-> (ptr i8))
  (case i
    0 c"Sun X"
    1 c"Sun Y"
    2 c"Sun height"
    3 c"Paper depth"
    4 c"Paper grain"
    5 c"Texture size"
    6 c"Texture depth"
    7 c"Texture angle"
    c"Hover movement"))

(defn parameter-key [(i i64)] (-> (ptr i8))
  (case i
    0 c"x"
    1 c"y"
    2 c"height"
    3 c"depth"
    4 c"grain"
    5 c"texture-size"
    6 c"texture-depth"
    7 c"texture-angle"
    c"hover-lift"))

(defn minimum-value [(i i64)] (-> f64)
  (case i 0 -5.0 1 -5.0 2 10.0 5 0.25 7 -180.0 0.0))

(defn maximum-value [(i i64)] (-> f64)
  (case i 0 5.0 1 5.0 2 20000.0 3 12.0 4 10.0 5 16.0 6 8.0 7 180.0 30.0))

(defn default-value [(s (ptr light/Lighting)) (i i64)] (-> f64)
  (case i
    0 (.default-x s)
    1 (.default-y s)
    2 (.default-height s)
    3 (.default-depth s)
    4 (.default-grain s)
    5 1.6
    6 1.4
    7 0.0
    tuning/DEFAULT_HOVER_LIFT))

(defn parameter-value [(s (ptr light/Lighting)) (i i64)] (-> f64)
  (let [t (tuning/state)]
    (case i
      0 (.x s)
      1 (.y s)
      2 (.height s)
      3 (.depth s)
      4 (.grain s)
      5 (.texture-size t)
      6 (.texture-depth t)
      7 (.texture-angle t)
      (.hover-lift t))))

(defn set-parameter [(s (ptr light/Lighting)) (i i64) (value f64)] (-> i64)
  (let [v (clamp value (minimum-value i) (maximum-value i))
        t (tuning/state)]
    (case i
      0 (set! (.x s) v)
      1 (set! (.y s) v)
      2 (set! (.height s) v)
      3 (set! (.depth s) v)
      4 (set! (.grain s) v)
      5 (set! (.texture-size t) v)
      6 (set! (.texture-depth t) v)
      7 (set! (.texture-angle t) v)
      (set! (.hover-lift t) v)))
  0)

(defn parameter-fraction [(s (ptr light/Lighting)) (i i64)] (-> f64)
  (let [fraction
          (clamp (/ (- (parameter-value s i) (minimum-value i))
                    (- (maximum-value i) (minimum-value i)))
                 0.0
                 1.0)]
    (if (= i 2) (sqrt fraction) fraction)))

(defn set-fraction [(s (ptr light/Lighting)) (i i64) (fraction f64)] (-> i64)
  (let [f (clamp fraction 0.0 1.0)]
    (set-parameter s
                   i
                   (+ (minimum-value i)
                      (* (if (= i 2) (* f f) f)
                         (- (maximum-value i) (minimum-value i)))))))

(defn restore-settings [(s (ptr light/Lighting))] (-> i64)
  (let [saved
          (n/msg (ptr i8)
                 (preferences)
                 (n/sel c"objectForKey:")
                 [(ptr i8)]
                 (n/ns c"paper-blog.sunlight.v1"))]
    (when (n/dict? saved)
      (for [i 0 COUNT]
        (set-parameter s
                       i
                       (saved-number saved
                                     (parameter-key i)
                                     (parameter-value s i)
                                     (minimum-value i)
                                     (maximum-value i))))))
  0)

(defn save-settings [(s (ptr light/Lighting))] (-> i64)
  (let [saved (n/new c"NSMutableDictionary")]
    (for [i 0 COUNT]
      (n/msg i64
             saved
             (n/sel c"setObject:forKey:")
             [(ptr i8) (ptr i8)]
             (n/msg (ptr i8)
                    (n/class c"NSNumber")
                    (n/sel c"numberWithDouble:")
                    [f64]
                    (parameter-value s i))
             (n/ns (parameter-key i))))
    (n/msg i64
           (preferences)
           (n/sel c"setObject:forKey:")
           [(ptr i8) (ptr i8)]
           saved
           (n/ns c"paper-blog.sunlight.v1"))
    (n/release saved))
  0)

(defn state [] (-> (ptr light/Lighting))
  (let [s (p/alloc-static light/Lighting)]
    (when (<= (.height s) 0.0)
      (set! s (light/lighting 0.16 -0.18 760.0 1.05 1.0))
      (restore-settings s))
    s))

(defn anchor [(sheet Rect)] (-> Rect)
  (rect (- (+ (.x sheet) (.w sheet)) 56.0) (+ (.y sheet) 12.0) 36.0 36.0))

(defn apply [] (-> i64)
  (let [s (state)
        viewport (rect 0.0 0.0 (host/logical-width) (host/logical-height))]
    (set! (.viewport s) viewport)
    (host/paper_light_extended (* (.x s) (.w viewport))
                               (* (.y s) (.h viewport))
                               (.height s)
                               (.depth s)
                               (.grain s)))
  0)

(defn track-bounds [(s (ptr light/Lighting)) (i i64)] (-> Rect)
  (let [r (.bounds s)]
    (rect (+ (.x r) 22.0)
          (+ (.y r) 244.0 (* (cast f64 i) 44.0))
          (- (.w r) 44.0)
          20.0)))

(defstruct SunMap [(low f64) (high f64) (dragging bool)])

(defn map-state [] (-> (ptr SunMap))
  (let [m (p/alloc-static SunMap)]
    (when (<= (.high m) (.low m))
      (set! m
            (SunMap
              :low -1.0
              :high 2.0
              :dragging false)))
    m))

(defn map-bounds [(s (ptr light/Lighting))] (-> Rect)
  (let [r (.bounds s)]
    (rect (+ (.x r) 22.0) (+ (.y r) 60.0) (- (.w r) 44.0) 132.0)))

(defn draw-map [(s (ptr light/Lighting))] (-> i64)
  (let [m (map-state)
        r (map-bounds s)]
    (when (not (.dragging m))
      (set! (.low m)
            (minimum (.low m) (minimum -1.0 (- (minimum (.x s) (.y s)) 0.25))))
      (set! (.high m)
            (maximum (.high m) (maximum 2.0 (+ (maximum (.x s) (.y s)) 0.25)))))
    (let [span (- (.high m) (.low m))]
      (panel r 1.0 63.2 (t/paper t/BACK))
      ;; This outline represents the whole dashboard in the light's world.
      (frame (rect (+ (.x r) (* (.w r) (/ (- (.low m)) span)))
                   (+ (.y r) (* (.h r) (/ (- (.low m)) span)))
                   (/ (.w r) span)
                   (/ (.h r) span))
             0.0
             0.7
             63.4
             (t/paper t/MUTED))
      (disc (- (+ (.x r) (* (.w r) (/ (- (.x s) (.low m)) span))) 6.0)
            (- (+ (.y r) (* (.h r) (/ (- (.y s) (.low m)) span))) 6.0)
            12.0
            63.8
            (t/paper t/GOLD)))
    (ink-height 64.0)
    (hit (+ BASE 1) r c"Drag the sun to light all paper in the dashboard")
    (label (.x r)
           (+ (.y r) (.h r) 10.0)
           10.0
           t/MUTED
           0
           c"Drag the sun · lights the whole dashboard"))
  0)

(defn value-buffer [] (-> (ptr (array i8 96)))
  (p/alloc-static (array i8 96)))

(defn draw [(sheet Rect)] (-> i64)
  (let [s (state)
        a (anchor sheet)
        v (.viewport s)]
    (ink-height 16.0)
    (label (+ (.x a) 7.7) (+ (.y a) 4.8) 25.0 0x102630 0 c"☀")
    (ink-height 17.0)
    (label (+ (.x a) 7.0) (+ (.y a) 4.0) 25.0 t/GOLD 0 c"☀")
    (hit BASE a c"Adjust paper and sunlight")
    (when (.open s)
      (let [width 350.0
            height 694.0
            x
              (clamp (if (.positioned s)
                         (.x (.bounds s))
                         (- (+ (.x a) (.w a)) width))
                     16.0
                     (- (.w v) width 16.0))
            y
              (clamp (if (.positioned s)
                         (.y (.bounds s))
                         (+ (.y a) (.h a) 12.0))
                     16.0
                     (- (.h v) height 16.0))]
        (set! (.bounds s) (rect x y width height)))
      (let [r (.bounds s)]
        (panel r 2.0 63.0 (t/paper t/POST))
        (frame r 2.0 0.8 63.2 (t/paper 0x9b6075))
        (ink-height 64.0)
        (hit (+ BASE 5) r c"Paper and sunlight controls")
        (hit (+ BASE 7)
             (rect (+ (.x r) 10.0) (+ (.y r) 8.0) (- (.w r) 65.0) 44.0)
             c"Move paper controls")
        (label (+ (.x r) 22.0) (+ (.y r) 20.0) 18.0 t/INK 1 c"Paper & sunlight")
        (label (- (+ (.x r) (.w r)) 40.0) (+ (.y r) 18.0) 20.0 t/INK 0 c"×")
        (hit (+ BASE 2)
             (rect (- (+ (.x r) (.w r)) 49.0) (+ (.y r) 9.0) 36.0 36.0)
             c"Close paper controls")
        (draw-map s)
        (for [i 0 COUNT]
          (let [track (track-bounds s i)
                value (parameter-fraction s i)
                text (index (value-buffer) 0)]
            (label (.x track)
                   (- (.y track) 17.0)
                   12.0
                   t/INK
                   0
                   (parameter-name i))
            (cast i64 (snprintf text 96 c"%.2f" (parameter-value s i)))
            (label (- (+ (.x track) (.w track)) 64.0)
                   (- (.y track) 17.0)
                   11.0
                   t/INK
                   3
                   text)
            (panel (rect (.x track) (+ (.y track) 8.0) (.w track) 4.0)
                   1.0
                   63.3
                   (t/paper t/BACK))
            (panel (rect (.x track) (+ (.y track) 8.0) (* (.w track) value) 4.0)
                   1.0
                   63.5
                   (t/paper t/GOLD))
            (disc (- (+ (.x track) (* (.w track) value)) 6.0)
                  (+ (.y track) 4.0)
                  12.0
                  63.8
                  (t/paper t/GOLD))
            (ink-height 64.0)
            (host/paper_hit (+ BASE 20 i)
                            (.x track)
                            (.y track)
                            (.w track)
                            (.h track)
                            (parameter-name i)
                            1
                            value)))
        (label (+ (.x r) 22.0)
               (+ (.y r) (- (.h r) 28.0))
               11.0
               t/INK
               0
               c"Reset all")
        (label (+ (.x r) 140.0)
               (+ (.y r) (- (.h r) 28.0))
               10.0
               t/MUTED
               0
               c"Shift-drag for fine adjustment")
        (hit (+ BASE 4)
             (rect (+ (.x r) 14.0) (+ (.y r) (- (.h r) 37.0)) 85.0 30.0)
             c"Reset all paper and sunlight settings"))))
  0)

(defstruct ParameterDrag [(row i64) (x f64) (fraction f64)])

(defn parameter-drag [] (-> (ptr ParameterDrag))
  (p/alloc-static ParameterDrag))

(defn fine-drag? [] (-> bool)
  (and (!= (.window (host/host)) (n/nil))
       (!= (& (n/msg i64 (n/class c"NSEvent") (n/sel c"modifierFlags") [])
              131072)
           0)))

(defn owns-id? [(id i64)] (-> bool)
  (and (>= id BASE) (< id (+ BASE 20 COUNT))))

;;; Preserve graph inspection while the pointer adjusts the popup itself,
;;; while leaving all uncovered dashboard controls live.
(defn captures-pointer? [] (-> bool)
  (and (.open (state))
       (or (owns-id? (.hover (host/host)))
           (owns-id? (.drag (host/host)))
           (.dragging (state))
           (.dragging (map-state)))))

(defn handle [(kind i64) (id i64) (x f64) (y f64)] (-> bool)
  (let [s (state)]
    (cond (and (.open s) (= kind 4) (= id 53))
            (do
              (set! (.open s) false)
              (set! (.dragging s) false)
              (set! (.dragging (map-state)) false)
              (host/paper_redraw)
              true)
          (and (= kind 3) (or (= id BASE) (and (.open s) (= id (+ BASE 2)))))
            (do
              (set! (.open s) (not (.open s)))
              (when (not (.open s))
                (set! (.dragging s) false)
                (set! (.dragging (map-state)) false))
              (host/paper_redraw)
              true)
          (and (.open s) (= kind 3) (= id (+ BASE 4)))
            (do
              (for [i 0 COUNT] (set-parameter s i (default-value s i)))
              (set! (.low (map-state)) -1.0)
              (set! (.high (map-state)) 2.0)
              (set! (.dragging (map-state)) false)
              (save-settings s)
              (host/paper_redraw)
              true)
          (and (.open s) (= id (+ BASE 1)))
            (do
              (when (= kind 1) (set! (.dragging (map-state)) true))
              (when (or (= kind 1) (= kind 2))
                (let [r (map-bounds s)
                      m (map-state)
                      span (- (.high m) (.low m))]
                  (set-parameter s
                                 0
                                 (+ (.low m)
                                    (* span
                                       (clamp (/ (- x (.x r)) (.w r)) 0.0 1.0))))
                  (set-parameter s
                                 1
                                 (+ (.low m)
                                    (* span
                                       (clamp (/ (- y (.y r)) (.h r)) 0.0 1.0))))
                  (save-settings s)
                  (host/paper_redraw)))
              (when (= kind 3) (set! (.dragging (map-state)) false))
              true)
          (and (.open s) (>= id (+ BASE 20)) (< id (+ BASE 20 COUNT)))
            (do
              (when (or (= kind 1) (= kind 2))
                (let [i (- id (+ BASE 20))
                      track (track-bounds s i)
                      drag (parameter-drag)]
                  (when (= kind 1)
                    (set! (.row drag) i)
                    (set! (.x drag) x)
                    (set! (.fraction drag) (parameter-fraction s i)))
                  (set-fraction s
                                i
                                (if (and (fine-drag?) (= (.row drag) i))
                                    (+ (.fraction drag)
                                       (* 0.1 (/ (- x (.x drag)) (.w track))))
                                    (/ (- x (.x track)) (.w track))))
                  (save-settings s)
                  (host/paper_redraw)))
              true)
          (and (.open s) (= id (+ BASE 7)) (= kind 1))
            (do
              (set! (.dragging s) true)
              (set! (.grab-x s) (- x (.x (.bounds s))))
              (set! (.grab-y s) (- y (.y (.bounds s))))
              true)
          (and (.open s) (.dragging s) (= kind 2))
            (do
              (set! (.bounds s)
                    (rect (- x (.grab-x s))
                          (- y (.grab-y s))
                          (.w (.bounds s))
                          (.h (.bounds s))))
              (set! (.positioned s) true)
              (host/paper_redraw)
              true)
          (and (.open s) (= kind 3) (= id (+ BASE 7)))
            (do (set! (.dragging s) false) true)
          (and (.open s) (or (= id (+ BASE 5)) (= id (+ BASE 7)))) true
          (= kind 6) false
          (= kind 0) false
          :else false)))
