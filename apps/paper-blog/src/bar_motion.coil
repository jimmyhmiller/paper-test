(module blog.bar-motion)
(import "coil.primitive" :as p)
(import "paper.flow" :use [Rect rect clamp])
(import "paper.platform" :as host)
(import "paper.ffi" :use [fabs pow])
(import "blog.native" :as n)
(import "blog.tuning" :as tuning)

(defstruct Motion
  [(last f64)
   (seconds f64)
   (pending bool)
   (animate bool)
   (levels (ptr f64))
   (slots i64)])

(defn state [] (-> (ptr Motion))
  (p/alloc-static Motion))

(defn reserve [(days i64)] (-> i64)
  (let [s (state)
        slots (if (> days 0) days 1)]
    (when (!= slots (.slots s))
      (let [values (cast (ptr f64) (n/calloc (cast u64 (+ slots 24)) 8))]
        (when (!= values (cast (ptr f64) 0))
          (n/free (cast (ptr i8) (.levels s)))
          (set! (.levels s) values)
          (set! (.slots s) slots)))))
  0)

(defn shutdown [] (-> i64)
  (n/free (cast (ptr i8) (.levels (state))))
  (set! (.levels (state)) (cast (ptr f64) 0))
  (set! (.slots (state)) 0)
  0)

(defn step [(value f64) (target f64) (seconds f64)] (-> f64)
  (let [next
          (+ value
             (* (- target value)
                (- 1.0 (pow 0.001 (/ (clamp seconds 0.0 0.05) 0.12)))))]
    (if (< (fabs (- target next)) 0.001) target next)))

(defn begin [(days i64)] (-> i64)
  (reserve days)
  (let [s (state)
        now (host/CACurrentMediaTime)]
    (set! (.seconds s)
          (if (> (.last s) 0.0) (clamp (- now (.last s)) 0.0 0.05) (/ 1.0 60.0)))
    (set! (.last s) now)
    (set! (.pending s) false)
    (set! (.animate s)
          (and (not (.headless (host/host)))
               (not (n/msg bool
                           (n/msg (ptr i8)
                                  (n/class c"NSWorkspace")
                                  (n/sel c"sharedWorkspace")
                                  [])
                           (n/sel c"accessibilityDisplayShouldReduceMotion")
                           [])))))
  0)

(defn amount [(group i64) (slot i64) (active bool)] (-> f64)
  (let [s (state)
        target (if active 1.0 0.0)]
    (if (or (= (.levels s) (cast (ptr f64) 0))
            (< slot 0)
            (>= slot (if (= group 0) (.slots s) 24)))
        target
        (let [value (index (.levels s) (+ (if (= group 0) 0 (.slots s)) slot))
              next
                (if (.animate s) (step (load value) target (.seconds s)) target)]
          (set! value next)
          (when (!= next target) (set! (.pending s) true))
          next))))

(defn active? [] (-> bool)
  (.pending (state)))

(defn finish [] (-> i64)
  (when (active?) (host/paper_tick_interval (/ 1.0 60.0)))
  0)

;;; A shallow approach toward the viewer, centered on the original bar. The
;;; stationary footprint remains the quantitative rectangle and hover target.
(defn projected-face [(base Rect) (amount f64) (paper-depth f64)] (-> Rect)
  (let [rise (* (.hover-lift (tuning/state)) amount paper-depth)
        scale (+ 1.0 (* rise 0.01))
        width (* (.w base) scale)
        height (* (.h base) scale)]
    (rect (- (.x base) (* (- width (.w base)) 0.5))
          (- (.y base) (* (- height (.h base)) 0.5))
          width
          height)))
