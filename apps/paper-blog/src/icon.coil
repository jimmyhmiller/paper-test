(module blog.icon)
(import "paper.flow" :use *)
(import "paper.platform" :as host)
(import "blog.theme" :as t)

(defn draw [] (-> i64)
  (host/paper_begin t/BACK)
  (host/paper_light 90.0 -150.0 700.0 0.55 0.65)
  (panel (rect 8.0 8.0 496.0 496.0) 100.0 10.0 (t/paper t/INDEX))
  (panel (rect 36.0 36.0 440.0 300.0) 72.0 14.0 (t/paper t/DAILY))
  (begin-sheet)
  (move-to 65.0 286.0)
  (line-to 111.0 228.0)
  (line-to 150.0 101.0)
  (line-to 198.0 247.0)
  (line-to 243.0 269.0)
  (line-to 292.0 173.0)
  (line-to 332.0 230.0)
  (line-to 380.0 260.0)
  (line-to 447.0 236.0)
  (line-to 447.0 303.0)
  (line-to 65.0 303.0)
  (close-path)
  (finish-sheet 19.0 (t/paper t/GOLD))
  (for [i 0 3]
    (let [y (+ 370.0 (* (cast f64 i) 34.0))]
      (panel (rect 71.0 y 235.0 9.0) 3.0 19.0 (t/paper t/INK))
      (panel (rect 365.0 y 70.0 9.0) 3.0 19.0 (t/paper t/JADE))))
  0)

(defn event [(kind i64) (id i64) (x f64) (y f64)] (-> i64)
  0)

(defn main [] (-> i64)
  (host/paper_configure c"Paper Blog Icon" 512.0 512.0)
  (host/paper_run (fnptr-of draw) (fnptr-of event)))
