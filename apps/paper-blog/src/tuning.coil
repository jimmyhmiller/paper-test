(module blog.tuning)
(import "coil.primitive" :as p)

;;; One material treatment shared by every sheet in this dashboard.
(defstruct Tuning
  [(initialized bool)
   (texture-size f64)
   (texture-depth f64)
   (texture-angle f64)])

(defn state [] (-> (ptr Tuning))
  (let [s (p/alloc-static Tuning)]
    (when (not (.initialized s))
      (set! s
            (Tuning
              :initialized true
              :texture-size 1.6
              :texture-depth 1.4
              :texture-angle 0.0)))
    s))
