(module blog.tuning)
(import "coil.primitive" :as p)

;;; Shared paper treatment and hover motion for the whole dashboard.
;;; User-selected movement amount for the centered hover effect.
(const DEFAULT_HOVER_LIFT 2.5)

(defstruct Tuning
  [(initialized bool)
   (texture-size f64)
   (texture-depth f64)
   (texture-angle f64)
   (hover-lift f64)])

(defn state [] (-> (ptr Tuning))
  (let [s (p/alloc-static Tuning)]
    (when (not (.initialized s))
      (set! s
            (Tuning
              :initialized true
              :texture-size 1.6
              :texture-depth 1.4
              :texture-angle 0.0
              :hover-lift DEFAULT_HOVER_LIFT)))
    s))
