(module blog.source)
(import "coil.primitive" :as p)
(import "paper.ffi" :use [snprintf strcmp])
(import "blog.native" :as n)
(import "blog.model" :as m)
(import "blog.transport" :as transport)
(import "coil.str" :as str)
(import "coil.thread" :as thread)
(import "coil.atomic" :as atomic)
(import "coil.cancellation" :as cancellation)
(import "coil.result" :use *)

(defstruct Source
  [(data m/Dataset)
   (transfer transport/Transfer)
   (catalog (ptr i8))
   (cache (ptr i8))
   (loading bool)
   (failed bool)
   (fixture bool)
   (last-attempt i64)
   (message (ptr i8))])

(defn state [] (-> (ptr Source))
  (p/alloc-static Source))

(defn buffer [] (-> (ptr (array i8 2048)))
  (p/alloc-static (array i8 2048)))

(defn error-buffer [] (-> (ptr (array i8 256)))
  (p/alloc-static (array i8 256)))

(defn manager [] (-> (ptr i8))
  (n/msg (ptr i8) (n/class c"NSFileManager") (n/sel c"defaultManager") []))

(defn append [(base (ptr i8)) (child (ptr i8))] (-> (ptr i8))
  (n/msg (ptr i8)
         base
         (n/sel c"stringByAppendingPathComponent:")
         [(ptr i8)]
         (n/ns child)))

(defn exists? [(path (ptr i8))] (-> bool)
  (n/msg bool (manager) (n/sel c"fileExistsAtPath:") [(ptr i8)] path))

(defn make-directory [(path (ptr i8))] (-> bool)
  (let [(mut error) (n/nil)]
    (n/msg bool
           (manager)
           (n/sel c"createDirectoryAtPath:withIntermediateDirectories:attributes:error:")
           [(ptr i8) bool (ptr i8) (mut (ptr i8))]
           path
           true
           (n/nil)
           (mut error))))

(defn fail [(message (ptr i8))] (-> bool)
  (set! (.failed (state)) true)
  (set! (.message (state)) message)
  false)

(defn request [] (-> bool)
  (let [s (state) t (field s transfer) text (index (buffer) 0)]
    (if (or (.loading s) (.fixture s))
        false
        (do
          (set! (.last-attempt s) (n/now-ms))
          (cast i64 (snprintf text 2048 c"%s/.jim/dataflow/analytics.token" (n/home)))
          (let [bytes (n/read-data (n/env c"PAPER_BLOG_TOKEN_FILE" text))
                token-text (n/msg (ptr i8)
                             (n/msg (ptr i8) (n/class c"NSString") (n/sel c"alloc") [])
                             (n/sel c"initWithData:encoding:") [(ptr i8) i64] bytes 4)
                token (n/msg (ptr i8) token-text (n/sel c"stringByTrimmingCharactersInSet:")
                        [(ptr i8)] (n/msg (ptr i8) (n/class c"NSCharacterSet")
                                     (n/sel c"whitespaceAndNewlineCharacterSet") []))]
            (if (or (= token (n/nil))
                    (> (n/msg i64 bytes (n/sel c"length") []) 16384)
                    (!= (len (str/from-cstr (n/utf8 token)))
                        (n/msg i64 token (n/sel c"lengthOfBytesUsingEncoding:") [i64] 4))
                    (not (transport/valid-token? (str/from-cstr (n/utf8 token)))))
                (do (n/release token-text)
                    (fail c"Bearer token missing or invalid. Run scripts/migrate_auth.py · ⌘R to retry"))
                (do
                  (set! (.authorization t)
                    (n/retain (n/msg (ptr i8) (n/ns c"Bearer ") (n/sel c"stringByAppendingString:")
                                    [(ptr i8)] token)))
                  (n/release token-text)
                  (cast i64 (snprintf text 2048
                    c"https://computer.jimmyhmiller.com/analytics/timeline?prefix=/api/&n=all&bucket=hour&from=0&to=%lld"
                    (n/now-ms)))
                  (set! (.url t) (n/retain (n/ns text)))
                  (set! (.bytes t) (n/new c"NSMutableData"))
                  (set! (.status t) 0)
                  (set! (.error t) 0)
                  (atomic/store (field t done) 0)
                  (match (cancellation/Cancellation::init (field t cancel))
                    (Err [e]
                      (do
                        (n/release (.url t)) (n/release (.authorization t)) (n/release (.bytes t))
                        (fail c"Could not initialize request cancellation · ⌘R to retry")))
                    (Ok [cancel]
                      (if (= (thread/Thread::spawn (field t worker) (fnptr-of transport/work)
                                                  (cast (ptr i8) t)) (: 0 i32))
                          (do (set! (.loading s) true)
                              (set! (.message s) c"Refreshing from your blog…") true)
                          (do (transport/cleanup t)
                              (fail c"Could not start the data request · ⌘R to retry"))))))))))))

;;; Only publish a complete, validated snapshot. A failed refresh preserves
;;; last-good data and its original time range. Cache writes are atomic.
(defn poll [] (-> bool)
  (let [s (state)]
    (if (or (not (.loading s)) (= (atomic/read (field (field s transfer) done)) 0))
        false
        (let [t (field s transfer)
              joined (thread/Thread::join (field t worker))
              code (.error t)
              http (.status t)
              bytes (.bytes t)
              root (n/parse-data bytes)]
          (set! (.loading s) false)
          (cond (or (= http 401) (= http 403))
                  (fail c"Blog access was denied. Check your bearer token · ⌘R to retry")
                (= code 2)
                  (fail c"The blog response exceeded 16 MiB · ⌘R to retry")
                (= code 3)
                  (fail c"The blog request timed out · ⌘R to retry")
                (!= code 0)
                  (let [text (index (error-buffer) 0)]
                    (cast i64
                          (snprintf text
                                    256
                                    c"Request failed (transport %lld, HTTP %lld) · ⌘R to retry"
                                    code
                                    http))
                    (fail text))
                (or (< http 200) (>= http 300))
                  (fail c"The blog API returned an unexpected HTTP response · ⌘R to retry")
                (not (m/decode (field s data) root (.catalog s)))
                  (fail c"The blog API returned invalid or inconsistent data · ⌘R to retry")
                :else
                  (do
                    (set! (.failed s) false)
                    (set! (.message s)
                          c"Live data · updates every 5 min · ⌘R to refresh")
                    (when (!= (.cache s) (n/nil))
                      (when (not (n/msg bool
                                        bytes
                                        (n/sel c"writeToFile:atomically:")
                                        [(ptr i8) bool]
                                        (.cache s)
                                        true))
                        (set! (.message s)
                              c"Live data · could not save offline cache · ⌘R to refresh")))
                    true))
          (transport/cleanup t)
          true))))

(defn initialize [] (-> i64)
  (let [s (state)
        text (index (buffer) 0)
        bundle (n/msg (ptr i8) (n/class c"NSBundle") (n/sel c"mainBundle") [])
        resources (n/msg (ptr i8) bundle (n/sel c"resourcePath") [])
        title-path (append resources c"titles.json")]
    (set! (.catalog s) (n/retain (n/read-json (n/utf8 title-path))))
    (when (= (.catalog s) (n/nil))
      (set! (.catalog s) (n/retain (n/read-json c"resources/titles.json"))))
    (set! (.data s) (m/empty))
    (cast i64
          (snprintf text
                    2048
                    c"%s/Library/Application Support/Paper Blog"
                    (n/home)))
    (let [directory (n/ns (n/env c"PAPER_BLOG_CACHE_DIR" text))]
      (when (make-directory directory)
        (set! (.cache s) (n/retain (append directory c"timeline.json")))))
    (let [fixture (n/arg c"--fixture")]
      (if (!= fixture (n/nil))
          (do
            (set! (.fixture s) true)
            (if (let [root (n/read-json fixture)]
                  (if (= (n/integer (n/key root c"bucket_ms")) m/HOUR)
                      (m/decode (field s data) root (.catalog s))
                      (m/decode-utc (field s data) root (.catalog s))))
                (set! (.message s) c"Fixture preview · recorded page views")
                (fail c"Could not load the requested fixture")))
          (do
            (when (!= (.cache s) (n/nil))
              (m/decode (field s data)
                        (n/read-json (n/utf8 (.cache s)))
                        (.catalog s)))
            (request)))))
  0)

(defn shutdown [] (-> i64)
  (let [s (state)]
    (when (.loading s)
      (cancellation/Cancellation::request! (field (field s transfer) cancel))
      (thread/Thread::join (field (field s transfer) worker))
      (transport/cleanup (field s transfer))
      (set! (.loading s) false))
    (m/clear (field s data))
    (n/release (.catalog s))
    (n/release (.cache s)))
  0)
