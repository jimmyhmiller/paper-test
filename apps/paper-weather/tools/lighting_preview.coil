(module paper-weather.lighting-preview)
(import "paper-weather.app" :as app)
(import "paper.lighting" :as light)
(import "paper.scene" :as scene)
(import "paper.platform" :as host)
(import "paper.render" :as render)
(import "paper.workers" :as workers)
(import "paper.objc" :as o)

;;; Exercise the real event route, modal geometry and rendered lighting panel.
(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (assert (= argc (: 2 i32)))
  (let [pool (o/new c"NSAutoreleasePool")]
    (host/paper_configure c"Paper Weather" 1536.0 1024.0)
    (scene/init)
    (set! (.headless (host/host)) true)
    (set! (.width (scene/scene)) 1536)
    (set! (.height (scene/scene)) 1024)
    (set! (.scale (scene/scene)) 1.0)
    (render/setup)
    (app/event 0 0 0.0 0.0)
    (app/event 3 204 0.0 0.0)
    (assert (.open (app/lighting)))
    (app/draw)
    ;; The shared modal scope must remove all underlying app controls.
    (for [i 0 (len (.hits (scene/scene)))]
      (assert (>= (.id (get (.hits (scene/scene)) i)) 500)))
    (let [track (light/track-bounds (app/lighting) 1)]
      (app/event 1 503 (+ (.x track) (* (.w track) 0.8)) (.y track)))
    (assert (< (.depth (app/lighting)) 1.201))
    (assert (> (.depth (app/lighting)) 1.199))
    (let [track (light/track-bounds (app/lighting) 2)]
      (app/event 1 508 (+ (.x track) (.w track)) (.y track)))
    (assert (> (.paper-height (app/lighting)) 1.299))
    (app/draw)
    (assert (< (host/fabs (- (.depth (scene/scene)) 1.56)) 0.000001))
    (render/render-frame true)
    (assert (= (render/snapshot (load (index argv 1))) 0))
    (app/event 3 504 0.0 0.0)
    (light/advance-animation (app/lighting)
                             (+ (.animation-start (app/lighting)) 0.4))
    (assert (= (.depth (app/lighting)) (.default-depth (app/lighting))))
    (assert (= (.paper-height (app/lighting)) 1.0))
    (app/event 4 53 0.0 0.0)
    (assert (not (.open (app/lighting))))
    (app/event 3 500 0.0 0.0)
    (assert (.open (app/lighting)))
    (workers/stop)
    (o/release pool))
  0)
