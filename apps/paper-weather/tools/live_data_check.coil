(module paper-weather.live-data-check)
(import "paper-weather.service" :as weather)
(import "paper-weather.app" :as app)
(import "paper.platform" :as host)
(import "paper.scene" :as scene)
(import "paper.render" :as render)
(import "paper.workers" :as workers)
(import "paper.objc" :use *)
(import "paper.ffi" :use [CACurrentMediaTime strcmp])

(defn wait-for-request [(search bool)] (-> i64)
  (let [deadline (+ (CACurrentMediaTime) 35.0)]
    (while (and (< (CACurrentMediaTime) deadline)
                (if search
                    (.searching (weather/state))
                    (.loading (weather/state))))
      (msg i64
           (msg (ptr i8) (class c"NSRunLoop") (sel c"currentRunLoop") [])
           (sel c"runUntilDate:")
           [(ptr i8)]
           (msg (ptr i8)
                (class c"NSDate")
                (sel c"dateWithTimeIntervalSinceNow:")
                [f64]
                0.03))))
  0)

(defn check-place [(query (ptr i8)) (country (ptr i8))] (-> i64)
  (weather/query-changed query)
  (weather/search-now false)
  (wait-for-request true)
  (assert (not (.searching (weather/state))))
  (assert (> (weather/count (.results (weather/state))) 0))
  (let [location (weather/at (.results (weather/state)) 0)]
    (assert (= (strcmp (weather/text (weather/item location c"country_code"))
                       country)
               0))
    (weather/select-location location)
    (wait-for-request false)
    (assert (not (.loading (weather/state))))
    (assert (= (.forecast-error (weather/state)) (nil)))
    (assert (weather/ready))
    (assert (= (strcmp (weather/location-name)
                       (weather/text (weather/item location c"name")))
               0))
    (assert (weather/number? (weather/current c"temperature_2m")))
    (assert (weather/number? (weather/daily c"temperature_2m_max" 6)))
    (assert (weather/number? (weather/hourly c"temperature_2m" 7)))
    (assert (> (weather/value (weather/current c"time")) 1700000000.0)))
  0)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [pool (new c"NSAutoreleasePool")]
    (weather/init)
    (check-place c"Berlin, Germany" c"DE")
    ;; An in-flight old query must not replace the next query's results.
    (weather/query-changed c"Paris")
    (weather/search-now false)
    (check-place c"Tokyo, Japan" c"JP")
    (weather/query-changed c"zzzznotarealcityxxxxx")
    (weather/search-now false)
    (wait-for-request true)
    (assert (= (weather/count (.results (weather/state))) 0))
    (assert (= (.search-error (weather/state)) (nil)))
    (when (= argc (: 2 i32))
      (scene/init)
      (set! (.headless (host/host)) true)
      (host/paper_configure c"Paper Weather" 1536.0 1024.0)
      (set! (.width (scene/scene)) 1536)
      (set! (.height (scene/scene)) 1024)
      (set! (.scale (scene/scene)) 1.0)
      (render/setup)
      (app/event 0 0 0.0 0.0)
      (set! (.search-open (weather/state)) false)
      (app/draw)
      (render/render-frame true)
      (assert (= (render/snapshot (load (index argv 1))) 0))
      (workers/stop))
    (msg i64 (.session (weather/state)) (sel c"invalidateAndCancel") [])
    (release pool))
  0)
