(module paper-weather.data-test)
(import "paper-weather.service" :as weather)
(import "paper-weather.app" :as app)
(import "paper-weather.units" :as units)
(import "paper.platform" :as host)
(import "paper.scene" :as scene)
(import "paper.objc" :use *)
(import "paper.ffi" :use [strcmp])

(defn json [(source (ptr i8))] (-> (ptr i8))
  (weather/decode (msg (ptr i8) (ns source) (sel c"dataUsingEncoding:") [u64] 4)))

(deftest location-validation-and-missing-weather-values
  (let [pool (new c"NSAutoreleasePool")]
    (assert (weather/valid-location? (json c"{\"name\":\"Tokyo\",\"latitude\":35.68,\"longitude\":139.69}")))
    (assert (not (weather/valid-location? (json c"{\"name\":\"Invalid\",\"latitude\":120,\"longitude\":0}"))))
    (assert (not (weather/valid-location? (json c"{\"name\":\"Missing\"}"))))
    (assert (not (weather/valid-forecast? (json c"{\"error\":true,\"reason\":\"invalid\"}"))))
    (assert (not (weather/number? (weather/item (json c"{\"temperature\":null}")
                                                c"temperature"))))
    (assert (= (strcmp (weather/formatted (nil) c"°") c"—") 0))
    (assert (= (weather/at (nil) -1) (nil)))
    (release pool)))

(deftest weather-codes-distinguish-night-rain-snow-thunder-and-fog
  (assert (= (weather/icon 0 true) 0))
  (assert (= (weather/icon 0 false) 4))
  (assert (= (weather/icon 63 true) 5))
  (assert (= (weather/icon 73 false) 3))
  (assert (= (weather/icon 95 true) 6))
  (assert (= (weather/icon 45 true) 7))
  (assert (= (weather/icon -1 true) 2)))

(deftest dates-use-the-selected-place-timezone-and-hour-index-uses-current-time
  (let [pool (new c"NSAutoreleasePool")
        s (weather/state)
        root
          (json c"{\"timezone\":\"Asia/Tokyo\",\"current\":{\"time\":1704072600},\"hourly\":{\"time\":[1704067200,1704070800,1704074400,1704078000]}}")]
    (weather/owns (field s forecast) root)
    (assert (= (strcmp (weather/date-text (weather/integer 1704067200)
                                          c"h:mm a")
                       c"9:00 AM")
               0))
    (assert (= (weather/hour-index 0) 1))
    (assert (= (weather/hour-index 1) 3))
    (assert (= (weather/hour-index 7) 3))
    (weather/owns (field s forecast) (nil))
    (release pool)))

(deftest missing-hourly-reading-breaks-the-graph-without-becoming-zero
  (let [pool (new c"NSAutoreleasePool")
        s (weather/state)
        root
          (json c"{\"timezone\":\"UTC\",\"current\":{\"time\":0},\"hourly\":{\"time\":[0,3600,7200,10800,14400,18000,21600,25200,28800,32400,36000,39600,43200,46800,50400,54000],\"temperature_2m\":[10,11,12,13,14,15,null,17,18,19,20,21,22,23,24,25]}}")
        (mut ribbons) 0]
    (scene/init)
    (set! (.headless (host/host)) true)
    (host/paper_configure c"Weather graph test" 1536.0 1024.0)
    (app/event 0 0 0.0 0.0)
    (weather/owns (field s forecast) root)
    (msg i64 (.formatters s) (sel c"removeAllObjects") [])
    (assert (= (app/chart-min) 10.0))
    (assert (= (app/chart-max) 24.0))
    (host/paper_begin 0xf3ead9)
    (app/hourly)
    (for [i 0 (len (.sheets (scene/scene)))]
      (when (= (.color (get (.sheets (scene/scene)) i)) (: 0xe68d70 u32))
        (set! ribbons (+ (load ribbons) 1))))
    (assert (= (load ribbons) 2))
    (weather/owns (field s forecast) (nil))
    (msg i64 (.formatters s) (sel c"removeAllObjects") [])
    (release pool)))

(deftest user-units-convert-once-without-changing-provider-values
  (let [pool (new c"NSAutoreleasePool")
        zero (weather/integer 0)
        freezing (weather/integer -40)
        boiling (weather/integer 100)]
    (store! (units/mode) 0)
    (assert (= (weather/value (units/temperature zero)) 32.0))
    (assert (= (weather/value (units/temperature freezing)) -40.0))
    (assert (= (weather/value (units/temperature boiling)) 212.0))
    (assert (= (strcmp (units/temperature-label zero) c"32°") 0))
    (assert (= (strcmp (units/wind-label (weather/integer 16)) c"10 mph") 0))
    (assert (= (strcmp (units/temperature-label (nil)) c"—") 0))
    (assert (= (weather/value zero) 0.0))
    (store! (units/mode) 1)
    (assert (= (weather/value (units/temperature boiling)) 100.0))
    (assert (= (strcmp (units/temperature-label zero) c"0°") 0))
    (assert (= (strcmp (units/wind-label (weather/integer 16)) c"16 km/h") 0))
    (release pool)))
