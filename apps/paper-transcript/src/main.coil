(module transcript.main)
(import "coil.cc" :as cc)
(import "paper.platform" :as host)
(import "transcript.ui" :as ui)
(import "transcript.app" :as app)
(import "transcript.waveform" :as waveform)
(import "paper.masks" :as masks)

(extern getenv :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(defn main [] (-> i64)
  (host/paper_configure c"Paper Transcript" 1480.0 940.0)
  (host/paper_responsive 1120.0 760.0)
  (host/paper_unified_window true)
  ;; A benchmark is launched over and over by scripts; it must not take focus.
  (when (and (app/bench?)
             (= (getenv c"PAPER_TRANSCRIPT_BENCH_FOREGROUND")
                (cast (ptr i8) 0)))
    (host/paper_background_launch true))
  ;; PAPER_MICRO_REFERENCE shades every surface's grain in the fragment shader
  ;; and keeps no cached copy of it: the comparison the cache has to beat.
  (when (!= (getenv c"PAPER_MICRO_REFERENCE") (cast (ptr i8) 0))
    (set! (.reference (masks/micro-cache)) true))
  (host/paper_run (fnptr-of ui/draw) (fnptr-of app/event))
  (waveform/stop (waveform/state)))
