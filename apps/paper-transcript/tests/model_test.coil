(module transcript.tests.model)
(import "coil.primitive" :as primitive)
(import "coil.assert" :use *)
(import "transcript.model" :as model)

;;; A take of `count` words, each 200 ms long with an 800 ms gap after it, so
;;; every gap is long enough to carry a pill and the arithmetic stays readable.
(defn fixture [(count i64)] (-> (ptr model/Session))
  (let [s (model/session)]
    (model/reset-session s)
    (for [i 0 count]
      (let [w (model/word i)
            start (* (cast f64 i) 1000.0)]
        (set! (.t0 w) start)
        (set! (.t1 w) (+ start 200.0))
        (set! (.off w) 0)
        (set! (.len w) 1)
        (set! (.width w) 10.0)
        (set! (.gap-keep w) model/GAP-UNTOUCHED)
        (set! (.deleted w) false)
        (set! (.filler w) false)
        (set! (.para w) false)))
    (set! (.word-count s) count)
    (set! (.dur-ms s) (* (cast f64 count) 1000.0))
    (model/rebuild-clips s)
    s))

(defn clip-from [(i i64)] (-> f64)
  (.from (index (model/clips) i)))

(defn clip-to [(i i64)] (-> f64)
  (.to (index (model/clips) i)))

(deftest kept_words_are_one_run
         (let [s (fixture 5)]
           (assert-eq (.clip-count s) 1)
           (assert (primitive/fcmp-eq (clip-from 0) 0.0))
           (assert (primitive/fcmp-eq (clip-to 0) 4200.0))))

(deftest a_deleted_word_splits_the_run
         (let [s (fixture 5)]
           (set! (.deleted (model/word 2)) true)
           (model/rebuild-clips s)
           (assert-eq (.clip-count s) 2)
           (assert (primitive/fcmp-eq (clip-to 0) 1200.0))
           (assert (primitive/fcmp-eq (clip-from 1) 3000.0))))

(deftest deleting_the_edges_keeps_the_middle
         (let [s (fixture 5)]
           (set! (.deleted (model/word 0)) true)
           (set! (.deleted (model/word 4)) true)
           (model/rebuild-clips s)
           (assert-eq (.clip-count s) 1)
           (assert (primitive/fcmp-eq (clip-from 0) 1000.0))
           (assert (primitive/fcmp-eq (clip-to 0) 3200.0))))

;;; A trimmed gap removes the middle of the silence, so the kept milliseconds
;;; straddle the word boundary evenly.
(deftest trimming_a_gap_cuts_its_middle
         (let [s (fixture 3)]
           (model/set-gap-keep s 0 200.0)
           (assert-eq (.clip-count s) 2)
           (assert (primitive/fcmp-eq (clip-to 0) 300.0))
           (assert (primitive/fcmp-eq (clip-from 1) 900.0))))

(deftest a_fully_cut_gap_removes_all_of_its_silence
         (let [s (fixture 3)]
           (model/toggle-gap s 0)
           (assert (primitive/fcmp-eq (model/gap-kept s 0) 0.0))
           (assert (primitive/fcmp-eq (clip-to 0) 200.0))
           (assert (primitive/fcmp-eq (clip-from 1) 1000.0))))

(deftest tapping_a_cut_gap_restores_it
         (let [s (fixture 3)]
           (model/toggle-gap s 0)
           (model/toggle-gap s 0)
           (assert-eq (.clip-count s) 1)))

(deftest a_region_splits_the_clip_it_lands_in
         (let [s (fixture 3)]
           (set! (.sel-kind s) model/SEL-REGION)
           (set! (.ra s) 500.0)
           (set! (.rb s) 700.0)
           (model/toggle-selection s)
           (assert-eq (.clip-count s) 2)
           (assert (primitive/fcmp-eq (clip-to 0) 500.0))
           (assert (primitive/fcmp-eq (clip-from 1) 700.0))))

(deftest a_second_pass_over_a_region_restores_it
         (let [s (fixture 3)]
           (set! (.sel-kind s) model/SEL-REGION)
           (set! (.ra s) 500.0)
           (set! (.rb s) 700.0)
           (model/toggle-selection s)
           (model/toggle-selection s)
           (assert-eq (.region-count s) 0)
           (assert-eq (.clip-count s) 1)))

(deftest a_word_selection_toggles_as_one_run
         (let [s (fixture 6)]
           (set! (.sel-kind s) model/SEL-WORDS)
           (set! (.sa s) 3)
           (set! (.sb s) 1)
           (model/toggle-selection s)
           (assert-eq (model/kept-word-count s) 3)
           (model/toggle-selection s)
           (assert-eq (model/kept-word-count s) 6)))

(deftest fillers_are_cut_in_one_pass
         (let [s (fixture 4)]
           (set! (.filler (model/word 1)) true)
           (set! (.filler (model/word 3)) true)
           (assert-eq (model/remove-fillers s) 2)
           (assert-eq (model/kept-word-count s) 2)))

;;; Edited time is what playback reports; source time is what the transcript and
;;; the waveform are drawn in. The two must agree in both directions or the
;;; highlighted word drifts away from the audio.
(deftest edited_and_source_time_round_trip
         (let [s (fixture 5)]
           (set! (.deleted (model/word 2)) true)
           (model/rebuild-clips s)
           (assert (primitive/fcmp-eq (model/edited-ms s) 2400.0))
           (assert (primitive/fcmp-eq (model/edited-to-source s 0.0) 0.0))
           ;; 1200 ms of audio precedes the cut, so the next edited millisecond is the
           ;; first source millisecond after it.
           (assert (primitive/fcmp-eq (model/edited-to-source s 1200.0) 1200.0))
           (assert (primitive/fcmp-eq (model/edited-to-source s 1300.0) 3100.0))
           (assert (primitive/fcmp-eq (model/source-to-edited s 3100.0) 1300.0))))

;;; A source position inside a cut has no edited position; it must report the
;;; boundary rather than a value inside a span that no longer exists.
(deftest a_source_time_inside_a_cut_maps_to_the_seam
         (let [s (fixture 5)]
           (set! (.deleted (model/word 2)) true)
           (model/rebuild-clips s)
           (assert (primitive/fcmp-eq (model/source-to-edited s 2500.0) 1200.0))))

(deftest word_lookup_finds_the_spoken_word
         (let [s (fixture 5)]
           (assert-eq (model/word-at s 0.0) 0)
           (assert-eq (model/word-at s 2100.0) 2)
           (assert-eq (model/word-at s 99999.0) 4)))

(deftest an_untranscribed_take_is_still_one_whole_clip
         (let [s (model/session)]
           (model/reset-session s)
           (set! (.dur-ms s) 5000.0)
           (model/rebuild-clips s)
           (assert-eq (.clip-count s) 1)
           (assert (primitive/fcmp-eq (clip-to 0) 5000.0))))

(deftest nudging_a_word_edge_moves_only_that_word
         (let [s (fixture 3)]
           (set! (.sel-kind s) model/SEL-WORDS)
           (set! (.sa s) 1)
           (set! (.sb s) 1)
           (set! (.cur-ms s) 1400.0)
           (assert-eq (model/nudge-word-edge s false) 1)
           (assert (primitive/fcmp-eq (.t1 (model/word 1)) 1400.0))
           (assert (primitive/fcmp-eq (.t1 (model/word 0)) 200.0))))
