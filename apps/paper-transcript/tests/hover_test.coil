(module transcript.tests.hover)
(import "coil.assert" :use *)
(import "paper.scene" :as scene)
(import "coil.arraylist" :as al)
(import "paper.platform" :as host)
(import "transcript.ui" :as ui)
(import "transcript.model" :as model)

(deftest controls_can_be_hovered_in_the_composed_scene
         (scene/init)
         (host/paper_configure c"Paper Transcript" 1480.0 940.0)
         (model/reset-session (model/session))
         (ui/draw)
         (let [(mut found) false
               (mut x) 0.0
               (mut y) 0.0]
           (for [i 0 (al/al-len [scene/Hit] (.hits (scene/scene)))]
             (let [hit (al/al-get [scene/Hit] (.hits (scene/scene)) i)]
               (when (= (.id hit) ui/ID-PLAY)
                 (set! found true)
                 (set! x (+ (.x (.bounds hit)) (* 0.5 (.w (.bounds hit)))))
                 (set! y (+ (.y (.bounds hit)) (* 0.5 (.h (.bounds hit))))))))
           (assert (load found))
           (assert-eq (host/hit-test (load x) (load y)) ui/ID-PLAY)
           (host/update-hover (load x) (load y))
           (assert (host/paper_hovered ui/ID-PLAY))
           (ui/draw)
           (assert (host/paper_hovered ui/ID-PLAY))
           (host/update-hover -1.0 -1.0)
           (assert (not (host/paper_hovered ui/ID-PLAY)))))
