(module folio.native)
(import "folio.objc" :use * :reexport)
(import "coil.primitive" :as p)

(defstruct Point [(x f64) (y f64)])

(defstruct Size [(w f64) (h f64)])

(defstruct Rect [(x f64) (y f64) (w f64) (h f64)])

(defstruct Range [(location u64) (length u64)])

(extern objc_allocateClassPair :cc c [(ptr i8) (ptr i8) u64] (-> (ptr i8)))

(extern objc_registerClassPair :cc c [(ptr i8)] (-> void))

(extern class_addMethod :cc c [(ptr i8) (ptr i8) (ptr i8) (ptr i8)] (-> bool))

(extern class_addProtocol :cc c [(ptr i8) (ptr i8)] (-> i8))

(extern objc_getProtocol :cc c [(ptr i8)] (-> (ptr i8)))

(extern objc_setAssociatedObject :cc c [(ptr i8) (ptr i8) (ptr i8) u64] (-> void))

(extern objc_getAssociatedObject :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))

(extern strlen :cc c [(ptr i8)] (-> u64))

(extern strcmp :cc c [(ptr i8) (ptr i8)] (-> i32))

(extern printf :cc c [(ptr i8) ...] (-> i32))

(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))

(extern setenv :cc c [(ptr i8) (ptr i8) i32] (-> i32))

(extern NSTemporaryDirectory :cc c [] (-> (ptr i8)))

(defn nil [] (-> (ptr i8))
  (p/cast (ptr i8) 0))

(defn ns [(s (ptr i8))] (-> (ptr i8))
  (msg (ptr i8) (class c"NSString") (sel c"stringWithUTF8String:") [(ptr i8)] s))

(defn utf8 [(s (ptr i8))] (-> (ptr i8))
  (msg (ptr i8) s (sel c"UTF8String") []))

(defn new [(name (ptr i8))] (-> (ptr i8))
  (msg (ptr i8) (msg (ptr i8) (class name) (sel c"alloc") []) (sel c"init") []))

(defn release [(obj (ptr i8))] (-> i64)
  (msg i64 obj (sel c"release") []))

(defn rect [(x f64) (y f64) (w f64) (h f64)] (-> Rect)
  (Rect
    :x x
    :y y
    :w w
    :h h))

(defn frame! [(view (ptr i8)) (r Rect)] (-> i64)
  (msg i64 view (sel c"setFrame:") [Rect] r))

(defn method! [(cls (ptr i8)) (name (ptr i8)) (fn (ptr i8)) (encoding (ptr i8))] (-> bool)
  (class_addMethod cls (sel name) fn encoding))
