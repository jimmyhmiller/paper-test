(module folio.snapshot)
(import "paper.platform" :as host)
(import "paper.scene" :as scene)
(import "paper.render" :as render)
(import "paper.objc" :as o)
(import "paper.geometry" :use [Rect])
(import "coil.primitive" :as p)

;;; Export our own two render buffers. Ghostty presents its completed Metal frame
;;; through an IOSurface-backed CALayer. This reads that published frame, not the
;;; desktop, and never reconstructs terminal text or requests screen recording.
(extern IOSurfaceGetWidth :cc c [(ptr i8)] (-> u64))

(extern IOSurfaceGetHeight :cc c [(ptr i8)] (-> u64))

(extern IOSurfaceGetBytesPerRow :cc c [(ptr i8)] (-> u64))

(extern IOSurfaceGetBaseAddress :cc c [(ptr i8)] (-> (ptr i8)))

(extern IOSurfaceLock :cc c [(ptr i8) u32 (ptr u32)] (-> i32))

(extern IOSurfaceUnlock :cc c [(ptr i8) u32 (ptr u32)] (-> i32))

(extern CGContextDrawImage :cc c [(ptr i8) host/CGRect (ptr i8)] (-> void))

(defstruct FrameSample [(signature i64) (premultiplication-errors i64)])

(defn sample [(view (ptr i8))] (-> FrameSample)
  ; Inspect the actual published BGRA frame, not the generated shader source.
  (let [layer (o/msg (ptr i8) view (o/sel c"layer") [])
        surface (o/retain (o/msg (ptr i8) layer (o/sel c"contents") []))
        (mut signature) 0
        (mut errors) 0]
    (assert (!= surface (o/nil)))
    (assert (= (IOSurfaceLock surface 1 (cast (ptr u32) 0)) (cast i32 0)))
    (let [bytes (cast (ptr u8) (IOSurfaceGetBaseAddress surface))
          stride (cast i64 (IOSurfaceGetBytesPerRow surface))]
      (for [y 0 (cast i64 (IOSurfaceGetHeight surface))]
        (for [x 0 (cast i64 (IOSurfaceGetWidth surface))]
          (let [offset (+ (* y stride) (* x 4))
                b (cast i64 (load (p/index bytes offset)))
                g (cast i64 (load (p/index bytes (+ offset 1))))
                r (cast i64 (load (p/index bytes (+ offset 2))))
                a (cast i64 (load (p/index bytes (+ offset 3))))]
            (set! signature (+ (load signature) (* (+ (+ b (* g 3)) (+ (* r 7) (* a 11))) (+ 1 (% x 251)))))
            (when (or (> r (+ a 1)) (> g (+ a 1)) (> b (+ a 1)))
              (set! errors (+ (load errors) 1)))))))
    (assert (= (IOSurfaceUnlock surface 1 (cast (ptr u32) 0)) (cast i32 0)))
    (o/release surface)
    (FrameSample :signature (load signature) :premultiplication-errors (load errors))))

(defn write [(view (ptr i8)) (bounds Rect) (path (ptr i8))] (-> i64)
  (let [layer (o/msg (ptr i8) view (o/sel c"layer") [])
        surface (o/retain (o/msg (ptr i8) layer (o/sel c"contents") []))]
    (assert (!= surface (o/nil)))
    (assert (= (IOSurfaceLock surface 1 (cast (ptr u32) 0)) (cast i32 0)))
    (let [cs (host/CGColorSpaceCreateDeviceRGB)
          bitmap
            (host/CGBitmapContextCreate (IOSurfaceGetBaseAddress surface)
                                        (IOSurfaceGetWidth surface)
                                        (IOSurfaceGetHeight surface)
                                        8
                                        (IOSurfaceGetBytesPerRow surface)
                                        cs
                                        0x2002)]
      (assert (!= bitmap (o/nil)))
      (let [image (host/CGBitmapContextCreateImage bitmap)
            output (.output-context (scene/scene))]
        (render/render-frame true)
        (host/CGContextSaveGState output)
        (host/CGContextTranslateCTM output (.x bounds) (+ (.y bounds) (.h bounds)))
        (host/CGContextScaleCTM output 1.0 -1.0)
        (CGContextDrawImage output (host/cgrect 0.0 0.0 (.w bounds) (.h bounds)) image)
        (host/CGContextRestoreGState output)
        (assert (= (render/snapshot path) 0))
        (host/CGImageRelease image))
      (host/CGContextRelease bitmap)
      (host/CGColorSpaceRelease cs))
    (assert (= (IOSurfaceUnlock surface 1 (cast (ptr u32) 0)) (cast i32 0)))
    (o/release surface))
  0)
