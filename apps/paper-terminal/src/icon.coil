(module folio.icon)
(import "paper.flow" :use *)
(import "paper.platform" :as host)
(import "paper.scene" :as scene)
(import "paper.render" :as render)
(import "paper.objc" :as o)
(import "paper.workers" :as workers)

(extern CGContextClearRect :cc c [(ptr i8) host/CGRect] (-> void))

(defn main [] (-> i64)
  (let [pool (o/new c"NSAutoreleasePool")]
    (scene/init)
    (set! (.width (scene/scene)) 1024)
    (set! (.height (scene/scene)) 1024)
    (set! (.scale (scene/scene)) 1.0)
    (render/setup)
    (host/paper_begin 0x354235)
    (host/paper_light -100.0 -200.0 1000.0 1.0 0.6)
    (panel (rect 173.0 245.0 690.0 590.0) 66.0 8.0 (cotton 0x929d7b))
    (panel (rect 160.0 230.0 690.0 590.0) 66.0 16.0 (cotton 0xbdc7a5))
    (panel (rect 160.0 185.0 275.0 100.0) 30.0 25.0 (ochre))
    (panel (rect 148.0 220.0 690.0 590.0) 66.0 28.0 (cream))
    (recess (rect 196.0 288.0 594.0 454.0) 32.0 30.0 8.0 5.0 (sage) (cotton 0xe9dfc6))
    (ink-height 30.0)
    (caption (rect 260.0 365.0 250.0 260.0) 180.0 0x384934 2 c"›")
    (panel (rect 510.0 414.0 92.0 153.0) 3.0 36.0 (ochre))
    (begin-sheet)
    (move-to 577.0 414.0)
    (line-to 602.0 439.0)
    (line-to 577.0 439.0)
    (close-path)
    (finish-sheet 41.0 (cream))
    (render/render)
    (let [ctx (.output-context (scene/scene))]
      (host/CGContextSaveGState ctx)
      (begin-sheet)
      (rounded-path (rect 0.0 0.0 1024.0 1024.0) 0.0)
      (rounded-path (rect 32.0 32.0 960.0 960.0) 206.0)
      (host/CGContextAddPath ctx (.path (scene/scene)))
      (host/CGContextEOClip ctx)
      (CGContextClearRect ctx (host/cgrect 0.0 0.0 1024.0 1024.0))
      (host/CGContextRestoreGState ctx))
    (assert (= (render/snapshot c"build/icon.png") 0))
    (workers/stop)
    (o/release pool))
  0)
