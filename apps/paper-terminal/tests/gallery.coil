(module folio.gallery)
(import "folio.main" :as app)
(import "folio.integration" :as integration)
(import "folio.terminal" :as terminal)
(import "folio.native" :as n)
(import "folio.ghostty" :as g)
(import "folio.snapshot" :as snapshot)
(import "paper.platform" :as host)
(import "paper.objc" :as o)

(defn main [] (-> i64)
  (let [pool (o/new c"NSAutoreleasePool")]
    (app/initialize true)
    (let [first (app/current)]
      (integration/send first
                        c"printf '\\033[2J\\033[H\\033]2;Field notes\\007'; printf '\\n  \\033[1;32mPAPER / FIELD NOTES\\033[0m\\n\\n  A real shell. A little room to think.\\n\\n'; printf '  \\033[33m●\\033[0m  Ghostty handles the terminal.\\n  \\033[34m●\\033[0m  Coil lays out the paper.\\n  \\033[35m●\\033[0m  Your commands stay yours.\\n\\n'; printf '  Unicode   café · λ · 日本語\\n\\n'; printf '  \\033[7m SELECTABLE TEXT \\033[0m    24-bit \\033[38;2;176;94;65mcolor\\033[0m\\n\\n'; printf '  Ready%s\\n\\n' '.'\n")
      (integration/until-text first c"Ready.")
      (assert (app/new-tab c"/bin/sh -i"))
      (integration/send (app/current)
                        c"printf '\\033]2;Workshop\\007'; printf '%s %s\\n' SECOND SESSION\n")
      (integration/until-text (app/current) c"SECOND SESSION")
      (assert (app/new-tab c"/bin/sh -i"))
      (integration/send (app/current)
                        c"printf '\\033]2;Scratch paper\\007'; printf '%s %s\\n' THIRD SESSION\n")
      (integration/until-text (app/current) c"THIRD SESSION")
      (app/focus-tab 0)
      (integration/settle)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal.png")
      ; Exercise the in-app Material Lab and its live GPU uniform path.
      (app/event 3 4 0.0 0.0)
      (app/refresh)
      (let [lab (.lab-bounds (app/app))]
        (app/event 3 201 (+ (+ (.x lab) 20.0) (* (- (.w lab) 40.0) 0.75)) 0.0))
      (integration/settle)
      (assert (> (.text-relief (app/app)) 0.999))
      (app/event 3 207 0.0 0.0)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-material-lab.png")
      (app/event 3 208 0.0 0.0)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-carved.png")
      (app/event 3 210 0.0 0.0)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-light.png")
      (let [before (snapshot/sample (.view first))
            map (app/light-map-bounds (.lab-bounds (app/app)))]
        (app/event 2
                   211
                   (+ (.x map) (* (.w map) 0.9))
                   (+ (.y map) (* (.h map) 0.9)))
        (integration/until-frame-changes (.view first) (.signature before)))
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-light-opposite.png")
      (let [before (snapshot/sample (.view first))
            track (app/light-height-track (.lab-bounds (app/app)))]
        (app/event 2 212 (+ (.x track) (* (.w track) 0.25)) (.y track))
        (integration/until-frame-changes (.view first) (.signature before)))
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-light-low.png")
      (app/event 3 213 0.0 0.0)
      (app/event 3 209 0.0 0.0)
      (integration/settle)
      (app/event 3 299 0.0 0.0)
      (o/msg i64
             (.window (host/host))
             (o/sel c"setContentSize:")
             [host/CGSize]
             (host/CGSize :w 780.0 :h 560.0))
      (integration/settle)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-small.png")
      (app/event 3 4 0.0 0.0)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-small-lab.png")
      (app/event 3 210 0.0 0.0)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-small-light.png")
      ; Larger actual Ghostty glyphs make the cut topology reviewable without
      ; manufacturing a mockup or substituting another text renderer.
      (app/event 3 299 0.0 0.0)
      (o/msg i64
             (.window (host/host))
             (o/sel c"setContentSize:")
             [host/CGSize]
             (host/CGSize :w 1100.0 :h 760.0))
      (integration/settle)
      (assert (g/ghostty_surface_binding_action (.surface first)
                                                c"set_font_size:26"
                                                16))
      (integration/send first
                        c"printf '\\033[2J\\033[H\\n  \\033[1mPaper, cut & folded.\\033[0m\\n\\n  1234  /  café  /  日本語\\n\\n  A little room to think.\\n\\n'; printf '%s\\n' '  Colour is still colour:'; printf '  \\033[31mClay\\033[0m  \\033[32mSage\\033[0m  \\033[34mBlue\\033[0m\\n\\n'\n")
      (integration/until-text first c"Colour is still colour:")
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-carved-study.png")
      (app/event 3 207 0.0 0.0)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-raised-study.png")
      ; Compare the separate paper layer at real reading sizes. Gap and
      ; thickness are independently exercised through the visible controls.
      (app/event 3 214 0.0 0.0)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-cut-paper-26.png")
      (app/event 3 225 0.0 0.0)
      (set! (.light-x (app/app)) 260.0)
      (set! (.light-y (app/app)) 270.0)
      (set! (.light-height (app/app)) 450.0)
      (app/apply-material)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-coated.png")
      (app/event 3 213 0.0 0.0)
      (app/event 3 224 0.0 0.0)
      (assert (g/ghostty_surface_binding_action (.surface first)
                                                c"set_font_size:16"
                                                16))
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-cut-paper-16.png")
      (assert (g/ghostty_surface_binding_action (.surface first)
                                                c"set_font_size:12"
                                                16))
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-cut-paper-12.png")
      (app/event 3 4 0.0 0.0)
      (app/event 3 209 0.0 0.0)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-cut-paper-lab.png")
      (let [track (app/material-track (.lab-bounds (app/app)) 1)
            before (snapshot/sample (.view first))]
        (app/event 3 201 (.x track) (.y track))
        (integration/until-frame-changes (.view first) (.signature before)))
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-cut-paper-contact.png")
      (let [track (app/material-track (.lab-bounds (app/app)) 1)
            before (snapshot/sample (.view first))]
        (app/event 3 201 (+ (.x track) (* (.w track) 0.75)) (.y track))
        (integration/until-frame-changes (.view first) (.signature before)))
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-cut-paper-gap.png")
      (app/event 3 215 0.0 0.0)
      (app/event 3 225 0.0 0.0)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-finish.png")
      (app/event 3 299 0.0 0.0)
      (assert (g/ghostty_surface_binding_action (.surface first)
                                                c"set_font_size:20"
                                                16))
      (integration/send first
                        c"printf '\\033[2J\\033[H\\n  SURFACE STUDY\\n\\n  \\033[48;2;194;184;160m  LIGHT STOCK  \\033[0m  \\033[48;2;100;110;87m\\033[97m  DEEP STOCK  \\033[0m\\n\\n  Different pigments, different depths.\\n\\n'\n")
      (integration/until-text first c"Different pigments, different depths.")
      (set! (.background-depth (app/app)) 3.0)
      (app/apply-material)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-background-depths.png")
      (assert (g/ghostty_surface_binding_action (.surface first)
                                                c"select_all"
                                                10))
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-selection-depth.png")
      (app/event 3 500 0.0 0.0)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first)
                      (.terminal-bounds (app/app))
                      c"build/paper-terminal-shared-light.png"))
    (app/shutdown)
    (o/release pool))
  0)
