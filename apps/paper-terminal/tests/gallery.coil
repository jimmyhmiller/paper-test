(module folio.gallery)
(import "folio.main" :as app)
(import "folio.integration" :as integration)
(import "folio.terminal" :as terminal)
(import "folio.native" :as n)
(import "folio.ghostty" :as g)
(import "folio.snapshot" :as snapshot)
(import "paper.platform" :as host)
(import "paper.objc" :as o)

(defn main [] (-> i64)
  (let [pool (o/new c"NSAutoreleasePool")]
    (app/initialize true)
    (let [first (app/current)]
      (integration/send first
                        c"printf '\\033[2J\\033[H\\033]2;Field notes\\007'; printf '\\n  \\033[1;32mPAPER / FIELD NOTES\\033[0m\\n\\n  A real shell. A little room to think.\\n\\n'; printf '  \\033[33m●\\033[0m  Ghostty handles the terminal.\\n  \\033[34m●\\033[0m  Coil lays out the paper.\\n  \\033[35m●\\033[0m  Your commands stay yours.\\n\\n'; printf '  Unicode   café · λ · 日本語\\n\\n'; printf '  \\033[7m SELECTABLE TEXT \\033[0m    24-bit \\033[38;2;176;94;65mcolor\\033[0m\\n\\n'; printf '  Ready%s\\n\\n' '.'\n")
      (integration/until-text first c"Ready.")
      (assert (app/new-tab c"/bin/sh -i"))
      (integration/send (app/current) c"printf '\\033]2;Workshop\\007'; printf '%s %s\\n' SECOND SESSION\n")
      (integration/until-text (app/current) c"SECOND SESSION")
      (assert (app/new-tab c"/bin/sh -i"))
      (integration/send (app/current) c"printf '\\033]2;Scratch paper\\007'; printf '%s %s\\n' THIRD SESSION\n")
      (integration/until-text (app/current) c"THIRD SESSION")
      (app/focus-tab 0)
      (integration/settle)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first) (.terminal-bounds (app/app)) c"build/paper-terminal.png")
      ; Exercise the in-app Material Lab and its live Ghostty configuration path.
      (app/event 3 4 0.0 0.0)
      (app/refresh)
      (let [lab (.lab-bounds (app/app))]
        (app/event 3 201 (+ (+ (.x lab) 20.0) (* (- (.w lab) 40.0) 0.75)) 0.0))
      (integration/settle)
      (let [generated
              (o/msg (ptr i8)
                     (o/class c"NSString")
                     (o/sel c"stringWithContentsOfFile:encoding:error:")
                     [(ptr i8) u64 (ptr i8)]
                     (o/msg (ptr i8)
                            (.material-directory (app/app))
                            (o/sel c"stringByAppendingPathComponent:")
                            [(ptr i8)]
                            (o/ns (if (= (.material-slot (app/app)) 0)
                                      c"paper-terminal-material-a.glsl"
                                      c"paper-terminal-material-b.glsl")))
                     (cast u64 4)
                     (o/nil))]
        (assert (o/msg bool generated (o/sel c"containsString:") [(ptr i8)] (o/ns c"TEXT_RELIEF = 1.0000;"))))
      (app/event 3 207 0.0 0.0)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first) (.terminal-bounds (app/app)) c"build/paper-terminal-material-lab.png")
      (app/event 3 208 0.0 0.0)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first) (.terminal-bounds (app/app)) c"build/paper-terminal-carved.png")
      (app/event 3 210 0.0 0.0)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first) (.terminal-bounds (app/app)) c"build/paper-terminal-light.png")
      (let [before (snapshot/sample (.view first))
            map (app/light-map-bounds (.lab-bounds (app/app)))]
        (app/event 2 211 (+ (.x map) (* (.w map) 0.9)) (+ (.y map) (* (.h map) 0.9)))
        (integration/until-frame-changes (.view first) (.signature before)))
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first) (.terminal-bounds (app/app)) c"build/paper-terminal-light-opposite.png")
      (let [before (snapshot/sample (.view first))
            track (app/light-height-track (.lab-bounds (app/app)))]
        (app/event 2 212 (+ (.x track) (* (.w track) 0.25)) (.y track))
        (integration/until-frame-changes (.view first) (.signature before)))
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first) (.terminal-bounds (app/app)) c"build/paper-terminal-light-low.png")
      (app/event 3 213 0.0 0.0)
      (app/event 3 209 0.0 0.0)
      (integration/settle)
      (app/event 3 299 0.0 0.0)
      (o/msg i64 (.window (host/host)) (o/sel c"setContentSize:") [host/CGSize] (host/CGSize :w 780.0 :h 560.0))
      (integration/settle)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first) (.terminal-bounds (app/app)) c"build/paper-terminal-small.png")
      (app/event 3 4 0.0 0.0)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first) (.terminal-bounds (app/app)) c"build/paper-terminal-small-lab.png")
      (app/event 3 210 0.0 0.0)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first) (.terminal-bounds (app/app)) c"build/paper-terminal-small-light.png")
      ; Larger actual Ghostty glyphs make the cut topology reviewable without
      ; manufacturing a mockup or substituting another text renderer.
      (app/event 3 299 0.0 0.0)
      (o/msg i64 (.window (host/host)) (o/sel c"setContentSize:") [host/CGSize] (host/CGSize :w 1100.0 :h 760.0))
      (integration/settle)
      (assert (g/ghostty_surface_binding_action (.surface first) c"set_font_size:26" 16))
      (integration/send first
                        c"printf '\\033[2J\\033[H\\n  \\033[1mPaper, cut & folded.\\033[0m\\n\\n  1234  /  café  /  日本語\\n\\n  A little room to think.\\n\\n'; printf '%s\\n' '  Colour is still colour:'; printf '  \\033[31mClay\\033[0m  \\033[32mSage\\033[0m  \\033[34mBlue\\033[0m\\n\\n'\n")
      (integration/until-text first c"Colour is still colour:")
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first) (.terminal-bounds (app/app)) c"build/paper-terminal-carved-study.png")
      (app/event 3 207 0.0 0.0)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first) (.terminal-bounds (app/app)) c"build/paper-terminal-raised-study.png")
      (app/event 3 500 0.0 0.0)
      (app/refresh)
      (integration/settle)
      (snapshot/write (.view first) (.terminal-bounds (app/app)) c"build/paper-terminal-shared-light.png"))
    (app/shutdown)
    (o/release pool))
  0)
