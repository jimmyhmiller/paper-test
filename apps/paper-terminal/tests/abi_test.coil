(module folio.abi-test)
(import "folio.ghostty" :as g)

(deftest coil-records-match-pinned-c-abi
  (assert (= (sizeof g/SurfaceConfig) 88))
  (assert (= (sizeof g/Key) 32))
  (assert (= (sizeof g/Runtime) 64))
  (assert (= (sizeof g/Target) 16))
  (assert (= (sizeof g/Action) 32))
  (assert (= (sizeof g/SurfaceSize) 20))
  (assert (= (sizeof g/PaperMaterial) 80)))
