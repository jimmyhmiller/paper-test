(module folio.model-test)
(import "folio.model" :use *)

(deftest closing-preserves-active-session-and-chooses-neighbor
         (assert-eq (after-close 2 0 4) 1)
         (assert-eq (after-close 1 3 4) 1)
         (assert-eq (after-close 1 1 4) 1)
         (assert-eq (after-close 3 3 4) 2)
         (assert-eq (after-close 0 0 1) -1))

(deftest navigation-wraps-and-pages-keep-active-tab-visible
         (assert-eq (adjacent 0 -1 4) 3)
         (assert-eq (adjacent 3 1 4) 0)
         (assert-eq (page-start 12 5) 10))
