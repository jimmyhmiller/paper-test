+// Uncorrected atlas coverage is geometric coverage. The normal text pass
+// applies foreground-dependent contrast correction for ink, which must not
+// alter the thickness of a cut-paper silhouette or its cast shadow.
+fragment float4 paper_glyph_fragment(
+  CellTextVertexOut in [[stage_in]],
+  texture2d<float> textureGrayscale [[texture(0)]],
+  texture2d<float> textureColor [[texture(1)]],
+  constant Uniforms& uniforms [[buffer(1)]]
+) {
+  if (!in.paper_eligible) return float4(0.0);
+  constexpr sampler atlasSampler(coord::pixel, address::clamp_to_edge, filter::nearest);
+  float a = textureGrayscale.sample(atlasSampler, in.tex_coord).r;
+  float4 color = in.color;
+  if (!uniforms.use_linear_blending && color.a > 0.0) {
+    color.rgb /= color.a;
+    color = unlinearize(color);
+    color.rgb *= color.a;
+  }
+  return color * a;
+}
