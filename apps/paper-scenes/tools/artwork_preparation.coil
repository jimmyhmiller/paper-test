(module paper-scenes.artwork-preparation)
(import "paper-scenes.ukiyo" :as ukiyo)
(import "paper.scene" :as scene)
(import "paper.objc" :as o)
(import "paper.ffi" :use [CACurrentMediaTime])

(extern printf :cc c [(ptr i8) ...] (-> i32))

;;; Measure first construction of canonical artwork in dependency order.
;;; Earlier rows prepare shared dependencies; the final row measures remaining
;;; scene construction after those caches are populated. No GPU or fps claim.
(defn main [] (-> i64)
  (let [pool (o/new c"NSAutoreleasePool")
        labels [c"clouds" c"mountain" c"ridge-stock" c"ridge-grain" c"panes"
                c"navy-wraps" c"red-folds" c"navy-creases" c"navy-grain" c"surf" c"remaining-scene"]]
    (scene/init)
    (set! (.width (scene/scene)) 2560) (set! (.height (scene/scene)) 1680)
    (set! (.scale (scene/scene)) 2.0)
    (printf c"stage,first_construction_ms\n")
    (for [stage 0 11]
      (let [start (CACurrentMediaTime)]
        (case stage
          0 (for [i 0 8] (ukiyo/cloud-path i))
          1 (for [i 0 3] (ukiyo/mountain-path i))
          2 (for [i 0 2] (ukiyo/ridge-path i))
          3 (for [i 0 2] (ukiyo/ridge-grain i))
          4 (for [i 0 4] (for [layer 0 4] (ukiyo/pane-path i layer)))
          5 (for [i 0 4] (for [layer 0 2] (ukiyo/pane-backing i layer)))
          6 (for [i 0 8] (ukiyo/fold-path i))
          7 (for [i 0 6] (ukiyo/navy-crease-path i))
          8 (for [i 0 2] (ukiyo/navy-grain i))
          9 (for [i 0 6] (ukiyo/wave-asset i))
          (ukiyo/draw 1280.0 840.0 0.0 0 false))
        (printf c"%s,%.4f\n" (get labels stage) (* 1000.0 (- (CACurrentMediaTime) start)))))
    (o/release pool))
  0)
