(module paper-scenes.stage-benchmark)
(import "paper-scenes.workload" :use [setting draw-case])
(import "paper.scene" :as scene)
(import "paper.render" :as render)
(import "paper.gpu" :as gpu)
(import "paper.masks" :as masks)
(import "paper.damage" :as damage)
(import "paper.platform" :as host)
(import "paper.workers" :as workers)
(import "paper.objc" :as o)
(import "paper.ffi" :use [CACurrentMediaTime])

(extern printf :cc c [(ptr i8) ...] (-> i32))

(extern fflush :cc c [(ptr i8)] (-> i32))

(defn drain-stage [] (-> f64)
  (if (= (.command (gpu/gpu)) (o/nil))
      0.0
      (do (gpu/synchronize) (.gpu-ms (gpu/gpu)))))

;;; Diagnostic only: split command buffers and wait between stages. These waits
;;; change scheduling, so this tool cannot establish native presentation cadence.
;;; Never reuse the previous command's GPU time for an empty stage.
(defn main [] (-> i64)
  (let [pool (o/new c"NSAutoreleasePool")
        theme (setting c"PAPER_BENCH_THEME" 5)
        frames (setting c"PAPER_BENCH_FRAMES" 300)]
    (assert (and (>= theme 0) (< theme 8) (> frames 0)))
    (scene/init)
    (set! (.headless (host/host)) true)
    (set! (.width (scene/scene)) (setting c"PAPER_BENCH_WIDTH" 2560))
    (set! (.height (scene/scene)) (setting c"PAPER_BENCH_HEIGHT" 1680))
    (render/setup)
    (assert (.available (gpu/gpu)))
    (printf c"theme,scenario,frame,scene_ms,compose_cpu_ms,compose_gpu_ms,prepare_light_cpu_ms,prepare_light_gpu_ms,regions,composed_pixels,micro_pixels\n")
    (for [scenario 0 3]
      (for [frame 0 frames]
        (let [frame-pool (o/new c"NSAutoreleasePool")
              start (CACurrentMediaTime)]
          (draw-case theme scenario frame 4)
          (let [built (CACurrentMediaTime)]
            (store! (masks/last-composed-area) 0.0)
            (set! (.prepared-pixels (masks/micro-cache)) 0)
            (render/rasterize-frame false)
            (let [composed (CACurrentMediaTime)
                  compose-gpu (drain-stage)
                  lit-start (CACurrentMediaTime)]
              (render/render-frame false)
              (let [lit (CACurrentMediaTime)
                    light-gpu (drain-stage)]
                (printf c"%lld,%lld,%lld,%.4f,%.4f,%.4f,%.4f,%.4f,%lld,%.0f,%lld\n"
                        theme
                        scenario
                        frame
                        (* 1000.0 (- built start))
                        (* 1000.0 (- composed built))
                        compose-gpu
                        (* 1000.0 (- lit lit-start))
                        light-gpu
                        (.region-count (damage/cache))
                        (load (masks/last-composed-area))
                        (.prepared-pixels (masks/micro-cache))))))
          (o/release frame-pool)))
      (fflush (o/nil)))
    (workers/stop)
    (o/release pool))
  0)
