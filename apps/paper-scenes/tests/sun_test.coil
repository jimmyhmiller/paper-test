(module paper-scenes.sun-test)
(import "paper-scenes.gallery" :as gallery)
(import "paper-scenes.ukiyo" :as ukiyo)
(import "paper.scene" :as scene)
(import "paper.platform" :as host)
(import "paper.lighting" :as light)
(import "paper.objc" :as o)
(import "paper.geometry" :use [rect])
(import "paper.render" :as render)
(import "paper.ffi" :use [CGBitmapContextGetData])
(extern printf :cc c [(ptr i8) ...] (-> i32))
(extern fflush :cc c [(ptr i8)] (-> i32))

(deftest sun-creases-reach-the-rendered-height-field
  (let [pool (o/new c"NSAutoreleasePool")]
    (scene/init) (scene/clear 0xffffff)
    ; Inspect at 3x canonical scale, near the gallery screenshot density. The
    ; narrow crest is subpixel at 1x and the CPU height field is only 8-bit.
    (set! (.width (scene/scene)) 2304) (set! (.height (scene/scene)) 384)
    (set! (.scale (scene/scene)) 1.0)
    (set! (.sx (ukiyo/canvas)) 3.0) (set! (.sy (ukiyo/canvas)) 3.0)
    (render/setup)
    (ukiyo/path-stock (ukiyo/sun-path) 17.0 0xad3e2d 0.62)
    (render/rasterize)
    (let [data (CGBitmapContextGetData (.height-context (scene/scene)))
          baseline (render/height-at data 1746 120 2304 384)
          (mut raised) 0 (mut flat) 0]
      (assert (and (> baseline 16.8) (< baseline 17.2)))
      (ukiyo/sun-relief)
      (render/rasterize)
      (for [y 45 234]
        (for [x 1650 1836]
          (let [height (render/height-at data x y 2304 384) difference (- height baseline)]
            (when (> difference 0.3) (set! raised (+ (load raised) 1)))
            (when (< (* difference difference) 0.000000001)
              (set! flat (+ (load flat) 1))))))
      (printf c"sun baseline %.6f raised %lld flat %lld\n" baseline (load raised) (load flat))
      (fflush (cast (ptr i8) 0))
      (assert (> (load raised) 270))
      (assert (> (load flat) 13500)))
    (scene/clear 0xffffff) (o/release pool)))

(deftest red-sun-is-the-shaped-lighting-launcher-and-opens-anchored-popover
  (let [pool (o/new c"NSAutoreleasePool") state (gallery/state)]
    (scene/init)
    (set! (.width (scene/scene)) 1536) (set! (.height (scene/scene)) 1024)
    (set! (.scale (scene/scene)) 2.0)
    (set! (.theme state) 5) (set! (.density state) 4)
    (set! (.lighting state) (light/lighting 0.2 -0.3 700.0 0.45 0.8))
    (gallery/compose 5 768.0 512.0 4 0.0 0 false)
    (let [sun (get (.hits (scene/scene)) 0)]
      (assert (= (.id sun) 500)) (assert (= (.role sun) 0)))
    (assert (= (host/hit-test 582.0 46.0) 500))
    ; Foreground cloud stock occludes this part of the circular sun.
    (assert (!= (host/hit-test 605.0 56.0) 500))
    (assert (!= (host/hit-test 547.0 11.0) 500))
    (assert (!= (host/hit-test 665.0 146.0) 500))
    (gallery/event 3 500 582.0 46.0)
    (assert (.open (.lighting state)))
    (light/apply-light (field state lighting) (rect 0.0 0.0 768.0 512.0))
    (light/popover-panel (field state lighting) 500 (ukiyo/sun-bounds 768.0 512.0))
    (let [bounds (.bounds (.lighting state))]
      (assert (> (.y bounds) 82.0))
      (assert (< (+ (.x bounds) (.w bounds)) 768.0)))
    (gallery/event 4 53 0.0 0.0)
    (assert (not (.open (.lighting state))))
    (o/release pool)))
