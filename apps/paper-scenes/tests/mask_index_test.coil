(module paper-scenes.mask-index-test)
(import "paper.masks" :as masks)
(import "paper.scene" :as scene)
(import "paper.objc" :as o)
(import "paper.ffi" :use *)

(defn triangle [(phase f64)] (-> (ptr i8))
  (let [path (CGPathCreateMutable)]
    (CGPathMoveToPoint path (cast (ptr CGAffine) 0) phase 0.0)
    (CGPathAddLineToPoint path (cast (ptr CGAffine) 0) 8.0 0.0)
    (CGPathAddLineToPoint path (cast (ptr CGAffine) 0) 4.0 8.0)
    (CGPathCloseSubpath path)
    path))

(defn key [(path (ptr i8))] (-> masks/Key)
  (masks/Key :path path :edges (o/nil) :text (o/nil) :x 0.0 :y 0.0 :width 0.0
             :height 0.0 :size 0.0 :font 0 :kind 0))

(deftest mask-index-grows-resolves-bucket-collisions-and-resets
  (let [pool (o/new c"NSAutoreleasePool") count 4097]
    (scene/init) (masks/reset)
    ; Reserve keys without rasterization: this test isolates the owning index.
    (set! (.preparing (masks/cache)) true)
    (for [i 0 count]
      (masks/lookup (key (triangle (/ (cast f64 i) 8192.0))) 16 16)
      (assert (= (.last-entry (masks/cache)) i)))
    (assert (> (len (.buckets (masks/cache))) 8192))
    (let [(mut occupied) 0]
      (for [i 0 (len (.buckets (masks/cache)))]
        (when (>= (get (.buckets (masks/cache)) i) 0)
          (set! occupied (+ (load occupied) 1))))
      (assert (> (load occupied) 3000)))
    (for [i 0 count]
      (let [slot (- (- count 1) i)]
        (masks/lookup (key (triangle (/ (cast f64 slot) 8192.0))) 16 16)
        (assert (= (.last-entry (masks/cache)) slot))))
    (assert (= (len (.entries (masks/cache))) count))
    ; Deliberately collapse the table, exercising collision chains and exact
    ; path comparison without requiring an accidental 64-bit hash collision.
    (masks/rebuild-index 2)
    (for [i 0 32]
      (masks/lookup (key (triangle (/ (cast f64 i) 8192.0))) 16 16)
      (assert (= (.last-entry (masks/cache)) i)))
    (masks/reset)
    (assert (= (len (.entries (masks/cache))) 0))
    (assert (= (len (.buckets (masks/cache))) 0))
    (masks/lookup (key (triangle 0.125)) 16 16)
    (assert (= (.last-entry (masks/cache)) 0))
    (masks/reset) (set! (.preparing (masks/cache)) false)
    (o/release pool)))

(deftest mask-key-hash-preserves-numeric-zero-equivalence
  (let [positive (triangle 0.0) negative (triangle -0.0)]
    (assert (masks/equal (key positive) (key negative)))
    (assert (= (masks/key-hash (key positive) 16 16)
               (masks/key-hash (key negative) 16 16)))
    (CGPathRelease positive) (CGPathRelease negative)))

(defn check-recency [] (-> i64)
  (let [cache (masks/cache) (mut slot) (.oldest cache) (mut previous) -1
        (mut visited) 0 (mut used) -1]
    (while (>= (load slot) 0)
      (let [entry (get (.entries cache) (load slot))]
        (assert (= (.older entry) (load previous)))
        (assert (> (.used entry) (load used)))
        (set! used (.used entry))
        (set! previous (load slot))
        (set! slot (.newer entry))
        (set! visited (+ (load visited) 1))
        (assert (<= (load visited) (len (.entries cache))))))
    (assert (= (load visited) (len (.entries cache))))
    (assert (= (load previous) (.newest cache))))
  0)

(deftest mask-lru-remaps-moved-slots-and-preserves-recent-keys
  (let [pool (o/new c"NSAutoreleasePool")]
    (scene/init) (masks/reset)
    (set! (.preparing (masks/cache)) true)
    (for [i 0 8] (masks/lookup (key (triangle (cast f64 i))) 16 16))
    (masks/lookup (key (triangle 0.0)) 16 16)
    (masks/lookup (key (triangle 3.0)) 16 16)
    (check-recency)
    (let [first (get (.entries (masks/cache)) (.oldest (masks/cache)))
          expected (triangle 1.0)]
      (assert (CGPathEqualToPath (.path (.key first)) expected))
      (CGPathRelease expected))
    (masks/evict-oldest) (masks/rebuild-index 32)
    (check-recency)
    (for [i 0 8]
      (when (!= i 1)
        (masks/lookup (key (triangle (cast f64 i))) 16 16)
        (assert (= (len (.entries (masks/cache))) 7))
        (check-recency)))
    (for [i 0 7] (masks/evict-oldest) (check-recency))
    (masks/rebuild-index 32)
    (masks/lookup (key (triangle 0.0)) 16 16)
    (assert (= (len (.entries (masks/cache))) 1))
    (check-recency)
    (masks/reset) (set! (.preparing (masks/cache)) false)
    (o/release pool)))
