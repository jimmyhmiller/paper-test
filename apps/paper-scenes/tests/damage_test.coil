(module paper-scenes.damage-test)
(import "paper-scenes.workload" :as bench)
(import "paper.scene" :as scene)
(import "paper.render" :as render)
(import "paper.damage" :as damage)
(import "paper.masks" :as masks)
(import "paper.gpu" :as gpu)
(import "paper.platform" :as host)
(import "paper.workers" :as workers)
(import "paper.surface" :use *)
(import "paper.material" :use *)
(import "paper.geometry" :use [rect clamp])
(import "paper.objc" :as o)
(import "paper.ffi" :use [CGBitmapContextGetData cgrect sqrt])
(import "coil.alloc" :as alloc)

(extern memcpy :cc c [(ptr u8) (ptr u8) u64] (-> (ptr u8)))

(extern memcmp :cc c [(ptr u8) (ptr u8) u64] (-> i32))

(deftest motion-workloads-change-geometry-in-all-eight-themes
         (let [pool (o/new c"NSAutoreleasePool")]
           (setup 640 420 0.5)
           (for [theme 0 8]
             (bench/draw-case theme 2 11 4)
             (render/render-frame true)
             (bench/draw-case theme 2 12 4)
             (scene/sort-commands)
             (let [bounds (damage/measure)]
               (assert (and (> (.w bounds) 0.0) (> (.h bounds) 0.0)))))
           (workers/stop)
           (o/release pool)))

(defn setup [(width i64) (height i64) (scale f64)] (-> i64)
  (scene/init)
  (set! (.headless (host/host)) true)
  (set! (.width (scene/scene)) width)
  (set! (.height (scene/scene)) height)
  (set! (.scale (scene/scene)) scale)
  (render/setup))

(defn cursor-scene [(cursor bool) (crossing bool)] (-> i64)
  (host/paper_begin 0xeee8d9)
  (panel (rect 4.0 4.0 280.0 180.0) 7.0 10.0 (cream))
  (when crossing (panel (rect 40.0 36.0 110.0 45.0) 5.0 10.0 (clay)))
  (ink-height 10.0)
  (host/paper_ink 30.0 40.0 18.0 0x273c38 2 c"overlapping ink")
  (when cursor (host/paper_rule 32.0 80.0 2.0 19.0 0x273c38))
  (when (not crossing) (panel (rect 40.0 36.0 110.0 45.0) 5.0 10.0 (clay)))
  (panel (rect 220.0 110.0 45.0 40.0) 5.0 20.0 (sage))
  (host/paper_ink 220.0 115.0 10.0 0x273c38 0 c"later")
  0)

(deftest cursor-insertion-and-removal-retain-the-unchanged-painter-suffix
         (let [pool (o/new c"NSAutoreleasePool")]
           (setup 300 200 1.0)
           (cursor-scene false false)
           (render/render-frame true)
           (for [i 0 4]
             (cursor-scene (= (% i 2) 0) false)
             (scene/sort-commands)
             (let [bounds (damage/measure)]
               (assert (< (.x bounds) 33.0))
               (assert (> (.x bounds) 28.0))
               (assert (< (.w bounds) 8.0))
               (assert (< (.h bounds) 25.0)))
             (render/render-frame true))
           (workers/stop)
           (o/release pool)))

(defn assert-full-agreement [(copy (ptr u8)) (bytes u64)] (-> i64)
  (memcpy copy (CGBitmapContextGetData (.output-context (scene/scene))) bytes)
  (set! (.valid (damage/cache)) false)
  (set! (.geometry-dirty (scene/scene)) true)
  (set! (.reference (masks/visibility)) true)
  (render/render-frame true)
  (assert (= (memcmp copy
                     (CGBitmapContextGetData (.output-context (scene/scene)))
                     bytes)
             (cast i32 0)))
  (set! (.reference (masks/visibility)) false)
  0)

(defn separated-edits [(selection i64) (cursor bool)] (-> i64)
  (host/paper_begin 0xeee8d9)
  (panel (rect 4.0 4.0 280.0 180.0) 7.0 1.0 (watercolor 0xeee8d9))
  (ink-height 10.0)
  (host/paper_rule (+ 20.0 (* 10.0 (cast f64 selection)))
                   20.0
                   8.0
                   12.0
                   0x273c38)
  (panel (rect 220.0 40.0 45.0 40.0) 5.0 11.0 (sage))
  (ink-height 12.0)
  (when cursor (host/paper_rule 32.0 80.0 2.0 19.0 0x273c38))
  0)

(deftest independent-selection-and-cursor-edits-retain-interior-commands
         (let [pool (o/new c"NSAutoreleasePool")
               copy (cast (ptr u8) (alloc/malloc 240000))]
           (setup 300 200 1.0)
           (separated-edits 0 false)
           (render/render-frame true)
           (for [i 0 8]
             (separated-edits (% (+ i 1) 2) (= (% i 2) 0))
             (scene/sort-commands)
             (let [bounds (damage/measure)]
               (assert (> (.x bounds) 15.0))
               (assert (< (+ (.x bounds) (.w bounds)) 45.0)))
             (masks/micro-reset)
             (render/rasterize-frame false)
             (when (.available (gpu/gpu))
               (assert (> (.prepared-pixels (masks/micro-cache)) 0))
               (assert (< (.prepared-pixels (masks/micro-cache)) 3000))
               (assert (> (.w (.pending (gpu/gpu))) 0.0))
               (assert (< (.w (.pending (gpu/gpu))) 45.0)))
             (render/render-frame true)
             (when (.available (gpu/gpu))
               (assert (> (load (masks/last-composed-area)) 0.0))
               (assert (< (load (masks/last-composed-area)) 800.0)))
             (assert-full-agreement copy 240000))
           (render/free (cast (ptr i8) copy))
           (workers/stop)
           (o/release pool)))

(deftest lighting-dispatch-padding-bounds-the-unchanged-shadow-sampler
         (scene/init)
         (set! (.width (scene/scene)) 2560)
         (set! (.height (scene/scene)) 1680)
         (for [backing 1 4]
           (let [scale (* (cast f64 backing) 0.5)
                 w (/ 2560.0 scale)
                 h (/ 1680.0 scale)]
             (set! (.scale (scene/scene)) scale)
             (for [variant 0 4]
               (let [lx (case variant 0 -600.0 1 256.0 2 3000.0 0.0)
                     ly (case variant 0 900.0 1 -220.0 2 1400.0 0.0)
                     elevation (case variant 0 10.0 1 700.0 2 300.0 100000.0)
                     depth (case variant 0 0.0 1 0.45 2 1.0 0.45)]
                 (host/paper_light lx ly elevation depth 0.8)
                 (let [padding (gpu/shadow-padding)]
                   (assert (<= padding (+ (* 181.0 scale) 2.0)))
                   (for [yi 0 17]
                     (for [xi 0 17]
                       (let [dx (- lx (* w (/ (cast f64 xi) 16.0)))
                             dy (- ly (* h (/ (cast f64 yi) 16.0)))
                             horizontal (sqrt (+ (+ (* dx dx) (* dy dy)) 0.001))
                             reach
                               (clamp (/ (* (* 64.0 (.depth (scene/scene)))
                                            horizontal)
                                         (.elevation (scene/scene)))
                                      1.0
                                      180.0)]
                         (assert (>= padding (+ (* (+ reach 0.6) scale) 1.0)))))))))))
         (set! (.scale (scene/scene)) 2.0)
         (host/paper_light 256.0 -220.0 700.0 0.45 0.8)
         (assert (< (gpu/shadow-padding) 150.0)))

(deftest overlapping-regions-share-depth-without-changing-coverage
         (let [pool (o/new c"NSAutoreleasePool")
               copy (cast (ptr u8) (alloc/malloc 240000))]
           (setup 300 200 1.0)
           (for [variant 0 4]
             (cursor-scene (= (% variant 2) 0) (= (% (/ variant 2) 2) 0))
             (render/render-frame true)
             (when (.available (gpu/gpu))
               (let [c (damage/cache)
                     bounds (cgrect 10.0 15.0 180.0 120.0)]
                 (store! (index (field c regions) 0)
                         (cgrect 10.0 15.0 120.0 100.0))
                 (store! (index (field c regions) 1)
                         (cgrect 60.0 30.0 130.0 105.0))
                 (store! (index (field c regions) 2)
                         (cgrect 25.0 20.0 130.0 90.0))
                 (masks/render-regions (index (field c regions) 0) 3 bounds)
                 (damage/include bounds)
                 (render/render-frame true)))
             (assert-full-agreement copy 240000))
           (render/free (cast (ptr i8) copy))
           (workers/stop)
           (o/release pool)))

(deftest damage-regions-merge-transitively-and-bound-fragmentation
         (scene/init)
         (damage/reset)
         (damage/include (cgrect 0.0 0.0 10.0 10.0))
         (damage/include (cgrect 20.0 0.0 10.0 10.0))
         (damage/include (cgrect 10.0 0.0 10.0 10.0))
         (assert (= (.region-count (damage/cache)) 1))
         (damage/include (cgrect 100.0 100.0 5.0 5.0))
         (assert (= (.region-count (damage/cache)) 2))
         (damage/reset)
         (for [i 0 80]
           (damage/include (cgrect (* (cast f64 i) 10.0) 0.0 2.0 2.0)))
         (assert (and (> (.region-count (damage/cache)) 0)
                      (<= (.region-count (damage/cache)) 32)))
         (for [i 0 80]
           (let [x (+ (* (cast f64 i) 10.0) 1.0)
                 (mut covered) false]
             (for [j 0 (.region-count (damage/cache))]
               (let [r (index (field (damage/cache) regions) j)]
                 (when (and (<= (.x r) x)
                            (>= (+ (.x r) (.w r)) x)
                            (<= (.y r) 1.0)
                            (>= (+ (.y r) (.h r)) 1.0))
                   (set! covered true))))
             (assert (load covered)))))

(deftest repeated-and-reordered-painter-commands-match-full-render
         (let [pool (o/new c"NSAutoreleasePool")
               copy (cast (ptr u8) (alloc/malloc 240000))]
           (setup 300 200 1.0)
           (for [frame 0 48]
             (host/paper_begin 0xeee8d9)
             (for [i 0 (+ 3 (% frame 5))]
               (let [token (% (+ (* i (+ frame 1)) (/ frame 3)) 3)]
                 (panel (rect (+ 30.0 (* 15.0 (cast f64 token)))
                              35.0
                              100.0
                              90.0)
                        5.0
                        10.0
                        (if (= token 0) (cream) (if (= token 1) (clay) (sage))))))
             (render/render-frame true)
             (assert-full-agreement copy 240000))
           ; Exceed the edit budget: conservative fallback must retain correctness.
           (for [frame 0 2]
             (host/paper_begin 0xeee8d9)
             (for [i 0 80]
               (ink-height 10.0)
               (host/paper_rule (cast f64 (+ 5 (* (% i 20) 12)))
                                (cast f64 (+ 5 (* (/ i 20) 35)))
                                8.0
                                20.0
                                (if (= frame 0) 0x273c38 0xa8412c)))
             (render/render-frame true)
             (assert-full-agreement copy 240000))
           (render/free (cast (ptr i8) copy))
           (workers/stop)
           (o/release pool)))

(deftest incremental-insert-remove-and-equal-height-interleaving-match-full-render
         (let [pool (o/new c"NSAutoreleasePool")
               copy (cast (ptr u8) (alloc/malloc 240000))]
           (setup 300 200 1.0)
           (for [i 0 16]
             (cursor-scene (= (% i 2) 0) (= (% (/ i 2) 2) 0))
             (render/render-frame true)
             (assert-full-agreement copy 240000))
           (render/free (cast (ptr i8) copy))
           (workers/stop)
           (o/release pool)))

(deftest complex-scenes-incremental-and-visibility-reference-agree
         (let [pool (o/new c"NSAutoreleasePool")
               copy (cast (ptr u8) (alloc/malloc 1075200))]
           (setup 640 420 0.5)
           (for [theme 0 8]
             (for [scenario 0 3]
               (for [frame 0 3]
                 (let [frame-pool (o/new c"NSAutoreleasePool")]
                   (bench/draw-case theme scenario (+ frame 7) 4)
                   (render/render-frame true)
                   (assert-full-agreement copy 1075200)
                   (o/release frame-pool)))))
           (render/free (cast (ptr i8) copy))
           (workers/stop)
           (o/release pool)))
