(module paper-scenes.vector-ink-test)
(import "paper.scene" :as scene)
(import "paper.render" :as render)
(import "paper.platform" :as host)
(import "paper.surface" :use *)
(import "paper.material" :use [cream])
(import "paper.geometry" :use [rect])
(import "paper.ffi" :use [CGBitmapContextGetData])
(import "paper.objc" :as o)
(import "paper.workers" :as workers)
(import "coil.alloc" :as alloc)
(import "coil.primitive" :as p)
(extern memcpy :cc c [(ptr u8) (ptr u8) u64] (-> (ptr u8)))
(extern memcmp :cc c [(ptr u8) (ptr u8) u64] (-> i32))

(deftest printed-vector-path-preserves-paper-height-counters-and-layout-clipping
  (let [pool (o/new c"NSAutoreleasePool")
        heights (cast (ptr u8) (alloc/malloc 14400))
        pixels (cast (ptr u8) (alloc/malloc 57600))]
    (scene/init) (set! (.headless (host/host)) true)
    (set! (.width (scene/scene)) 120) (set! (.height (scene/scene)) 120)
    (set! (.scale (scene/scene)) 1.0) (render/setup)
    (host/paper_begin 0xeeeeee) (panel (rect 5.0 5.0 110.0 110.0) 3.0 12.0 (cream))
    (render/render)
    (memcpy heights (CGBitmapContextGetData (.height-context (scene/scene))) 14400)
    (memcpy pixels (CGBitmapContextGetData (.output-context (scene/scene))) 57600)
    (host/paper_begin 0xeeeeee) (panel (rect 5.0 5.0 110.0 110.0) 3.0 12.0 (cream))
    (ink-height 12.0)
    (begin-sheet) (oval-path (rect 20.0 20.0 80.0 80.0)) (oval-path (rect 40.0 40.0 40.0 40.0))
    (with-clip (rect 50.0 0.0 70.0 120.0)
      (host/paper_path_ink (.path (scene/scene)) 0x173b4a))
    ; Release and replace the caller's path before rendering: ink owns its copy.
    (begin-sheet)
    (render/render)
    (assert (= (memcmp heights (CGBitmapContextGetData (.height-context (scene/scene))) 14400) (cast i32 0)))
    (let [output (CGBitmapContextGetData (.output-context (scene/scene)))]
      (assert (!= (memcmp (index pixels (* (+ (* 30 120) 70) 4)) (index output (* (+ (* 30 120) 70) 4)) 4) (cast i32 0)))
      (assert (= (memcmp (index pixels (* (+ (* 30 120) 30) 4)) (index output (* (+ (* 30 120) 30) 4)) 4) (cast i32 0)))
      (assert (= (memcmp (index pixels (* (+ (* 60 120) 60) 4)) (index output (* (+ (* 60 120) 60) 4)) 4) (cast i32 0))))
    (p/free (cast (ptr i8) heights)) (p/free (cast (ptr i8) pixels))
    (workers/stop) (o/release pool)))
