(module paper-scenes.artwork-test)
(import "paper-scenes.ukiyo" :as ukiyo)
(import "paper.scene" :as scene)
(import "paper.ffi" :use *)
(extern printf :cc c [(ptr i8) ...] (-> i32))
(extern fflush :cc c [(ptr i8)] (-> i32))

(deftest header-stock-continues-under-cherry-occluders
  (scene/init)
  (let [path (ukiyo/cloud-path 3)
        paper [(CGPoint :x 70.0 :y 75.0) (CGPoint :x 95.0 :y 60.0)
               (CGPoint :x 130.0 :y 55.0) (CGPoint :x 180.0 :y 55.0)]]
    (for [i 0 4]
      (assert (CGPathContainsPoint path (cast (ptr CGAffine) 0) (get paper i) true)))
    (assert (not (CGPathContainsPoint path (cast (ptr CGAffine) 0)
                   (CGPoint :x 91.0 :y 43.0) true)))))

(deftest surf-stock-keeps-the-central-navy-opening-and-caches-ink-tones
  (scene/init)
  (for [which 0 6]
    (let [path (ukiyo/wave-asset which)]
      (assert (not (CGPathIsEmpty path)))
      (assert (= path (ukiyo/wave-asset which)))))
  (let [paper (ukiyo/wave-asset 5)]
    (assert (CGPathContainsPoint paper (cast (ptr CGAffine) 0) (CGPoint :x 120.0 :y 490.0) true))
    (assert (CGPathContainsPoint paper (cast (ptr CGAffine) 0) (CGPoint :x 600.0 :y 490.0) true))
    (for [x 280 380]
      (for [y 480 512]
        (assert (not (CGPathContainsPoint paper (cast (ptr CGAffine) 0)
                      (CGPoint :x (cast f64 x) :y (cast f64 y)) true)))))))

(deftest folded-wrapping-stock-preserves-printable-pane-interiors
  (scene/init)
  (for [face 0 8]
    (let [path (ukiyo/fold-path face) pane (ukiyo/fold-pane face)
          inner (ukiyo/pane-path pane 3)
          edge (CGPathCreateCopyByStrokingPath inner (cast (ptr CGAffine) 0) 0.1 1 1 10.0)]
      (assert (not (CGPathIsEmpty path)))
      (assert (= path (ukiyo/fold-path face)))
      (for [y 125 490]
        (for [x 214 730]
          (let [point (CGPoint :x (+ (cast f64 x) 0.5) :y (+ (cast f64 y) 0.5))]
            (when (CGPathContainsPoint path (cast (ptr CGAffine) 0) point true)
              (assert (CGPathContainsPoint (ukiyo/pane-path pane 1) (cast (ptr CGAffine) 0) point true))
              ; Quartz classifies some shared boundary points inside both
              ; Boolean results. Bound this to 0.05 reference units, as in the
              ; pane containment test; runtime geometry has no expansion.
              (assert (or (not (CGPathContainsPoint inner (cast (ptr CGAffine) 0) point true))
                          (CGPathContainsPoint edge (cast (ptr CGAffine) 0) point true)))))))
      (CGPathRelease edge)))
  (for [pane 0 4]
    (for [layer 0 2]
      (let [path (ukiyo/pane-backing pane layer)]
        (assert (not (CGPathIsEmpty path)))
        (assert (= path (ukiyo/pane-backing pane layer)))
        (for [y 60 245]
          (for [x 35 370]
            (let [point (CGPoint :x (cast f64 (* x 2)) :y (cast f64 (* y 2)))]
              (when (CGPathContainsPoint (ukiyo/pane-path pane 0) (cast (ptr CGAffine) 0) point true)
                (assert (CGPathContainsPoint path (cast (ptr CGAffine) 0) point true))))))))))

(deftest foothill-stock-and-printed-grain-are-cached-with-cloud-occlusion
  (scene/init)
  (let [interiors [(CGPoint :x 470.0 :y 115.0) (CGPoint :x 500.0 :y 130.0)]]
    (for [ridge 0 2]
      (let [path (ukiyo/ridge-path ridge) grain (ukiyo/ridge-grain ridge)]
        (assert (= path (ukiyo/ridge-path ridge)))
        (assert (= grain (ukiyo/ridge-grain ridge)))
        (assert (not (CGPathIsEmpty grain)))
        (assert (CGPathContainsPoint path (cast (ptr CGAffine) 0) (get interiors ridge) true))
        (for [y 100 175]
          (for [x 350 710]
            (let [point (CGPoint :x (+ (cast f64 x) 0.5) :y (+ (cast f64 y) 0.5))]
              (when (CGPathContainsPoint (ukiyo/cloud-path 3) (cast (ptr CGAffine) 0) point true)
                (assert (not (CGPathContainsPoint path (cast (ptr CGAffine) 0) point true)))))))))))

(deftest traced-paper-keeps-continuous-printable-interiors
  (scene/init)
  (let [regions [(cgrect 96.0 167.0 101.0 230.0)
                 (cgrect 241.0 190.0 262.0 235.0)
                 (cgrect 577.0 216.0 98.0 52.0)
                 (cgrect 568.0 339.0 119.0 49.0)]]
    (for [pane 0 4]
      (let [path (ukiyo/pane-path pane 3) area (get regions pane)]
        (for [y 0 11]
          (for [x 0 11]
            (assert (CGPathContainsPoint path (cast (ptr CGAffine) 0)
                       (CGPoint :x (+ (.x area) (* (.w area) (/ (cast f64 x) 10.0)))
                                :y (+ (.y area) (* (.h area) (/ (cast f64 y) 10.0))))
                       true))))))))

(defn coverage [(path (ptr i8)) (scale f64) (edge-tolerance f64)] (-> (ptr i8))
  (let [color-space (CGColorSpaceCreateDeviceRGB)
        width (cast u64 (* 768.0 scale)) height (cast u64 (* 512.0 scale))
        context (CGBitmapContextCreate (cast (ptr i8) 0) width height 8 (* width (cast u64 4)) color-space 0x4001)]
    (CGColorSpaceRelease color-space)
    (CGContextScaleCTM context scale scale)
    (CGContextSetRGBFillColor context 1.0 0.0 0.0 1.0)
    (let [shape (if (> edge-tolerance 0.0)
                    (let [stroke (CGPathCreateCopyByStrokingPath path (cast (ptr CGAffine) 0)
                                    (* edge-tolerance 2.0) 1 1 10.0)
                          expanded (CGPathCreateCopyByUnioningPath path stroke true)]
                      (CGPathRelease stroke) expanded)
                    (CGPathCreateCopy path))]
      (CGContextAddPath context shape) (CGContextEOFillPath context)
      (CGPathRelease shape))
    context))

(deftest canonical-paper-layers-cover-inner-stock-with-subpixel-precision
  (scene/init)
  (for [pane 0 4]
    (for [layer 0 3]
      (let [outer (ukiyo/pane-path pane layer) inner (ukiyo/pane-path pane (+ layer 1))]
        (for [resolution 1 4]
          ; Quartz Boolean operations can change Bezier decomposition and its
          ; antialias coverage. Bound containment error to 0.05 reference units,
          ; tighter than the author's 0.28-unit contour simplification tolerance.
          ; This expansion is a test measurement only; runtime paths are unchanged.
          (let [scale (cast f64 resolution) a (coverage outer scale 0.05) b (coverage inner scale 0.0)
                outer-pixels (CGBitmapContextGetData a) inner-pixels (CGBitmapContextGetData b)
                (mut maximum) 0]
            (for [i 0 (* (* 768 512) (* resolution resolution))]
              (let [difference (- (cast i64 (load (index inner-pixels (* i 4))))
                                  (cast i64 (load (index outer-pixels (* i 4)))))]
                (when (> difference (load maximum)) (set! maximum difference))))
            (printf c"pane %lld layer %lld scale %lld excess beyond 0.05-unit boundary tolerance %lld\n"
                    pane layer resolution (load maximum))
            (fflush (cast (ptr i8) 0))
            (assert (<= (load maximum) 1))
            (CGContextRelease a) (CGContextRelease b)))
        (assert (= outer (ukiyo/pane-path pane layer)))
        0))))
