      (curve-to 705.0 244.0 706.0 261.0 713.0 274.0)
      (curve-to 718.0 284.0 704.0 291.0 692.0 295.0)
      (curve-to 665.0 306.0 642.0 315.0 614.0 311.0)
      (curve-to 583.0 308.0 554.0 319.0 544.0 297.0)
      (curve-to 536.0 279.0 542.0 253.0 541.0 229.0)
      (curve-to 540.0 201.0 548.0 183.0 567.0 180.0))
    6 (do
      (move-to 559.0 302.0)
      (curve-to 602.0 300.0 651.0 307.0 702.0 303.0)
      (curve-to 729.0 302.0 739.0 320.0 737.0 347.0)
      (curve-to 733.0 386.0 733.0 426.0 740.0 463.0)
      (curve-to 742.0 485.0 718.0 494.0 683.0 492.0)
      (curve-to 634.0 488.0 587.0 496.0 551.0 490.0)
      (curve-to 531.0 486.0 530.0 465.0 535.0 440.0)
      (curve-to 540.0 401.0 529.0 365.0 534.0 336.0)
      (curve-to 537.0 316.0 541.0 306.0 559.0 302.0))
    (do
      (move-to 560.0 308.0)
      (curve-to 603.0 305.0 651.0 312.0 701.0 309.0)
      (curve-to 724.0 307.0 734.0 323.0 731.0 348.0)
      (curve-to 727.0 388.0 729.0 428.0 734.0 463.0)
      (curve-to 736.0 483.0 715.0 488.0 683.0 487.0)
      (curve-to 635.0 483.0 588.0 491.0 553.0 485.0)
      (curve-to 537.0 481.0 537.0 462.0 541.0 439.0)
      (curve-to 546.0 400.0 536.0 365.0 540.0 337.0)
      (curve-to 542.0 320.0 545.0 313.0 560.0 308.0)))
