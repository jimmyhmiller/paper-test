(defn navy-crease [(which i64)] (-> i64)
  (case which
    0 (do
      (move-to 78.0 151.0)
      (curve-to 82.0 134.0 102.0 130.0 129.0 132.0)
      (curve-to 151.0 133.0 179.0 130.0 200.0 136.0)
      (curve-to 210.0 139.0 216.0 145.0 218.0 155.0)
      (curve-to 211.0 143.0 194.0 139.0 171.0 139.0)
      (curve-to 143.0 138.0 112.0 134.0 93.0 140.0)
      (curve-to 86.0 142.0 82.0 147.0 78.0 151.0))
    1 (do
      (move-to 74.0 163.0)
      (curve-to 66.0 194.0 70.0 223.0 71.0 253.0)
      (curve-to 74.0 290.0 68.0 325.0 74.0 361.0)
      (curve-to 78.0 387.0 75.0 417.0 84.0 440.0)
      (curve-to 71.0 419.0 74.0 388.0 69.0 364.0)
      (curve-to 63.0 326.0 69.0 291.0 66.0 254.0)
      (curve-to 65.0 220.0 64.0 184.0 74.0 163.0))
    2 (do
      (move-to 240.0 475.0)
      (curve-to 270.0 485.0 294.0 481.0 317.0 484.0)
      (curve-to 338.0 487.0 354.0 481.0 374.0 487.0)
      (curve-to 397.0 494.0 423.0 495.0 448.0 490.0)
      (curve-to 425.0 498.0 395.0 498.0 371.0 492.0)
      (curve-to 351.0 485.0 336.0 494.0 314.0 489.0)
      (curve-to 290.0 484.0 261.0 490.0 240.0 475.0))
    3 (do
      (move-to 548.0 206.0)
      (curve-to 541.0 244.0 544.0 281.0 548.0 314.0)
      (curve-to 553.0 353.0 546.0 391.0 549.0 424.0)
      (curve-to 542.0 400.0 548.0 354.0 543.0 316.0)
      (curve-to 539.0 279.0 537.0 238.0 548.0 206.0))
    4 (do
      (move-to 710.0 209.0)
      (curve-to 704.0 239.0 707.0 260.0 716.0 273.0)
      (curve-to 721.0 284.0 707.0 291.0 693.0 295.0)
      (curve-to 706.0 286.0 714.0 282.0 709.0 272.0)
      (curve-to 700.0 253.0 699.0 229.0 710.0 209.0))
    (do
      (move-to 722.0 315.0)
      (curve-to 737.0 331.0 730.0 356.0 731.0 380.0)
      (curve-to 731.0 398.0 734.0 415.0 733.0 432.0)
      (curve-to 728.0 413.0 726.0 397.0 726.0 378.0)
      (curve-to 725.0 351.0 731.0 333.0 722.0 315.0)))
  (close-path))

;;; Fold faces in the reference's 768 x 512 coordinates. The caller clips each
;;; face to its pane's exposed wrapping stock, preserving the printable inset.
(defn outline [(which i64)] (-> i64)
  (case which
    0 (do
      (move-to 224.0 147.0)
      (curve-to 233.0 128.0 280.0 130.0 308.0 135.0)
      (curve-to 332.0 138.0 332.0 156.0 356.0 162.0)
      (curve-to 370.0 168.0 399.0 171.0 421.0 170.0)
      (curve-to 376.0 177.0 346.0 172.0 332.0 158.0)
      (curve-to 312.0 141.0 266.0 137.0 224.0 147.0))
    1 (do
      (move-to 334.0 151.0)
      (curve-to 373.0 175.0 451.0 154.0 508.0 165.0)
      (curve-to 527.0 169.0 534.0 182.0 534.0 206.0)
      (curve-to 533.0 181.0 520.0 178.0 501.0 177.0)
      (curve-to 439.0 172.0 373.0 182.0 349.0 172.0)
      (curve-to 341.0 167.0 337.0 159.0 334.0 151.0))
    2 (do
      (move-to 218.0 433.0)
      (curve-to 224.0 467.0 253.0 458.0 289.0 456.0)
      (curve-to 353.0 450.0 376.0 466.0 435.0 475.0)
      (curve-to 461.0 479.0 486.0 475.0 505.0 471.0)
      (curve-to 469.0 490.0 426.0 486.0 382.0 474.0)
      (curve-to 322.0 459.0 294.0 472.0 256.0 471.0)
      (curve-to 227.0 470.0 215.0 458.0 218.0 433.0))
    3 (do
      (move-to 278.0 456.0)
      (curve-to 356.0 472.0 412.0 467.0 465.0 451.0)
      (curve-to 499.0 442.0 516.0 434.0 526.0 415.0)
      (curve-to 519.0 449.0 498.0 461.0 464.0 466.0)
      (curve-to 397.0 478.0 342.0 467.0 278.0 456.0))
    4 (do
      (move-to 549.0 208.0)
      (curve-to 554.0 185.0 576.0 181.0 609.0 185.0)
      (curve-to 640.0 188.0 679.0 179.0 696.0 198.0)
      (curve-to 677.0 188.0 646.0 197.0 610.0 193.0)
      (curve-to 579.0 189.0 558.0 190.0 549.0 208.0))
    5 (do
      (move-to 546.0 279.0)
      (curve-to 555.0 309.0 583.0 300.0 620.0 301.0)
      (curve-to 646.0 303.0 667.0 301.0 690.0 294.0)
      (curve-to 675.0 309.0 644.0 309.0 617.0 306.0)
      (curve-to 581.0 302.0 554.0 321.0 546.0 279.0))
    6 (do
      (move-to 544.0 338.0)
      (curve-to 552.0 310.0 578.0 311.0 612.0 314.0)
      (curve-to 650.0 318.0 696.0 307.0 715.0 320.0)
      (curve-to 696.0 316.0 666.0 325.0 630.0 322.0)
      (curve-to 590.0 319.0 559.0 314.0 544.0 338.0))
    (do
      (move-to 719.0 328.0)
      (curve-to 732.0 366.0 716.0 400.0 721.0 436.0)
      (line-to 715.0 450.0)
      (curve-to 708.0 407.0 725.0 364.0 719.0 328.0)))
  (close-path))
