(module paper-scenes.folds)
(import "paper.surface" :use *)

;;; The navy wraps follow separate folds, not constant-distance pane offsets.
;;; Coordinates are in the reference's 768 x 512 space. The caller unions the
;;; inner stock into each backing so the folds cannot expose unsupported paper.
(defn backing-outline [(pane i64) (layer i64)] (-> i64)
  (case (+ (* pane 2) layer)
    0 (do
      (move-to 93.0 128.0)
      (curve-to 121.0 124.0 171.0 129.0 200.0 129.0)
      (curve-to 225.0 129.0 229.0 149.0 226.0 181.0)
      (curve-to 222.0 237.0 222.0 287.0 224.0 340.0)
      (curve-to 226.0 394.0 228.0 432.0 210.0 456.0)
      (curve-to 196.0 477.0 170.0 482.0 143.0 475.0)
      (curve-to 114.0 469.0 94.0 479.0 80.0 459.0)
      (curve-to 67.0 439.0 74.0 400.0 68.0 370.0)
      (curve-to 62.0 329.0 67.0 294.0 65.0 263.0)
      (curve-to 62.0 225.0 60.0 186.0 65.0 157.0)
      (curve-to 68.0 137.0 76.0 130.0 93.0 128.0))
    1 (do
      (move-to 95.0 136.0)
      (curve-to 132.0 130.0 168.0 136.0 200.0 134.0)
      (curve-to 219.0 136.0 224.0 153.0 220.0 182.0)
      (curve-to 217.0 232.0 219.0 293.0 219.0 344.0)
      (curve-to 221.0 393.0 223.0 431.0 204.0 454.0)
      (curve-to 183.0 476.0 161.0 476.0 140.0 468.0)
      (curve-to 115.0 461.0 95.0 471.0 84.0 450.0)
      (curve-to 76.0 429.0 80.0 399.0 76.0 369.0)
      (curve-to 71.0 328.0 75.0 288.0 72.0 257.0)
      (curve-to 69.0 218.0 69.0 181.0 73.0 161.0)
      (curve-to 76.0 144.0 82.0 137.0 95.0 136.0))
    2 (do
      (move-to 232.0 122.0)
      (curve-to 258.0 118.0 301.0 121.0 325.0 125.0)
      (curve-to 343.0 129.0 344.0 149.0 364.0 153.0)
      (curve-to 408.0 163.0 463.0 149.0 512.0 154.0)
      (curve-to 542.0 158.0 553.0 176.0 552.0 208.0)
      (curve-to 549.0 255.0 548.0 304.0 551.0 350.0)
      (curve-to 555.0 400.0 552.0 450.0 533.0 475.0)
      (curve-to 517.0 499.0 475.0 494.0 439.0 498.0)
      (curve-to 408.0 503.0 378.0 488.0 348.0 490.0)
      (curve-to 318.0 493.0 287.0 495.0 255.0 487.0)
      (curve-to 220.0 486.0 204.0 465.0 205.0 427.0)
      (curve-to 202.0 381.0 208.0 334.0 207.0 290.0)
      (curve-to 204.0 250.0 209.0 208.0 207.0 176.0)
      (curve-to 206.0 145.0 214.0 127.0 232.0 122.0))
    3 (do
      (move-to 233.0 127.0)
      (curve-to 261.0 123.0 300.0 127.0 322.0 129.0)
      (curve-to 339.0 132.0 340.0 154.0 362.0 159.0)
      (curve-to 409.0 168.0 467.0 154.0 513.0 160.0)
      (curve-to 538.0 164.0 548.0 182.0 547.0 210.0)
      (curve-to 543.0 254.0 544.0 305.0 547.0 351.0)
      (curve-to 551.0 403.0 545.0 449.0 528.0 472.0)
      (curve-to 510.0 491.0 474.0 489.0 439.0 493.0)
      (curve-to 405.0 496.0 375.0 482.0 348.0 485.0)
      (curve-to 319.0 489.0 287.0 490.0 256.0 482.0)
      (curve-to 226.0 481.0 211.0 462.0 211.0 426.0)
      (curve-to 208.0 377.0 214.0 333.0 212.0 290.0)
      (curve-to 210.0 249.0 215.0 207.0 212.0 176.0)
      (curve-to 212.0 149.0 218.0 132.0 233.0 127.0))
    4 (do
      (move-to 567.0 173.0)
      (curve-to 602.0 172.0 654.0 176.0 682.0 174.0)
      (curve-to 709.0 174.0 719.0 195.0 714.0 219.0)
      (curve-to 711.0 243.0 710.0 257.0 719.0 271.0)
      (curve-to 727.0 284.0 713.0 295.0 694.0 299.0)
      (curve-to 664.0 309.0 643.0 320.0 614.0 317.0)
      (curve-to 581.0 313.0 550.0 325.0 537.0 299.0)
      (curve-to 529.0 280.0 536.0 253.0 535.0 229.0)
