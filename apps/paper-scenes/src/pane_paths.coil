(defn pane-path [(pane i64) (layer i64) (sx f64) (sy f64)] (-> i64)
  (case (+ (* pane 4) layer)
    0 (pane-0-0 sx sy)
    1 (pane-0-1 sx sy)
    2 (pane-0-2 sx sy)
    3 (pane-0-3 sx sy)
    4 (pane-1-0 sx sy)
    5 (pane-1-1 sx sy)
    6 (pane-1-2 sx sy)
    7 (pane-1-3 sx sy)
    8 (pane-2-0 sx sy)
    9 (pane-2-1 sx sy)
    10 (pane-2-2 sx sy)
    11 (pane-2-3 sx sy)
    12 (pane-3-0 sx sy)
    13 (pane-3-1 sx sy)
    14 (pane-3-2 sx sy)
    (pane-3-3 sx sy)
  ))
(defn backing-path [(pane i64) (layer i64) (sx f64) (sy f64)] (-> i64)
  (case (+ (* pane 2) layer)
    0 (backing-0-0 sx sy)
    1 (backing-0-1 sx sy)
    2 (backing-1-0 sx sy)
    3 (backing-1-1 sx sy)
    4 (backing-2-0 sx sy)
    5 (backing-2-1 sx sy)
    6 (backing-3-0 sx sy)
    (backing-3-1 sx sy)
  ))
