(module paper-scenes.art-clipping)
(import "coil.cc" :as cc)
(import "paper.ffi" :use *)

(defstruct Element [(kind i32) (points (ptr CGPoint))])

(extern CGPathApply
        :cc
        (cc/C)
        [(ptr i8) (ptr i8) (fnptr (cc/C) [(ptr i8) (ptr Element)] void)]
        (-> void))

(extern CGPathAddQuadCurveToPoint
        :cc
        (cc/C)
        [(ptr i8) (ptr CGAffine) f64 f64 f64 f64]
        (-> void))

(defstruct ClipState
  [(result (ptr i8)) (affected (ptr i8)) (part (ptr i8)) (bounds CGRect)])

(defn intersects [(a CGRect) (b CGRect)] (-> bool)
  (and (<= (.x a) (+ (.x b) (.w b)))
       (>= (+ (.x a) (.w a)) (.x b))
       (<= (.y a) (+ (.y b) (.h b)))
       (>= (+ (.y a) (.h a)) (.y b))))

(defn flush-contour [(state (ptr ClipState))] (-> i64)
  (when (not (CGPathIsEmpty (.part state)))
    (let [part (.part state)]
      (CGPathAddPath (if (intersects (CGPathGetPathBoundingBox part)
                                     (.bounds state))
                         (.affected state)
                         (.result state))
                     (cast (ptr CGAffine) 0)
                     part)
      (CGPathRelease part)
      (set! (.part state) (CGPathCreateMutable))))
  0)

(defn clip-element [(context (ptr i8)) (element (ptr Element))] (-> void)
  (let [state (cast (ptr ClipState) context)
        points (.points element)
        transform (cast (ptr CGAffine) 0)]
    (case (.kind element)
      0
        (do
          (flush-contour state)
          (CGPathMoveToPoint (.part state)
                             transform
                             (.x (index points 0))
                             (.y (index points 0))))
      1
        (CGPathAddLineToPoint (.part state)
                              transform
                              (.x (index points 0))
                              (.y (index points 0)))
      2
        (CGPathAddQuadCurveToPoint (.part state)
                                   transform
                                   (.x (index points 0))
                                   (.y (index points 0))
                                   (.x (index points 1))
                                   (.y (index points 1)))
      3
        (CGPathAddCurveToPoint (.part state)
                               transform
                               (.x (index points 0))
                               (.y (index points 0))
                               (.x (index points 1))
                               (.y (index points 1))
                               (.x (index points 2))
                               (.y (index points 2)))
      (CGPathCloseSubpath (.part state))))
  0)

(defn partition-contours [(state (ptr ClipState))
                          (source (ptr i8))
                          (boundary (ptr i8))] (-> i64)
  (set! (.result state) (CGPathCreateMutable))
  (set! (.affected state) (CGPathCreateMutable))
  (set! (.part state) (CGPathCreateMutable))
  (set! (.bounds state) (CGPathGetPathBoundingBox boundary))
  (CGPathApply source (cast (ptr i8) state) (fnptr-of clip-element))
  (flush-contour state)
  (CGPathRelease (.part state))
  0)

;;; Keep the complete source in the Boolean operation. Although subtraction
;;; distributes over even-odd contours geometrically, CoreGraphics normalizes
;;; curves during the operation. Partitioning and then recombining contours
;;; changes antialiased coverage, which compounds across successive cuts.
(defn subtract-contours [(source (ptr i8)) (occluder (ptr i8))] (-> (ptr i8))
  (if (or (CGPathIsEmpty source) (CGPathIsEmpty occluder))
      (CGPathCreateCopy source)
      (CGPathCreateCopyBySubtractingPath source occluder true)))

;;; For intersection, disjoint contours cannot contribute to the result.
;;; Batch possible contributors once, preserving even-odd holes and overlaps.
(defn intersect-contours [(source (ptr i8)) (boundary (ptr i8))] (-> (ptr i8))
  (let [(mut state) (zeroed ClipState)]
    (partition-contours (mut state) source boundary)
    (let [result
            (if (CGPathIsEmpty (.affected state))
                (CGPathCreateMutable)
                (CGPathCreateCopyByIntersectingPath (if (CGPathIsEmpty (.result state))
                                                        source
                                                        (.affected state))
                                                    boundary
                                                    true))]
      (CGPathRelease (.result state))
      (CGPathRelease (.affected state))
      result)))
