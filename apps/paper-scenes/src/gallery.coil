(module paper-scenes.gallery)
(import "coil.primitive" :as p)
(import "paper-scenes.art" :as art)
(import "paper-scenes.botanical" :as botanical)
(import "paper-scenes.ukiyo" :as ukiyo)
(import "paper.surface" :use *)
(import "paper.material" :use *)
(import "paper.geometry" :use [Rect rect inset])
(import "paper.platform" :as host)
(import "paper.scene" :as scene)
(import "paper.lighting" :as light)
(import "paper.ffi" :use [sin cos])

(defstruct State [(theme i64) (selection i64) (density i64) (animated bool) (time f64) (motion f64) (lighting light/Lighting)])
(defn state [] (-> (ptr State)) (p/alloc-static State))

(defn title [(theme i64)] (-> (ptr i8))
  (case theme 0 c"Botanical" 1 c"Alpine" 2 c"Orbit" 3 c"Atelier"
              4 c"Starry" 5 c"Ukiyo" 6 c"Geometry" c"Color study"))

;;; Layout responds in native points. The decoration never owns content bounds.
(defn pane [(i i64) (w f64) (h f64)] (-> Rect)
  (let [left 80.0 top 222.0 gap 64.0 sidebar (* w 0.205) right (* w 0.235)
        editor (- w (+ (+ (+ (* left 2.0) sidebar) right) (* gap 2.0)))
        body (- h 287.0) rx (- w (+ left right))]
    (case i
      0 (rect left top sidebar body)
      1 (rect (+ (+ left sidebar) gap) top editor body)
      2 (rect rx top right (* body 0.39))
      (rect rx (+ top (+ (* body 0.39) 60.0)) right (- (* body 0.61) 60.0)))))

(defn paper-color [(theme i64)] (-> u32)
  (if (= theme 2) 0x182330 0xead8b0))
(defn ink-color [(theme i64)] (-> u32)
  (if (= theme 2) 0xe2d5b9 0x263c3e))

(defn surface-z [(theme i64)] (-> f64) (if (= theme 0) 11.0 19.0))
(defn content-pane [(theme i64) (i i64) (w f64) (h f64)] (-> Rect)
  (if (= theme 0) (botanical/pane i w h) (pane i w h)))

(defn frame-stack [(theme i64) (w f64) (h f64)] (-> i64)
  (for [layer 0 (if (= theme 4) 15 11)]
    (let [n (cast f64 layer) layers (if (= theme 4) 15.0 11.0)
          expansion (* (+ n 1.0) 1.8)]
      (begin-sheet)
      (rounded-path (rect (+ 7.0 (* n 0.7)) (+ 183.0 (* n 1.5)) (- w (+ 14.0 (* n 1.4)))
                          (- h (+ 192.0 (* n 2.2)))) 38.0)
      (for [i 0 4]
        (art/aperture (inset (pane i w h) (- 0.0 expansion)) (+ (* n 0.45) (cast f64 i))))
      (finish-sheet (+ 20.0 (* n 1.15)) (art/paper theme (if (>= n (- layers 1.0)) 0 (+ layer 1))))))
  (for [i 0 4]
    (begin-sheet)
    (art/aperture (pane i w h) (cast f64 i))
    (finish-sheet 19.0 (cotton (paper-color theme))))
  0)

(defn text [(x f64) (y f64) (size f64) (color u32) (font i64) (value (ptr i8))] (-> i64)
  (host/paper_ink x y size color font value))

(defn file-name [(i i64)] (-> (ptr i8))
  (case i 0 c"main.bea" 1 c"vm.bea" 2 c"gc.bea" c"value.bea"))

(defn workspace [(r Rect) (theme i64) (selected i64)] (-> i64)
  (let [x (+ (.x r) 22.0) y (+ (.y r) 34.0) ink (ink-color theme)]
    (ink-height (surface-z theme))
    (text x y 16.0 ink 3 c"Workspace")
    (text x (+ y 38.0) 15.0 ink 0 c"⌄  beagle")
    (text (+ x 15.0) (+ y 70.0) 15.0 ink 0 c"⌄  src")
    (for [i 0 4]
      (let [fy (+ y (+ 105.0 (* (cast f64 i) 33.0)))]
        (when (= i selected)
          (panel (rect (+ x 13.0) (- fy 3.0) (- (.w r) 49.0) 29.0) 5.0 (+ (surface-z theme) 0.3)
                 (cotton (if (= theme 2) 0x276594 0x9cb7ad))))
        (ink-height (+ (surface-z theme) 0.6))
        (text (+ x 24.0) fy 14.0 ink 2 (file-name i))
        (host/paper_hit (+ 100 i) (+ x 13.0) (- fy 3.0) (- (.w r) 49.0) 29.0 (file-name i) 1 0.0)))
    (for [i 0 4]
      (text x (+ y (+ 254.0 (* (cast f64 i) 33.0))) 15.0 ink 0
            (case i 0 c"›  tests" 1 c"›  docs" 2 c"›  notes" c"›  scratch"))))
  0)

(defn source-line [(i i64)] (-> (ptr i8))
  (case i 0 c"fn main() {" 1 c"  let msg =" 2 c"    \"Hello, Beagle\"" 3 c"  println(msg)" 4 c"}"
          5 c"" 6 c"// A small example" 7 c"fn fib(n) {" 8 c"  if n <= 1 {" 9 c"    n"
          10 c"  } else {" 11 c"    fib(n - 1)" 12 c"      + fib(n - 2)" 13 c"  }" c"}"))

(defn editor [(r Rect) (theme i64) (selected i64) (cursor bool)] (-> i64)
  (let [x (+ (.x r) 25.0) y (+ (.y r) 35.0) ink (ink-color theme)
        numbers [c"1" c"2" c"3" c"4" c"5" c"6" c"7" c"8" c"9" c"10" c"11" c"12" c"13" c"14" c"15"]]
    (ink-height (surface-z theme))
    (text x y 15.0 ink 3 (file-name selected))
    (art/disc (+ x 116.0) (+ y 9.0) 4.5 (+ (surface-z theme) 0.4) (art/paper theme 4))
    (ink-height (surface-z theme))
    (for [i 0 15]
      (let [ly (+ y (+ 49.0 (* (cast f64 i) 25.0)))]
        (text x ly 12.0 (if (= theme 2) 0x73818a 0xa3987c) 2 (get numbers i))
        (text (+ x 32.0) ly 14.0 (case i 2 (if (= theme 2) 0xeea582 0xa24b32) 6 0x899083 ink) 2 (source-line i))))
    (host/paper_rule (+ x 24.0) (+ y 49.0) 0.6 374.0 (if (= theme 2) 0x33414a 0xc7ba9b))
    (when cursor (host/paper_rule (+ x 34.0) (+ y 399.0) 1.5 19.0 ink)))
  0)

(defn content [(theme i64) (w f64) (h f64) (selected i64) (cursor bool)] (-> i64)
  (workspace (content-pane theme 0 w h) theme selected)
  (editor (content-pane theme 1 w h) theme selected cursor)
  (let [r (content-pane theme 2 w h) x (+ (.x r) 24.0) y (+ (.y r) 37.0) ink (ink-color theme)]
    (ink-height (surface-z theme))
    (text x y 16.0 ink 3 c"Outline")
    (host/paper_rule x (+ y 28.0) (- (.w r) 48.0) 0.6 (if (= theme 2) 0x41505b 0xbdb192))
    (text x (+ y 47.0) 15.0 ink 2 c"›  main()")
    (text x (+ y 82.0) 15.0 ink 2 c"›  ƒ fib(n)"))
  (let [r (content-pane theme 3 w h) x (+ (.x r) 24.0) y (+ (.y r) 22.0) ink (ink-color theme)]
    (ink-height (surface-z theme))
    (if (= theme 0)
      (do
        (text x y 16.0 ink 0 c"Docs")
        (text x (+ y 52.0) 20.0 0x706345 1 c"Small")
        (text x (+ y 80.0) 20.0 0x706345 1 c"programs.")
        (text x (+ y 116.0) 20.0 0x706345 1 c"Large")
        (text x (+ y 144.0) 20.0 0x706345 1 c"horizons.")
        0)
      (do
        (text x y 16.0 ink 3 c"Terminal")
        (text x (+ y 52.0) 14.0 ink 2 c"beagle > cargo run")
        (text x (+ y 82.0) 14.0 ink 2 c"Hello, Beagle")
        (text x (+ y 112.0) 14.0 ink 2 c"beagle >")
        (when cursor (host/paper_rule (+ x 79.0) (+ y 114.0) 8.0 17.0 ink))
        0)))
  0)

;;; Deterministic scene entry shared by the interactive app, image tests and benchmarks.
;;; Density changes actual decorative geometry; motion deforms the ribbons/leaves.
(defn compose [(theme i64) (w f64) (h f64) (density i64) (motion f64) (selected i64) (cursor bool)] (-> i64)
  (assert (and (>= theme 0) (< theme 8) (>= density 1) (<= density 8)))
  (host/paper_begin (art/pigment theme 0))
  (when (!= theme 0) (panel (rect 0.0 0.0 w h) 0.0 2.0 (art/paper theme 0)))
  (cond (= theme 0) (botanical/draw w h motion)
        (= theme 5) (ukiyo/draw w h motion selected cursor)
        (or (= theme 1) (= theme 5)) (art/mountains w h theme)
        (or (= theme 2) (= theme 4)) (art/night w h theme density motion)
        (or (= theme 6) (= theme 7)) (art/geometric w h theme motion)
        :else (do
          (for [i 0 22]
            (art/ribbon 0.0 (+ 9.0 (* (cast f64 i) 9.0)) w (+ 60.0 motion) 12.0
                        (+ 5.0 (* 0.5 (cast f64 i))) (art/paper theme i)))
          0))
  (when (and (!= theme 0) (!= theme 5)) (frame-stack theme w h))
  (when (= theme 1)
    (for [i 0 9]
      (let [x (+ (+ (* w 0.8) (* (cast f64 i) 24.0)) (* motion (sin (cast f64 i))))
            y (+ 47.0 (* 10.0 (sin (cast f64 i))))]
        (for [branch 0 4]
          (let [b (cast f64 branch)]
            (begin-sheet) (move-to x (+ y (* b 14.0)))
            (line-to (- x (+ 9.0 (* b 4.0))) (+ y (+ 23.0 (* b 14.0))))
            (line-to (+ x (+ 9.0 (* b 4.0))) (+ y (+ 23.0 (* b 14.0)))) (close-path)
            (finish-sheet (+ 26.0 (* b 0.5)) (art/paper theme 0)))))))
  (when (!= theme 5)
  (content theme w h selected cursor)
  (ink-height 45.0)
  (text (if (= theme 0) (* w 0.14) 73.0) (if (= theme 0) 17.0 40.0)
        (if (= theme 0) 72.0 66.0) (if (or (= theme 2) (= theme 4)) 0xe5c997 0xf0dfba) 1 c"jim")
  (when (!= theme 0) (text 77.0 117.0 11.0 0xe9d9b9 0 c"EXPLORE  /  BUILD  /  REPEAT"))
  (panel (rect (- w 550.0) (if (= theme 0) 37.0 129.0) 386.0 49.0) 24.0 41.0 (cotton 0xd5bd8f))
  (panel (rect (- w 546.0) (if (= theme 0) 41.0 133.0) 378.0 41.0) 20.0 42.0 (cotton 0xefe1bd))
  (ink-height 42.0)
  (text (- w 528.0) (if (= theme 0) 53.0 145.0) 15.0 0x586353 0 c"⌕   Find in workspace...")
  (for [i 0 8]
    (let [x (+ 76.0 (* (cast f64 i) (/ (- w 152.0) 8.0))) y (- h 37.0)]
      (panel (rect x y (- (/ (- w 152.0) 8.0) 5.0) 25.0) 7.0 43.0
             (art/paper theme (if (= i theme) 3 0)))
      (ink-height 43.0)
      (text (+ x 8.0) (+ y 5.0) 11.0 (if (= i theme) 0x273c3e 0xf0dcaf) 0 (title i))
      (host/paper_hit (+ 10 i) x y (- (/ (- w 152.0) 8.0) 5.0) 25.0 (title i) 1 0.0))))
  0)

(defn draw [] (-> i64)
  (let [s (state) w (host/logical-width) h (host/logical-height)]
    (compose (.theme s) w h (.density s) (.motion s) (.selection s) (< (sin (.time s)) 0.5))
    (light/apply-light (field s lighting) (rect 0.0 0.0 w h))
    (if (= (.theme s) 5)
        (light/popover-panel (field s lighting) 500 (ukiyo/sun-bounds w h))
        (light/popover (field s lighting) 500 (rect (- w 114.0) (if (= (.theme s) 0) 44.0 133.0) 34.0 34.0))))
  0)

(defn event [(kind i64) (id i64) (x f64) (y f64)] (-> i64)
  (let [s (state)]
    (when (= kind 0)
      (set! (.theme s) 5) (set! (.density s) 4)
      (set! (.lighting s) (light/lighting 0.2 -0.3 700.0 0.45 0.8)))
    (light/handle (field s lighting) 500 kind id x y)
    (when (= kind 3)
      (cond (and (>= id 10) (< id 18)) (set! (.theme s) (- id 10))
            (and (>= id 100) (< id 104)) (set! (.selection s) (- id 100)) :else 0)
      (host/paper_redraw))
    (when (and (= kind 4) (= id 49) (not (.open (.lighting s)))) (set! (.animated s) (not (.animated s))))
    (when (and (= kind 4) (or (= id 123) (= id 124)) (not (.open (.lighting s))))
      (set! (.theme s) (% (+ (.theme s) (if (= id 124) 1 7)) 8))
      (host/paper_redraw))
    (when (= kind 6)
      (set! (.time s) x)
      (when (.animated s) (set! (.motion s) (* 8.0 (sin x))))
      (host/paper_redraw)))
  0)

(defn run [] (-> i64)
  (host/paper_configure c"Paper — complex scene gallery" 1280.0 840.0)
  (host/paper_responsive 1150.0 820.0)
  (host/paper_tick_interval (/ 1.0 60.0))
  (host/paper_run (fnptr-of draw) (fnptr-of event)))
