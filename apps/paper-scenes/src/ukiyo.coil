(module paper-scenes.ukiyo)
(import "coil.primitive" :as p)
(import "paper.surface" :use *)
(import "paper.material" :use *)
(import "paper.geometry" :use [Rect rect])
(import "paper.platform" :as host)
(import "paper.scene" :as scene)
(import "paper-scenes.wave-paths" :as waves)
(import "paper-scenes.mountain-paths" :as fuji)
(import "paper-scenes.pane-paths" :as panes)
(import "paper-scenes.cloud-paths" :as clouds)
(import "paper.ffi" :use [sin cos sqrt CGPathCreateMutable CGPathAddEllipseInRect CGPathRelease CGAffine cgrect
                           CGPathMoveToPoint CGPathAddLineToPoint CGPathCloseSubpath CGPathAddCurveToPoint
                           CGPathCreateCopyByStrokingPath
                           CGPathCreateCopyByTransformingPath CGPathAddPath CGPathCreateCopyByUnioningPath
                           CGPathCreateCopy CGPathCreateCopyByIntersectingPath CGPathCreateCopyBySubtractingPath])

;;; Reference-sized design coordinates. Geometry and typesetting share the same
;;; transform, keeping the mountain, panels, branches and surf in composition.
(defstruct Canvas [(sx f64) (sy f64)])
(defn canvas [] (-> (ptr Canvas)) (p/alloc-static Canvas))
(defn move [(x f64) (y f64)] (-> i64)
  (move-to (* x (.sx (canvas))) (* y (.sy (canvas)))))
(defn line [(x f64) (y f64)] (-> i64)
  (line-to (* x (.sx (canvas))) (* y (.sy (canvas)))))
(defn curve [(a f64) (b f64) (c f64) (d f64) (e f64) (f f64)] (-> i64)
  (curve-to (* a (.sx (canvas))) (* b (.sy (canvas))) (* c (.sx (canvas)))
            (* d (.sy (canvas))) (* e (.sx (canvas))) (* f (.sy (canvas)))))
(defn paper [(color u32) (seed f64)] (-> Material)
  (let [(mut result) (texture-relief (texture-scale (watercolor color) 0.45) 0.14)]
    (set! (.seed result) seed)
    (load result)))
(defn finish [(z f64) (color u32) (seed f64)] (-> i64) (finish-sheet z (paper color seed)))
(defn box [(x f64) (y f64) (w f64) (h f64) (r f64) (z f64) (color u32)] (-> i64)
  (panel (rect (* x (.sx (canvas))) (* y (.sy (canvas))) (* w (.sx (canvas))) (* h (.sy (canvas))))
         (* r (.sx (canvas))) z (paper color 0.37)))
(defn disc [(x f64) (y f64) (rx f64) (ry f64) (z f64) (color u32)] (-> i64)
  (begin-sheet)
  (oval-path (rect (* (- x rx) (.sx (canvas))) (* (- y ry) (.sy (canvas)))
                   (* (* rx 2.0) (.sx (canvas))) (* (* ry 2.0) (.sy (canvas)))))
  (finish z color 0.62))
(defn text [(x f64) (y f64) (size f64) (color u32) (font i64) (value (ptr i8))] (-> i64)
  (host/paper_ink (* x (.sx (canvas))) (* y (.sy (canvas))) (* size (.sy (canvas))) color font value))

;;; Cubic tapered strokes are closed paper shapes. Used for wood grain,
;;; ridgelines, curling surf filaments and cherry stamens.
(defn stroke [(ax f64) (ay f64) (bx f64) (by f64) (cx f64) (cy f64)
              (dx f64) (dy f64) (width f64) (z f64) (color u32)] (-> i64)
  (begin-sheet)
  (for [side 0 2]
    (for [i 0 25]
      (let [t (/ (cast f64 (if (= side 0) i (- 24 i))) 24.0) u (- 1.0 t)
            x (+ (+ (* (* (* u u) u) ax) (* (* 3.0 (* u u)) (* t bx)))
                 (+ (* (* 3.0 u) (* (* t t) cx)) (* (* (* t t) t) dx)))
            y (+ (+ (* (* (* u u) u) ay) (* (* 3.0 (* u u)) (* t by)))
                 (+ (* (* 3.0 u) (* (* t t) cy)) (* (* (* t t) t) dy)))
            vx (+ (+ (* (* 3.0 (* u u)) (- bx ax)) (* (* 6.0 (* u t)) (- cx bx)))
                  (* (* 3.0 (* t t)) (- dx cx)))
            vy (+ (+ (* (* 3.0 (* u u)) (- by ay)) (* (* 6.0 (* u t)) (- cy by)))
                  (* (* 3.0 (* t t)) (- dy cy)))
            length (+ 0.0001 (sqrt (+ (* vx vx) (* vy vy))))
            radius (* (* width (+ 0.06 (* 0.94 u))) (if (= side 0) 0.5 -0.5))
            px (- x (* (/ vy length) radius)) py (+ y (* (/ vx length) radius))]
        (if (and (= side 0) (= i 0)) (move px py) (line px py)))))
  (close-path) (finish z color 0.48))

(defn sun-bounds [(w f64) (h f64)] (-> Rect)
  (rect (* (/ 546.0 768.0) w) (* (/ 10.0 512.0) h) (* (/ 72.0 768.0) w) (* (/ 72.0 512.0) h)))

(defn print-path [(source (ptr i8)) (color u32)] (-> i64)
  (let [path (CGPathCreateCopyByTransformingPath source
               (CGAffine :a (.sx (canvas)) :b 0.0 :c 0.0 :d (.sy (canvas)) :tx 0.0 :ty 0.0))]
    (host/paper_path_ink path color) (CGPathRelease path))
  0)

(defstruct MountainArt [(paths (array (ptr i8) 3))])
(defn mountain-art [] (-> (ptr MountainArt)) (p/alloc-static MountainArt))
(defn mountain-path [(which i64)] (-> (ptr i8))
  (let [slot (index (field (mountain-art) paths) which)]
    (when (= (load slot) (cast (ptr i8) 0))
      (begin-sheet)
      (case which 0 (fuji/ink-path 1.0 1.0) 1 (fuji/ridge-path 1.0 1.0) (fuji/grain-path 1.0 1.0))
      (store! slot (CGPathCreateCopy (.path (scene/scene)))))
    (load slot)))

(defn sun-path [] (-> (ptr i8))
  (let [slot (p/alloc-static (ptr i8))]
    (when (= (load slot) (cast (ptr i8) 0))
      (let [circle (CGPathCreateMutable)]
        (CGPathAddEllipseInRect circle (cast (ptr CGAffine) 0) (cgrect 546.0 10.0 72.0 72.0))
        (store! slot (CGPathCreateCopyBySubtractingPath circle (cloud-path 2) true))
        (CGPathRelease circle) 0))
    (load slot)))

;;; Reference-derived cut stock. Cache canonical outlines separately from ink.
(defstruct RidgeArt [(paths (array (ptr i8) 2)) (grain (array (ptr i8) 2))])
(defn ridge-art [] (-> (ptr RidgeArt)) (p/alloc-static RidgeArt))
(defn ridge-path [(which i64)] (-> (ptr i8))
  (let [slot (index (field (ridge-art) paths) which)]
    (when (= (load slot) (cast (ptr i8) 0))
      (begin-sheet)
      (if (= which 0) (fuji/blue-stock-path 1.0 1.0)
                       (fuji/charcoal-stock-path 1.0 1.0))
      (let [outline (CGPathCreateCopy (.path (scene/scene)))]
        (store! slot (CGPathCreateCopyBySubtractingPath outline (cloud-path 3) true))
        (CGPathRelease outline) 0))
    (load slot)))

(defn ridge-grain [(which i64)] (-> (ptr i8))
  (let [slot (index (field (ridge-art) grain) which)]
    (when (= (load slot) (cast (ptr i8) 0))
      (store! slot (CGPathCreateCopyByIntersectingPath (ridge-path which) (mountain-path 2) true)))
    (load slot)))

(defn mountain [] (-> i64)
  (let [visible (CGPathCreateCopyByTransformingPath (sun-path)
                   (CGAffine :a (.sx (canvas)) :b 0.0 :c 0.0 :d (.sy (canvas)) :tx 0.0 :ty 0.0))]
    (begin-sheet) (CGPathAddPath (.path (scene/scene)) (cast (ptr CGAffine) 0) visible)
    (finish 17.0 0xad3e2d 0.62)
    (ink-height 17.0)
    (host/paper_path_hit 500 visible c"Sun: adjust lighting" 0 0.0)
    (CGPathRelease visible))
  (let [base (CGPathCreateCopyByTransformingPath (mountain-path 0)
                (CGAffine :a (.sx (canvas)) :b 0.0 :c 0.0 :d (.sy (canvas)) :tx 0.0 :ty 0.0))]
    (begin-sheet) (CGPathAddPath (.path (scene/scene)) (cast (ptr CGAffine) 0) base)
    (finish 17.0 0x1b3e51 0.38) (CGPathRelease base))
  (ink-height 17.0)
  (print-path (mountain-path 1) 0x405c65)
  (print-path (mountain-path 2) 0x385663)
  (for [ridge 0 2]
    (let [path (CGPathCreateCopyByTransformingPath (ridge-path ridge)
                 (CGAffine :a (.sx (canvas)) :b 0.0 :c 0.0 :d (.sy (canvas)) :tx 0.0 :ty 0.0))]
      (begin-sheet) (CGPathAddPath (.path (scene/scene)) (cast (ptr CGAffine) 0) path)
      (finish (+ 18.0 (* (cast f64 ridge) 0.8))
              (if (= ridge 0) 0x4d6875 0x424c4a)
              (+ 0.29 (* (cast f64 ridge) 0.17)))
      (CGPathRelease path)
      (ink-height (+ 18.0 (* (cast f64 ridge) 0.8)))
      (print-path (ridge-grain ridge) (if (= ridge 0) 0x556e7a 0x4a534f))))
  0)

;;; Reference-derived connected cloud stock, cached in design coordinates.
(defstruct CloudArt [(paths (array (ptr i8) 6))])
(defn cloud-art [] (-> (ptr CloudArt)) (p/alloc-static CloudArt))
(defn cloud-path [(which i64)] (-> (ptr i8))
  (let [slot (index (field (cloud-art) paths) which)]
    (when (= (load slot) (cast (ptr i8) 0))
      (if (= which 5)
          (let [banks (CGPathCreateCopyByUnioningPath (cloud-path 1) (cloud-path 2) true)]
            (store! slot (CGPathCreateCopyByUnioningPath banks (cloud-path 4) true))
            (CGPathRelease banks) 0)
          (do
            (begin-sheet) (clouds/stock-path which 1.0 1.0)
            (store! slot (CGPathCreateCopy (.path (scene/scene)))))))
    (load slot)))

(defn clouds [] (-> i64)
  (for [i 0 2]
    (let [which (if (= i 0) 0 3)
          source (cloud-path which)
          path (CGPathCreateCopyByTransformingPath source
                 (CGAffine :a (.sx (canvas)) :b 0.0 :c 0.0 :d (.sy (canvas)) :tx 0.0 :ty 0.0))]
      (begin-sheet)
      (CGPathAddPath (.path (scene/scene)) (cast (ptr CGAffine) 0) path)
      (finish (case which 0 19.4 1 17.0 2 17.0 23.0)
              (case which 0 0xe5d4b3 1 0xe1cead 2 0xe1cead 0xe7d5b2)
              (case which 0 0.17 3 0.47 0.43))
      (CGPathRelease path)))
  0)

(defstruct PaneArt [(paths (array (ptr i8) 16))])
(defn pane-art [] (-> (ptr PaneArt)) (p/alloc-static PaneArt))
(defn pane-path [(which i64) (layer i64)] (-> (ptr i8))
  (let [slot (index (field (pane-art) paths) (+ (* which 4) layer))]
    (when (= (load slot) (cast (ptr i8) 0))
      (let [inner (if (< layer 3) (pane-path which (+ layer 1)) (cast (ptr i8) 0))]
        (begin-sheet) (panes/pane-path which layer 1.0 1.0)
        (store! slot (if (= inner (cast (ptr i8) 0))
                        (CGPathCreateCopy (.path (scene/scene)))
                        (CGPathCreateCopyByUnioningPath (.path (scene/scene)) inner true)))))
    (load slot)))

(defn panels [] (-> i64)
  (for [which 0 4]
    (for [layer 0 4]
      (let [colors [0x8c3427 0xb94f32 0xc99a69 0xe5d0a8]
            sidebar [0xab906b 0xc5ac80 0xd8bf94 0xe5d0a8]
            heights [20.0 21.5 24.0 25.25]
            source (pane-path which layer)
            path (CGPathCreateCopyByTransformingPath source
                   (CGAffine :a (.sx (canvas)) :b 0.0 :c 0.0 :d (.sy (canvas)) :tx 0.0 :ty 0.0))]
        (begin-sheet) (CGPathAddPath (.path (scene/scene)) (cast (ptr CGAffine) 0) path)
        (finish (get heights layer) (cast u32 (if (= which 0) (get sidebar layer) (get colors layer)))
                (+ 0.1 (* (cast f64 layer) 0.21)))
        (CGPathRelease path))))
  0)


;;; Five notched cherry petals, independent overlapping sheets, a warm calyx,
;;; fine radial filaments and individual anthers. No circular-dot flower stand-in.
(defn blossom [(x f64) (y f64) (radius f64) (rotation f64) (z f64)] (-> i64)
  (for [i 0 5]
    (let [angle (+ rotation (* (cast f64 i) 1.256637061)) dx (cos angle) dy (sin angle)
          r (* radius (+ 0.93 (* 0.1 (sin (+ (* (cast f64 i) 2.1) rotation)))))
          px (+ x (* dx r)) py (+ y (* dy r)) nx (- 0.0 dy) ny dx]
      (begin-sheet) (move x y)
      (curve (+ x (* nx (* r 0.50))) (+ y (* ny (* r 0.50)))
             (+ px (* nx (* r 0.58))) (+ py (* ny (* r 0.58)))
             (+ px (* nx (* r 0.21))) (+ py (* ny (* r 0.21))))
      (line (- px (* dx (* r 0.14))) (- py (* dy (* r 0.14))))
      (line (- px (* nx (* r 0.18))) (- py (* ny (* r 0.18))))
      (curve (- px (* nx (* r 0.59))) (- py (* ny (* r 0.59)))
             (- x (* nx (* r 0.47))) (- y (* ny (* r 0.47))) x y)
      (close-path) (finish (+ z (* (cast f64 i) 0.13)) (if (= (% i 2) 0) 0xe9c6a3 0xd9a78c) (+ 0.1 (* (cast f64 i) 0.17)))))
  ; The woodblock print lies on the petals; these marks have no paper thickness.
  (ink-height (+ z 0.8))
  (begin-sheet)
  (for [i 0 5]
    (let [angle (+ rotation (* (cast f64 i) 1.256637061)) dx (cos angle) dy (sin angle)
          r (* radius (+ 0.93 (* 0.1 (sin (+ (* (cast f64 i) 2.1) rotation)))))]
      (move x y)
      (curve (+ x (* dx (* r 0.4))) (+ y (* dy (* r 0.4)))
             (+ x (* dx (* r 0.65))) (+ y (* dy (* r 0.65)))
             (+ x (* dx (* r 0.82))) (+ y (* dy (* r 0.82))))))
  (let [veins (CGPathCreateCopyByStrokingPath (.path (scene/scene)) (cast (ptr CGAffine) 0)
                (* 0.25 (.sx (canvas))) 1 1 10.0)]
    (host/paper_path_ink veins 0xc0876c) (CGPathRelease veins))
  (begin-sheet)
  (for [i 0 11]
    (let [a (+ rotation (* (cast f64 i) 0.5711986)) r (* radius (+ 0.28 (* 0.13 (sin (cast f64 i)))))
          dx (* r (cos a)) dy (* r (sin a))]
      (move x y)
      (curve (+ x (* dx 0.4)) (+ y (* dy 0.3)) (+ x dx) (+ y (* dy 0.8))
             (+ x dx) (+ y dy))))
  (let [filaments (CGPathCreateCopyByStrokingPath (.path (scene/scene)) (cast (ptr CGAffine) 0)
                    (* 0.22 (.sx (canvas))) 1 1 10.0)]
    (host/paper_path_ink filaments 0x965436) (CGPathRelease filaments))
  (begin-sheet)
  (for [i 0 12]
    (let [a (+ rotation (* (cast f64 i) 0.5711986))
          r (if (= i 11) 0.0 (* radius (+ 0.28 (* 0.13 (sin (cast f64 i))))))
          rx (if (= i 11) (* radius 0.12) 0.55) ry (if (= i 11) rx 0.48)
          px (+ x (* r (cos a))) py (+ y (* r (sin a)))]
      (oval-path (rect (* (- px rx) (.sx (canvas))) (* (- py ry) (.sy (canvas)))
                       (* (* rx 2.0) (.sx (canvas))) (* (* ry 2.0) (.sy (canvas)))))))
  (host/paper_path_ink (.path (scene/scene)) 0xa4663e)
  0)

(defstruct BarkArt [(paths (array (ptr i8) 2))])
(defn bark-art [] (-> (ptr BarkArt)) (p/alloc-static BarkArt))
(defn bark-path [(which i64) (branch (ptr i8))] (-> (ptr i8))
  (let [slot (index (field (bark-art) paths) which)]
    (when (= (load slot) (cast (ptr i8) 0))
      (let [clip (CGPathCreateCopyByTransformingPath branch
                   (CGAffine :a (/ 1.0 (.sx (canvas))) :b 0.0 :c 0.0
                             :d (/ 1.0 (.sy (canvas))) :tx 0.0 :ty 0.0))]
        (begin-sheet)
        (for [i 0 25]
          (let [offset (* (- (cast f64 i) 12.0) 0.53)]
            (if (= which 0)
                (do (move-to (+ 2.0 offset) 324.0)
                    (curve-to (+ 30.0 (* offset 0.8)) 205.0
                              (+ -5.0 (* offset 0.5)) 57.0 160.0 -12.0))
                (do (move-to (+ 5.0 offset) 96.0)
                    (curve-to (+ 39.0 (* offset 0.4)) 54.0
                              (+ 126.0 (* offset 0.3)) 16.0 228.0 -7.0)))))
        (let [lines (CGPathCreateCopyByStrokingPath (.path (scene/scene)) (cast (ptr CGAffine) 0)
                       0.22 1 1 10.0)]
          (store! slot (CGPathCreateCopyByIntersectingPath lines clip true))
          (CGPathRelease lines) (CGPathRelease clip)
          0)))
    (load slot)))

(defn branches [(motion f64)] (-> i64)
  (stroke 2.0 324.0 30.0 205.0 -5.0 57.0 160.0 -12.0 12.0 27.0 0x41382c)
  (ink-height 27.1) (print-path (bark-path 0 (.path (scene/scene))) 0x64513d)
  (stroke 5.0 96.0 39.0 54.0 126.0 16.0 228.0 -7.0 10.0 28.0 0x44352a)
  (ink-height 28.1) (print-path (bark-path 1 (.path (scene/scene))) 0x64513d)
  (stroke 9.0 281.0 37.0 206.0 37.0 185.0 60.0 155.0 6.5 28.0 0x51412f)
  (stroke 11.0 203.0 30.0 163.0 46.0 141.0 63.0 116.0 4.5 28.0 0x46382c)
  (stroke 68.0 58.0 76.0 30.0 59.0 8.0 85.0 -5.0 5.0 28.0 0x54432e)
  (stroke 127.0 25.0 156.0 14.0 191.0 27.0 223.0 8.0 4.0 28.0 0x584530)
  (for [i 0 17]
    (let [n (cast f64 i) y (+ 26.0 (* n 16.0)) x (+ 15.0 (* 13.0 (sin (* n 0.7))))
          dx (if (= (% i 2) 0) 21.0 -15.0)]
      (stroke x y (+ x (* dx 0.4)) (- y 10.0) (+ x dx) (- y 12.0)
              (+ x dx) (- y 21.0) 1.4 29.0 0x5a4734)))
  (for [i 0 26]
    (let [n (cast f64 i) top (< i 11)
          x (if top (+ 15.0 (* n 18.0)) (+ 16.0 (* 17.0 (sin (* n 1.9)))))
          y (if top (+ 16.0 (* 12.0 (sin (* n 1.5)))) (+ 57.0 (* (- n 11.0) 15.0)))
          radius (+ 7.0 (* 4.0 (+ 1.0 (sin (* n 2.6)))))]
      (blossom (+ x (* motion (* 0.025 (sin n)))) y radius (* n 0.77) 31.0)))
  (for [i 0 14]
    (let [n (cast f64 i) x (+ 23.0 (* 195.0 (/ n 14.0))) y (+ 19.0 (* 25.0 (sin (* n 1.3))))]
      (disc x y 2.3 3.2 33.0 0xca8e74)
      (stroke x (+ y 2.0) (- x 1.0) (+ y 3.0) (- x 2.0) (+ y 5.0) (- x 4.0) (+ y 8.0) 0.8 32.0 0x624b35)))
  0)

;;; Keep canonical engraved surf paths and transform copies for the viewport.

(defstruct WaveArt [(paths (array (ptr i8) 4))])
(defn wave-art [] (-> (ptr WaveArt)) (p/alloc-static WaveArt))

(defn engraved-flow [] (-> i64)
  (for [group 0 5]
    (for [i 0 16]
      (let [n (cast f64 i) x (case group 0 81.0 1 135.0 2 438.0 3 557.0 690.0)
            y (case group 0 428.0 1 455.0 2 480.0 3 436.0 381.0)
            dx (* n 1.9) dy (* n 0.5)]
        (move-to (+ x dx) (+ y dy))
        (curve-to (+ x (+ dx 8.0)) (+ y 40.0)
                  (+ x (+ dx 21.0)) 499.0 (+ x (+ dx 55.0)) 514.0))))
  0)

(defn wave-asset [(which i64)] (-> (ptr i8))
  (let [slot (index (field (wave-art) paths) which)]
    (when (= (load slot) (cast (ptr i8) 0))
      (if (< which 3)
          (do
            (begin-sheet)
            (case which 0 (waves/ink-path 1.0 1.0) 1 (waves/mid-path 1.0 1.0) (waves/line-path 1.0 1.0))
            (store! slot (CGPathCreateCopy (.path (scene/scene))))
            0)
          (let [clip (wave-asset 0)]
            (begin-sheet) (engraved-flow)
            (let [stroke (CGPathCreateCopyByStrokingPath (.path (scene/scene)) (cast (ptr CGAffine) 0) 0.33 1 1 10.0)
                  clipped (CGPathCreateCopyByIntersectingPath stroke clip true)]
              (store! slot clipped) (CGPathRelease stroke))
            0)))
    (load slot)))

(defn print-wave-asset [(which i64) (color u32)] (-> i64)
  (print-path (wave-asset which) color))

(defn surf [] (-> i64)
  ; Uneven ivory undercut separates the foreground wave group from the panes.
  (begin-sheet) (move 0.0 411.0)
  (curve 39.0 390.0 46.0 422.0 80.0 407.0)
  (curve 100.0 398.0 105.0 445.0 139.0 435.0)
  (curve 172.0 427.0 163.0 471.0 201.0 467.0)
  (curve 230.0 467.0 230.0 498.0 277.0 504.0)
  (curve 364.0 516.0 376.0 491.0 421.0 470.0)
  (curve 451.0 449.0 470.0 488.0 501.0 475.0)
  (curve 532.0 455.0 548.0 424.0 577.0 426.0)
  (curve 614.0 423.0 622.0 449.0 654.0 418.0)
  (curve 689.0 385.0 685.0 359.0 717.0 363.0)
  (curve 738.0 339.0 750.0 350.0 768.0 341.0)
  (line 768.0 512.0) (line 0.0 512.0) (close-path) (finish 35.0 0xe1cfab 0.38)
  (ink-height 35.0)
  (print-wave-asset 0 0x214b5e)
  (print-wave-asset 1 0x496a74)
  (print-wave-asset 2 0x8e9b92)
  (print-wave-asset 3 0x83978f)
  0)

(defn file-icon [(x f64) (y f64) (folder bool)] (-> i64)
  (begin-sheet)
  (if folder
      (do
        (move x (+ y 1.0)) (line (+ x 4.0) (+ y 1.0)) (line (+ x 5.0) (+ y 3.0))
        (line (+ x 10.0) (+ y 3.0)) (line (+ x 10.0) (+ y 10.0)) (line x (+ y 10.0)) (close-path)
        (move (+ x 1.2) (+ y 3.0)) (line (+ x 3.3) (+ y 3.0)) (line (+ x 4.4) (+ y 4.3))
        (line (+ x 8.8) (+ y 4.3)) (line (+ x 8.8) (+ y 8.8)) (line (+ x 1.2) (+ y 8.8)) (close-path))
      (do
        (move x y) (line (+ x 5.0) y) (line (+ x 8.0) (+ y 3.0))
        (line (+ x 8.0) (+ y 10.0)) (line x (+ y 10.0)) (close-path)
        (move (+ x 1.1) (+ y 1.1)) (line (+ x 4.0) (+ y 1.1)) (line (+ x 4.0) (+ y 4.0))
        (line (+ x 6.9) (+ y 4.0)) (line (+ x 6.9) (+ y 8.9)) (line (+ x 1.1) (+ y 8.9)) (close-path)))
  (host/paper_path_ink (.path (scene/scene)) 0x26353a)
  0)

(defn contents [(selected i64) (cursor bool)] (-> i64)
  (let [ink (cast u32 0x26353a) names [c"main.bea" c"vm.bea" c"gc.bea" c"value.bea"]
        lines [c"fn main() {" c"  let msg = \"Hello, Beagle\"" c"  println(msg)" c"}" c""
               c"// A small example" c"fn fib(n) {" c"  if n <= 1 {" c"    n" c"  } else {"
               c"    fib(n - 1) + fib(n - 2)" c"  }" c"}"]
        numbers [c"1" c"2" c"3" c"4" c"5" c"6" c"7" c"8" c"9" c"10" c"11" c"12" c"13"]]
    (ink-height 27.0)
    (file-icon 94.0 162.0 true) (text 109.0 161.0 12.0 ink 0 c"Workspace")
    (text 96.0 183.0 11.5 ink 0 c"⌄") (file-icon 109.0 184.0 true) (text 124.0 183.0 11.5 ink 0 c"beagle")
    (text 108.0 204.0 11.5 ink 0 c"⌄") (file-icon 121.0 205.0 true) (text 136.0 204.0 11.5 ink 0 c"src")
    (for [i 0 4]
      (let [y (+ 226.0 (* (cast f64 i) 22.0))]
        (when (= i selected) (box 121.0 (- y 3.0) 84.0 19.0 2.0 27.3 0xc27651))
        (ink-height 28.0) (file-icon 127.0 (+ y 1.0) false) (text 140.0 y 10.5 ink 2 (get names i))
        (host/paper_hit (+ 100 i) (* 121.0 (.sx (canvas))) (* (- y 3.0) (.sy (canvas)))
