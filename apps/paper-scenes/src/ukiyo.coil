(defn draw [(w f64) (h f64) (motion f64) (selected i64) (cursor bool)] (-> i64)
  (set! (.sx (canvas)) (/ w 768.0)) (set! (.sy (canvas)) (/ h 512.0))
  (box 0.0 0.0 768.0 512.0 0.0 2.0 0xdfc9a3)
  (box 7.0 6.0 755.0 500.0 12.0 3.0 0x244959)
  (box 8.0 5.0 752.0 178.0 12.0 4.0 0x4c6571)
  (let [sky (CGPathCreateCopyByTransformingPath (cloud-path 5)
               (CGAffine :a (.sx (canvas)) :b 0.0 :c 0.0 :d (.sy (canvas)) :tx 0.0 :ty 0.0))]
    (begin-sheet) (CGPathAddPath (.path (scene/scene)) (cast (ptr CGAffine) 0) sky)
    (finish 17.0 0xe1cead 0.43) (CGPathRelease sky))
  (mountain) (panels) (clouds)
  ; The vermilion stock behind the left cherry branch is part of the reference
  ; composition, with a narrower ochre fold along the workspace pane.
  (begin-sheet) (move 6.0 108.0)
  (curve 40.0 116.0 76.0 121.0 96.0 139.0)
  (curve 80.0 158.0 84.0 187.0 78.0 214.0)
  (curve 63.0 236.0 73.0 270.0 60.0 299.0)
  (curve 41.0 325.0 46.0 371.0 16.0 399.0)
  (line 5.0 388.0) (close-path) (finish 18.0 0xa8412c 0.64)
  (begin-sheet) (move 89.0 142.0)
  (curve 73.0 180.0 82.0 220.0 64.0 259.0)
  (curve 67.0 224.0 65.0 189.0 78.0 158.0)
  (close-path) (finish 18.4 0xc47a4c 0.29)
  ; Shoji at the right edge: translucent stock and separate wooden lattice.
  (box 743.0 78.0 25.0 267.0 0.0 25.0 0x633b28)
  (box 731.0 100.0 30.0 227.0 0.0 26.0 0x9b5438)
  (box 735.0 105.0 24.0 216.0 0.0 27.0 0xd8c39f)
  (for [i 0 5] (box 734.0 (+ 109.0 (* (cast f64 i) 47.0)) 29.0 2.5 0.0 28.0 0x87513a))
  (box 745.0 102.0 2.0 223.0 0.0 28.0 0x88543a)
  (branches motion) (contents selected cursor) (surf)
  0)
