(module calculator.model-test)
(import "calculator.model" :use *)
(import "paper.ffi" :use [strcmp fabs])
(import "coil.primitive" :use [zeroed])

(defn near [(a f64) (b f64)] (-> bool)
  (< (fabs (- a b)) 0.0000000001))

(deftest unary-results-start-new-entry-and-complete-pending-operations
         (let [(mut s) (zeroed Calculator)]
           (reset s)
           (press s 9)
           (press s 26)
           (press s 2)
           (assert (near (.value s) 2.0))
           (press s 11)
           (press s 9)
           (press s 26)
           (press s 13)
           (assert (near (.value s) 5.0))
           (press s 2)
           (press s 15)
           (assert (near (.value s) 10.0))))

(deftest sign-preserves-decimal-entry-and-input-is-bounded
         (let [(mut s) (zeroed Calculator)]
           (reset s)
           (press s 18)
           (press s 5)
           (assert (= (strcmp (display s) c"-5") 0))
           (reset s)
           (press s 1)
           (press s 10)
           (press s 0)
           (press s 18)
           (press s 2)
           (assert (= (strcmp (display s) c"-1.02") 0))
           (press s 18)
           (assert (= (strcmp (display s) c"1.02") 0))
           (press s 16)
           (for [i 0 100] (press s 9))
           (assert (= (strcmp (display s) c"999999999999999") 0))
           (press s 27)
           (press s 27)
           (press s 27)
           (press s 27)
           (press s 27)
           (assert (.error s))))

(deftest decimal-entry-and-backspace
         (let [(mut s) (zeroed Calculator)]
           (reset s)
           (press s 0)
           (press s 0)
           (press s 1)
           (press s 10)
           (press s 10)
           (press s 2)
           (assert (= (strcmp (display s) c"1.2") 0))
           (press s 17)
           (assert (= (strcmp (display s) c"1.") 0))
           (press s 17)
           (press s 17)
           (assert (near (.value s) 0.0))))

(deftest chaining-operator-replacement-and-repeat
         (let [(mut s) (zeroed Calculator)]
           (reset s)
           (press s 2)
           (press s 11)
           (press s 13)
           (press s 3)
           (press s 11)
           (assert (near (.value s) 6.0))
           (press s 4)
           (press s 15)
           (assert (near (.value s) 10.0))
           (press s 15)
           (assert (near (.value s) 14.0))
           (press s 8)
           (assert (near (.value s) 8.0))
           (press s 15)
           (assert (near (.value s) 8.0))))

(deftest percent-and-sign
         (let [(mut s) (zeroed Calculator)]
           (reset s)
           (press s 2)
           (press s 0)
           (press s 0)
           (press s 11)
           (press s 1)
           (press s 0)
           (press s 19)
           (press s 15)
           (assert (near (.value s) 220.0))
           (press s 18)
           (assert (near (.value s) -220.0))))

(deftest domain-errors-recover-with-new-entry
         (let [(mut s) (zeroed Calculator)]
           (reset s)
           (set! (.degrees s) true)
           (press s 9)
           (press s 0)
           (press s 22)
           (assert (.error s))
           (reset s)
           (press s 1)
           (press s 14)
           (press s 0)
           (press s 15)
           (assert (.error s))
           (press s 9)
           (assert (not (.error s)))
           (assert (near (.value s) 9.0))
           (press s 18)
           (press s 26)
           (assert (.error s))
           (press s 16)
           (assert (not (.error s)))
           (press s 23)
           (assert (.error s))))

(deftest scientific-functions-and-powers
         (let [(mut s) (zeroed Calculator)]
           (reset s)
           (set! (.degrees s) true)
           (press s 9)
           (press s 0)
           (press s 20)
           (assert (< (fabs (- (.value s) 1.0)) 0.0000000001))
           (press s 16)
           (press s 2)
           (press s 25)
           (press s 3)
           (press s 15)
           (assert (near (.value s) 8.0))
           (press s 16)
           (press s 9)
           (press s 26)
           (assert (near (.value s) 3.0))
           (press s 27)
           (assert (near (.value s) 9.0))
           (press s 16)
           (press s 31)
           (press s 29)
           (press s 21)
           (assert (< (fabs (+ (.value s) 1.0)) 0.0000000001))
           (press s 30)
           (assert (.scientific s))
           (press s 16)
           (assert (.scientific s))))
