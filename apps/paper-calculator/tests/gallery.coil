(module calculator.gallery)
(import "calculator.ui" :as ui)
(import "calculator.model" :as model)
(import "paper.platform" :as host)
(import "paper.scene" :as scene)
(import "paper.render" :as render)
(import "paper.workers" :as workers)
(import "paper.objc" :as o)

(defn snapshot [(path (ptr i8))] (-> i64)
  (ui/draw)
  (render/render)
  (assert (= (render/snapshot path) 0))
  0)

(defn main [] (-> i64)
  (let [pool (o/new c"NSAutoreleasePool")]
    (scene/init)
    (host/paper_configure c"Paper Calculator" 620.0 790.0)
    (set! (.width (scene/scene)) 1240)
    (set! (.height (scene/scene)) 1580)
    (set! (.scale (scene/scene)) 2.0)
    (render/setup)
    (ui/event 0 0 0.0 0.0)
    (model/press (ui/state) 1)
    (model/press (ui/state) 2)
    (model/press (ui/state) 3)
    (model/press (ui/state) 4)
    (snapshot c"build/basic.png")
    (set! (.hover (host/host)) 500)
    (snapshot c"build/sun-hover.png")
    (set! (.hover (host/host)) 0)
    (model/press (ui/state) 30)
    (snapshot c"build/scientific.png")
    (set! (.open (ui/lighting)) true)
    (snapshot c"build/lighting.png")
    (workers/stop)
    (o/release pool))
  0)
